{{!-- The Save row every settings submenu ends with. Written once so a change to the button
      (an icon, a label, a second action) reaches every menu rather than whichever was edited. --}}
<footer class="sheet-footer flexrow">
	<button type="submit">
		<i class="fas fa-save"></i>
		{{localize "SETTINGS.Save"}}
	</button>
</footer>
