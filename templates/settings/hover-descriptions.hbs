<form class="stonetop-hover-settings">
	{{> "stonetop.settings-toggle-row" id="hover-descriptions-enabled" name="hoverDescriptionsEnabled"
	    labelKey="stonetop.settings.hoverDescriptionsEnabled.name"
	    hintKey="stonetop.settings.hoverDescriptionsEnabled.hint" checked=enabled}}

	<hr>

	{{#each settings}}
	{{> "stonetop.settings-toggle-row" id=key name=key label=name hint=hint checked=enabled}}
	{{/each}}

	{{> "stonetop.settings-save-footer"}}
</form>
