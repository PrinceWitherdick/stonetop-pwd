{{!-- Notes: the GM's own page about the place, its own tab as on Stonetop's sheet. The editor carries
      no `name` (the sheet saves it on its own change) and is drawn for anyone who may write, with
      or without the window header's wrench, as Stonetop's notes are. A reader gets the enriched text in
      the same bordered box, which Stonetop's notes always sit in. The `.stonetop-settlement-notes` wrapper sits INSIDE the tab,
      never on it, so its `display` cannot beat core's hidden-tab rule. --}}
<div class="tab notes stonetop-settlement-tab" data-group="primary" data-tab="notes">
	<section class="sheet-tab steading-notes stonetop-settlement-notes">
		{{!-- Stonetop's Plans (Make a Plan, Book I p.530), the same partial, kept in `system.plans`. Live for
		      anyone who may write, wrench or no, as Stonetop's are. --}}
		{{> "stonetop.steading-plans" plans=plans canEdit=canWrite titleId=(concat "settlement-plans-title-" actor.id)}}
		<h3 class="stonetop-move-group-title steading-notes-heading">{{localize "stonetop.settlement.tab.notes"}}</h3>
		{{#if canWrite}}
		<prose-mirror class="steading-notes-editor" value="{{system.notes}}" toggled data-document-uuid="{{actor.uuid}}">{{{this.enrichedNotes}}}</prose-mirror>
		{{else}}
		<div class="steading-notes-editor stonetop-settlement-notes-read"><div class="editor-content">{{{this.enrichedNotes}}}</div></div>
		{{/if}}
	</section>
</div>
