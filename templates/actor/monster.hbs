<form class="{{this.cssClass}} stonetop-monster-sheet" autocomplete="off">
	<div class="sheet-wrapper stonetop-monster-container">

		<header class="sheet-header stonetop-sheet-header stonetop-monster-header{{#unless stonetop.showPortrait}} stonetop-monster-header--no-portrait{{/unless}}">
			{{!-- The slot is what the crop pip positions against; the portrait keeps its own
			      sizing. Clicking it opens the People of Stonetop gallery in edit mode and the
			      portrait window in play mode — plenty of a monster's art is a person (bandits,
			      cultists, the Lodge), and the gallery carries "Browse files…" for the rest.

			      ONE slot for both modes, as on the character and NPC headers. The lock button
			      changes what a field DOES, not what a picture looks like, and while edit mode had
			      a branch of its own it drew the raw illustration where play mode drew the framed
			      face — so locking and unlocking re-cropped a face somebody had chosen. What the
			      two modes still differ in is answered in getData (stonetop.headerImg /
			      stonetop.showPortrait), not here.

			      NO data-edit: see the note in actor-header.hbs. Foundry's own binding on that
			      attribute runs first and cannot be called off, so while it was here the click
			      could only ever reach the raw file browser. --}}
			{{#if stonetop.showPortrait}}
			<span class="stonetop-portrait-slot">
				{{#if stonetop.portraitFramed}}
				{{!-- Framed: a clipping box, for the reason spelled out in actor-header.hbs. Only
				      real art can be framed, so the creature-type mark never takes this branch. --}}
				<span class="stonetop-portrait stonetop-portrait-clip" title="{{actor.name}}">
					<img class="stonetop-portrait-img" src="{{stonetop.portraitImg}}" style="{{stonetop.portraitImgStyle}}" alt="{{actor.name}}">
				</span>
				{{else}}
				<img class="stonetop-portrait" src="{{stonetop.headerImg}}"
				     title="{{actor.name}}" alt="{{actor.name}}">
				{{/if}}
				{{> "stonetop.portrait-frame-pip" canFrame=stonetop.canFramePortrait canTokenize=stonetop.canTokenizePortrait}}
			</span>
			{{/if}}
			<div class="sheet-header__fields">
				<div class="stonetop-monster-namewrap">
					{{#if stonetop.editMode}}
					<input class="input--title stonetop-name-field" name="name" type="text"
					       value="{{actor.name}}" placeholder='{{localize "stonetop.monster.namePlaceholder"}}'>
					{{else}}
					<span class="input--title stonetop-header-locked stonetop-name-field">{{actor.name}}</span>
					{{/if}}
					{{!-- A Judge's Condemn brand. In both modes: nothing on this sheet can lift it
					      (only the Judge's own roster can), so it never makes way for an edit
					      control the way a writable field would. --}}
					{{#if stonetop.condemned.condemned}}{{> "stonetop.condemned-tag" byLabel=stonetop.condemned.byLabel}}{{/if}}
				</div>{{!-- /name wrapper --}}

				{{!-- Concept + traits on their own row, stretching full width beneath
				      the name and HP/Armor. --}}
				<div class="stonetop-monster-header-details">
					<div class="stonetop-monster-subtitle">
						{{#if stonetop.editMode}}
						<textarea name="system.concept"
						          placeholder='{{localize "stonetop.monster.conceptPlaceholder"}}'>{{system.concept}}</textarea>
						{{else}}
						<p class="stonetop-monster-prose">{{system.concept}}</p>
						{{/if}}
					</div>

					<div class="stonetop-monster-stat-line stonetop-monster-stat-line--traits stonetop-monster-header-traits">
						{{#if stonetop.editMode}}
						<span class="stonetop-monster-stat-key">{{localize "stonetop.monster.organization"}}</span>
						<select class="stonetop-monster-stat-input stonetop-monster-org-select" name="system.organization">
							{{selectOptions stonetop.organizationChoices selected=system.organization localize=true blank=""}}
						</select>
						<span class="stonetop-monster-stat-sep"> · </span>
						<span class="stonetop-monster-stat-key">{{localize "stonetop.monster.size"}}</span>
						<input class="stonetop-monster-stat-input" type="text"
						       name="system.size" value="{{system.size}}"
						       placeholder="tiny, small, large, huge">
						<span class="stonetop-monster-stat-sep"> · </span>
						<span class="stonetop-monster-stat-key">{{localize "stonetop.monster.tags"}}</span>
						<input class="stonetop-monster-stat-input" type="text"
						       name="system.tags" value="{{system.tags}}"
						       placeholder="hoarder, cautious, stealthy...">
						<a class="stonetop-monster-reset-defaults" title='{{localize "stonetop.monster.resetDefaults"}}'>
							<i class="fas fa-rotate-left"></i>
						</a>
						{{else}}
						{{#if stonetop.organizationLabel}}<span class="stonetop-monster-org-pill"{{#if stonetop.organizationTooltip}} data-tooltip="{{stonetop.organizationTooltip}}" data-tooltip-direction="UP"{{/if}}>{{localize stonetop.organizationLabel}}</span>{{/if}}
						{{#if system.size}}<span class="stonetop-monster-size{{#if stonetop.sizeTooltip}} stonetop-monster-tag{{/if}}"{{#if stonetop.sizeTooltip}} data-tooltip="{{stonetop.sizeTooltip}}" data-tooltip-direction="UP"{{/if}}>{{system.size}}</span>{{/if}}
						{{#if stonetop.displayTags}}{{#if system.size}}<span class="stonetop-monster-stat-sep"> · </span>{{/if}}<span class="stonetop-monster-tags">{{{stonetop.displayTagsHtml}}}</span>{{/if}}
						{{/if}}
					</div>
				</div>
				{{!-- HP & Armor — boxed vital cells, top-aligned with the name --}}
				<div class="sheet-attributes-top stonetop-monster-statbar stonetop-monster-header-statbar">
					<div class="cell--attributes-top flexrow">
						<div class="cell cell--Resource cell--attr-hp">
							<div class="stonetop-vital-inner">
								{{!-- Run as one group, this box is the group's pool (one member's HP), not a creature's. --}}
								{{#if stonetop.fightAsGroup}}
								<label class="cell__title" data-tooltip='{{localize "stonetop.monster.groupHitPointsHint"}}' data-tooltip-direction="DOWN">{{localize "stonetop.monster.groupHitPoints"}}</label>
								{{else}}
								<label class="cell__title">{{localize "stonetop.monster.hitPoints"}}</label>
								{{/if}}
								<div class="cell__resource">
									<span class="cell__value">
										<input class="attr-value" type="number"
										       name="system.attributes.hp.value"
										       value="{{system.attributes.hp.value}}" min="0">
									</span>
									<span class="cell__separator">/</span>
									<span class="cell__max">
										{{#if stonetop.editMode}}
										<input class="attr-max" type="number"
										       name="system.attributes.hp.max"
										       value="{{system.attributes.hp.max}}" min="0">
										{{else}}
										<span class="attr-max stonetop-hp-max-readonly">{{system.attributes.hp.max}}</span>
										{{/if}}
									</span>
								</div>
							</div>
						</div>

						<div class="cell cell--Number cell--attr-armor{{#unless stonetop.editMode}}{{#if stonetop.armorBoost}} stonetop-monster-armor--boosted{{/if}}{{/unless}}">
							<div class="stonetop-vital-inner">
								<label class="cell__title">{{localize "stonetop.monster.armor"}}</label>
								<input class="attr-value" type="number"
								       name="system.attributes.armor.value"
								       value="{{system.attributes.armor.value}}" min="0">
								{{!-- Source of the armor, shown as a parenthetical like the book ("Armor 1 (reflexes)").
								      While an armor-boost move is active, that move's name replaces the source in
								      green, explaining why Armor is higher than normal. --}}
								{{#if stonetop.editMode}}
								<input class="stonetop-monster-armor-source" type="text"
								       name="system.attributes.armor.source"
								       value="{{system.attributes.armor.source}}" placeholder="reflexes">
								{{else}}{{#if stonetop.armorBoost}}
								<span class="stonetop-monster-armor-source stonetop-monster-armor-boost-note"
								      data-tooltip="{{stonetop.armorBoost.tooltip}}" data-tooltip-direction="DOWN">
									<i class="fas fa-arrow-up"></i> {{stonetop.armorBoost.label}}
								</span>
								{{else}}{{#if system.attributes.armor.source}}
								<span class="stonetop-monster-armor-source">({{system.attributes.armor.source}})</span>
								{{/if}}{{/if}}{{/if}}
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>

		{{!-- Two tabs under the header. STAT BLOCK (the stat block and its moves) is where the
		      sheet opens, and the window's opening height is fitted to it (see
		      _applyInitialHeight). NOTES leads with the codex Details, then the GM's own. --}}
		<section class="stonetop-monster-body">
		<div class="tab stonetop-monster-tab stonetop-monster-statblock" data-group="primary" data-tab="statblock">

		<section class="sheet-top stonetop-monster-top">
			<div class="stonetop-monster-stat-block">
				{{!-- The top splits into two equal columns: every stat line left (Qualities and
				      Instinct included), the fighting-in-numbers rows right. --}}
				<div class="stonetop-monster-stat-split">
				<div class="stonetop-monster-stat-split__main">
				<div class="stonetop-monster-stat-line">
					<strong class="stonetop-monster-stat-key">{{localize "stonetop.monster.creatureType"}}</strong>
					{{#if stonetop.editMode}}
					<select class="stonetop-monster-stat-input stonetop-monster-org-select" name="system.creatureType">
						{{selectOptions stonetop.creatureTypeChoices selected=system.creatureType blank=""}}
					</select>
					{{else}}
					<span>{{stonetop.creatureTypeLabel}}</span>
					{{/if}}
				</div>
				<div class="stonetop-monster-stat-line stonetop-monster-stat-line--damage">
					<strong class="stonetop-monster-stat-key">{{localize "stonetop.monster.damage"}}</strong>
					{{#if stonetop.editMode}}
					<input class="stonetop-monster-stat-input" type="text"
					       name="system.attributes.damage.value" value="{{system.attributes.damage.value}}"
					       placeholder="claws, rocks, choking d6 (hand)">
					<input class="stonetop-monster-stat-input stonetop-monster-damage-formula-input" type="text"
					       name="system.attributes.damage.rollFormula" value="{{system.attributes.damage.rollFormula}}"
					       title="Rollable dice formula (e.g. d6, 1d8+2)" placeholder="d6">
					{{else}}
					{{!-- One line per damage mode; the leading dice icon doubles as a bullet and rolls that mode. --}}
					<ul class="stonetop-monster-damage-modes{{#if stonetop.multiDamage}} stonetop-monster-damage-modes--stacked{{/if}}">
						{{#each stonetop.damageModes}}
						<li class="stonetop-monster-damage-mode">
							{{#if formula}}
							<a class="stonetop-monster-damage-roll" data-mode-index="{{@index}}" data-roll-formula="{{this.formula}}" data-roll-label="{{this.title}}" data-roll-keywords="{{this.keywords}}" data-roll-mode="{{this.rollMode}}" title="Roll damage ({{this.formula}})">
								<i class="fas fa-dice-d6"></i>
							</a>
							{{/if}}
							<span class="stonetop-monster-prose">{{this.text}}</span>
						</li>
						{{/each}}
					</ul>
					{{/if}}
				</div>
				{{#if (or stonetop.editMode stonetop.hasQualities)}}
				<div class="stonetop-monster-stat-line stonetop-monster-stat-line--qualities">
					<strong class="stonetop-monster-stat-key">{{localize "stonetop.monster.qualities"}}</strong>
					{{#if stonetop.editMode}}
					<prose-mirror class="stonetop-monster-rich-editor stonetop-monster-qualities-editor" data-field="qualities" toggled value="{{system.qualities}}">{{{stonetop.enrichedQualities}}}</prose-mirror>
					{{else}}
					<span class="stonetop-monster-prose stonetop-monster-rich-text">{{{stonetop.enrichedQualities}}}</span>
					{{/if}}
				</div>
				{{/if}}
				<div class="stonetop-monster-stat-line">
					<strong class="stonetop-monster-stat-key">{{localize "stonetop.monster.instinct"}}</strong>
					{{#if stonetop.editMode}}
					<input class="stonetop-monster-stat-input" type="text"
					       name="system.attributes.instinct.value" value="{{system.attributes.instinct.value}}"
					       placeholder="to...">
					{{else}}
					<span class="stonetop-monster-prose">{{system.attributes.instinct.value}}</span>
					{{/if}}
				</div>
				</div>

				{{!-- Fighting in numbers (horde/group), the right-hand column: the Group fight switch
				      on top, then Group size, then ONE ROW PER RULE. The two bonuses answer
				      different questions and agree only against a single target, so neither row is
				      allowed to stand in for the other — each says which rule it is and pays out what
				      that rule pays (the swarm rule is damage only; the group-vs-group abstraction is
				      damage AND armor). Book I, Dangers pp.414-416. The rows are play tools for a group
				      run as one, so they show only in play with Group fight on; edit mode keeps the
				      switch and the headcount input.
				      With the Fight tab on, the switch and both rows are the fight's (the "how many?"
				      window, Merge and Split, and the bonuses it adds to the Damage roll), so the column
				      keeps only Group size and a group token's casualties, and a creature fought on its
				      own draws no column in play at all. See getData. --}}
				{{#if stonetop.groupColumn}}
				<div class="stonetop-monster-group-fight-section">
						{{#unless stonetop.fightTab}}
						{{!-- Which scale the HP box is read at: one creature (off), or the whole group run
						      as one combatant (on). First, since it decides what the rest of the column
						      means; in both modes, since a token is switched in play. Laid out like every other
						      line in the column: its title is a stat key in the label track, and its box sits in
						      the fields track with the boxes below it. The <label> has no box of its own, and a
						      click on the title still ticks it. Having no box is also why the hint hangs on the
						      title and the checkbox, not the label: a tooltip anchors to its element's rect, and
						      a boxless element's rect is 0x0 at the screen's top-left corner. --}}
						<label class="stonetop-monster-group-toggle">
							<span class="stonetop-monster-stat-key" data-tooltip='{{localize "stonetop.monster.fightAsGroupHint"}}' data-tooltip-direction="UP">{{localize "stonetop.monster.fightAsGroup"}}</span>
							<span class="stonetop-monster-numbers-fields"><input class="stonetop-monster-group-toggle-check" type="checkbox" name="system.fightAsGroup" {{checked system.fightAsGroup}} data-tooltip='{{localize "stonetop.monster.fightAsGroupHint"}}' data-tooltip-direction="UP"></span>
						</label>
						{{!-- A hidden copy of the two rows' labels, sharing the switch's cell. The label track is
						      as wide as its longest label, and the rows are drawn only with Group fight on, so
						      without this ticking the box widened the track and slid the checkbox right. Drawn in
						      both modes, so the checkbox holds one x everywhere. Keep it in step with the row
						      labels below. --}}
						<span class="stonetop-monster-group-label-sizer" aria-hidden="true"><span class="stonetop-numbers-label">Swarm one foe:</span><span class="stonetop-numbers-label">Group vs group:</span></span>
						{{/unless}}

						{{!-- Always in edit mode, where the count the group mode reads is set, and the size the
						      Fight tab's "how many?" window offers first when this monster joins a fight. In
						      play, only while run as one group: on one creature's sheet it is a fact about
						      other tokens. --}}
						{{#if (or stonetop.editMode stonetop.fightAsGroup)}}
						{{!-- Every labelled line in this column is a label, then ONE fields span holding the
						      rest, so the section's grid can start each line's first box at the same x. --}}
						<div class="stonetop-monster-group-size">
							<strong class="stonetop-monster-stat-key">Group size</strong>
							<span class="stonetop-monster-numbers-fields">
								{{#if stonetop.editMode}}
								<input class="stonetop-monster-stat-input stonetop-monster-count-input" type="number"
								       name="system.count" value="{{system.count}}" min="0" placeholder="e.g. 6">
								{{else}}
								{{!-- In play it stays a box, saved to the token like HP: the GM settles how many
								      showed up when the fight starts, and the group gains or loses members mid-fight
								      in ways HP does not track ("foes that are engaged by individual PCs aren't really
								      part of a group", p.416). Sized like the rows' count boxes below it. Once they
								      are hurt, the bodies still on their feet sit beside it. --}}
								<input class="stonetop-monster-group-count" type="number" name="system.count" value="{{system.count}}" min="0" title="How many are in this group">
								{{#if stonetop.casualtyNote}}<span class="stonetop-monster-casualties">{{stonetop.casualtyNote}}</span>{{/if}}
								{{/if}}
							</span>
						</div>
						{{/if}}

						{{#unless stonetop.editMode}}
						{{!-- Both rules count a group's bodies, so only a group being run as one draws them.
						      With Group fight off the sheet is one creature, and how many pile onto a foe is
						      not a question its own sheet can answer. With the Fight tab on, the fight
						      answers both on the Damage roll, and neither row is drawn. --}}
						{{#if stonetop.numbersRows}}
						{{!-- Several of them onto one foe. --}}
						<span class="stonetop-monster-numbers-row" data-rule="swarm">
							<span class="stonetop-numbers-label"
							      data-tooltip="Several of them on a single foe: roll ONE attacker's damage, +1 per each additional attacker. Damage only; this rule grants no armor."
							      data-tooltip-direction="UP">Swarm one foe:</span>
							{{!-- The fields wrap like text, not like flex items: a count stays with its word, a
							      readout breaks only between its clauses, and the die stays with its formula. --}}
							<span class="stonetop-monster-numbers-fields">
								<span class="stonetop-monster-numbers-nowrap"><input class="stonetop-monster-swarm-count" data-numbers-count="attackers" type="number" min="1" value="{{stonetop.swarmCount}}" title="How many of them pile onto that one foe"> <span class="stonetop-outnumber-vs">attackers</span></span>
								<span class="stonetop-monster-numbers-result" data-numbers-result data-numbers-clauses>{{#each stonetop.swarmClauses}}{{#unless @first}} {{/unless}}<span class="stonetop-numbers-clause">{{this}}</span>{{/each}}</span>
								<span class="stonetop-monster-numbers-nowrap"><a class="stonetop-monster-damage-roll stonetop-monster-group-dmg-roll" data-numbers-roll data-roll-formula="{{stonetop.swarmFormula}}" data-base-formula="{{stonetop.baseDamageFormula}}" data-roll-label="{{this.name}} (swarm)" title="Roll the swarm's damage against that foe"><i class="fas fa-dice-d6"></i></a> <span class="stonetop-monster-group-dmg-label" data-numbers-formula>{{stonetop.swarmFormula}}</span></span>
							</span>
						</span>

						{{!-- The optional abstraction: both sides run as one combatant. --}}
						<span class="stonetop-monster-numbers-row" data-rule="exchange">
							<span class="stonetop-numbers-label"
							      data-tooltip="Abstracting group exchanges (optional): each side fights as ONE combatant, with the HP, armor and damage of a single member. The larger side gets +1 damage and +1 armor for each whole multiple it outnumbers the other by (3:1 → +2). Damage is casualties; at 0 HP the group is routed."
							      data-tooltip-direction="UP">Group vs group:</span>
							<span class="stonetop-monster-numbers-fields">
								<span class="stonetop-monster-numbers-nowrap"><input class="stonetop-monster-outnumber-yours" data-numbers-count="yours" type="number" min="1" value="{{stonetop.swarmCount}}" title="How many of this group"> <span class="stonetop-outnumber-vs">vs</span> <input class="stonetop-monster-outnumber-theirs" data-numbers-count="theirs" type="number" min="1" value="1" title="How many they face"></span>
								<span class="stonetop-monster-numbers-result" data-numbers-result data-numbers-clauses>{{#each stonetop.exchangeClauses}}{{#unless @first}} {{/unless}}<span class="stonetop-numbers-clause">{{this}}</span>{{/each}}</span>
								<span class="stonetop-monster-numbers-nowrap"><a class="stonetop-monster-damage-roll stonetop-monster-group-dmg-roll" data-numbers-roll data-roll-formula="{{stonetop.exchangeFormula}}" data-base-formula="{{stonetop.baseDamageFormula}}" data-roll-label="{{this.name}} (group)" title="Roll the group's damage in an abstracted exchange"><i class="fas fa-dice-d6"></i></a> <span class="stonetop-monster-group-dmg-label" data-numbers-formula>{{stonetop.exchangeFormula}}</span></span>
							</span>
						</span>
						{{/if}}
						{{/unless}}
				</div>
				{{/if}}
				</div>
			</div>
		</section>

		<section class="sheet-main flexcol stonetop-monster-main">

			{{!-- Moves — full width below the stat block; the list splits into two
			     balanced columns. --}}
			<section class="stonetop-monster-field stonetop-monster-field--full stonetop-monster-moves">
				{{> "stonetop.section-heading" title=(localize "stonetop.monster.moves")}}
				<ul class="stonetop-monster-moves-list{{#unless stonetop.editMode}} stonetop-monster-moves-list--cols{{/unless}}">
					{{#each monsterMoves}}
					<li class="stonetop-monster-move-item{{#if boostActive}} is-boost-active{{/if}}{{#if ../stonetop.editMode}} stonetop-monster-move-item--edit{{/if}}" data-item-id="{{this.id}}">
						<div class="stonetop-monster-move-body">
							{{#if ../stonetop.editMode}}
							{{!-- Edit mode: name, roll formula, and description are all edited
							      inline on the stat block (like the rest of the sheet). --}}
							<div class="stonetop-monster-move-head">
								<input class="stonetop-monster-move-name-input stonetop-monster-move-field" type="text"
								       data-field="name" value="{{this.name}}"
								       placeholder='{{localize "stonetop.monster.moveNamePlaceholder"}}'>
								<input class="stonetop-monster-move-formula-input stonetop-monster-move-field" type="text"
								       data-field="system.rollFormula" value="{{system.rollFormula}}"
								       title='{{localize "stonetop.monster.moveFormulaHint"}}' placeholder="d6">
								<span class="stonetop-monster-move-controls">
									<a class="stonetop-monster-delete-move" title='{{localize "stonetop.monster.deleteMove"}}'>
										<i class="fas fa-trash"></i>
									</a>
								</span>
							</div>
							<prose-mirror class="stonetop-monster-rich-editor stonetop-monster-move-editor stonetop-monster-move-field"
							              data-field="system.description" toggled value="{{system.description}}">{{{this.enrichedDescription}}}</prose-mirror>
							{{else}}
							<div class="stonetop-monster-move-head">
								{{#if system.rollFormula}}
								<a class="stonetop-monster-move-roll" title="Roll {{system.rollFormula}}">
									<i class="fas fa-dice-d6"></i>
								</a>
								{{/if}}
								<span class="stonetop-monster-move-name"{{#if boostTooltip}} data-tooltip="{{this.boostTooltip}}" data-tooltip-direction="UP"{{/if}}>{{#if showBoostIcon}}<i class="fas fa-shield-halved stonetop-monster-move-boost-icon"></i> {{/if}}{{this.name}}</span>
							</div>
							{{#if system.description}}
							<div class="stonetop-monster-move-description">{{{moveBody system.description system.moveResults}}}</div>
							{{/if}}
							{{/if}}
						</div>
					</li>
					{{else}}
					{{!-- Twenty shipped creatures (Beast Warden and the elemental spirits) have no moves
					      and keep everything they do in Notes, which has a tab of its own, so the
					      landing tab says where to look instead of reading as blank. --}}
					<li class="stonetop-monster-moves-empty">{{#if stonetop.hasNotes}}{{localize "stonetop.monster.noMovesSeeNotes"}}{{else}}{{localize "stonetop.monster.noMoves"}}{{/if}}</li>
					{{/each}}
				</ul>
				{{#if stonetop.editMode}}
				<div class="stonetop-monster-add-controls">
					<a class="stonetop-monster-add-move">
						<i class="fas fa-plus"></i> {{localize "stonetop.monster.addMove"}}
					</a>
				</div>
				{{/if}}
			</section>

		</section>
		</div>{{!-- /statblock tab --}}

		{{!-- NOTES: the creature's Details, then the GM's own notes on it.

		      DETAILS is the codex prose, lifted from the bestiary page `system.entry` points at (see
		      _resolveWriteUp). Read-only on purpose: the page stays the source of truth, and the
		      header's "Open Bestiary Entry" button is still the way to change it. No illustration
		      either, since that picture is already this sheet's portrait. Always rendered; when
		      there is nothing to show it says which reason it is. The source line names the entry
		      only when it is not this creature's own name, which is the stat blocks that share a
		      page with their kin.

		      The notes editor below stays editable in play mode (the pencil appears on hover). --}}
		<div class="tab stonetop-monster-tab stonetop-monster-notes-tab" data-group="primary" data-tab="notes">
			<section class="stonetop-monster-field stonetop-monster-field--full stonetop-monster-writeup">
				{{> "stonetop.section-heading" title=(localize "stonetop.monster.details")}}
				{{#if stonetop.writeUp}}
				{{#if stonetop.writeUp.name}}
				<p class="stonetop-monster-writeup-source">{{localize "stonetop.monster.writeUpFrom" name=stonetop.writeUp.name}}</p>
				{{/if}}
				<div class="stonetop-monster-rich-text stonetop-monster-writeup-body">{{{stonetop.writeUp.html}}}</div>
				{{else}}
				<p class="stonetop-monster-writeup-empty">{{#if stonetop.writeUpLinked}}{{localize "stonetop.monster.noWriteUp"}}{{else}}{{localize "stonetop.monster.noEntry"}}{{/if}}</p>
				{{/if}}
			</section>
			<section class="stonetop-monster-field stonetop-monster-field--full stonetop-monster-notes">
				<prose-mirror class="stonetop-monster-rich-editor stonetop-monster-notes-editor"
				              data-field="notes" toggled value="{{system.notes}}">{{{stonetop.enrichedNotes}}}</prose-mirror>
			</section>
		</div>{{!-- /notes tab --}}

		</section>{{!-- /stonetop-monster-body --}}

		{{!-- The icon rail, rendered here and lifted onto the window frame by
		      module/utils/tab-rail.js. Modern only: like the GM Toolkit, the monster sheet has no
		      classic toggle. The glyphs are CSS masks keyed on each button's data-tab. --}}
		<nav class="sheet-tabs tabs stonetop-tab-rail" data-group="primary" aria-label="{{localize "stonetop.sheet.tabs.railLabel"}}">
			{{> "stonetop.tab-rail-item" tab="statblock" label=(localize "stonetop.monster.tabs.statBlock")}}
				{{> "stonetop.tab-rail-item" tab="notes" label=(localize "stonetop.monster.tabs.notes")}}
		</nav>
	</div>
</form>
