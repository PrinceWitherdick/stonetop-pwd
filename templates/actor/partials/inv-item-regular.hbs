{{!-- One row of the Items (◇) column: the load diamonds, the name, the note/uses
      parenthetical, and the edit-mode affordances. Shared by the write-in list and the
      Treasures section so the checkbox contract the sheet binds against (the
      `stonetop-inventory-item-check` class, `data-slug`, `data-weight`) lives in exactly
      one place. Context: an inventory item snapshot, plus `deletable` — whether this row
      may be removed individually in edit mode (write-ins and treasures may; catalog gear
      may not). `isAddedSpecial` is absent on rows that can't be one, so its ✕ falls out.
      `data-loot` marks weight gained in the field (the provisions a Forage brought in): marking
      it draws nothing from the undefined ◇ (StonetopCharacter#toggleCarriedItem).
      `data-write-in` marks a written-in item or a treasure, which could be either (found out
      here, or owned all along and produced by Have What You Need, Book I p.89, p.326), so marking
      one asks (StonetopCharacter#markWriteInCarried); `data-name` is the name that question uses. --}}
<div class="stonetop-inv-item{{#if treasure}} stonetop-inv-treasure{{/if}}{{#if checked}} is-checked{{/if}}">
	<label class="stonetop-inv-item-toggle">
		<span class="stonetop-inv-diamonds">
			{{#each (times weight)}}
			<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
			       data-slug="{{../slug}}"
			       data-weight="{{../weight}}"
			       {{#if (eq ../slug "provisions")}}data-loot="true"{{/if}}
			       {{#if ../deletable}}data-write-in="true" data-name="{{../name}}"{{/if}}
			       {{#if ../checked}}checked{{/if}}
			       {{#if ../disabled}}disabled{{/if}}>
			{{/each}}
		</span>
		<span class="stonetop-inv-label">{{name}}</span>
	</label>
	{{> "stonetop.inv-note" note=note resource=resource resourceFirst=resourceFirst slug=slug}}
	{{!-- A row whose own note offers provisions (butcher a goat, harvest a brightberry) gets the
	      button that collects them. Shown only while carried: you cannot butcher a goat you left
	      at home. See provisions.js#readProvisionsYield for what counts as an offer. --}}
	{{#if checked}}{{#with (provisionsYield note)}}
	{{!-- `data-name` so the chat record names what was butchered from the scope that drew the row,
	      rather than the handler scraping the rendered label back out of the DOM. --}}
	<button type="button" class="stonetop-inv-harvest" data-name="{{../name}}" data-formula="{{formula}}"
	        data-roll="{{#if isRoll}}1{{else}}0{{/if}}"
	        title="{{#if isRoll}}Roll {{formula}} uses of provisions{{else}}Take {{formula}} uses of provisions{{/if}}">
		<i class="fas {{#if isRoll}}fa-dice-d6{{else}}fa-basket-shopping{{/if}}"></i>
	</button>
	{{/with}}{{/if}}
	{{> "stonetop.inv-artifact" deletable=deletable}}
	{{#if (and deletable @root.stonetop.editMode)}}
	<a class="stonetop-inv-delete" data-owned-id="{{ownedId}}" title="{{localize 'stonetop.inventory.removeItem'}}"><i class="fas fa-times"></i></a>
	{{/if}}
	{{#if isAddedSpecial}}
	<a class="stonetop-inv-remove-special" data-slug="{{slug}}" title="Remove special item"><i class="fas fa-times"></i></a>
	{{/if}}
</div>
