<div class="tab improvements{{#if stonetop.hideUnearnedImprovements}} hide-unearned-improvements{{/if}} steading-edit-section{{#unless stonetop.edit.improvements}} stonetop-readonly{{/unless}}" data-group="primary" data-tab="improvements">
	{{> "stonetop.steading-section-toggle" section="improvements" editing=stonetop.edit.improvements}}
	<section class="sheet-tab steading-improvements">

		<p class="steading-improvements-intro">
			Known, available improvements you can make to Stonetop. The GM may present others in the course of play.
		</p>

		<div class="steading-improvements-controls">
			<label class="steading-hide-unearned-improvements-label">
				<input type="checkbox" class="stonetop-hide-unselected-check steading-hide-unearned-improvements-check"{{#if stonetop.hideUnearnedImprovements}} checked{{/if}}>
				Hide improvements not started
			</label>
			{{> "stonetop.tab-search-control" title="Search improvements" placeholder="Filter improvements…"}}

			{{!-- Category chips, sitting just right of the magnifying glass. Single-select:
			      one lights at a time, and clicking the lit chip clears back to showing
			      everything (which is why there's no fourth "All" chip). Wired in
			      StonetopSteadingSheet._wireImprovementCategoryFilter. --}}
			<div class="steading-improvement-filters" role="group" aria-label="Filter improvements by category">
				{{#each stonetop.improvementCategories}}
				<button type="button" class="steading-improvement-filter{{#if active}} is-active{{/if}}"
				        data-category="{{this.key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}"
				        data-tooltip="{{this.hint}}" data-tooltip-direction="UP">
					<i class="{{this.icon}}" aria-hidden="true"></i>
					<span>{{this.label}}</span>
				</button>
				{{/each}}
			</div>
		</div>

		<div class="steading-improvements-grid">
			{{#each stonetop.improvements}}
			<div class="steading-improvement {{#if completed}}is-complete{{/if}}{{#if earned}} is-earned{{/if}}{{#if custom}} is-custom{{/if}}{{#if isOpen}} is-open{{/if}}{{#if filtered}} steading-improvement-filtered{{/if}}" data-slug="{{this.slug}}" data-category="{{this.category}}">

				{{!-- The header toggles the card open on a click anywhere in it (the sheet's capture
				      handler); the chevron is that toggle as a real button, so the keyboard can open a
				      card and a screen reader hears whether it is open. The status line says in words
				      what the border and the lock only show: built, ready, or how far along. --}}
				<div class="steading-improvement-header">
					<label class="steading-improvement-complete-label{{#if completeLocked}} is-locked{{/if}}"
					       data-tooltip="{{#if completeLocked}}Requirements not all met. Tap to mark them complete, earn this improvement, and apply its effects{{else}}Mark complete: automatically applies its effects (Fortunes/Defenses, new resources, etc.){{/if}}"
					       data-tooltip-direction="UP">
						<input type="checkbox" class="steading-improvement-complete"
						       data-slug="{{this.slug}}" {{#if completed}}checked{{/if}}
						       aria-label="Mark {{this.label}} complete" aria-describedby="{{this.domId}}-status">
						{{#if completeLocked}}<i class="fas fa-lock steading-improvement-lock" aria-hidden="true"></i>{{/if}}
					</label>
					<div class="steading-improvement-summary">
						<h4 class="steading-improvement-title">{{this.label}}{{#if custom}} <span class="steading-improvement-custom-tag">added</span>{{/if}}</h4>
						<p class="steading-improvement-status steading-improvement-status--{{status.kind}}" id="{{this.domId}}-status">
							{{#if completed}}<i class="fas fa-check" aria-hidden="true"></i> {{/if}}{{status.text}}
						</p>
						{{#if flavor}}<p class="steading-improvement-flavor">{{this.flavor}}</p>{{/if}}
					</div>
					{{#if (and custom @root.stonetop.edit.improvements)}}
					{{!-- Edit in place, keeping the ticked steps: the alternative was copying it,
					      correcting the copy and removing the original, which lost them. --}}
					<button type="button" class="steading-improvement-edit" data-slug="{{this.slug}}"
					        data-tooltip="Edit this added improvement" data-tooltip-direction="UP"
					        aria-label="Edit {{this.label}}">
						<i class="fas fa-pen" aria-hidden="true"></i>
					</button>
					<button type="button" class="steading-improvement-remove" data-slug="{{this.slug}}"
					        data-tooltip="Remove this added improvement" data-tooltip-direction="UP"
					        aria-label="Remove {{this.label}}">
						<i class="fas fa-trash" aria-hidden="true"></i>
					</button>
					{{/if}}
					<button type="button" class="steading-improvement-toggle"
					        aria-expanded="{{#if isOpen}}true{{else}}false{{/if}}" aria-controls="{{this.domId}}-body"
					        aria-label="{{this.label}}: requirements and effect">
						<i class="fas fa-chevron-down steading-improvement-chevron" aria-hidden="true"></i>
					</button>
				</div>

				<div class="steading-improvement-body" id="{{this.domId}}-body">
					{{#each sections}}
					{{#if alternative}}<p class="steading-req-or">or</p>{{/if}}
					<p class="steading-req-heading">{{{this.heading}}}</p>
					<ul class="steading-req-list">
						{{#each items}}
						<li class="steading-req-item">
							<label>
								<input type="checkbox" class="steading-improvement-req"
								       data-slug="{{../../slug}}" data-index="{{this.index}}"
								       {{#if checked}}checked{{/if}}>
								<span>{{{this.label}}}</span>
							</label>
						</li>
						{{/each}}
					</ul>
					{{/each}}

					<div class="steading-improvement-effect">{{{this.effect}}}</div>

					{{!-- A `condition` grant (Book II's Aetherium Crucible: "As long as you trade
					      aetherium to the outside world, increase Prosperity by 1"): ticked while it
					      holds, and its stat follows the box (StonetopSteading#setImprovementCondition). --}}
					{{#if condition}}
					<label class="steading-improvement-condition-label">
						<input type="checkbox" class="steading-improvement-condition stonetop-check" data-slug="{{this.slug}}"
						       {{#if condition.checked}}checked{{/if}} {{#unless @root.stonetop.canEdit}}disabled{{/unless}}>
						<span>{{condition.text}} <span class="steading-improvement-condition-effect">({{condition.effect}} while ticked)</span></span>
					</label>
					{{/if}}

					{{!-- An improvement that is a move (Aurochs Hunting, Heroic Reputation) rolls
					      from here as well as from the Homefront list. Rolling is play, open to
					      anyone who can see the sheet, so it is not gated on canEdit. --}}
					{{#if rollsMove}}
					<button type="button" class="steading-improvement-move-btn" data-action="improvement-move" data-move="{{rollsMove.move}}">
						<i class="fas {{rollsMove.icon}}" aria-hidden="true"></i> {{rollsMove.label}}
					</button>
					{{/if}}

					{{#if herd}}
					<div class="steading-herd" data-slug="{{this.slug}}">
						<div class="steading-herd-header">
							<span class="steading-herd-title"><i class="fas fa-horse" aria-hidden="true"></i> The Herd</span>
							<span class="steading-herd-total">Total <strong>{{herd.total}}</strong></span>
						</div>
						<div class="steading-herd-tiers">
							{{#each herd.tiers}}
							<div class="steading-herd-tier">
								<span class="steading-herd-tier-label">{{this.label}} <span class="steading-herd-tier-value">V{{this.value}}</span></span>
								<div class="steading-herd-stepper">
									<button type="button" class="steading-herd-step" data-slug="{{../slug}}" data-tier="{{this.key}}" data-delta="-1" {{#unless @root.stonetop.canEdit}}disabled{{/unless}} aria-label="Fewer {{this.label}}"><i class="fas fa-minus" aria-hidden="true"></i></button>
									<input type="number" class="steading-herd-input" data-slug="{{../slug}}" data-tier="{{this.key}}" value="{{this.count}}" min="0" aria-label="{{this.label}}: how many" {{#unless @root.stonetop.canEdit}}disabled{{/unless}}>
									<button type="button" class="steading-herd-step" data-slug="{{../slug}}" data-tier="{{this.key}}" data-delta="1" {{#unless @root.stonetop.canEdit}}disabled{{/unless}} aria-label="More {{this.label}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
								</div>
							</div>
							{{/each}}
						</div>
						<p class="steading-herd-hint">Summer promotes each tier and adds 1d4+Fortunes foals; winter feeds off grown + yearlings. Run it via <em>Seasons Change</em>.</p>
					</div>
					{{/if}}

					{{!-- The Inn's once-per-season gathering. Not a Seasons Change step: the
					      trigger fires whenever the fiction reaches for it during a season, so
					      it lives on the card, and only the CAP is seasonal. --}}
					{{#if innGathering}}
					<div class="steading-inn-gathering" data-slug="{{this.slug}}">
						<div class="steading-inn-gathering-header">
							<span class="steading-inn-gathering-title"><i class="fas fa-hand-holding-heart" aria-hidden="true"></i> Bring Folks Together</span>
							<span class="steading-inn-gathering-season">{{innGathering.seasonLabel}}</span>
						</div>
						<button type="button" class="steading-inn-gathering-btn" data-action="inn-gathering"
						        {{#unless innGathering.canGather}}disabled{{/unless}}
						        {{#unless @root.stonetop.canEdit}}disabled{{/unless}}>
							<i class="fas fa-beer-mug-empty" aria-hidden="true"></i> Spend 1 Surplus, clear a debility
						</button>
						{{!-- One sentence, chosen by the state itself (GATHERING_HINT in
						      inn-gathering.js) rather than re-derived from booleans here: the
						      window says the same thing, and a rule written in two languages
						      is a rule that drifts. --}}
						<p class="steading-inn-gathering-hint">{{innGathering.hint}}</p>
					</div>
					{{/if}}

					{{!-- "Name the inn": asked when it is built, and here any time after, which is
					      what that window's "Not yet" promises (StonetopSteadingSheet#_onNameInn). --}}
					{{#if innName}}
					<div class="steading-inn-name">
						<span class="steading-inn-name-text">{{#if innName.name}}Named <strong>{{innName.name}}</strong>{{else}}Not named yet{{/if}}</span>
						<button type="button" class="steading-inn-name-btn" data-current="{{innName.name}}"
						        {{#unless @root.stonetop.canEdit}}disabled{{/unless}}>
							<i class="fas fa-signature" aria-hidden="true"></i> {{#if innName.name}}Rename the inn{{else}}Name the inn{{/if}}
						</button>
					</div>
					{{/if}}
				</div>

			</div>
			{{/each}}
		</div>

		{{!-- Create a custom improvement to track alongside the book's built-ins.
		      Mirrors the Followers/Moves tabs' quiet dashed "add" bar; shown to any
		      owner (like Add Resident), so you can jot one down without first
		      unlocking the tab. The per-card remove control stays edit-mode only.
		      Dropping a journal card is the other way in
		      (see StonetopSteadingSheet._onDropSteadingImprovement). --}}
		{{#if stonetop.canEdit}}
		{{> "stonetop.gm-prep-add-bar" kind="steading-improvement" label="Create improvement"}}
		{{/if}}

	</section>
</div>
