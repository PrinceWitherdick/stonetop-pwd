{{!-- One row of the Small Items column: a single check (no ◇ load), the name, the
      note/uses parenthetical, and the edit-mode affordances. The ◇ counterpart is
      inv-item-regular.hbs; see it for why these are partials. Context: an inventory item
      snapshot, plus `deletable` — whether this row may be removed individually in edit
      mode (write-ins and treasures may; catalog gear may not). --}}
<div class="stonetop-inv-item stonetop-inv-small{{#if treasure}} stonetop-inv-treasure{{/if}}{{#if checked}} is-checked{{/if}}">
	<label class="stonetop-inv-item-toggle">
		<input type="checkbox" class="stonetop-inventory-item-check"
		       data-slug="{{slug}}"
		       {{#if checked}}checked{{/if}}
		       {{#if disabled}}disabled{{/if}}>
		<span class="stonetop-inv-label">{{name}}</span>
	</label>
	{{> "stonetop.inv-note" note=note resource=resource resourceFirst=resourceFirst slug=slug}}
	{{> "stonetop.inv-artifact" deletable=deletable}}
	{{#if (and deletable @root.stonetop.editMode)}}
	<a class="stonetop-inv-delete" data-owned-id="{{ownedId}}" title="{{localize 'stonetop.inventory.removeItem'}}"><i class="fas fa-times"></i></a>
	{{/if}}
	{{#if isAddedSpecial}}
	<a class="stonetop-inv-remove-special" data-slug="{{slug}}" title="Remove special item"><i class="fas fa-times"></i></a>
	{{/if}}
</div>
