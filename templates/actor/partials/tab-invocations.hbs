{{!-- stonetop-gap-managed: this tab is a flex column whose `gap` sets every step, so the
      generic heading-row sibling margin must not stack on top of it. See the CSS. --}}
<div class="tab stonetop-invocations stonetop-gap-managed{{#if stonetop.invocations.hideUnknown}} hide-unknown-invocations{{/if}}" data-group="primary" data-tab="invocations">

	<div class="stonetop-details-heading-row">
		{{> "stonetop.section-heading" title=(localize "stonetop.sheet.tabs.invocations")
		    searchControl=true
		    searchTitle="Search invocations"
		    searchPlaceholder="Filter invocations…"}}
		{{> "stonetop.details-section-edit-toggle" section="invocations" editing=stonetop.invocationsEdit collapse="invocations"}}
	</div>

	{{!-- The filter moved up into the shared section heading (searchControl); the hide toggle
	      stayed down here, since it is about what the grid below shows. --}}
	<div class="stonetop-invocations-toolbar">
		<label class="stonetop-hide-unselected-label">
			<input type="checkbox" class="stonetop-hide-unknown-invocations-check"{{#if stonetop.invocations.hideUnknown}} checked{{/if}}>
			Hide un-learned invocations
		</label>
	</div>

	<div class="stonetop-invocations-rules">
		<p>While one Invocation is ongoing, you can't use another. You can end an Invocation whenever you wish, and it will end immediately if your holy light is extinguished. An invocation's range is equal to that of its light source.</p>
		{{#if stonetop.invocationsEdit}}
		{{#if stonetop.invocations.startingCount}}
		<p>You start knowing <strong>{{stonetop.invocations.startingCount}}</strong> Invocations. Each time you reach an even-numbered level, learn 1 new Invocation.</p>
		{{else}}
		<p>Each time you reach an even-numbered level, learn 1 new Invocation.</p>
		{{/if}}
		{{/if}}
	</div>

	{{!-- The Invocation currently being held open, stated under the rule it is subject to.
	      Its own card says so too, but the card can be scrolled past, filtered out by the
	      search, or hidden outright by "Hide un-learned" — this banner cannot. --}}
	{{#if stonetop.invocations.concentrating.active}}
	<div class="stonetop-invocation-concentrating">
		<i class="fas fa-sun" aria-hidden="true"></i>
		{{!-- The name is the only untrusted part and rides in through `localize`'s {name}, which
		      does not escape — so the whole sentence is emitted raw and the name is escaped on the
		      way in (`escapeHtml`). The <strong> around it is the string's, not the template's, so
		      a translator can move it. --}}
		<span class="stonetop-invocation-concentrating-text">{{{localize "stonetop.invocations.bannerText" name=(escapeHtml stonetop.invocations.concentrating.label)}}}</span>
		{{#if editable}}
		<button type="button" class="stonetop-invocation-end" data-slug="{{stonetop.invocations.concentrating.slug}}"
		        data-tooltip="{{localize "stonetop.invocations.endTooltip"}}"
		        data-tooltip-direction="UP">{{localize "stonetop.invocations.endLabel"}}</button>
		{{/if}}
	</div>
	{{/if}}
	{{!-- The second running Invocation, when two run at once, with an End it of its own. --}}
	{{#if stonetop.invocations.concentratingSecond.active}}
	<div class="stonetop-invocation-concentrating is-second">
		<i class="fas fa-sun" aria-hidden="true"></i>
		<span class="stonetop-invocation-concentrating-text">{{{localize "stonetop.invocations.bannerSecond" name=(escapeHtml stonetop.invocations.concentratingSecond.label)}}}</span>
		{{#if editable}}
		<button type="button" class="stonetop-invocation-end" data-slug="{{stonetop.invocations.concentratingSecond.slug}}"
		        data-tooltip="{{localize "stonetop.invocations.endTooltip"}}"
		        data-tooltip-direction="UP">{{localize "stonetop.invocations.endLabel"}}</button>
		{{/if}}
	</div>
	{{/if}}

	{{!-- "N of M": how many Invocations are known against how many the level brings. Flagged,
	      never blocked: blue when some are still to choose, the gold caution when there are more
	      than expected (invocation-count.js). --}}
	{{#with stonetop.invocations.countCue}}
	<div class="stonetop-intros-notice {{#if shortfall}}stonetop-intros-notice--choice{{else}}stonetop-intros-notice--warn{{/if}} stonetop-invocations-count-notice">
		<i class="fas {{#if shortfall}}fa-circle-question{{else}}fa-triangle-exclamation{{/if}}" aria-hidden="true"></i>
		<div class="stonetop-moves-level-notice-body">
			<p>
			{{#if shortfall}}
				{{#if (eq shortfall 1)}}
					{{localize "stonetop.invocations.countShortOne" known=known expected=expected}}
				{{else}}
					{{localize "stonetop.invocations.countShortMany" known=known expected=expected count=shortfall}}
				{{/if}}
			{{else}}
				{{localize "stonetop.invocations.countOver" known=known expected=expected}}
			{{/if}}
			</p>
			{{#if shortfall}}<p class="stonetop-moves-level-notice-hint">{{localize "stonetop.invocations.countHint"}}</p>{{/if}}
		</div>
	</div>
	{{/with}}

	<div class="stonetop-invocations-grid">
		{{#each stonetop.invocations.options}}
		<div class="stonetop-invocation-card{{#unless known}} is-unknown{{/unless}}{{#if active}} is-concentrating{{/if}}"
		     data-slug="{{this.slug}}"{{#if ongoing}} data-ongoing="1"{{/if}}>
			<div class="stonetop-invocation-header">
				<input type="checkbox"
				       class="stonetop-item-check stonetop-invocation-check"
				       data-slug="{{this.slug}}"
				       {{#if known}}checked{{/if}}
				       {{#unless @root.stonetop.invocationsEdit}}disabled{{/unless}}>
				{{!-- Both states are tappable: an un-learned Invocation still posts its text, it
				      just isn't offered the roll (see the click handler). The tooltip is what
				      says which of the two this tap will be. --}}
				<span class="stonetop-invocation-name" role="button" tabindex="0" data-tooltip="{{#if known}}Use this Invocation{{else}}You haven't learned this Invocation: tap to read it out{{/if}}">{{this.label}}</span>
				{{!-- The badge says what this Invocation IS until it says what it is DOING: a card
				      that is visibly running doesn't also need telling that it's the running kind. --}}
				{{#if active}}<span class="stonetop-item-source stonetop-invocation-active" data-tooltip="You are concentrating on this Invocation. It lasts until you end it, until you use another, or until your holy light goes out." data-tooltip-direction="UP">Concentrating</span>
				{{else if ongoing}}<span class="stonetop-item-source stonetop-invocation-ongoing" data-tooltip="While one Invocation is ongoing, you can't use another. You can end an Invocation whenever you wish, and it will end immediately if your holy light is extinguished. An invocation's range is equal to that of its light source." data-tooltip-direction="UP">Ongoing</span>{{/if}}
			</div>
			{{!-- The Invoke consequence "You must bask in sunlight for an hour or so before using that
			      Invocation again". A cue, never a block: Basked clears it, and so does using it. --}}
			{{#if needsSun}}
			<div class="stonetop-invocation-needs-sun">
				<span class="stonetop-item-source stonetop-invocation-sun-badge" data-tooltip="{{localize "stonetop.invocations.needsSunTooltip"}}" data-tooltip-direction="UP"><i class="fas fa-cloud-sun" aria-hidden="true"></i> {{localize "stonetop.invocations.needsSunBadge"}}</span>
				{{#if @root.editable}}
				<button type="button" class="stonetop-invocation-basked" data-slug="{{this.slug}}"
				        data-tooltip="{{localize "stonetop.invocations.baskedTooltip"}}"
				        data-tooltip-direction="UP">{{localize "stonetop.invocations.baskedLabel"}}</button>
				{{/if}}
			</div>
			{{/if}}
			<div class="stonetop-invocation-desc">{{{this.description}}}</div>
		</div>
		{{/each}}
	</div>

</div>
