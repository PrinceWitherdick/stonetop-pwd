<div class="tab neighbors" data-group="primary" data-tab="neighbors">
	<section class="sheet-tab steading-neighbors-tab">
		{{!-- Shared suggestion pools for the inline occupation / traits / home combo
		      fields below; every row's input points at these via list="". --}}
		<datalist id="steading-occupation-suggestions">
			{{#each stonetop.suggestions.occupations}}<option value="{{this}}"></option>{{/each}}
		</datalist>
		<datalist id="steading-trait-suggestions">
			{{#each stonetop.suggestions.traits}}<option value="{{this}}"></option>{{/each}}
		</datalist>
		<datalist id="steading-home-suggestions">
			{{#each stonetop.suggestions.homes}}<option value="{{this}}"></option>{{/each}}
		</datalist>
		{{!-- The three People lists are CARDS, not columns (user's call, 10-19): a row reads
		      face | who they are (name, occupation, traits) | what to remember (Relations, Notes),
		      with no header to sort by, because sorting on a sentence of traits or notes tells
		      nobody anything. Rows stay A-Z by name (`data-sort="name"`, sortable-columns.js).
		      Read mode draws plain wrapping text and leaves an empty field out; edit mode draws
		      every field as an input. --}}
		<div class="steading-players-section steading-edit-section{{#unless stonetop.edit.players}} stonetop-readonly{{/unless}}">
			{{> "stonetop.steading-section-toggle" section="players" editing=stonetop.edit.players collapse="players"}}
			<h3 class="steading-residents-heading">Player Characters</h3>
			{{#if stonetop.players.length}}
			<div class="steading-residents-table steading-people-cards" data-resize-key="players" data-sort="name">
				<ul class="steading-residents-list">
					{{#each stonetop.players}}
					{{#if name}}
					<li class="steading-residents-row steading-person" data-sort-name="{{this.name}}">
						<div class="steading-person-face">
							{{#if img}}
							{{!-- No data-tooltip here: this portrait raises the shared hover preview
							      (module/utils/avatar-preview.js), and a tooltip would open a second
							      popup over it. The playbook rides along as the preview's subtitle. --}}
							{{!-- The span is the clipping box a chosen frame paints inside; the
							      --empty branch below already IS one, so only this branch wraps.
							      Like the NPC rows below, the drag attributes stay on the WRAPPER
							      and the inner image is explicitly undraggable so Gecko cannot hand
							      over an image payload in place of the Actor uuid. --}}
							<span class="steading-player-portrait stonetop-portrait-box"
							     {{#if uuid}}draggable="true" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"{{/if}}><img class="steading-player-portrait-img" src="{{this.img}}" alt="" draggable="false"
							     data-name="{{this.name}}" {{#if playbookName}}data-subtitle="{{this.playbookName}}"{{/if}}{{#if imgStyle}} style="{{this.imgStyle}}"{{/if}}></span>
							{{else}}
							<span class="steading-player-portrait steading-player-portrait--empty"
							      {{#if uuid}}draggable="true" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"{{/if}}
							      {{#if playbookName}}data-tooltip="{{this.playbookName}}" data-tooltip-direction="UP"{{/if}}>
								<i class="fas fa-user"></i>
							</span>
							{{/if}}
						</div>
						<div class="steading-residents-col-name steading-person-who">
							<div class="steading-person-name-line">
								{{!-- The playbook rides the name here, "Pim The Lightbearer", as it does in
								      the Actors sidebar and on a chat card's speaker. --}}
								{{#if uuid}}
								{{!-- Labelled rather than tooltipped, for the same reason as the NPC rows
								      below: no href to announce, and no room for a hover bubble. --}}
								<a class="steading-player-name-text steading-player-open steading-person-text" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"
								   draggable="true" aria-label='{{localize "stonetop.relationships.open" name=fullName}}'>{{this.name}}{{#if playbookName}} <span class="stonetop-playbook-epithet">{{this.playbookName}}</span>{{/if}}</a>
								{{else}}
								<span class="steading-player-name-text steading-person-text">{{this.name}}{{#if playbookName}} <span class="stonetop-playbook-epithet">{{this.playbookName}}</span>{{/if}}</span>
								{{/if}}
							</div>
							{{#if @root.stonetop.edit.players}}
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="occupation" data-list="players" list="steading-occupation-suggestions"
							       value="{{this.occupation}}" placeholder="Occupation or Playbook" aria-label="Occupation">
							{{else if resolvedOccupation}}
							<div class="steading-person-role steading-person-text">{{this.resolvedOccupation}}</div>
							{{/if}}
						</div>
						<div class="steading-person-details">
							{{#if @root.stonetop.edit.players}}
							<label class="steading-person-field"><span class="steading-person-label">Relations</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="relations" data-list="players"
								       value="{{this.relations}}" placeholder="Relations"></label>
							<label class="steading-person-field"><span class="steading-person-label">Notes</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="notes" data-list="players"
								       value="{{this.notes}}" placeholder="Notes"></label>
							{{else}}
							{{#if relations}}<div class="steading-person-field"><span class="steading-person-label">Relations</span><span class="steading-person-value steading-person-text">{{this.relations}}</span></div>{{/if}}
							{{#if notes}}<div class="steading-person-field"><span class="steading-person-label">Notes</span><span class="steading-person-value steading-person-text">{{this.notes}}</span></div>{{/if}}
							{{/if}}
						</div>
						<div class="steading-residents-col-actions">
							<button type="button" class="steading-list-delete"
							        data-list="players" data-index="{{@index}}"
							        title="Remove" tabindex="-1">
								<i class="fas fa-times"></i>
							</button>
						</div>
						{{!-- The character's gear tags and typed reminders (gear-reminders.js), read-only,
						      under the who/details pair. --}}
						{{#if reminders.length}}
						<div class="steading-player-reminders">{{> "stonetop.reminder-chips" chips=reminders}}</div>
						{{/if}}
					</li>
					{{/if}}
					{{/each}}
				</ul>
			</div>
			{{else}}
			<p class="steading-player-empty">Drag player characters here to keep them with Stonetop.</p>
			{{/if}}
		</div>
		<div class="steading-residents-section steading-residents-section--residents steading-edit-section{{#unless stonetop.edit.residents}} stonetop-readonly{{/unless}}">
			{{> "stonetop.steading-section-toggle" section="residents" editing=stonetop.edit.residents collapse="residents"}}
			<h3 class="steading-residents-heading">Residents of Stonetop {{> "stonetop.tab-search-control" title="Search residents" placeholder="Filter residents…"}}</h3>
			<div class="steading-residents-table steading-people-cards" data-resize-key="residents" data-sort="name">
				<ul class="steading-residents-list">
					{{#each stonetop.residents}}
					{{#if name}}
					<li class="steading-residents-row steading-person" data-sort-name="{{this.name}}">
						<div class="steading-person-face">
							{{!-- Behaviour attributes stay on the WRAPPER (it is what the click and
							      drag handlers resolve with closest), and the inner image is
							      explicitly undraggable so Gecko cannot hand over an image payload
							      in place of the Actor uuid. --}}
							<span class="steading-member-avatar stonetop-portrait-box" data-name="{{this.name}}"
							     data-list="residents" data-index="{{@index}}"
							     {{#if uuid}}draggable="true" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"{{/if}}><img class="steading-member-avatar-img" src="{{this.profileImg}}" alt="" draggable="false" data-name="{{this.name}}"{{#if imgStyle}} style="{{this.imgStyle}}"{{/if}}></span>
						</div>
						<div class="steading-residents-col-name steading-person-who{{#if unresolved}} steading-member-unresolved{{/if}}">
							{{#if @root.stonetop.edit.residents}}
							<input type="text" class="steading-resident-input steading-person-name-input"
							       data-index="{{@index}}" data-field="name"
							       value="{{this.name}}" placeholder="Name" aria-label="Name">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="occupation" list="steading-occupation-suggestions"
							       value="{{this.occupation}}" placeholder="Occupation or Playbook" aria-label="Occupation">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="traits" list="steading-trait-suggestions"
							       value="{{this.traits}}" placeholder="Traits" aria-label="Traits">
							{{else}}
							<div class="steading-person-name-line">
								{{#if uuid}}
								{{!-- Labelled rather than tooltipped: no href, so nothing else tells a
								      screen-reader user this name opens anything. --}}
								<a class="steading-member-open steading-member-name-text steading-person-text{{#if statusInactive}} is-inactive{{/if}}" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"
								   draggable="true" aria-label="Open {{this.name}}'s NPC sheet">{{this.name}}</a>
								{{#if status}}<span class="stonetop-npc-status-badge stonetop-npc-status-badge--sm" data-status="{{this.status}}" data-tooltip="{{this.statusLabel}}"><span class="stonetop-npc-status-badge-text">{{this.statusLabel}}</span></span>{{/if}}
								{{else}}
								<span class="steading-member-name-text steading-person-text">{{this.name}}</span>
								{{/if}}
							</div>
							{{#if resolvedOccupation}}<div class="steading-person-role steading-person-text">{{this.resolvedOccupation}}</div>{{/if}}
							{{#if traits}}<div class="steading-person-traits steading-person-text">{{this.traits}}</div>{{/if}}
							{{/if}}
						</div>
						<div class="steading-person-details">
							{{#if @root.stonetop.edit.residents}}
							<label class="steading-person-field"><span class="steading-person-label">Relations</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="relations"
								       value="{{this.relations}}" placeholder="Relations"></label>
							{{else if relations}}
							<div class="steading-person-field"><span class="steading-person-label">Relations</span><span class="steading-person-value steading-person-text">{{this.relations}}</span></div>
							{{/if}}
							{{#if uuid}}
							{{!-- Actor-backed row: the rich notes live on the NPC. A rendered preview,
							      clamped; in edit mode a pencil opens the shared pop-up editor. --}}
							{{#if (or @root.stonetop.edit.residents notes)}}
							<div class="steading-person-field steading-person-field--notes"><span class="steading-person-label">Notes</span><div class="steading-person-value steading-member-notes-preview stonetop-npc-rich-text steading-person-text">{{{this.notesHtml}}}</div>{{#if @root.stonetop.edit.residents}}<button type="button" class="steading-member-notes-edit" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"
							        title="Edit notes" aria-label="Edit notes" tabindex="-1"><i class="fas fa-pen"></i></button>{{/if}}</div>
							{{/if}}
							{{else}}
							{{!-- Legacy plain-text row (pre-migration): keep the inline input. --}}
							{{#if @root.stonetop.edit.residents}}
							<label class="steading-person-field"><span class="steading-person-label">Notes</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="notes"
								       value="{{this.notes}}" placeholder="Notes"></label>
							{{else if notes}}
							<div class="steading-person-field"><span class="steading-person-label">Notes</span><span class="steading-person-value steading-person-text">{{this.notes}}</span></div>
							{{/if}}
							{{/if}}
						</div>
						<div class="steading-residents-col-actions">
							<button type="button" class="steading-list-delete"
							        data-list="residents" data-index="{{@index}}"
							        title="Remove" tabindex="-1">
								<i class="fas fa-times"></i>
							</button>
						</div>
					</li>
					{{else}}
					{{#if @root.stonetop.edit.residents}}
					<li class="steading-residents-row steading-person" data-sort-name="">
						<div class="steading-person-face"><span class="steading-person-face-empty"></span></div>
						<div class="steading-residents-col-name steading-person-who">
							<input type="text" class="steading-resident-input steading-person-name-input"
							       data-index="{{@index}}" data-field="name"
							       value="{{this.name}}" placeholder="Name" aria-label="Name">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="occupation" list="steading-occupation-suggestions"
							       value="{{this.occupation}}" placeholder="Occupation or Playbook" aria-label="Occupation">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="traits" list="steading-trait-suggestions"
							       value="{{this.traits}}" placeholder="Traits" aria-label="Traits">
						</div>
						<div class="steading-person-details">
							<label class="steading-person-field"><span class="steading-person-label">Relations</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="relations"
								       value="{{this.relations}}" placeholder="Relations"></label>
							<label class="steading-person-field"><span class="steading-person-label">Notes</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="notes"
								       value="{{this.notes}}" placeholder="Notes"></label>
						</div>
						<div class="steading-residents-col-actions">
							<button type="button" class="steading-list-delete"
							        data-list="residents" data-index="{{@index}}"
							        title="Remove" tabindex="-1">
								<i class="fas fa-times"></i>
							</button>
						</div>
					</li>
					{{/if}}
					{{/if}}
					{{/each}}
				</ul>
			</div>
			{{#if stonetop.canEdit}}
			<button type="button" class="steading-list-add" data-list="residents">
				<i class="fas fa-plus"></i> Add Resident
			</button>
			{{/if}}
		</div>

		<div class="steading-residents-section steading-residents-section--neighbors steading-edit-section{{#unless stonetop.edit.neighbors}} stonetop-readonly{{/unless}}">
			{{> "stonetop.steading-section-toggle" section="neighbors" editing=stonetop.edit.neighbors collapse="neighbors"}}
			<h3 class="steading-residents-heading">Neighbors of Stonetop {{> "stonetop.tab-search-control" title="Search neighbors" placeholder="Filter neighbors…"}}</h3>
			<div class="steading-residents-table steading-people-cards steading-neighbors-table" data-resize-key="neighbors" data-sort="name">
				<ul class="steading-residents-list">
					{{#each stonetop.neighbors}}
					{{#if name}}
					<li class="steading-residents-row steading-person" data-sort-name="{{this.name}}">
						<div class="steading-person-face">
							{{!-- See the residents list above: attributes on the wrapper, image
							      explicitly undraggable. --}}
							<span class="steading-member-avatar stonetop-portrait-box" data-name="{{this.name}}"
							     data-list="neighbors" data-index="{{@index}}"
							     {{#if uuid}}draggable="true" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"{{/if}}><img class="steading-member-avatar-img" src="{{this.profileImg}}" alt="" draggable="false" data-name="{{this.name}}"{{#if imgStyle}} style="{{this.imgStyle}}"{{/if}}></span>
						</div>
						<div class="steading-residents-col-name steading-person-who{{#if unresolved}} steading-member-unresolved{{/if}}">
							{{#if @root.stonetop.edit.neighbors}}
							<input type="text" class="steading-resident-input steading-person-name-input"
							       data-index="{{@index}}" data-field="name" data-list="neighbors"
							       value="{{this.name}}" placeholder="Name" aria-label="Name">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="home" data-list="neighbors" list="steading-home-suggestions"
							       value="{{this.home}}" placeholder="Home" aria-label="Home">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="occupation" data-list="neighbors" list="steading-occupation-suggestions"
							       value="{{this.occupation}}" placeholder="Occupation or Playbook" aria-label="Occupation">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="traits" data-list="neighbors" list="steading-trait-suggestions"
							       value="{{this.traits}}" placeholder="Traits" aria-label="Traits">
							{{else}}
							<div class="steading-person-name-line">
								{{#if uuid}}
								{{!-- Labelled rather than tooltipped: no href, so nothing else tells a
								      screen-reader user this name opens anything. --}}
								<a class="steading-member-open steading-member-name-text steading-person-text{{#if statusInactive}} is-inactive{{/if}}" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"
								   draggable="true" aria-label="Open {{this.name}}'s NPC sheet">{{this.name}}</a>
								{{#if status}}<span class="stonetop-npc-status-badge stonetop-npc-status-badge--sm" data-status="{{this.status}}" data-tooltip="{{this.statusLabel}}"><span class="stonetop-npc-status-badge-text">{{this.statusLabel}}</span></span>{{/if}}
								{{else}}
								<span class="steading-member-name-text steading-person-text">{{this.name}}</span>
								{{/if}}
							</div>
							{{!-- Where they live rides the occupation line: "Trader · Marshedge". --}}
							{{#if (or occupation home)}}<div class="steading-person-role steading-person-text">{{this.occupation}}{{#if (and occupation home)}} · {{/if}}{{#if home}}<span class="steading-person-home">{{this.home}}</span>{{/if}}</div>{{/if}}
							{{#if traits}}<div class="steading-person-traits steading-person-text">{{this.traits}}</div>{{/if}}
							{{/if}}
						</div>
						<div class="steading-person-details">
							{{#if @root.stonetop.edit.neighbors}}
							<label class="steading-person-field"><span class="steading-person-label">Relations</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="relations" data-list="neighbors"
								       value="{{this.relations}}" placeholder="Relations"></label>
							{{else if relations}}
							<div class="steading-person-field"><span class="steading-person-label">Relations</span><span class="steading-person-value steading-person-text">{{this.relations}}</span></div>
							{{/if}}
							{{#if uuid}}
							{{!-- Actor-backed row: the rich notes live on the NPC. A rendered preview,
							      clamped; in edit mode a pencil opens the shared pop-up editor. --}}
							{{#if (or @root.stonetop.edit.neighbors notes)}}
							<div class="steading-person-field steading-person-field--notes"><span class="steading-person-label">Notes</span><div class="steading-person-value steading-member-notes-preview stonetop-npc-rich-text steading-person-text">{{{this.notesHtml}}}</div>{{#if @root.stonetop.edit.neighbors}}<button type="button" class="steading-member-notes-edit" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"
							        title="Edit notes" aria-label="Edit notes" tabindex="-1"><i class="fas fa-pen"></i></button>{{/if}}</div>
							{{/if}}
							{{else}}
							{{!-- Legacy plain-text row (pre-migration): keep the inline input. --}}
							{{#if @root.stonetop.edit.neighbors}}
							<label class="steading-person-field"><span class="steading-person-label">Notes</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="notes" data-list="neighbors"
								       value="{{this.notes}}" placeholder="Notes"></label>
							{{else if notes}}
							<div class="steading-person-field"><span class="steading-person-label">Notes</span><span class="steading-person-value steading-person-text">{{this.notes}}</span></div>
							{{/if}}
							{{/if}}
						</div>
						<div class="steading-residents-col-actions">
							<button type="button" class="steading-list-delete"
							        data-list="neighbors" data-index="{{@index}}"
							        title="Remove" tabindex="-1">
								<i class="fas fa-times"></i>
							</button>
						</div>
					</li>
					{{else}}
					{{#if @root.stonetop.edit.neighbors}}
					<li class="steading-residents-row steading-person" data-sort-name="">
						<div class="steading-person-face"><span class="steading-person-face-empty"></span></div>
						<div class="steading-residents-col-name steading-person-who">
							<input type="text" class="steading-resident-input steading-person-name-input"
							       data-index="{{@index}}" data-field="name" data-list="neighbors"
							       value="{{this.name}}" placeholder="Name" aria-label="Name">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="home" data-list="neighbors" list="steading-home-suggestions"
							       value="{{this.home}}" placeholder="Home" aria-label="Home">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="occupation" data-list="neighbors" list="steading-occupation-suggestions"
							       value="{{this.occupation}}" placeholder="Occupation or Playbook" aria-label="Occupation">
							<input type="text" class="steading-resident-input"
							       data-index="{{@index}}" data-field="traits" data-list="neighbors" list="steading-trait-suggestions"
							       value="{{this.traits}}" placeholder="Traits" aria-label="Traits">
						</div>
						<div class="steading-person-details">
							<label class="steading-person-field"><span class="steading-person-label">Relations</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="relations" data-list="neighbors"
								       value="{{this.relations}}" placeholder="Relations"></label>
							<label class="steading-person-field"><span class="steading-person-label">Notes</span>
								<input type="text" class="steading-resident-input"
								       data-index="{{@index}}" data-field="notes" data-list="neighbors"
								       value="{{this.notes}}" placeholder="Notes"></label>
						</div>
						<div class="steading-residents-col-actions">
							<button type="button" class="steading-list-delete"
							        data-list="neighbors" data-index="{{@index}}"
							        title="Remove" tabindex="-1">
								<i class="fas fa-times"></i>
							</button>
						</div>
					</li>
					{{/if}}
					{{/if}}
					{{/each}}
				</ul>
			</div>
			{{#if stonetop.canEdit}}
			<button type="button" class="steading-list-add" data-list="neighbors">
				<i class="fas fa-plus"></i> Add Neighbor
			</button>
			{{/if}}
		</div>

		{{!-- MODERN layout: the settlements Relationships card sits at the bottom of this tab,
		      under the Players / Residents / Neighbors tables - the only carded block on the
		      page, which is what sets it apart from the three people tables. The CLASSIC layout
		      mounts the same partial on Overview instead, where it used to live. Both mounts are
		      guarded so exactly one copy renders. --}}
		{{#unless stonetop.classicLayout}}{{> "stonetop.steading-settlements-card"}}{{/unless}}
	</section>
</div>
