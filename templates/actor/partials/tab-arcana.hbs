<div class="tab arcana" data-group="primary" data-tab="arcana">

	{{!-- The per-tier "Create arcanum" buttons live at the foot of their own Major /
	      Minor sections (see below). The empty-state line only shows when there's
	      nothing to create with either — i.e. the sections themselves won't render. --}}
	{{#unless stonetop.canCreateArcana}}
	{{#unless stonetop.arcana.major.hasOwned}}{{#unless stonetop.arcana.minor.hasOwned}}
	<p class="stonetop-arcana-empty">{{localize "stonetop.arcana.empty"}}</p>
	{{/unless}}{{/unless}}
	{{/unless}}

	{{#*inline "arcanumCard"}}
	{{#if owned}}
	<div class="stonetop-arcanum-card{{#if isSpread}} stonetop-arcanum-card--spread{{/if}}{{#if collapsed}} is-collapsed{{/if}}" data-slug="{{slug}}" data-section="{{slug}}"{{#if greaterConduit}} data-greater-conduit="true"{{/if}}>

		{{!-- Corner toggle: clamp the whole card to just its title bar. Persisted per
		      actor; the chevron rotates like the section headers (see stonetop.css). --}}
		<button type="button" class="stonetop-arcanum-collapse-btn"
		        aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
		        title="{{localize 'stonetop.arcana.toggleCard'}}"
		        aria-label="{{localize 'stonetop.arcana.toggleCard'}}"></button>

		{{#if identified}}

		{{!-- Front and (when visible) back render as side-by-side panels: front | back.
		      With only the front shown the single panel fills the card. --}}
		<div class="stonetop-arcanum-sides">
		{{#if frontVisible}}
		<div class="stonetop-arcanum-side stonetop-arcanum-side--front">
		{{!-- Front side — shown once identified, unless the viewer has flipped the card to
		      its back (back-only view). Always present in a spread. --}}
		<div class="stonetop-arcanum-header">
			{{#if img}}
			<img class="stonetop-arcanum-thumb" src="{{img}}" data-name="{{front.title}}" alt="" title="{{front.title}}">
			{{/if}}
			<div class="stonetop-arcanum-header-left">
				<span class="stonetop-arcanum-title stonetop-arcanum-title--clickable"
				      data-slug="{{slug}}" data-flipped="false">{{front.title}}</span>
				{{#if front.item}}
				<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
					{{#if front.item.weight}}
					<span class="stonetop-inv-diamonds">
						{{#each (times front.item.weight)}}
						<input type="checkbox"
						       class="stonetop-inventory-item-check stonetop-inv-diamond"
						       data-slug="{{../slug}}"
						       {{#if ../checked}}checked{{/if}}>
						{{/each}}
					</span>
					{{/if}}
					{{#if front.item.note}}<span class="stonetop-inv-note">{{{front.item.note}}}</span>{{/if}}
				</div>
				{{/if}}
			</div>
		</div>
		<div class="stonetop-arcanum-body">
			<span class="stonetop-arcanum-side-label">{{localize "stonetop.arcana.frontLabel"}}</span>
			{{!-- A 7-9 on the identifying Know Things roll bought the front and promised the back
			      "when they have some time to study it or learn more" (Book I p.440). The strip
			      keeps that promise on the card instead of in a chat message that scrolls away;
			      it disappears the moment the back is permitted. The owner's button asks for the
			      back in chat, the GM's grants it outright. --}}
			{{#if showBackOwed}}
			<div class="stonetop-arcanum-backowed">
				<i class="fas fa-hourglass-half"></i>
				<span>{{localize "stonetop.arcana.backOwedText"}}</span>
				<button type="button" class="stonetop-arcanum-backowed-btn" data-slug="{{slug}}">
					{{localize "stonetop.arcana.backOwedStudy"}}
				</button>
			</div>
			{{else if gmBackOwed}}
			<div class="stonetop-arcanum-backowed stonetop-arcanum-backowed--gm">
				<i class="fas fa-hourglass-half"></i>
				<span>{{localize "stonetop.arcana.backOwedGmText"}}</span>
				<button type="button" class="stonetop-arcanum-backowed-btn" data-slug="{{slug}}">
					{{localize "stonetop.arcana.backOwedGrant"}}
				</button>
			</div>
			{{/if}}
			{{{front.description}}}
			<p class="stonetop-arcanum-unlock-lead">{{{front.unlock.description}}}</p>
			<ul class="stonetop-arcanum-unlock-list">
				{{#each front.unlock.requirements}}
				{{#if (eq type "text")}}
				<li class="stonetop-arcanum-unlock-text">{{{content}}}</li>
				{{else}}
				<li class="stonetop-arcanum-unlock-option">
					<span class="stonetop-arcanum-unlock-checks">
						{{#each (times max)}}
						<input type="checkbox" class="stonetop-arcanum-unlock-check"
						       data-arcanum-slug="{{../../slug}}"
						       data-option-slug="{{../slug}}"
						       data-index="{{@index}}"
						       {{#if (lt @index ../count)}}checked{{/if}}>
						{{/each}}
					</span>
					<span class="stonetop-arcanum-unlock-desc">{{{description}}}</span>
				</li>
				{{/if}}
				{{/each}}
			</ul>
			{{!-- Consequences surfaced from the back for cards whose front references them
			      ("mark a consequence (see reverse)"). Rendered only in the front-only view; the
			      leading <h3>Consequences</h3> is folded behind a collapsible at render time
			      (activateListeners), and the front text's "(see reverse)" becomes "(see below)". --}}
			{{#if showFrontConsequences}}
			{{{consequences}}}
			{{/if}}
		</div>
		</div>
		{{/if}}

		{{#if backVisible}}
		{{!-- Back side. In a spread it sits to the right of the front; in the back-only
		      flip view it stands alone. Shown per backVisible: always to the GM; to players
		      once unlocked when the world setting allows; or when the GM has revealed it. --}}
		<div class="stonetop-arcanum-side stonetop-arcanum-side--back">
		<div class="stonetop-arcanum-header">
			<div class="stonetop-arcanum-header-left">
				<span class="stonetop-arcanum-title stonetop-arcanum-title--clickable"
				      data-slug="{{slug}}" data-flipped="true">{{back.title}}</span>
				{{#if back.item}}
				<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
					{{#if back.item.weight}}
					<span class="stonetop-inv-diamonds">
						{{#each (times back.item.weight)}}
						<input type="checkbox"
						       class="stonetop-inventory-item-check stonetop-inv-diamond"
						       data-slug="{{../slug}}"
						       {{#if ../checked}}checked{{/if}}>
						{{/each}}
					</span>
					{{/if}}
					{{#unless (eq back.item.name back.title)}}
					<span class="stonetop-inv-label">{{back.item.name}}</span>
					{{/unless}}
					{{#if back.item.note}}<span class="stonetop-inv-note">{{{back.item.note}}}</span>{{/if}}
					{{#if back.item.resource}}
					<span class="stonetop-inv-resources">
						{{> "stonetop.resource-track" resource=back.item.resource btnClass="stonetop-arcanum-resource-btn" slug=slug resourceKind="item"}}
					</span>
					{{/if}}
				</div>
				{{/if}}
			</div>
			{{#if back.resource}}
			<div class="stonetop-arcanum-header-resource">
				{{> "stonetop.resource-track" resource=back.resource btnClass="stonetop-arcanum-resource-btn" slug=slug}}
			</div>
			{{/if}}
		</div>
		<div class="stonetop-arcanum-body">
			<span class="stonetop-arcanum-side-label">{{localize "stonetop.arcana.backLabel"}}</span>
			{{{back.description}}}
			{{#if back.move}}
			<p class="stonetop-arcanum-move-trigger"><strong><em>{{back.move.name}}</em></strong></p>
			{{{moveBody back.move.description}}}
			{{/if}}
			{{#if summon}}
			<div class="stonetop-arcanum-summon">
				<button type="button" class="stonetop-arcanum-summon-btn{{#if summon.added}} is-added{{/if}}"
				        data-slug="{{slug}}"{{#if summon.added}} disabled{{/if}}>
					<i class="fas {{#if summon.added}}fa-check{{else}}fa-user-plus{{/if}}"></i> {{summon.label}}
				</button>
			</div>
			{{/if}}
		</div>
		</div>
		{{/if}}
		</div>

		{{!-- Collapsed preview: when the card is clamped, the full body is hidden and this
		      front-description lead shows beneath whichever header is visible (front, or the
		      back header on a back-only flip). Present only in the DOM; CSS reveals it while
		      the card carries .is-collapsed. --}}
		{{#if frontLead}}
		<div class="stonetop-arcanum-collapsed-preview">{{{frontLead}}}</div>
		{{/if}}

		{{#if (or sectionEditable canToggleBoth)}}
		<div class="stonetop-arcanum-footer">
			{{!-- Flip toggle (front ⇄ back): swaps the single visible side. Like show-both it
			      renders in and out of edit mode and only when the viewer may see the back; it
			      hides while the card is spread open (nothing to flip). Sits left of show-both. --}}
			{{#if canFlip}}
			<button type="button" class="stonetop-arcanum-flip-btn"
			        data-slug="{{slug}}" data-show="{{showBack}}">
				<i class="fas fa-rotate"></i>
				{{#if showBack}}{{localize "stonetop.arcana.showFront"}}{{else}}{{localize "stonetop.arcana.showBack"}}{{/if}}
			</button>
			{{/if}}
			{{!-- The show-both toggle renders whenever the viewer may see the back (the GM
			      always, or a player once permitted) — not only in edit mode — so a spread
			      can be opened/closed while reading in play mode. Reveal/Remove stay edit-only. --}}
			{{#if canToggleBoth}}
			<button type="button" class="stonetop-arcanum-showboth-btn{{#if showBoth}} is-active{{/if}}"
			        data-slug="{{slug}}" data-show="{{showBoth}}">
				<i class="fas {{#if showBoth}}fa-book{{else}}fa-book-open{{/if}}"></i>
				{{#if showBoth}}{{localize "stonetop.arcana.showFrontOnly"}}{{else}}{{localize "stonetop.arcana.showBothSides"}}{{/if}}
			</button>
			{{/if}}
			{{!-- Reveal is a play action, not an edit one: it's how the GM settles a 7-9's owed
			      back (Book I p.440), so it can't sit behind the section pencil. It is already
			      GM-only via canReveal, so lifting it out of edit mode exposes nothing new.
			      Remove stays edit-only. --}}
			{{#if canReveal}}
			<button type="button" class="stonetop-arcanum-reveal-btn{{#if revealedToPlayers}} is-revealed{{/if}}"
			        data-slug="{{slug}}" data-revealed="{{revealedToPlayers}}">
				<i class="fas {{#if revealedToPlayers}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
				{{#if revealedToPlayers}}{{localize "stonetop.arcana.hideFromPlayers"}}{{else}}{{localize "stonetop.arcana.revealToPlayers"}}{{/if}}
			</button>
			{{/if}}
			{{#if sectionEditable}}
			<button type="button" class="stonetop-arcanum-delete" data-slug="{{slug}}"
			        title="{{localize 'stonetop.arcana.removeArcanum'}}">
				<i class="fas fa-trash"></i> Remove
			</button>
			{{/if}}
		</div>
		{{/if}}

		{{else if lead}}
		{{!-- Lead state: the owner knows this arcanum's whereabouts but hasn't recovered it
		      yet. Shows the card's name over a placeholder; "discovered" promotes it to the
		      normal, identified minor-arcanum form. --}}
		<div class="stonetop-arcanum-header">
			<div class="stonetop-arcanum-header-left">
				<span class="stonetop-arcanum-title">{{front.title}}</span>
			</div>
		</div>
		<div class="stonetop-arcanum-body stonetop-arcanum-lead-body">
			<i class="fas fa-map-location-dot stonetop-arcanum-lead-icon"></i>
			<p>{{localize "stonetop.arcana.leadText"}}</p>
			<button type="button" class="stonetop-arcanum-discover-btn" data-slug="{{slug}}">
				{{localize "stonetop.arcana.discover"}}
			</button>
		</div>
		{{#if sectionEditable}}
		<div class="stonetop-arcanum-footer">
			<button type="button" class="stonetop-arcanum-delete" data-slug="{{slug}}"
			        title="{{localize 'stonetop.arcana.removeArcanum'}}">
				<i class="fas fa-trash"></i> Remove
			</button>
		</div>
		{{/if}}

		{{else}}
		{{!-- Unidentified state --}}
		<div class="stonetop-arcanum-header">
			<div class="stonetop-arcanum-header-left">
				<span class="stonetop-arcanum-title">{{front.title}}</span>
			</div>
		</div>
		<div class="stonetop-arcanum-body stonetop-arcanum-unidentified-body">
			<p>{{localize "stonetop.arcana.unidentifiedText"}}</p>
			{{!-- The player's route to a face-down card is the roll (Book I p.440, "prompt them
			      to Know Things about the arcanum"); handing it over without one is the GM's
			      move, so "Give the card" renders only for them. --}}
			<div class="stonetop-arcanum-identify-row">
				<button type="button" class="stonetop-arcanum-identify-btn" data-slug="{{slug}}"
				        title="{{localize 'stonetop.arcana.identifyHint'}}">
					<i class="fas fa-dice-d6"></i> {{localize "stonetop.arcana.identify"}}
				</button>
				{{#if canGiveCard}}
				<button type="button" class="stonetop-arcanum-givecard-btn" data-slug="{{slug}}"
				        title="{{localize 'stonetop.arcana.giveCardHint'}}">
					<i class="fas fa-hand-holding"></i> {{localize "stonetop.arcana.giveCard"}}
				</button>
				{{/if}}
			</div>
		</div>
		{{#if sectionEditable}}
		<div class="stonetop-arcanum-footer">
			<button type="button" class="stonetop-arcanum-delete" data-slug="{{slug}}"
			        title="{{localize 'stonetop.arcana.removeArcanum'}}">
				<i class="fas fa-trash"></i> Remove
			</button>
		</div>
		{{/if}}

		{{/if}}

	</div>
	{{/if}}
	{{/inline}}

	{{!-- A section renders when the character holds arcana of that tier OR the viewer may
	      author them — so a would-be author always has the "Create …" button, even before
	      the first card exists. The search control and edit pencil only show once there are
	      cards to search / edit; the dashed "Create …" button is pinned at the section foot
	      (mirrors the Moves / Followers "add" bars) and folds away with the section. --}}
	{{#if (or stonetop.arcana.major.hasOwned stonetop.canCreateArcana)}}
	<section class="stonetop-arcana-section stonetop-arcana-collapsible{{#unless stonetop.arcanaOpen.major}} is-collapsed{{/unless}}" data-section="arcanaMajor">
		<div class="stonetop-arcana-summary" role="button" tabindex="0"
		     aria-expanded="{{#if stonetop.arcanaOpen.major}}true{{else}}false{{/if}}">
			{{> "stonetop.section-heading" title=stonetop.arcana.major.title caret=true searchControl=stonetop.arcana.major.hasOwned searchTitle=(localize "stonetop.arcana.searchLabel") searchPlaceholder=(localize "stonetop.arcana.searchPlaceholder")}}
			{{#if stonetop.arcana.major.hasOwned}}
			{{> "stonetop.section-edit-toggle" toggleClass="stonetop-arcana-section-edit-toggle" section="arcanaMajor" editing=stonetop.arcanaEdit.major}}
			{{/if}}
		</div>
		<div class="stonetop-arcana-grid">
		{{#each stonetop.arcana.major.items}}{{> arcanumCard}}{{/each}}
		</div>
		{{#if stonetop.canCreateArcana}}
		<div class="stonetop-arcana-add-bar">
			<button type="button" class="stonetop-arcana-create stonetop-arcana-add-btn" data-major="true">
				<i class="fas fa-plus" aria-hidden="true"></i> Create major arcanum
			</button>
		</div>
		{{/if}}
	</section>
	{{/if}}

	{{#if (or stonetop.arcana.minor.hasOwned stonetop.canCreateArcana)}}
	<section class="stonetop-arcana-section stonetop-arcana-collapsible{{#unless stonetop.arcanaOpen.minor}} is-collapsed{{/unless}}" data-section="arcanaMinor">
		<div class="stonetop-arcana-summary" role="button" tabindex="0"
		     aria-expanded="{{#if stonetop.arcanaOpen.minor}}true{{else}}false{{/if}}">
			{{> "stonetop.section-heading" title=stonetop.arcana.minor.title caret=true searchControl=stonetop.arcana.minor.hasOwned searchTitle=(localize "stonetop.arcana.searchLabel") searchPlaceholder=(localize "stonetop.arcana.searchPlaceholder")}}
			{{#if stonetop.arcana.minor.hasOwned}}
			{{> "stonetop.section-edit-toggle" toggleClass="stonetop-arcana-section-edit-toggle" section="arcanaMinor" editing=stonetop.arcanaEdit.minor}}
			{{/if}}
		</div>
		<div class="stonetop-arcana-grid">
		{{#each stonetop.arcana.minor.items}}{{> arcanumCard}}{{/each}}
		</div>
		{{#if stonetop.canCreateArcana}}
		<div class="stonetop-arcana-add-bar">
			<button type="button" class="stonetop-arcana-create stonetop-arcana-add-btn" data-major="false">
				<i class="fas fa-plus" aria-hidden="true"></i> Create minor arcanum
			</button>
		</div>
		{{/if}}
	</section>
	{{/if}}

</div>
