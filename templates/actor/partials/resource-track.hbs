{{#if resource.title}}<span class="stonetop-arcanum-resource-title">{{resource.title}}</span>{{/if}}
{{#if groupBy}}
<span class="stonetop-resource-circles">
{{#each (resourceGroups resource groupBy)}}
	<span class="stonetop-resource-group">
	{{#each this}}
	<button type="button"
	        class="{{../../btnClass}}{{#if checked}} is-checked{{/if}}"
	        {{#if ../../possessionSlug}}data-possession-slug="{{../../possessionSlug}}"{{/if}}
	        {{#if ../../slug}}data-slug="{{../../slug}}"{{/if}}
	        {{#if ../../resourceKind}}data-resource-kind="{{../../resourceKind}}"{{/if}}
	        {{#if ../../choiceSlug}}data-choice-slug="{{../../choiceSlug}}"{{/if}}
	        data-index="{{this.index}}"></button>
	{{#if label}}<span class="stonetop-resource-label">{{this.label}}</span>{{/if}}
	{{/each}}
	</span>
{{/each}}
</span>
{{else}}
{{#each (resourceChecks resource)}}
<button type="button"
        class="{{../btnClass}}{{#if checked}} is-checked{{/if}}"
        {{#if ../possessionSlug}}data-possession-slug="{{../possessionSlug}}"{{/if}}
        {{#if ../slug}}data-slug="{{../slug}}"{{/if}}
        {{#if ../resourceKind}}data-resource-kind="{{../resourceKind}}"{{/if}}
        {{#if ../choiceSlug}}data-choice-slug="{{../choiceSlug}}"{{/if}}
        data-index="{{@index}}"></button>
{{#if label}}<span class="stonetop-resource-label">{{this.label}}</span>{{/if}}
{{/each}}
{{/if}}
