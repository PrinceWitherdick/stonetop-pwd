<div class="tab followers" data-group="primary" data-tab="followers">
{{!-- stonetop-gap-managed: this is a responsive grid whose row gap sets the spacing under the
      heading row, so the generic heading-row sibling margin must not stack on top of it.
      See the CSS. --}}
<div class="stonetop-followers stonetop-gap-managed">

	{{!-- The "exceptional" tag chip, shown in the tags row. A gated tag: rendered
	      only for follower types whose playbook grants it (exceptionalAvailable —
	      the crew via Heroes to the Last, the animal companion via Beast of Legend).
	      In edit mode it's a selectable chip that shows a lock and warns on click
	      until the granting move is owned (exceptionalMet); in view mode it shows
	      only once earned. --}}
	{{#*inline "stonetopExceptionalChip"}}
	{{#if exceptionalAvailable}}{{#if edit.stats}}<button type="button" class="stonetop-follower-tag stonetop-follower-tag--exceptional stonetop-exceptional-toggle{{#if exceptional}} is-selected{{/if}}{{#unless exceptionalMet}} is-locked{{/unless}}" data-ftype="{{ftype}}" data-slug="{{slug}}" data-met="{{exceptionalMet}}" data-hint="{{exceptionalHint}}"{{#unless exceptionalMet}} data-tooltip="{{exceptionalHint}}" data-tooltip-direction="UP"{{/unless}}>exceptional{{#unless exceptionalMet}} <i class="fas fa-lock"></i>{{/unless}}</button>{{else}}{{#if exceptional}}<span class="stonetop-follower-tag stonetop-follower-tag--exceptional">exceptional</span>{{/if}}{{/if}}{{/if}}
	{{/inline}}

	{{!-- One roster row's face: the crew's named individuals and anonymous members, and the
	      members of a custom group follower. The same picture the follower CARD's portrait
	      shows, one size down and circular — the small avatars in this system
	      (.steading-member-avatar, .stonetop-rel-portrait) are name-row bullets rather than
	      cards, and this is a dense list of them.

	      Nothing is required and nothing had to be migrated: a member with no face of their own
	      shows the empty-figure placeholder the steading's rosters draw, which is DRAWN and never
	      stored, so "has this person a portrait?" keeps answering honestly.

	      `roster` names which store a pick goes to (crew-individual / crew-member /
	      custom-member — the same three names the HP writer uses for these rows), and `slug` is
	      the custom follower's id where there is one. Behaviour attributes stay on the WRAPPER,
	      which is what the handler resolves with closest, and the inner image is explicitly
	      undraggable so a press on the face is a click rather than the start of an image drag. --}}
	{{#*inline "stonetopRosterAvatar"}}
	<span class="stonetop-roster-avatar stonetop-portrait-box{{#if hasPortrait}} stonetop-roster-avatar--photo{{/if}}{{#if avatarInteractive}} stonetop-roster-avatar--editable{{/if}}"
	      data-roster="{{roster}}" data-slug="{{slug}}" data-index="{{index}}"
	      data-portrait-mode="{{avatarMode}}"
	      {{#if avatarInteractive}}role="button" tabindex="0"
	      data-tooltip="{{avatarLabel}}"
	      data-tooltip-direction="UP"
	      aria-label="{{avatarLabel}}"{{/if}}><img class="stonetop-roster-avatar-img" src="{{avatarImg}}" alt="" draggable="false" data-name="{{avatarName}}"{{#if avatarStyle}} style="{{avatarStyle}}"{{/if}}></span>
	{{/inline}}

	{{!-- Every button that opens the Order dialog. Six of these are rendered across this file —
	      the card's own "Order", the crew individual's inline one, and Clash / Let Fly for the
	      crew and for a custom group — and all six carry the SAME six data-attributes, which the
	      handler reads to build the roll. Written once so an attribute added to the dialog's
	      contract lands on all of them at once rather than on five of six.

	      `ftype` / `slug` / `moveKey` / `icon` / `caption` / `extraClass` are the only things that
	      vary; everything else is read from the surrounding card context. Omit `moveKey` for the
	      plain Order button — the dialog opens on no particular move. --}}
	{{#*inline "stonetopOrderButton"}}
	<button type="button" class="stonetop-follower-order{{#if extraClass}} {{extraClass}}{{/if}}"
	        data-ftype="{{ftype}}" data-slug="{{slug}}"
	        data-follower-name="{{orderName}}"
	        data-exceptional="{{#if exceptional}}true{{else}}false{{/if}}"
	        data-tags="{{orderTagsCsv}}"
	        data-moves="{{orderMovesCsv}}"{{#if moveKey}} data-move-key="{{moveKey}}"{{/if}}>
		<i class="fas {{icon}}"></i> {{caption}}
	</button>
	{{/inline}}

	{{!-- ═══ Shared follower-card body (rulebook "Follower" card layout) ═══════
	      Rendered for every follower type. Type-specific extras (crew inventory,
	      individuals, group fight) are appended by the caller inside the same
	      .stonetop-follower-card wrapper. --}}
	{{#*inline "stonetopFollowerCardBody"}}
	{{!-- One card-level edit pencil (top-right corner, may overlay the HP box)
	      makes the whole body editable at once. The crew Roster keeps its own
	      pencil below. --}}
	{{> "stonetop.follower-section-edit" section="card" editing=edit.card editTitle="Edit follower"}}
	<div class="stonetop-follower-header">
		<div class="stonetop-follower-header-main">
			{{!-- The follower's face. A chosen portrait when they have one, else the type's
			      glyph (a paw, a seedling, a crowd), which is the normal state — nothing
			      here is required and nothing had to be migrated to add it.

			      Clicking opens the People of Stonetop gallery, the same picker the
			      steading's rosters use, so a follower recruited from the village can wear
			      the village's face; hovering a real portrait pops the enlarged copy through
			      the shared avatar preview. data-name is both that preview's caption and the
			      selector hook wireAvatarPreview matches on, so a portrait that previews and
			      one that is captioned are the same element.

			      A tap does one of two things, and portraitInteractive is true for either:
			      it opens the gallery to CHANGE the portrait (with the card's pencil open,
			      or where there is no face yet to enlarge), and otherwise it ENLARGES the
			      one that is there — and that window carries the same "Edit Photo" and
			      "Frame Face" the sheet's own portrait window does, so a face can be
			      changed without first opening the pencil. A viewer who can do neither (no
			      portrait, and no permission to choose one) gets no tab stop and no pointer
			      cursor, rather than one promising something that will not happen. --}}
			<div class="stonetop-follower-portrait stonetop-portrait-box{{#if img}} stonetop-follower-portrait--photo{{/if}}{{#if portraitInteractive}} stonetop-follower-portrait--editable{{/if}}"
			     data-ftype="{{ftype}}" data-slug="{{slug}}"
			     data-portrait-mode="{{#if portraitEditable}}pick{{else}}view{{/if}}"
			     {{#if portraitInteractive}}role="button" tabindex="0"
			     data-tooltip="{{portraitLabel}}"
			     data-tooltip-direction="UP"
			     aria-label="{{portraitLabel}}"{{/if}}>
				{{#if img}}
				{{!-- draggable="false": a press on the face is a click on the picker, not the
				      start of an image drag. --}}
				{{!-- The circular mask lives on this span rather than on the portrait box, so the
				      box itself can stay unclipped and let the crop pip sit in the corner of the
				      SQUARE around the circle. The glyph branch needs no clip: it is centred art,
				      not a photo that has to be cut to a circle. --}}
				<span class="stonetop-follower-portrait-clip"><img class="stonetop-follower-portrait-img" src="{{img}}" alt="" draggable="false" data-name="{{orderName}}"{{#if imgStyle}} style="{{imgStyle}}"{{/if}}></span>
				{{else}}
				<i class="{{portraitIcon}}" aria-hidden="true"></i>
				{{/if}}
				{{!-- The same pair of pips a sheet header carries, in the same order and the same
				      corner, shown in BOTH modes exactly as the header's are: neither is an
				      edit-mode act. Framing is a reading choice about a picture that already
				      exists, and Tokenizer makes a map token, not a sheet. Each has its own gate
				      (see the sheet's withSectionEdits) rather than the card's pencil.

				      Tokenizer sits to the LEFT of the crop pip and is emitted first so tabbing
				      runs left to right; the visual order comes from `right` in the CSS, since
				      both are absolutely positioned. It appears only for a follower who already
				      exists as an Actor — dropped on a scene, or the NPC they were recruited
				      from — because that Actor is the thing a token is made for.

				      tabindex="-1": the portrait itself already owns the tab stop and Enter/Space,
				      and a second stop inside a 75px circle is noise. The keyboard route to
				      framing is the portrait, then "Frame Face" in the window it opens. --}}
				{{#if portraitTokenizable}}
				<button type="button" class="stonetop-follower-portrait-pip stonetop-follower-portrait-tokenize" tabindex="-1"
				        data-tooltip="{{localize 'stonetop.portraitFrame.tokenizerPip'}}"
				        aria-label="{{localize 'stonetop.portraitFrame.tokenizerPip'}}"><i class="fas fa-circle-user"></i></button>
				{{/if}}
				{{#if portraitFrameable}}
				<button type="button" class="stonetop-follower-portrait-pip stonetop-follower-portrait-frame" tabindex="-1"
				        data-tooltip="{{portraitFrameLabel}}" aria-label="{{portraitFrameLabel}}"><i class="fas fa-crop-simple"></i></button>
				{{/if}}
			</div>
			<div class="stonetop-follower-title">
				<div class="stonetop-follower-name-row">
					{{#if nameLines.length}}
					<span class="stonetop-follower-name stonetop-follower-name--multiline">{{#each nameLines}}<span class="stonetop-follower-name-line">{{text}}{{#if pronoun}} <span class="stonetop-follower-pronoun">({{pronoun}})</span>{{/if}}</span>{{/each}}</span>
					{{else}}
						{{#if (and nameEditable edit.name)}}
						<input class="stonetop-follower-name-input stonetop-follower-name-field" type="text" value="{{name}}" placeholder="{{namePlaceholder}}" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="name">
						{{else}}
						<span class="stonetop-follower-name">{{#if name}}{{name}}{{else}}{{namePlaceholder}}{{/if}}{{#if pronoun}} <span class="stonetop-follower-pronoun">({{pronoun}})</span>{{/if}}</span>
						{{/if}}
					{{/if}}
				</div>
				{{#if pronounEditable}}{{#if edit.name}}
				<div class="stonetop-follower-name-row">
					<span class="stonetop-follower-field-label">Pronoun</span>
					<input class="stonetop-follower-pronoun-input stonetop-follower-name-field" type="text" value="{{pronoun}}" placeholder="pronoun…" maxlength="12" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="pronoun">
				</div>
				{{/if}}{{/if}}
				<span class="stonetop-follower-type">{{typeLabel}}</span>
				{{#if dead}}<span class="stonetop-follower-dead-badge"><i class="fas fa-skull-crossbones"></i> Fallen</span>{{/if}}
			</div>
			<div class="stonetop-follower-hp-octagon">
				<span class="stonetop-follower-hp-octagon-label">HP</span>
				<span class="stonetop-follower-hp-octagon-body">
					{{#if hpFollower}}
					<input class="stonetop-follower-hp-input stonetop-follower-hp-octagon-input" type="number" data-follower="{{hpFollower}}" {{#if hpSlug}}data-slug="{{hpSlug}}"{{/if}} value="{{hpCurrent}}" min="0" max="{{hpMax}}">
					{{#if edit.stats}}
					<span class="stonetop-follower-hp-octagon-max">/</span>
					<input class="stonetop-follower-stat-input stonetop-follower-hp-octagon-max-input" type="number" min="1" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="hpMax" value="{{hpMax}}">
					{{else}}
					{{#if hpMax}}<span class="stonetop-follower-hp-octagon-max">/ {{hpMax}}</span>{{/if}}
					{{/if}}
					{{else}}
					{{#if edit.stats}}
					<input class="stonetop-follower-stat-input stonetop-follower-hp-octagon-max-input" type="number" min="1" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="hpMax" value="{{hpStaticValue}}">
					{{#if hpStaticSuffix}}<span class="stonetop-follower-hp-octagon-suffix">{{hpStaticSuffix}}</span>{{/if}}
					{{else}}
					<span class="stonetop-follower-hp-octagon-static">{{hpStaticValue}}</span>
					{{#if hpStaticSuffix}}<span class="stonetop-follower-hp-octagon-suffix">{{hpStaticSuffix}}</span>{{/if}}
					{{/if}}
					{{/if}}
				</span>
			</div>
		</div>
		<div class="stonetop-follower-tags-row">
			{{#if (and tagOptions edit.stats)}}
			{{!-- Edit mode (crew): pick from the playbook's tag list. One tag from
			      your background is locked on; choose up to the limit more. --}}
			<div class="stonetop-crew-tag-picker">
				<span class="stonetop-crew-tag-hint">Your crew starts with <em>group</em>{{#if tagAutoLabel}} and <em>{{tagAutoLabel}}</em>, a tag granted by your background{{/if}}. Pick {{tagLimit}} more:</span>
				<div class="stonetop-follower-tags">
					{{> stonetopExceptionalChip}}
					{{#each tagOptions}}
					<label class="stonetop-follower-tag stonetop-crew-tag-choice{{#if isSelected}} is-selected{{/if}}{{#if isAuto}} is-auto{{/if}}{{#if disabled}} is-disabled{{/if}}">
						<input type="checkbox" class="stonetop-crew-tag-option" value="{{value}}" {{#if isSelected}}checked{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}
					</label>
					{{/each}}
				</div>
				<input type="text" class="stonetop-follower-text stonetop-crew-tag-custom" value="{{tagCustom}}" placeholder="custom tag…" {{#if tagCustomDisabled}}disabled{{/if}}>
			</div>
			{{else if (and edit.stats traitChoices)}}
			{{!-- Edit mode (animal companion): pick the type's traits, up to the
			      pickCount the rulebook allows. Traits drive HP / armor / damage, so
			      the card's stats re-derive as they're toggled. --}}
			<div class="stonetop-crew-tag-picker">
				<span class="stonetop-crew-tag-hint">Pick {{traitChoices.limit}} more trait{{#unless (eq traitChoices.limit 1)}}s{{/unless}} for your animal companion:</span>
				<div class="stonetop-follower-tags">
					{{> stonetopExceptionalChip}}
					{{#each traitChoices.options}}
					<label class="stonetop-follower-tag stonetop-crew-tag-choice{{#if selected}} is-selected{{/if}}{{#if disabled}} is-disabled{{/if}}{{#if mandatory}} is-mandatory{{/if}}"{{#if mandatory}} title="Always included; doesn't count toward your picks"{{/if}}>
						<input type="checkbox" class="stonetop-ac-trait-option" value="{{value}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}>{{value}}{{#if mandatory}} <em class="stonetop-ac-trait-included">(included)</em>{{/if}}
					</label>
					{{/each}}
				</div>
				<input type="text" class="stonetop-follower-text stonetop-ac-trait-custom" value="{{traitChoices.customTrait}}" placeholder="custom trait…" {{#if traitChoices.customTraitDisabled}}disabled{{/if}}>
			</div>
			{{else if (and edit.stats traitRows)}}
			{{!-- Edit mode (initiate of Danu): the rulebook's "pick 1 on each line".
			      Fixed subtitle traits stay as read-only chips above the line pickers. --}}
			<div class="stonetop-crew-tag-picker">
				{{#if subtitleTags.length}}
				<div class="stonetop-follower-tags">
					{{#each subtitleTags}}<span class="stonetop-follower-tag">{{label}}</span>{{/each}}
				</div>
				{{/if}}
				<div class="stonetop-initiate-trait-rows">
					{{#each traitRows}}
					<div class="stonetop-follower-field-row stonetop-follower-field-row--block">
						{{#if label}}<span class="stonetop-follower-field-label">{{label}}</span>{{/if}}
						<div class="stonetop-follower-field-value stonetop-follower-option-list">
							{{#each options}}
							<label class="stonetop-follower-option{{#if selected}} is-selected{{/if}}">
								<input type="radio" class="stonetop-initiate-trait-option" name="initiate-trait-{{../slug}}-{{../rowIdx}}" data-slug="{{../slug}}" data-row-idx="{{../rowIdx}}" value="{{value}}" {{#if selected}}checked{{/if}}>
								<span>{{value}}</span>
							</label>
							{{/each}}
						</div>
					</div>
					{{/each}}
				</div>
			</div>
			{{else}}
			{{#if (or exceptional tags.length (and edit.stats exceptionalAvailable))}}
			<div class="stonetop-follower-tags">
				{{> stonetopExceptionalChip}}
				{{#each tags}}<span class="stonetop-follower-tag{{#if cls}} {{cls}}{{/if}}{{#if tooltip}} stonetop-follower-tag--tooltip{{/if}}"{{#if tooltip}} data-tooltip="{{tooltip}}" data-tooltip-direction="UP"{{/if}}>{{label}}</span>{{/each}}
				{{#if traitsNote}}<span class="stonetop-follower-trait-note">{{traitsNote}}</span>{{/if}}
			</div>
			{{else}}<span class="stonetop-follower-fill-line"></span>{{/if}}
			{{/if}}
		</div>
	</div>

	{{!-- --st-follower-pip-slots: how many pip circles the card's widest track draws
	      (Loyalty is always 3; Readiness gains a 4th with a borne shield). Both the
	      Loyalty and Readiness rows size their pip column from it, so their Spend
	      buttons line up whatever each row's own count is. --}}
	<div class="stonetop-follower-body"{{#if pipSlots}} style="--st-follower-pip-slots: {{pipSlots}};"{{/if}}>
		{{!-- Stat block: Max HP through Cost/Loyalty, edited as one section. The
		      exceptional tag lives up in the chips row, not here. --}}
		<div class="stonetop-follower-stats-section">

		{{!-- Armor (Max. HP lives in the octagonal HP box up in the header). Editable
		      in edit mode for every follower type — stored as a stat override. --}}
		<div class="stonetop-follower-stat-row">
			<div class="stonetop-follower-statline">
				<span class="stonetop-follower-field-label">Armor</span>
				{{#if edit.stats}}
				<div class="stonetop-follower-armor-edit">
					<input class="stonetop-follower-stat-input stonetop-follower-stat-input--num" type="number" min="0" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="armor" value="{{armorInput}}">
					<input class="stonetop-follower-text stonetop-follower-armor-source-input" type="text" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="armorSource" value="{{armorSource}}" placeholder="from… (leather, shield…)" data-tooltip="Where their armor comes from: leather, a shield, thick hides. Optional, and it never changes the number." data-tooltip-direction="UP">
				</div>
				{{else}}
				<span class="stonetop-follower-field-value">{{armor}}{{#if armorSource}} <span class="stonetop-follower-armor-source">({{armorSource}})</span>{{/if}}</span>
				{{/if}}
			</div>
		</div>

		{{!-- Damage. In edit mode, a "uses ammo" checkbox opts a ranged follower
		      (bow / sling / thrown) into the ◇ low ammo / ◇ all out track that
		      renders just below. --}}
		<div class="stonetop-follower-field-row">
			<span class="stonetop-follower-field-label">Damage</span>
			{{#if edit.stats}}
			<div class="stonetop-follower-damage-edit">
				<input class="stonetop-follower-stat-input" type="text" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="damage" value="{{damage}}" placeholder="e.g. d8 (forceful)">
				{{#if canUseAmmo}}
				<label class="stonetop-follower-uses-ammo{{#if usesAmmo}} is-checked{{/if}}" data-tooltip="For a bow, sling, or thrown weapons: adds “low ammo” and “all out” circles to mark as they run low, then when they're spent (Moves &amp; Gear)." data-tooltip-direction="UP">
					<input type="checkbox" class="stonetop-follower-uses-ammo-input" data-ftype="{{ftype}}" data-slug="{{slug}}" {{#if usesAmmo}}checked{{/if}}>
					<span>uses ammo</span>
				</label>
				{{/if}}
			</div>
			{{else}}
			<span class="stonetop-follower-field-value">{{#if damageRoll}}<a class="rollable stonetop-follower-damage-roll" data-roll="{{damageRoll}}" data-follower-type="{{damageType}}" data-follower-kind="{{damageKind}}" data-follower-name="{{damageName}}" data-follower-pronoun="{{damagePronoun}}" data-damage-form="{{damageForm}}"><i class="fas fa-dice-d6"></i></a> {{/if}}{{damage}}</span>
			{{/if}}
		</div>

		{{!-- Ammo track (◇ low ammo / ◇ all out) — shown whenever "uses ammo" is on,
		      in both view and edit mode. Cumulative: mark "low ammo" as they run low,
		      "all out" when spent. --}}
		{{#if usesAmmo}}
		<div class="stonetop-follower-field-row stonetop-follower-ammo-row">
			<span class="stonetop-follower-field-label">Ammo</span>
			<div class="stonetop-follower-field-value stonetop-follower-ammo-controls" data-tooltip="For a follower with a bow, sling, or thrown weapons: mark as they run low on ammo, then when they're all out (Moves &amp; Gear)." data-tooltip-direction="UP">
				{{#each ammoChecks}}
				<label class="stonetop-follower-ammo-check{{#if checked}} is-checked{{/if}}">
					<input type="checkbox" class="stonetop-follower-ammo-input" data-ftype="{{../ammoFollower}}" data-slug="{{../ammoSlug}}" data-index="{{index}}" {{#if checked}}checked{{/if}}>
					<span>{{label}}</span>
				</label>
				{{/each}}
			</div>
		</div>
		{{/if}}

		{{!-- Instinct --}}
		{{#if (or instinct edit.stats)}}
		<div class="stonetop-follower-field-row{{#if (and edit.stats instinctOptions)}} stonetop-follower-field-row--block{{/if}}">
			<span class="stonetop-follower-field-label">Instinct</span>
			{{#if edit.stats}}
			{{#if instinctOptions}}
			<div class="stonetop-follower-field-value stonetop-follower-option-list">
				{{#each instinctOptions}}
				<label class="stonetop-follower-option{{#if selected}} is-selected{{/if}}">
					<input type="radio" class="stonetop-crew-instinct-option" value="{{value}}" {{#if selected}}checked{{/if}}>
					<span>{{value}}</span>
				</label>
				{{/each}}
				<input type="text" class="stonetop-follower-text stonetop-crew-instinct-custom" value="{{instinctCustom}}" placeholder="or write your own…">
			</div>
			{{else}}
			<input class="stonetop-follower-stat-input" type="text" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="instinct" value="{{instinct}}" placeholder="instinct…">
			{{/if}}
			{{else}}
			<span class="stonetop-follower-field-value">{{instinct}}</span>
			{{/if}}
		</div>
		{{/if}}

		{{!-- Moves (hidden when empty outside edit mode) --}}
		{{#if (or movesLines.length edit.moves)}}
		<div class="stonetop-follower-field-row stonetop-follower-field-row--block">
			<span class="stonetop-follower-field-label">Moves</span>
			<div class="stonetop-follower-field-value stonetop-follower-moves">
				{{#if edit.moves}}
				<textarea class="stonetop-follower-text stonetop-follower-moves-input" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="moves" rows="3" placeholder="one move per line…">{{moves}}</textarea>
				{{else}}
				<ul class="stonetop-follower-moves-list">{{#each movesLines}}<li>{{this}}</li>{{/each}}</ul>
				{{/if}}
			</div>
		</div>
		{{/if}}

		{{!-- Cost — its own fill line now (Loyalty drops to the row below), so it
		      reads like Armor / Damage / Instinct above. Crew shows its playbook
		      cost list as radio options in edit mode. --}}
		<div class="stonetop-follower-stat-row">
			<div class="stonetop-follower-statline{{#if (and edit.stats costOptions)}} stonetop-follower-statline--options{{/if}}">
				<span class="stonetop-follower-field-label">Cost</span>
				{{#if edit.stats}}
				{{#if costOptions}}
				<div class="stonetop-follower-field-value stonetop-follower-option-list">
					{{#each costOptions}}
					<label class="stonetop-follower-option{{#if selected}} is-selected{{/if}}">
						<input type="radio" class="stonetop-crew-cost-option" value="{{value}}" {{#if selected}}checked{{/if}}>
						<span>{{value}}</span>
					</label>
					{{/each}}
					<input type="text" class="stonetop-follower-text stonetop-crew-cost-custom" value="{{costCustom}}" placeholder="or write your own…">
				</div>
				{{else}}
				<input class="stonetop-follower-stat-input" type="text" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="cost" value="{{cost}}" placeholder="cost…">
				{{/if}}
				{{else}}
				<span class="stonetop-follower-field-value">{{#if cost}}{{cost}}{{else}}—{{/if}}</span>
				{{/if}}
			</div>
		</div>

		{{!-- Loyalty — its own line below Cost (mirrors the Readiness row). Always
		      click-editable, even outside edit mode: a single click fills/clears up
		      to the pip (handler keys off the data-loyalty ftype). --}}
		{{#if loyalty}}
		{{!-- Flat row (label, pips, Spend as siblings — matching the Readiness row
		      below) so the pips stay glued to the label and only Spend peels off
		      under extreme narrowness. --}}
		<div class="stonetop-follower-field-row stonetop-follower-loyalty-row">
			<span class="stonetop-follower-field-label">Loyalty</span>
			<div class="stonetop-loyalty-pips">
				{{#each loyalty}}
				<button type="button" class="stonetop-loyalty-pip{{#if filled}} is-filled{{/if}}" data-loyalty="{{../ftype}}" data-slug="{{../loyaltySlug}}" data-index="{{index}}" title="Set Loyalty"></button>
				{{/each}}
			</div>
			{{#unless edit.stats}}
			{{!-- Spend Loyalty (p.464): overcome fear / resist instinct / do something
			      they'd rather not. Disabled when they hold none. --}}
			<button type="button" class="stonetop-spend-loyalty stonetop-inline-btn"
			        data-ftype="{{ftype}}" data-slug="{{loyaltySlug}}" data-follower-name="{{orderName}}"
			        {{#unless loyaltyValue}}disabled data-tooltip="No Loyalty to spend." data-tooltip-direction="UP"{{else}}data-tooltip="Spend 1 Loyalty (overcome fear / resist instinct / do something they'd rather not)." data-tooltip-direction="UP"{{/unless}}>
				<i class="fas fa-hand-holding-hand"></i> Spend
			</button>
			{{/unless}}
		</div>
		{{/if}}
		</div>{{!-- /stonetop-follower-stats-section --}}

		{{!-- Readiness: held when they Defend; spend to suffer an attack for a ward or
		      draw all attention (p.469). A group holds ONE common pool for the whole
		      crew instead of a track per member (p.473) — same row, different wording
		      and a cap that counts shields / Shield Wall. --}}
		{{#if showReadiness}}{{#unless edit.stats}}
		<div class="stonetop-follower-field-row stonetop-follower-readiness-row">
			<span class="stonetop-follower-field-label">Readiness</span>
			<div class="stonetop-readiness-pips" data-tooltip="{{#if readinessIsPool}}Crew ordered to Defend, 7+ (p.473): common pool. 7–9: hold 1{{#if readinessHasShield}} ({{#if readinessShieldWall}}3 with Shield Wall{{else}}2 with shields{{/if}}){{/if}}. 10+: hold 3{{#if readinessHasShield}} ({{#if readinessShieldWall}}5 with Shield Wall{{else}}4 with shields{{/if}}){{/if}}.{{else}}Ordered to Defend, 7+ (p.469). 7–9: hold 1{{#if readinessHasShield}} (2 with their shield){{/if}}. 10+: hold 3{{#if readinessHasShield}} (4 with their shield){{/if}}.{{/if}} Click a circle to set how much they hold." data-tooltip-direction="UP">
				{{#each readinessPips}}
				<button type="button" class="stonetop-readiness-pip{{#if filled}} is-filled{{/if}}" data-ftype="{{../readinessFollower}}" data-slug="{{../readinessSlug}}" data-index="{{index}}" title="Set Readiness"></button>
				{{/each}}
			</div>
			<button type="button" class="stonetop-spend-readiness stonetop-inline-btn"
			        data-ftype="{{readinessFollower}}" data-slug="{{readinessSlug}}" data-follower-name="{{orderName}}"
			        {{#unless readinessValue}}disabled data-tooltip="No Readiness to spend." data-tooltip-direction="UP"{{else}}data-tooltip="Spend 1 Readiness (suffer an attack for a ward or draw all attention)." data-tooltip-direction="UP"{{/unless}}>
				<i class="fas fa-shield"></i> Spend
			</button>
		</div>
		<div class="stonetop-follower-readiness-note">held when {{#if readinessIsPool}}the crew Defends{{else}}they Defend{{/if}}; spend to suffer an attack for a ward or draw all attention</div>
		{{/unless}}{{/if}}

		{{!-- Butcher (livestock) --}}
		{{#if butcher}}
		<div class="stonetop-follower-field-row">
			<span class="stonetop-follower-field-label">Butcher</span>
			<span class="stonetop-follower-field-value">{{butcher}}</span>
		</div>
		{{/if}}

		{{!-- Gear --}}
		{{#if showGear}}
		<div class="stonetop-follower-field-row stonetop-follower-field-row--block">
			<span class="stonetop-follower-field-label">Gear</span>
			<div class="stonetop-follower-field-value">
				<div class="stonetop-follower-gear-list">
					{{#each gear}}
					<div class="stonetop-follower-gear-item{{#if checked}} is-checked{{/if}}">
						{{#if ../edit.gear}}
						<input type="checkbox" class="stonetop-follower-gear-check" data-ftype="{{../ftype}}" data-slug="{{../slug}}" data-index="{{index}}" {{#if checked}}checked{{/if}}>
						<input type="text" class="stonetop-follower-gear-label" data-ftype="{{../ftype}}" data-slug="{{../slug}}" data-index="{{index}}" value="{{label}}" placeholder="gear…">
						<button type="button" class="stonetop-follower-gear-remove stonetop-inline-btn stonetop-inline-btn--danger" data-ftype="{{../ftype}}" data-slug="{{../slug}}" data-index="{{index}}" title="Remove"><i class="fas fa-times"></i></button>
						{{else}}
						<label class="stonetop-follower-gear-toggle">
							<input type="checkbox" class="stonetop-follower-gear-check" data-ftype="{{../ftype}}" data-slug="{{../slug}}" data-index="{{index}}" {{#if checked}}checked{{/if}}>
							<span class="stonetop-follower-gear-name">{{label}}</span>
						</label>
						{{/if}}
					</div>
					{{/each}}
					{{#if edit.gear}}
					<button type="button" class="stonetop-follower-gear-add stonetop-inline-btn" data-ftype="{{ftype}}" data-slug="{{slug}}"><i class="fas fa-plus"></i> Add gear</button>
					{{else}}{{#unless gear.length}}<span class="stonetop-follower-empty">—</span>{{/unless}}{{/if}}
				</div>
			</div>
		</div>
		{{/if}}

		{{!-- Notes (hidden when empty outside edit mode) --}}
		{{#if (or notes edit.notes)}}
		<div class="stonetop-follower-field-row stonetop-follower-field-row--block">
			<span class="stonetop-follower-field-label">Notes</span>
			<div class="stonetop-follower-field-value">
				{{#if edit.notes}}
				<textarea class="stonetop-follower-text" data-ftype="{{ftype}}" data-slug="{{slug}}" data-field="notes" rows="2" placeholder="notes…">{{notes}}</textarea>
				{{else}}
				<div class="stonetop-follower-notes-text">{{notes}}</div>
				{{/if}}
			</div>
		</div>
		{{/if}}
		{{!-- Order Followers (p.462): direct them to make a move. View mode only —
		      in edit mode you're configuring the follower, not playing them. Crew
		      attacks also have the Group Fight buttons; this covers every other move
		      and every other follower type. Gated on canOrder (a Loyalty track) so
		      livestock — which can't be ordered — doesn't show it. --}}
		{{#if canOrder}}{{#unless edit.stats}}
		<div class="stonetop-follower-order-row">
			{{> stonetopOrderButton icon="fa-hand-point-right" caption="Order"}}
			{{#if canHaveNeed}}
			<button type="button" class="stonetop-follower-have-need stonetop-inline-btn"
			        data-ftype="{{ftype}}" data-slug="{{slug}}" data-follower-name="{{orderName}}"
			        data-tooltip="Have what they need: they produce a needed item; adds it to their gear (p.472)." data-tooltip-direction="UP">
				<i class="fas fa-sack"></i> Have what they need
			</button>
			{{/if}}
		</div>
		{{/unless}}{{/if}}
	</div>
	{{/inline}}

	<div class="stonetop-details-heading-row">
		{{> "stonetop.section-heading" title=(localize "stonetop.sheet.tabs.followers")
		    searchControl=true
		    searchTitle=(localize "stonetop.character.followers.searchLabel")
		    searchPlaceholder=(localize "stonetop.character.followers.searchPlaceholder")}}
		{{> "stonetop.details-section-edit-toggle" section="followers" editing=stonetop.followersEdit collapse="followers"}}
	</div>

	{{!-- Follower cards and the shared reference cards ("Animal Companion Moves",
	      "Follower Special Moves") all flow together as direct items of the
	      .stonetop-followers responsive grid, in document order. --}}

	{{!-- ── Animal Companion (Ranger) ──────────────────────────── --}}
	{{#if stonetop.followers.animalCompanion}}
	{{#with stonetop.followers.animalCompanion}}
	<div class="stonetop-follower-card" draggable="true" data-ftype="{{ftype}}" data-slug="{{slug}}">
		{{> stonetopFollowerCardBody}}
	</div>
	{{/with}}
	{{/if}}

	{{!-- ── Crew (Marshal) ────────────────────────────────────── --}}
	{{#if stonetop.followers.crew}}
	{{#with stonetop.followers.crew}}
	<div class="stonetop-follower-card stonetop-follower-card--crew" draggable="true" data-ftype="{{ftype}}" data-slug="{{slug}}">
		{{> stonetopFollowerCardBody}}

		{{!-- Inventory. The pips here (and the Supplies pips below) are deliberately NOT
		      under the card's pencil: what the crew is carrying and how much of their
		      Supplies is left changes constantly in play, so they stay live whenever the
		      sheet is editable — same as a follower's own gear ticks. --}}
		{{#if gear.length}}
		<details class="stonetop-follower-section stonetop-crew-collapsible" data-section="inventory" {{#if sectionsOpen.inventory}}open{{/if}}>
			<summary class="stonetop-follower-section-heading stonetop-follower-section-summary">Inventory <span class="stonetop-follower-section-subtitle">3 ✓ or fewer is a light load; 4–6 ✓ is a normal load; 7–9 ✓ is a heavy load.</span></summary>
			<div class="stonetop-crew-gear-list">
				{{#each gear}}
				<label class="stonetop-crew-gear-item{{#if checked}} is-checked{{/if}}">
					<span class="stonetop-crew-gear-pips">
						{{#each pips}}<input type="checkbox"
						       class="stonetop-crew-gear-check stonetop-crew-pip"
						       data-slug="{{../slug}}" data-pip="{{index}}" data-weight="{{../weight}}"
						       {{#if filled}}checked{{/if}}>{{/each}}
					</span>
					<span class="stonetop-crew-gear-label">{{{label}}}</span>
				</label>
				{{/each}}
			</div>
			<div class="stonetop-crew-supplies-section">
				<p class="stonetop-follower-section-heading">Supplies
					{{!-- Outfit the crew (p.472): members Outfit with the same gear — restock
					      all their Supplies to full. --}}
					<button type="button" class="stonetop-crew-outfit stonetop-inline-btn" data-tooltip="Outfit the crew: restock every member's Supplies to full (p.472)." data-tooltip-direction="UP">
						<i class="fas fa-sack"></i> Outfit crew
					</button>
				</p>
				<div class="stonetop-crew-supplies-grid">
					{{#each supplySets}}
					<div class="stonetop-crew-supply-set">
						{{#each pips}}<input type="checkbox"
						       class="stonetop-crew-supplies-pip stonetop-crew-pip"
						       data-set="{{setIndex}}" data-pip="{{pipIndex}}"
						       {{#if filled}}checked{{/if}}>{{/each}}
					</div>
					{{/each}}
				</div>
			</div>
		</details>
		{{/if}}

		{{!-- Roster: every member tracks their own current HP against the shared
		      max; named individuals are the ones who've "stood out" and get a tag /
		      traits, the rest are anonymous members (NPCs & Followers p.470–472). --}}
		<details class="stonetop-follower-section stonetop-crew-collapsible" data-section="roster" {{#if sectionsOpen.roster}}open{{/if}}>
			<summary class="stonetop-follower-section-heading stonetop-follower-section-summary">Roster
				<span class="stonetop-follower-section-subtitle">each member has their own HP; name those who stand out</span>
			</summary>
			{{> "stonetop.follower-section-edit" section="individuals" editing=edit.individuals}}

			{{#if edit.individuals}}
			<div class="stonetop-crew-size-row">
				<span class="stonetop-crew-size-label">Crew size</span>
				<button type="button" class="stonetop-crew-size-step stonetop-inline-btn" data-delta="-1" title="Remove a member"><i class="fas fa-minus"></i></button>
				<input class="stonetop-crew-size-input" type="number" value="{{size}}" min="{{namedCount}}" max="99">
				<button type="button" class="stonetop-crew-size-step stonetop-inline-btn" data-delta="1" title="Add a member"><i class="fas fa-plus"></i></button>
				<span class="stonetop-crew-size-suffix">members · {{memberHp}} HP each</span>
			</div>
			{{/if}}

			{{!-- Named individuals --}}
			{{#if individuals.length}}
			<div class="stonetop-crew-individuals">
				{{#each individuals}}
				<div class="stonetop-crew-individual">
					<div class="stonetop-crew-individual-header">
						{{> stonetopRosterAvatar roster="crew-individual" slug=""}}
						<span class="stonetop-crew-individual-name">{{name}}</span>
						<span class="stonetop-follower-hp-track stonetop-follower-hp-track--individual">
							<strong class="stonetop-follower-hp-label">HP</strong>
							<input class="stonetop-follower-hp-input" type="number"
							       data-follower="crew-individual" data-index="{{index}}"
							       value="{{hpCurrent}}" min="0" max="{{hpMax}}">
							<span class="stonetop-hp-sep">/</span>
							<span class="stonetop-hp-max">{{hpMax}}</span>
						</span>
						{{#if ../edit.individuals}}
						<button type="button" class="stonetop-crew-delete-individual stonetop-inline-btn stonetop-inline-btn--danger"
						        data-index="{{index}}" title="Remove">
							<i class="fas fa-times"></i>
						</button>
						{{/if}}
					</div>
					{{#if ../edit.individuals}}
					{{!-- Edit mode: labeled Tag / Traits rows --}}
					{{#if tag}}
					<div class="stonetop-crew-individual-row">
						<span class="stonetop-crew-individual-row-label">Tag</span>
						<span class="stonetop-follower-tag">{{tag}}</span>
					</div>
					{{/if}}
					{{#if traits.length}}
					<div class="stonetop-crew-individual-row">
						<span class="stonetop-crew-individual-row-label">Traits</span>
						<div class="stonetop-follower-tags">
							{{#each traits}}<span class="stonetop-follower-tag stonetop-follower-tag--trait">{{this}}</span>{{/each}}
						</div>
					</div>
					{{/if}}
					{{else}}
					{{!-- View mode: tag + traits together in one unlabeled row, tag first --}}
					{{#if (or tag traits.length)}}
					<div class="stonetop-crew-individual-row">
						<div class="stonetop-follower-tags">
							{{#if tag}}<span class="stonetop-follower-tag">{{tag}}</span>{{/if}}
							{{#each traits}}<span class="stonetop-follower-tag stonetop-follower-tag--trait">{{this}}</span>{{/each}}
						</div>
					</div>
					{{/if}}
					{{!-- Direct this member on their own (p.471): their unique tag + traits
					      apply on top of the crew's shared tags. Opens the Order dialog. --}}
					<div class="stonetop-crew-individual-order">
						{{> stonetopOrderButton ftype="crew" slug="" extraClass="stonetop-inline-btn" icon="fa-hand-point-right" caption=(concat "Order " name)}}
					</div>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{/if}}

			{{!-- Unnamed members (the rest of the half-dozen) --}}
			{{#if anonMembers.length}}
			<div class="stonetop-crew-members">
				{{#each anonMembers}}
				<div class="stonetop-crew-member-row">
					{{> stonetopRosterAvatar roster="crew-member" slug=""}}
					<span class="stonetop-crew-member-name">{{label}}</span>
					<span class="stonetop-follower-hp-track stonetop-follower-hp-track--individual">
						<strong class="stonetop-follower-hp-label">HP</strong>
						<input class="stonetop-follower-hp-input" type="number"
						       data-follower="crew-member" data-index="{{index}}"
						       value="{{hpCurrent}}" min="0" max="{{hpMax}}">
						<span class="stonetop-hp-sep">/</span>
						<span class="stonetop-hp-max">{{hpMax}}</span>
					</span>
					{{!-- Wrapped so it drops to a second line as a UNIT when the row runs out of
					      width, rather than each button wrapping on its own. Left-aligned when it
					      does, under the member's name rather than out under the HP box, so the
					      eye runs down one column of buttons; see the CSS. --}}
					{{#if ../edit.individuals}}
					<span class="stonetop-crew-member-actions">
						<button type="button" class="stonetop-crew-name-member stonetop-inline-btn" data-index="{{index}}" data-tooltip="Name this member" data-tooltip-direction="UP">
							<i class="fas fa-user-pen"></i> Name them
						</button>
					</span>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{/if}}

		</details>

		{{!-- Group Fight --}}
		<details class="stonetop-follower-section stonetop-group-fight-section stonetop-crew-collapsible" data-section="groupFight" {{#if sectionsOpen.groupFight}}open{{/if}}>
			<summary class="stonetop-follower-section-heading stonetop-follower-section-summary">Group Fight
				<span class="stonetop-follower-section-subtitle">treat the whole group as one combatant</span>
			</summary>
			<div class="stonetop-group-fight-stats-row">
				<span class="stonetop-group-fight-stat stonetop-group-fight-hp">
					<strong>Group HP</strong>
					<input class="stonetop-follower-hp-input stonetop-group-hp-input" type="number"
					       data-follower="crew-group" value="{{groupHpCurrent}}" min="0" max="{{groupHpMax}}">
					<span class="stonetop-hp-sep">/</span>
					<span class="stonetop-hp-max">{{groupHpMax}}</span>
					<a class="stonetop-group-hp-reset" title="Restore the group to full HP"><i class="fas fa-rotate-left"></i></a>
				</span>
				<span class="stonetop-group-fight-stat"><strong>Armor</strong> {{armor}}</span>
				<span class="stonetop-group-fight-stat"><strong>Roll</strong> +{{rollMod}}</span>
				<span class="stonetop-group-fight-stat">
					<strong>Damage</strong>
					<a class="rollable stonetop-follower-damage-roll stonetop-group-fight-dmg-roll"
					   data-roll="{{damageRoll}}"
					   data-base-roll="{{damageRoll}}"
					   data-follower-type="crew"
					   data-follower-name="{{#if name}}{{name}}{{else}}Crew{{/if}}"
					   data-follower-pronoun="they"
					   data-damage-form="">
						<i class="fas fa-dice-d6"></i>
					</a>
					<span class="stonetop-group-fight-dmg-label">{{damageRoll}}</span>
				</span>
			</div>
			{{!-- Readiness is NOT here: the crew's common pool sits under Loyalty in the
			      card body, where every other follower keeps theirs. --}}
			<div class="stonetop-group-fight-outnumber-row">
				<span class="stonetop-group-fight-outnumber-label">Outnumber:</span>
				<input class="stonetop-outnumber-yours" type="number" min="1"
				       value="{{#if memberCount}}{{memberCount}}{{else}}1{{/if}}">
				<span class="stonetop-outnumber-vs">vs</span>
				<input class="stonetop-outnumber-theirs" type="number" min="1" value="1">
				<span class="stonetop-outnumber-result"></span>
			</div>
			{{!-- Order Followers roll (p.462): the crew rolls its OWN bonus, not the PC's
			      +STAT. Opens the Order dialog with the crew's shared tags and moves, the
			      same as a named member's button and the custom groups below — the
			      "+{{rollMod}}" the stats row shows is just that dialog's answer when a
			      tag applies, and going through it is what lets a shared tag in the way
			      impose disadvantage. --}}
			<div class="stonetop-group-fight-roll-row">
				{{> stonetopOrderButton ftype="crew" slug="" moveKey="clash"   icon="fa-dice-d6" caption="Clash"}}
				{{> stonetopOrderButton ftype="crew" slug="" moveKey="let-fly" icon="fa-dice-d6" caption="Let Fly"}}
			</div>
		</details>
	</div>
	{{/with}}
	{{/if}}

	{{!-- ── Initiates of Danu (Blessed) ───────────────────────── --}}
	{{#if stonetop.followers.initiates.length}}
	{{#each stonetop.followers.initiates}}
	<div class="stonetop-follower-card stonetop-follower-card--initiate" draggable="true" data-ftype="{{ftype}}" data-slug="{{slug}}">
		{{> stonetopFollowerCardBody}}
	</div>
	{{/each}}
	{{/if}}

	{{!-- ── Livestock & Beasts (added via the inventory's special items) ── --}}
	{{#each stonetop.followers.beasts}}
	<div class="stonetop-follower-card stonetop-follower-card--beast{{#unless isFollower}} stonetop-follower-card--livestock{{/unless}}" draggable="true" data-ftype="{{ftype}}" data-slug="{{slug}}">
		{{> stonetopFollowerCardBody}}
	</div>
	{{/each}}

	{{!-- ── Custom followers (the Create-a-Follower walkthrough or a converted
	      monster). Same card body as the others; a Remove button appears with the
	      card's edit pencil since these are wholly player-made. ── --}}
	{{#each stonetop.followers.custom}}
	<div class="stonetop-follower-card stonetop-follower-card--custom{{#if isGroup}} stonetop-follower-card--crew{{/if}}{{#if dead}} is-dead{{/if}}" draggable="true" data-ftype="{{ftype}}" data-slug="{{slug}}">
		{{> stonetopFollowerCardBody}}

		{{!-- ── Group follower: roster + group-fight tools (p.470). Only rendered
		      for a custom follower flagged as a group (a warband, posse, arcana
		      summon, or converted group monster). Mirrors the Marshal's crew. ── --}}
		{{#if isGroup}}
		<details class="stonetop-follower-section stonetop-crew-collapsible" data-section="roster:custom:{{slug}}" {{#if groupSectionsOpen.roster}}open{{/if}}>
			<summary class="stonetop-follower-section-heading stonetop-follower-section-summary">Roster
				<span class="stonetop-follower-section-subtitle">each member tracks their own HP against the shared max</span>
			</summary>
			{{#if edit.card}}
			<div class="stonetop-crew-size-row">
				<span class="stonetop-crew-size-label">Group size</span>
				<button type="button" class="stonetop-custom-group-size-step stonetop-inline-btn" data-slug="{{slug}}" data-delta="-1" title="Remove a member"><i class="fas fa-minus"></i></button>
				<input class="stonetop-custom-group-size-input" type="number" data-slug="{{slug}}" value="{{groupSize}}" min="2" max="99">
				<button type="button" class="stonetop-custom-group-size-step stonetop-inline-btn" data-slug="{{slug}}" data-delta="1" title="Add a member"><i class="fas fa-plus"></i></button>
				<span class="stonetop-crew-size-suffix">members · {{groupMemberHp}} HP each</span>
			</div>
			{{/if}}
			<div class="stonetop-crew-members">
				{{#each groupMembers}}
				<div class="stonetop-crew-member-row">
					{{> stonetopRosterAvatar roster="custom-member" slug=../slug}}
					<span class="stonetop-crew-member-name">{{label}}</span>
					<span class="stonetop-follower-hp-track stonetop-follower-hp-track--individual">
						<strong class="stonetop-follower-hp-label">HP</strong>
						<input class="stonetop-follower-hp-input" type="number"
						       data-follower="custom-member" data-slug="{{../slug}}" data-index="{{index}}"
						       value="{{hpCurrent}}" min="0" max="{{hpMax}}">
						<span class="stonetop-hp-sep">/</span>
						<span class="stonetop-hp-max">{{hpMax}}</span>
					</span>
				</div>
				{{/each}}
			</div>
		</details>

		<details class="stonetop-follower-section stonetop-group-fight-section stonetop-crew-collapsible" data-section="groupFight:custom:{{slug}}" {{#if groupSectionsOpen.groupFight}}open{{/if}}>
			<summary class="stonetop-follower-section-heading stonetop-follower-section-summary">Group Fight
				<span class="stonetop-follower-section-subtitle">treat the whole group as one combatant</span>
			</summary>
			<div class="stonetop-group-fight-stats-row">
				<span class="stonetop-group-fight-stat stonetop-group-fight-hp">
					<strong>Group HP</strong>
					<input class="stonetop-follower-hp-input stonetop-group-hp-input" type="number"
					       data-follower="custom-group" data-slug="{{slug}}" value="{{groupHpCurrent}}" min="0" max="{{groupHpMax}}">
					<span class="stonetop-hp-sep">/</span>
					<span class="stonetop-hp-max">{{groupHpMax}}</span>
					<a class="stonetop-group-hp-reset" data-slug="{{slug}}" title="Restore the group to full HP"><i class="fas fa-rotate-left"></i></a>
				</span>
				<span class="stonetop-group-fight-stat"><strong>Armor</strong> {{armor}}</span>
				{{#if damageRoll}}
				<span class="stonetop-group-fight-stat">
					<strong>Damage</strong>
					<a class="rollable stonetop-follower-damage-roll stonetop-group-fight-dmg-roll"
					   data-roll="{{damageRoll}}"
					   data-base-roll="{{damageRoll}}"
					   data-follower-type="custom"
					   data-follower-name="{{#if name}}{{name}}{{else}}Group{{/if}}"
					   data-follower-pronoun="they"
					   data-damage-form="{{damageForm}}">
						<i class="fas fa-dice-d6"></i>
					</a>
					<span class="stonetop-group-fight-dmg-label">{{damageRoll}}</span>
				</span>
				{{/if}}
			</div>
			<div class="stonetop-group-fight-outnumber-row">
				<span class="stonetop-group-fight-outnumber-label">Outnumber:</span>
				<input class="stonetop-outnumber-yours" type="number" min="1"
				       value="{{#if memberCount}}{{memberCount}}{{else}}1{{/if}}">
				<span class="stonetop-outnumber-vs">vs</span>
				<input class="stonetop-outnumber-theirs" type="number" min="1" value="1">
				<span class="stonetop-outnumber-result"></span>
			</div>
			{{!-- Clash / Let Fly for the whole group open the Order dialog with the
			      group's tags (p.471); the outnumber bonus above rewrites the group
			      damage roll. --}}
			<div class="stonetop-group-fight-roll-row">
				{{> stonetopOrderButton ftype="custom" moveKey="clash"   icon="fa-dice-d6" caption="Clash"}}
				{{> stonetopOrderButton ftype="custom" moveKey="let-fly" icon="fa-dice-d6" caption="Let Fly"}}
			</div>
		</details>
		{{/if}}

		{{!-- ── Ring of Daagon actions (Book II, "Mysteries of the Ring of Daagon") ──
		      The Ring hosts Call Up the Deep Ones (roll & shape a fresh Servant batch);
		      each Servant batch hosts Send Them Back (+CHA). A Servant's Loyalty is the
		      Ring's shared pool — noted on the card so the pips read as shared. ── --}}
		{{#unless edit.card}}
		{{#if isRing}}
		<div class="stonetop-daagon-actions">
			<button type="button" class="stonetop-callup-deep-ones stonetop-daagon-btn" data-slug="{{slug}}"
			        data-tooltip="Stand in heavy fog or before deep water and call the servants of Daagon to serve you (spend 1 Loyalty or mark a consequence)." data-tooltip-direction="UP">
				<i class="fas fa-water"></i> Call Up the Deep Ones
			</button>
		</div>
		{{/if}}
		{{#if isServant}}
		{{#if sharedLoyalty}}
		<div class="stonetop-daagon-shared-note"><i class="fas fa-ring"></i> Loyalty is the Ring's shared pool.</div>
		{{/if}}
		{{#if brokenFree}}
		<div class="stonetop-daagon-broke-free"><i class="fas fa-skull-crossbones"></i> Broke free of your control. No longer yours to command.</div>
		{{/if}}
		<div class="stonetop-daagon-actions">
			<button type="button" class="stonetop-send-back stonetop-daagon-btn" data-slug="{{slug}}" data-follower-name="{{orderName}}"
			        data-tooltip="Send them back whence they came — roll +CHA to dismiss this batch." data-tooltip-direction="UP">
				<i class="fas fa-hand-sparkles"></i> Send Them Back
			</button>
		</div>
		{{/if}}
		{{/unless}}

		{{!-- Party-wide follower badge (advisory): any PC may pay its cost or spend
		      its Loyalty (p.464). --}}
		{{#if party}}{{#unless edit.card}}
		<div class="stonetop-follower-party-badge"><i class="fas fa-people-group"></i> Party follower: any PC may pay its cost or spend its Loyalty.</div>
		{{/unless}}{{/if}}
		{{!-- Fallen follower (marked Dead from the 0-HP fate): keep the card as a record but
		      surface a Remove button here so the player needn't open the edit pencil to clear
		      it. Reuses the same .stonetop-follower-remove handler as the edit-mode button. --}}
		{{#if dead}}{{#unless edit.card}}
		<div class="stonetop-follower-dead-actions">
			<span class="stonetop-follower-dead-note"><i class="fas fa-skull-crossbones"></i> {{#if name}}{{name}}{{else}}This follower{{/if}} has fallen. Set their HP above 0 to revive them, or remove the card.</span>
			<button type="button" class="stonetop-follower-remove stonetop-inline-btn stonetop-inline-btn--danger" data-slug="{{slug}}">
				<i class="fas fa-trash"></i> Remove
			</button>
		</div>
		{{/unless}}{{/if}}
		{{#if edit.card}}
		<div class="stonetop-follower-card-actions">
			<label class="stonetop-follower-party-toggle">
				<input type="checkbox" class="stonetop-follower-party-check" data-slug="{{slug}}" {{#if party}}checked{{/if}}>
				Party follower <span class="stonetop-follower-party-hint">(any PC pays/spends its Loyalty)</span>
			</label>
			<div class="stonetop-follower-card-actions-buttons">
				<button type="button" class="stonetop-follower-handoff stonetop-inline-btn" data-slug="{{slug}}" data-follower-name="{{orderName}}">
					<i class="fas fa-people-arrows"></i> Hand off to…
				</button>
				<button type="button" class="stonetop-follower-remove stonetop-inline-btn stonetop-inline-btn--danger" data-slug="{{slug}}">
					<i class="fas fa-trash"></i> Remove follower
				</button>
			</div>
		</div>
		{{/if}}
	</div>
	{{/each}}

	{{!-- The shared reference cards, flowing after the follower cards. --}}

	{{!-- Animal Companion special moves (Ranger insert, p.143) — only the beast-bonded
	      Ranger gets these; rendered from the playbook's animalCompanion.moves. --}}
	{{#if stonetop.animalCompanionMoves.length}}
	<div class="stonetop-follower-card stonetop-follower-card--rules">
		<div class="stonetop-follower-rules-header">
			<h3 class="stonetop-follower-rules-title">Animal Companion Moves</h3>
			<button type="button" class="stonetop-follower-rules-toggle" aria-expanded="false" title="Expand or collapse all moves">
				<i class="fas fa-chevron-up"></i>
			</button>
		</div>
		<div class="stonetop-follower-section stonetop-follower-rules">
			{{#each stonetop.animalCompanionMoves}}
			<details class="stonetop-follower-rule">
				<summary>{{name}}</summary>
				{{{description}}}
			</details>
			{{/each}}
		</div>
	</div>
	{{/if}}

	{{!-- Follower special moves shared across all followers --}}
	<div class="stonetop-follower-card stonetop-follower-card--rules">
		<div class="stonetop-follower-rules-header">
			<h3 class="stonetop-follower-rules-title">Follower Special Moves</h3>
			<button type="button" class="stonetop-follower-rules-toggle" aria-expanded="false" title="Expand or collapse all moves">
				<i class="fas fa-chevron-up"></i>
			</button>
		</div>
		<div class="stonetop-follower-section stonetop-follower-rules">
			{{!-- Rendered from the follower-moves items (module/data/follower-moves.js,
			      built from packs/src/stonetop-items/follower-moves/) so the rules text
			      lives in one place — the items — and isn't re-typed here. --}}
			{{#each stonetop.followerSpecialMoves}}
			<details class="stonetop-follower-rule">
				<summary>{{name}}</summary>
				{{{description}}}
			</details>
			{{/each}}
		</div>
	</div>

	{{!-- Create / convert entry points. The walkthrough mirrors Book I's "Creating
	      followers" steps; a dropped monster opens the conversion modal instead. Pinned
	      to the bottom of the tab, below every follower card and the rules cards. --}}
	{{#if stonetop.canAddFollower}}
	<div class="stonetop-follower-add-bar">
		<button type="button" class="stonetop-create-follower-btn stonetop-follower-add-btn">
			<i class="fas fa-user-plus"></i> Create a follower
		</button>
		{{!-- Playbook possession-followers (the dog / Hounds / Mastiffs) you hold but
		      haven't added yet — one click builds an editable card. --}}
		{{#each stonetop.followers.possessionFollowerOffers}}
		<button type="button" class="stonetop-add-possession-follower stonetop-follower-add-btn" data-slug="{{slug}}">
			<i class="fas fa-dog"></i> Add {{name}}{{#if isGroup}} (group){{/if}}
		</button>
		{{/each}}
		<span class="stonetop-follower-add-hint"><i class="fas fa-hand-pointer"></i> &hellip;or drag a monster onto this sheet to convert it to a follower.</span>
	</div>
	{{/if}}

</div>
</div>
