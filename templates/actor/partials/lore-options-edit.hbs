{{#each options}}
		{{! `caution` and `pdiMarkControl` are set only on a post-death insert's options, in
		    edit mode (post-death-outcomes.js): a pick the rules can't account for, flagged and never
		    blocked, and the GM's hand on a Thrall's Marks. A playbook's lore never carries them. }}
		{{! `atCap` and `capDisabled` are set only on a playbook's own lore, on the Details tab
		    (lore-pick-count.js#markLoreCaps): its list is at the book's most ("choose 2, maybe 3"),
		    so the boxes not yet ticked are disabled and an option with none ticked is faded. }}
		<div class="stonetop-lore-option{{#if (eq type 'text')}} stonetop-lore-option--text{{/if}}{{#if crossedOff}} is-crossed-off{{/if}}{{#if caution}} is-cautioned{{/if}}{{#if capDisabled}} is-disabled{{/if}}">
			{{#if (eq type "text")}}
			{{#if description}}<label class="stonetop-lore-option-desc">{{{this.description}}}</label>{{/if}}
			{{#if arcanaPicker}}
			<select class="stonetop-lore-arcana-select{{#if arcanaPicker.muted}} is-muted{{/if}}" data-role="{{arcanaPicker.role}}">
				<option value="">— choose a card —</option>
				{{#each arcanaPicker.options}}
				<option value="{{this.slug}}"{{#if (eq slug ../arcanaPicker.selectedSlug)}} selected{{/if}}>{{this.name}}</option>
				{{/each}}
			</select>
			{{/if}}
			<textarea class="stonetop-lore-option-text{{#if isName}} stonetop-lore-option-text--name{{/if}}"
			          data-lore-slug="{{../slug}}"
			          data-option-slug="{{this.slug}}"
			          placeholder="To be written."
			          >{{#if hasAnswer}}{{this.textValue}}{{/if}}</textarea>
			{{else}}
			<span class="stonetop-lore-option-checks">
				{{#each checks}}
				<input type="checkbox" class="stonetop-lore-option-check"
				       data-lore-slug="{{../../slug}}"
				       data-option-slug="{{../slug}}"
				       data-idx="{{@index}}"
				       {{#if this}}checked{{/if}} {{#if ../crossedOff}}disabled{{else}}{{#unless this}}{{#if ../atCap}}disabled{{/if}}{{/unless}}{{/if}}>
				{{/each}}
			</span>
			<span class="stonetop-lore-option-desc">{{#if hasBlank}}{{{this.fillBefore}}}<input type="text" class="stonetop-lore-option-text stonetop-lore-fill" data-lore-slug="{{../slug}}" data-option-slug="{{this.slug}}" value="{{this.fillValue}}" placeholder="…">{{{this.fillAfter}}}{{else}}{{{this.description}}}{{/if}}</span>
			{{#if caution}}<i class="fas fa-triangle-exclamation stonetop-lore-option-caution" role="img" aria-label="{{this.caution}}" data-tooltip="{{this.caution}}" data-tooltip-direction="UP"></i>{{/if}}
			{{#if pdiMarkControl}}
			<button type="button" class="stonetop-pdi-crossoff-btn" data-pdi-action="{{pdiMarkControl.action}}" data-slug="{{this.slug}}"
			        aria-label="{{pdiMarkControl.label}}" data-tooltip="{{pdiMarkControl.label}}">{{pdiMarkControl.text}}</button>
			{{/if}}
			{{/if}}
		</div>
{{/each}}
