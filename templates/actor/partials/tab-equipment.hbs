<div class="tab equipment" data-group="primary" data-tab="inventory">

	{{#if stonetop.editMode}}
	<div class="stonetop-inventory-toolbar">
		<button type="button" class="stonetop-inventory-reset-btn" title="{{localize 'stonetop.inventory.resetTitle'}}">
			<i class="fas fa-undo"></i> {{localize "stonetop.inventory.resetLabel"}}
		</button>
	</div>
	{{/if}}

	{{#if stonetop.inventory}}

	{{!-- Outfit header: load is a derived readout — the highlighted tier reflects
	     the ◇ you've actually marked (item weights + the undefined pool). --}}
	<div class="stonetop-outfit-header">
		<p class="stonetop-outfit-heading">{{{localize "stonetop.inventory.outfit.heading"}}}</p>
		<ul class="stonetop-outfit-loads">
			<li>
				<span class="stonetop-outfit-load-label{{#if stonetop.inventory.outfit.load.loadLevelLight}} is-checked{{/if}}">
					<span class="stonetop-outfit-load-marker"></span>
					<span>{{{format "stonetop.inventory.outfit.light" band=stonetop.inventory.outfit.loadBands.light}}}{{#if stonetop.inventory.outfit.loadBonusFrom}}{{{format "stonetop.inventory.outfit.boostedBy" moves=stonetop.inventory.outfit.loadBonusFrom}}}{{/if}}</span>
				</span>
			</li>
			<li>
				<span class="stonetop-outfit-load-label{{#if stonetop.inventory.outfit.load.loadLevelNormal}} is-checked{{/if}}">
					<span class="stonetop-outfit-load-marker"></span>
					<span>{{{format "stonetop.inventory.outfit.normal" band=stonetop.inventory.outfit.loadBands.normal}}}{{#if stonetop.inventory.outfit.loadBonusFrom}}{{{format "stonetop.inventory.outfit.boostedBy" moves=stonetop.inventory.outfit.loadBonusFrom}}}{{/if}}</span>
				</span>
			</li>
			<li>
				<span class="stonetop-outfit-load-label{{#if stonetop.inventory.outfit.load.loadLevelHeavy}} is-checked{{/if}}">
					<span class="stonetop-outfit-load-marker"></span>
					<span>{{{format "stonetop.inventory.outfit.heavy" band=stonetop.inventory.outfit.loadBands.heavy}}}{{#if stonetop.inventory.outfit.loadBonusFrom}}{{{format "stonetop.inventory.outfit.boostedBy" moves=stonetop.inventory.outfit.loadBonusFrom}}}{{/if}}</span>
				</span>
			</li>
		</ul>
		<p class="stonetop-outfit-load-current">
			{{{format "stonetop.inventory.outfit.currentLoad" count=stonetop.inventory.outfit.load.totalMarks}}}{{#if stonetop.inventory.outfit.load.loadLevelOverloaded}} <strong class="stonetop-outfit-overloaded">{{localize "stonetop.inventory.outfit.overloaded"}}</strong>{{/if}}
		</p>
	</div>

	<section class="stonetop-inventory">

		{{!-- Regular items (left column) --}}
		<div class="stonetop-inventory-regular">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.regularItems")
			    collapse="invRegular"
			    searchControl=true
			    searchTitle=(localize "stonetop.inventory.searchLabel")
			    searchPlaceholder=(localize "stonetop.inventory.searchPlaceholder")}}
			<hr class="stonetop-inv-separator">
			{{!-- Regular pool --}}
			<div class="stonetop-supplies-pool">
				<span class="stonetop-supplies-pool-label"><strong>{{localize "stonetop.inventory.regularUndefinedPoolLabel"}}</strong></span>
				<span class="stonetop-supplies-pool-diamonds" data-pool-cap="{{stonetop.inventory.outfit.regularPoolCap}}">
					{{#each (poolGroups stonetop.inventory.outfit.regularPool)}}
					{{#unless @first}}<span class="stonetop-supplies-pool-gap"></span>{{/unless}}
					{{#each this}}
					<input type="checkbox"
					       class="stonetop-inv-diamond stonetop-regular-pool-btn{{#if checked}} is-checked{{/if}}"
					       data-index="{{index}}"
					       {{#if checked}}checked{{/if}}>
					{{/each}}
					{{/each}}
				</span>
			</div>
			<p class="stonetop-supplies-pool-note">{{{localize "stonetop.inventory.regularUndefinedPoolNote"}}}</p>
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.regularSegments}}
			{{#if isGrid}}
			{{#if segmentBreak}}<hr class="stonetop-inv-separator">{{/if}}
			<div class="stonetop-inv-twocol-grid">
				{{#each items}}
				<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
					<label class="stonetop-inv-item-toggle">
						<span class="stonetop-inv-diamonds">
							{{#each (times weight)}}
							<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
							       data-slug="{{../slug}}"
							       data-weight="{{../weight}}"
							       {{#if ../checked}}checked{{/if}}
							       {{#if ../disabled}}disabled{{/if}}>
							{{/each}}
						</span>
						<span class="stonetop-inv-label">{{name}}</span>
					</label>
					{{#if note}}<span class="stonetop-inv-note">({{{note}}})</span>{{/if}}
					{{#if (and isCustom @root.stonetop.editMode)}}
					<a class="stonetop-inv-delete" data-owned-id="{{ownedId}}" title="{{localize 'stonetop.inventory.removeItem'}}"><i class="fas fa-times"></i></a>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{else}}
			{{#each items}}
			{{#if breakBefore}}<hr class="stonetop-inv-separator">{{/if}}
			{{> "stonetop.inv-item-regular" deletable=isCustom}}
			{{#if (eq slug "even-more-supplies")}}<p class="stonetop-inv-section-note">{{{localize "stonetop.inventory.regularItemsNote"}}}</p>{{/if}}
			{{/each}}
			{{/if}}
			{{/each}}
			<button type="button" class="stonetop-inv-add-btn" data-column="regular">
				<i class="fas fa-plus"></i> {{localize "stonetop.inventory.addItem"}}
			</button>
			{{!-- The ◇ half of the Arcana section: owned arcana whose curio has weight.
			      Their weightless siblings sit under the matching heading in the small
			      column. Marking one counts toward load. --}}
			{{#if stonetop.inventory.outfit.arcanaRegular.length}}
			<hr class="stonetop-inv-separator">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.arcanaItems") collapse="invArcanaRegular"}}
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.arcanaRegular}}
			<div class="stonetop-inv-item{{#if checked}} is-checked{{/if}}">
				<span class="stonetop-inv-diamonds">
					{{#each (times weight)}}
					<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
					       data-slug="{{../slug}}"
					       data-weight="{{../weight}}"
					       {{#if ../checked}}checked{{/if}}
					       {{#if ../disabled}}disabled{{/if}}>
					{{/each}}
				</span>
				<span class="stonetop-inv-label">{{name}}
					{{#if note}}<span class="stonetop-inv-note">({{{note}}})</span>{{/if}}
				</span>
			</div>
			{{/each}}
			{{/if}}
			{{!-- Treasures dragged out of a Book II journal (utils/treasure-drops.js), in
			      their own section below Arcana rather than mixed into the write-ins above.
			      The ◇ ones sit here; their pocket-sized siblings are under the matching
			      heading in the small column. Marking one still counts toward load. --}}
			{{#if stonetop.inventory.outfit.treasureRegular.length}}
			<hr class="stonetop-inv-separator">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.treasureItems") collapse="invTreasureRegular"}}
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.treasureRegular}}
			{{> "stonetop.inv-item-regular" deletable=true treasure=true}}
			{{/each}}
			{{/if}}
		</div>

		{{!-- Small items (right column) --}}
		<div class="stonetop-inventory-small" data-small-allotment="{{stonetop.inventory.outfit.smallItemLimit}}">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.smallItems")
			    collapse="invSmall"
			    searchControl=true
			    searchTitle=(localize "stonetop.inventory.searchSmallLabel")
			    searchPlaceholder=(localize "stonetop.inventory.searchSmallPlaceholder")}}
			{{#if stonetop.inventory.outfit.smallItemLimit}}
			<p class="stonetop-inv-section-note">{{{format "stonetop.inventory.smallItemsNoteWithLimit" limit=stonetop.inventory.outfit.smallItemLimit}}}</p>
			{{else}}
			<p class="stonetop-inv-section-note">{{{localize "stonetop.inventory.smallItemsNote"}}}</p>
			{{/if}}
			<hr class="stonetop-inv-separator">
			{{!-- Small pool --}}
			<div class="stonetop-supplies-pool">
				<span class="stonetop-supplies-pool-label"><strong>{{localize "stonetop.inventory.smallUndefinedPoolLabel"}}</strong></span>
				<span class="stonetop-supplies-pool-diamonds" data-pool-cap="{{stonetop.inventory.outfit.smallPoolCap}}">
					{{#each (poolItems stonetop.inventory.outfit.smallPool)}}
					<input type="checkbox"
					       class="stonetop-inventory-item-check stonetop-small-pool-display{{#if checked}} is-checked{{/if}}"
					       data-index="{{index}}"
					       {{#if checked}}checked{{/if}}>
					{{/each}}
				</span>
			</div>
			<p class="stonetop-supplies-pool-note">{{{localize "stonetop.inventory.smallUndefinedPoolNote"}}}</p>
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.smallItems}}
			{{#if breakBefore}}<hr class="stonetop-inv-separator">{{/if}}
			{{> "stonetop.inv-item-small" deletable=isCustom}}
			{{/each}}
			{{#if stonetop.inventory.outfit.smallGridItems.length}}
			<hr class="stonetop-inv-separator">
			<div class="stonetop-inv-grid">
				{{#each stonetop.inventory.outfit.smallGridItems}}
				<div class="stonetop-inv-item stonetop-inv-small{{#if checked}} is-checked{{/if}}">
					<label class="stonetop-inv-item-toggle">
						<input type="checkbox" class="stonetop-inventory-item-check"
						       data-slug="{{slug}}"
						       {{#if checked}}checked{{/if}}
						       {{#if disabled}}disabled{{/if}}>
						<span class="stonetop-inv-label">{{name}}</span>
					</label>
				</div>
				{{/each}}
			</div>
			{{/if}}
			<button type="button" class="stonetop-inv-add-btn" data-column="small">
				<i class="fas fa-plus"></i> {{localize "stonetop.inventory.addSmallItem"}}
			</button>
			{{!-- The weightless half of the Arcana section, level with the ◇ half in the
			      regular column. Rendered INERT on purpose — no checkbox, matching what a
			      ◇0 arcanum has always been — so owning cards never eats the small-item
			      allowance. --}}
			{{#if stonetop.inventory.outfit.arcanaSmall.length}}
			<hr class="stonetop-inv-separator">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.arcanaItems") collapse="invArcanaSmall"}}
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.arcanaSmall}}
			<div class="stonetop-inv-item stonetop-inv-small stonetop-inv-static{{#if checked}} is-checked{{/if}}">
				<span class="stonetop-inv-label">{{name}}
					{{#if note}}<span class="stonetop-inv-note">({{{note}}})</span>{{/if}}
				</span>
			</div>
			{{/each}}
			{{/if}}
			{{!-- The pocket-sized half of the Treasures section, sitting level with the ◇
			      half under Arcana in the regular column. Marking one still eats the small
			      allowance. --}}
			{{#if stonetop.inventory.outfit.treasureSmall.length}}
			<hr class="stonetop-inv-separator">
			{{> "stonetop.section-heading" title=(localize "stonetop.inventory.treasureItems") collapse="invTreasureSmall"}}
			<hr class="stonetop-inv-separator">
			{{#each stonetop.inventory.outfit.treasureSmall}}
			{{> "stonetop.inv-item-small" deletable=true treasure=true}}
			{{/each}}
			{{/if}}
		</div>

	</section>


	{{/if}}

	{{#if stonetop.inventory.possessions}}
	<div class="tab-section tab-section--possessions">
		<div class="stonetop-details-heading-row">
			{{#if stonetop.possessionsEdit}}
			{{> "stonetop.section-heading" title=(localize "stonetop.character.gear.specialPossessions") note=stonetop.inventory.possessions.pickNote}}
			{{else}}
			{{> "stonetop.section-heading" title=(localize "stonetop.character.gear.specialPossessions")}}
			{{/if}}
			{{> "stonetop.details-section-edit-toggle" section="possessions" editing=stonetop.possessionsEdit collapse="possessions"}}
		</div>
		<ol class="stonetop-possession-list">
		{{!-- In play mode the list is what you own; the full playbook menu lives behind the
		     edit pencil, the same way Appearance / Origin / Instinct collapse to your picks. --}}
		{{#each stonetop.inventory.possessions.items}}
			{{#if (or checked @root.stonetop.possessionsEdit)}}
			<li class="stonetop-item{{#if checked}} is-checked{{/if}}">
				<div class="stonetop-item-header">
					<input type="checkbox" class="stonetop-item-check stonetop-possession-check"
					       data-slug="{{slug}}"
					       {{#if checked}}checked{{/if}}
					       {{#if (or disabled (not @root.stonetop.possessionsEdit))}}disabled{{/if}}>
					<strong class="stonetop-item-name">{{{label}}}</strong>
					{{#if preselectedSource}}<span class="stonetop-item-source">{{preselectedSource}}</span>{{/if}}
					{{#if isCustom}}<span class="stonetop-item-source">Write-in</span>{{/if}}
					{{#if (and checked resource)}}
					<span class="stonetop-item-resources">
						{{#if usesLabel}}<span class="stonetop-uses-label">{{usesLabel}}</span>{{/if}}
						{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check" possessionSlug=slug groupBy=5}}
					</span>
					{{/if}}
					{{#if (and isCustom @root.stonetop.possessionsEdit)}}
					<a class="stonetop-possession-custom-remove" data-slug="{{slug}}" title="{{localize 'stonetop.character.gear.removePossession'}}"><i class="fas fa-times"></i></a>
					{{/if}}
					{{#if (and hasChoiceGroups @root.stonetop.possessionsEdit)}}
					<a class="stonetop-possession-choices-edit" data-possession-choices="{{slug}}"
					   data-tooltip="Edit your sacred pouch's details &amp; remarkable trait(s)" data-tooltip-direction="UP">
						<i class="fas fa-pen-to-square" aria-hidden="true"></i>
					</a>
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-item-description">{{{description}}}</div>
				{{/if}}
				{{#if choiceSummary}}
				<div class="stonetop-possession-choice-summary">
					{{#each choiceSummary}}
					<p class="stonetop-possession-choice-summary-line">
						<span class="stonetop-possession-choice-summary-heading">{{{heading}}}</span> {{{selections}}}
					</p>
					{{/each}}
				</div>
				{{/if}}
				{{!-- Bundled gear this possession grants: ◇ items (count toward load) on top,
				     small items (count toward the small-item allowance) below. Marking a box
				     drives the same accounting as the Items / Small Items columns. --}}
				{{#if (or grantedRegular.length grantedSmall.length)}}
				<div class="stonetop-possession-gear">
					{{#each grantedRegular}}
					<div class="stonetop-inv-item stonetop-possession-gear-item{{#if checked}} is-checked{{/if}}">
						<label class="stonetop-inv-item-toggle">
							<span class="stonetop-inv-diamonds">
								{{#each (times weight)}}
								<input type="checkbox" class="stonetop-inventory-item-check stonetop-inv-diamond"
								       data-slug="{{../slug}}"
								       data-weight="{{../weight}}"
								       {{#if ../checked}}checked{{/if}}
								       {{#if ../disabled}}disabled{{/if}}>
								{{/each}}
							</span>
							<span class="stonetop-inv-label">{{name}}</span>
						</label>
						{{#if resource}}<span class="stonetop-inv-note">(<span class="stonetop-inv-resources">{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" slug=slug}}</span>{{#if resourceSuffix}} {{resourceSuffix}}{{/if}})</span>{{/if}}
						{{!-- No delete control: bundled gear belongs to its possession and is
						     added/removed with the possession, not individually. --}}
					</div>
					{{/each}}
					{{#if (and grantedRegular.length grantedSmall.length)}}<hr class="stonetop-inv-separator stonetop-possession-gear-sep">{{/if}}
					{{#each grantedSmall}}
					<div class="stonetop-inv-item stonetop-inv-small stonetop-possession-gear-item{{#if checked}} is-checked{{/if}}">
						<label class="stonetop-inv-item-toggle">
							<input type="checkbox" class="stonetop-inventory-item-check"
							       data-slug="{{slug}}"
							       data-small="true"
							       {{#if checked}}checked{{/if}}
							       {{#if disabled}}disabled{{/if}}>
							<span class="stonetop-inv-label">{{name}}</span>
						</label>
						{{#if resource}}<span class="stonetop-inv-note">(<span class="stonetop-inv-resources">{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" slug=slug}}</span>{{#if resourceSuffix}} {{resourceSuffix}}{{/if}})</span>{{/if}}
						{{!-- No delete control: bundled gear belongs to its possession and is
						     added/removed with the possession, not individually. --}}
					</div>
					{{/each}}
				</div>
				{{/if}}
				{{!-- Weapons of war (the Heavy / Marshal): the weapons the player has *chosen*
				     render as ◇/□ rows exactly like a possession's bundled gear, and the diamond
				     is the load mark — tick it for the ones you're actually hauling. Choosing
				     which weapons you own happens on the edit-mode checklist below, so the
				     unchosen options stay off the card in play.
				     A weapon's uses track renders *inline* when `resourceInline` — the circles
				     stand in for the "○ low ammo, ○ all out" the label spells out, where the book
				     prints them, with the closing paren (`labelAfter`) re-attached after them. --}}
				{{#if (and choiceGear.hasPicked (not @root.stonetop.possessionsEdit))}}
				<div class="stonetop-possession-gear stonetop-possession-choice-gear">
					{{#each choiceGear.regular}}
					{{> "stonetop.choice-gear-row"}}
					{{/each}}
					{{#if (and choiceGear.regular.length choiceGear.small.length)}}<hr class="stonetop-inv-separator stonetop-possession-gear-sep">{{/if}}
					{{#each choiceGear.small}}
					{{> "stonetop.choice-gear-row" small=true}}
					{{/each}}
				</div>
				{{/if}}
				{{#if (and checked choices @root.stonetop.possessionsEdit)}}
				{{!-- A gear bundle's "Choose up to 3 (now or later)" heads its checklist: this is
				     the one place the choosing happens, so it's the one place the note belongs. --}}
				{{#if choiceGear.pickNote}}<p class="stonetop-possession-choice-gear-note">{{{choiceGear.pickNote}}}</p>{{/if}}
				<ol class="stonetop-sub-choice-list">
				{{#each choices.options}}
					<li class="stonetop-sub-choice{{#if checked}} is-checked{{/if}}">
						<label class="stonetop-sub-choice-label">
							<input type="checkbox" class="stonetop-item-check stonetop-possession-sub-check"
							       data-possession-slug="{{../slug}}"
							       data-choice-slug="{{slug}}"
							       {{#if checked}}checked{{/if}}
							       {{#if disabled}}disabled{{/if}}>
							{{!-- One element for the whole label: bare text beside the <em> tags would
							     each become their own flex item, gapped apart and wrapping between
							     words instead of inside them (see .stonetop-sub-choice-text). --}}
							<span class="stonetop-sub-choice-text">{{#if hasBlank}}{{{fillBefore}}}<input type="text" class="stonetop-possession-sub-fill" data-possession-slug="{{../slug}}" data-choice-slug="{{slug}}" value="{{fillValue}}" placeholder="…">{{{fillAfter}}}{{else}}{{{label}}}{{/if}}</span>
						</label>
						{{#if (and checked resource)}}
						<span class="stonetop-item-resources">
							{{> "stonetop.resource-track" resource=resource btnClass="stonetop-item-resource-check" possessionSlug=../slug choiceSlug=slug}}
						</span>
						{{/if}}
					</li>
				{{/each}}
				</ol>
				{{/if}}
			</li>
			{{/if}}
		{{/each}}
		</ol>
		{{#if stonetop.inventory.possessions.isIncomplete}}
		<div class="stonetop-details-onboarding-actions">
			<button type="button" class="stonetop-choose-possessions-btn" data-onboarding-start="possession">
				<i class="fas fa-question-circle" aria-hidden="true"></i>
				{{localize "stonetop.inventory.choosePossessionsButton"}}
			</button>
		</div>
		{{/if}}
	</div>
	{{/if}}


</div>
