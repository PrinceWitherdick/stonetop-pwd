{{!-- The "(… tags / uses-track …)" parenthetical after an inventory row's name. Renders
      nothing unless the item has a note or a resource track. `resourceFirst` puts the circle
      track ahead of the note text (else the note leads). Shared by the Items and Small Items
      columns so the note/resource ordering lives in exactly one place. Context: { note,
      resource, resourceFirst, slug }. Note is authored markup (escaped at save in
      wrapGearNoteTerms), so it renders raw. --}}
{{#if (or note resource)}}<span class="stonetop-inv-note">({{#if resourceFirst}}{{#if resource}}<span class="stonetop-inv-resources">{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" slug=slug}}</span>{{/if}}{{#if note}}{{#if resource}}, {{/if}}{{{this.note}}}{{/if}}{{else}}{{{this.note}}}{{#if resource}}{{#if note}} {{/if}}<span class="stonetop-inv-resources">{{> "stonetop.resource-track" resource=resource btnClass="stonetop-inv-resource-btn stonetop-inventory-resource-btn" slug=slug}}</span>{{/if}}{{/if}})</span>{{/if}}
