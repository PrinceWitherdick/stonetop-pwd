<div class="cell--attributes-top flexrow">

	{{!-- Damage die — rollable in play mode, editable text input in edit mode. The input
	      carries no `name`: the die shown is the computed one (playbook + move bonuses), so
	      letting the blanket form submit write it back would pin that value as an override
	      every time any other field changed. Typing here goes through the sheet's own change
	      handler instead, which normalizes to "d#" and stores a real override.

	      NO DICE ICON. The `<a class="rollable">` spans the whole cell and the die readout
	      inside it is `pointer-events: none` in play mode (see the .cell--Roll rules), so the
	      readout IS the button: clicking the number rolls it. The icon that used to lead the
	      row was a second, smaller target for the same click. In edit mode the input takes its
	      clicks back so it can be typed in, and the anchor still rolls from the space around
	      it. --}}
	<div class="cell cell--Roll cell--attr-damage">
		<div class="stonetop-vital-inner">
			<label class="cell__title" data-vital="damage">{{localize "stonetop.character.attributes.damage"}}</label>
			<div class="cell__roll">
				<a class="rollable" data-roll="{{system.attributes.damage.value}}" data-label="Damage">
					<input class="attr-value stonetop-damage-die-input" type="text"
					       data-damage-die
					       data-damage-base="{{stonetop.vitals.damageBase}}"
					       value="{{system.attributes.damage.value}}"
					       placeholder="{{#if stonetop.vitals.damageBase}}{{stonetop.vitals.damageBase}}{{else}}d6{{/if}}"
					       {{#if stonetop.editMode}}data-tooltip="Your damage die, as d4/d6/d8/d10/d12.{{#if stonetop.vitals.damageBase}} Clear it to go back to {{stonetop.vitals.damageBase}} from your playbook.{{/if}}"{{/if}}
					       {{#unless editable}}disabled{{/unless}}>
				</a>
			</div>
		</div>
	</div>

	{{!-- HP — the "add wound" control sits beside the label (wounds show under the vitals) --}}
	<div class="cell cell--Resource cell--attr-hp">
		<div class="stonetop-vital-inner">
			<div class="stonetop-vital-title-row">
				{{#if stonetop.woundsView.canEdit}}<span class="stonetop-wound-spacer" aria-hidden="true"></span>{{/if}}<label class="cell__title" data-vital="hp">HP</label>
				{{#if stonetop.woundsView.canEdit}}
				<button type="button" class="stonetop-wound-add" data-tooltip="Add a problematic or permanent wound" aria-label="Add a problematic or permanent wound"></button>
				{{/if}}
			</div>
			<div class="cell__resource">
				<span class="cell__value">
					<input class="attr-value" type="number"
					       name="system.attributes.hp.value"
					       value="{{system.attributes.hp.value}}"
					       min="0"
					       {{#unless editable}}disabled{{/unless}}>
				</span>
				<span class="cell__separator">/</span>
				{{!-- Max HP, like the damage die above, carries no `name`: the number shown is the
				      computed one (playbook + move bonuses - a Thrall's Marks), so a blanket form
				      write would be overwritten on the next render. Typing here goes through the
				      sheet's handler, which banks the difference as a permanent adjustment. --}}
				<span class="cell__max"{{#if stonetop.hpMaxNote}} data-tooltip="{{stonetop.hpMaxNote}}"{{/if}}>
					<input class="attr-max{{#if stonetop.hpMaxAdjusted}} stonetop-hp-max--adjusted{{/if}}" type="number"
					       data-hp-max
					       data-hp-base="{{stonetop.vitals.hpBase}}"
					       value="{{system.attributes.hp.max}}"
					       min="1"
					       {{#unless stonetop.editMode}}disabled{{/unless}}>
				</span>
			</div>
		</div>
	</div>

	{{!-- Armor (computed from inventory; always read-only) --}}
	<div class="cell cell--Number cell--attr-armor">
		<div class="stonetop-vital-inner">
			<label class="cell__title" data-vital="armor">{{localize "stonetop.character.attributes.armor"}}</label>
			<input class="attr-value" type="number"
			       name="system.attributes.armor.value"
			       value="{{system.attributes.armor.value}}"
			       disabled>
		</div>
	</div>

	{{!-- XP — max is derived from level, so its input is read-only --}}
	<div class="cell cell--Resource cell--attr-xp">
		<div class="stonetop-vital-inner">
			<label class="cell__title" data-vital="xp">{{localize "stonetop.character.attributes.xp"}}</label>
			<div class="cell__resource">
				<span class="cell__value">
					<input class="attr-value" type="number"
					       name="system.attributes.xp.value"
					       value="{{system.attributes.xp.value}}"
					       min="0"
					       {{#unless editable}}disabled{{/unless}}>
				</span>
				<span class="cell__separator">/</span>
				<span class="cell__max">
					<input class="attr-max" type="number"
					       value="{{stonetop.vitals.xp.max}}"
					       disabled>
				</span>
			</div>
		</div>
	</div>

	{{!-- Level --}}
	<div class="cell cell--Number cell--attr-level">
		<div class="stonetop-vital-inner">
			<div class="stonetop-vital-title-row">
				<label class="cell__title" data-vital="level">{{localize "stonetop.character.attributes.level"}}</label>
				{{#if stonetop.canLevelUp}}
				<a class="stonetop-levelup-icon" role="button" tabindex="0"
				   data-tooltip="{{localize "stonetop.specialMoves.levelUp.ready"}}"
				   aria-label="{{localize "stonetop.specialMoves.levelUp.ready"}}"></a>
				{{/if}}
			</div>
			<input class="attr-value" type="number"
			       name="system.attributes.level.value"
			       value="{{system.attributes.level.value}}"
			       {{#unless editable}}disabled{{/unless}}>
		</div>
	</div>

</div>
