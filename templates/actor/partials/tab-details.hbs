<div class="tab details{{#unless stonetop.editMode}} stonetop-readonly{{/unless}}" data-group="primary" data-tab="details">

		{{#if stonetop.detailsShow.lore}}
		<div class="stonetop-lore-section-wrapper{{#if stonetop.detailsEdit.lore}} stonetop-section-editing{{/if}}">
			{{#if stonetop.playbook.lore.hasEntries}}{{> "stonetop.details-section-edit-toggle" section="lore" editing=stonetop.detailsEdit.lore collapse="lore"}}{{/if}}
			{{!-- Lore renders its own playbook-specific headings, so it has never had a
			      "Lore" one of its own — it would be redundant above them. Folded, though,
			      those headings go with the rest and the section would be a caret over
			      nothing, so this stand-in appears in their place. Hidden while open, so
			      the section looks exactly as it always has; it is also what the fold
			      walker anchors on, which is why it precedes the lore body. --}}
			<h3 class="stonetop-move-group-title stonetop-lore-fold-heading">{{localize "stonetop.character.lore.sectionTitle"}}</h3>
			{{> "stonetop.lore-section" lore=stonetop.playbook.lore editMode=stonetop.detailsEdit.lore}}
		</div>
		{{/if}}

		{{#if (and stonetop.playbook.background.options.length stonetop.detailsShow.background)}}
		<div class="details-section{{#if stonetop.detailsEdit.background}} stonetop-section-editing{{/if}}">
			<div class="stonetop-details-heading-row">
				{{#if stonetop.detailsEdit.background}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.background.label") note=(localize "stonetop.character.selection.chooseOne")}}
				{{else}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.background.label")}}
				{{/if}}
				{{> "stonetop.details-section-edit-toggle" section="background" editing=stonetop.detailsEdit.background collapse="background"}}
			</div>
			{{#if stonetop.detailsEdit.background}}
			{{#each stonetop.playbook.background.options}}
			<label class="stonetop-item{{#if selected}} is-checked{{/if}}">
				<div class="stonetop-item-header">
					<input type="radio" class="stonetop-item-check" name="stonetop-background"
					       value="{{slug}}"{{#if selected}} checked{{/if}}>
					<strong class="stonetop-item-name">{{label}}</strong>
				</div>
				{{#if description}}
				<div class="stonetop-item-description stonetop-bg-description">{{{description}}}</div>
				{{/if}}
			</label>
			{{#if (and selected choices)}}
			<div class="stonetop-bg-choices">
				<p class="stonetop-bg-choices-label">{{choices.label}} (choose {{choices.countLabel}})</p>
				{{#each choices.options}}
				<label class="stonetop-bg-choice-option{{#if disabled}} is-disabled{{/if}}">
					<input type="checkbox" class="stonetop-item-check stonetop-bg-choice"
					       data-slug="{{slug}}"
					       {{#if checked}}checked{{/if}}{{#if disabled}} disabled{{/if}}>
					{{label}}
				</label>
				{{/each}}
				{{!-- Short of the count is said, never refused: the house rule for a sheet
				      that knows the book's number is to flag it and let the player decide. --}}
				{{#if choices.underMin}}
				<p class="stonetop-bg-choices-flag"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> {{choices.checkedCount}} chosen; the book asks for {{choices.countLabel}}.</p>
				{{/if}}
			</div>
			{{/if}}
			{{/each}}
			{{else}}
			{{#if stonetop.playbook.background.selected}}
			{{#each stonetop.playbook.background.options}}
			{{#if selected}}
			<div class="stonetop-item is-checked stonetop-bg-readonly">
				<div class="stonetop-item-header">
					<strong class="stonetop-item-name">{{label}}</strong>
				</div>
				{{#if description}}
				<div class="stonetop-item-description stonetop-bg-description">{{{description}}}</div>
				{{/if}}
			</div>
			{{#if choices}}
			<div class="stonetop-bg-choices">
				<p class="stonetop-bg-choices-label">{{choices.label}}</p>
				{{#each choices.options}}
				{{#if checked}}<p class="stonetop-bg-choice-readonly">{{label}}</p>{{/if}}
				{{/each}}
			</div>
			{{/if}}
			{{#if setupTexts.length}}
			<div class="stonetop-bg-choices">
				{{#each setupTexts}}
				{{#if value}}
				<p class="stonetop-bg-choices-label">{{label}}</p>
				<p class="stonetop-bg-choice-readonly">{{value}}</p>
				{{/if}}
				{{/each}}
			</div>
			{{/if}}
			{{#if setupResources.length}}
			<div class="stonetop-bg-choices stonetop-bg-resources">
				{{#each setupResources}}
				<div class="stonetop-bg-resource-row">
					<p class="stonetop-bg-choices-label">{{label}}</p>
					<span class="stonetop-item-resources">
						{{#each checks}}
						<button type="button"
						        class="stonetop-item-resource-check stonetop-bg-resource-check{{#if checked}} is-checked{{/if}}"
						        data-key="{{../key}}"
						        data-index="{{index}}"></button>
						{{/each}}
					</span>
				</div>
				{{/each}}
			</div>
			{{/if}}
			{{#if markableActions}}
			<div class="stonetop-bg-choices stonetop-bg-actions">
				<p class="stonetop-bg-choices-label">Marked actions
					<span class="stonetop-bg-actions-count">({{markableActions.markedCount}} / {{markableActions.allowed}})</span>
				</p>
				{{#each markableActions.options}}
				<label class="stonetop-bg-action-row{{#if checked}} is-checked{{/if}}">
					<input type="checkbox" class="stonetop-bg-action-check"
					       data-slug="{{slug}}"
					       {{#if checked}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}>
					<span class="stonetop-bg-action-label">{{{label}}}</span>
				</label>
				{{/each}}
			</div>
			{{/if}}
			{{/if}}
			{{/each}}
			{{/if}}
			{{/if}}
		</div>
		{{/if}}

		{{#if (and stonetop.playbook stonetop.detailsShow.instinct)}}
		<div class="details-section{{#if stonetop.detailsEdit.instinct}} stonetop-section-editing{{/if}}">
			<div class="stonetop-details-heading-row">
				{{#if stonetop.detailsEdit.instinct}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.instinct.label") note=(localize "stonetop.character.selection.chooseOne")}}
				{{else}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.instinct.label")}}
				{{/if}}
				{{> "stonetop.details-section-edit-toggle" section="instinct" editing=stonetop.detailsEdit.instinct collapse="instinct"}}
			</div>
			{{! "Lose the Instinct from your playbook, and replace it with one of these." The
			    playbook's is kept in the data and stays editable here in edit mode — removing the
			    insert brings it straight back — but it is the insert's that the sheet reads out. }}
			{{#if stonetop.postDeathInsert.activeInsert.instinct.selected}}
			<p class="stonetop-instinct-replaced-note">
				<i class="fas fa-skull"></i> {{localize "stonetop.postDeath.instinctRetired"}}
			</p>
			{{/if}}
			{{#if stonetop.detailsEdit.instinct}}
			<div class="stonetop-instinct-custom-row">
				<input type="text" class="stonetop-instinct-custom-word"
				       value="{{stonetop.playbook.instinct.customWord}}"
				       aria-label="Instinct word"
				       placeholder="{{localize "stonetop.character.selection.instinct.customWordPlaceholder"}}">
				<input type="text" class="stonetop-instinct-custom-desc"
				       value="{{stonetop.playbook.instinct.customDescription}}"
				       aria-label="Instinct description"
				       placeholder="{{localize "stonetop.character.selection.instinct.customPlaceholder"}}">
			</div>
			{{#if stonetop.playbook.instinct.options.length}}
			<div class="stonetop-instinct-options">
				{{#each stonetop.playbook.instinct.options}}
				<label class="stonetop-item{{#if selected}} is-checked{{/if}}">
					<div class="stonetop-item-header">
						<input type="radio" class="stonetop-item-check" name="stonetop-instinct"
						       value="{{value}}"{{#if selected}} checked{{/if}}>
						<strong class="stonetop-item-name">{{word}}</strong>
					</div>
					<div class="stonetop-item-description">{{description}}</div>
				</label>
				{{/each}}
			</div>
			{{/if}}
			{{else}}
			{{#if stonetop.postDeathInsert.activeInsert.instinct.selected}}
			<p class="stonetop-instinct-readonly">{{stonetop.postDeathInsert.activeInsert.instinct.selected}}</p>
			{{else if stonetop.playbook.instinct.selected}}
			<p class="stonetop-instinct-readonly">{{stonetop.playbook.instinct.selected}}</p>
			{{/if}}
			{{/if}}
		</div>
		{{/if}}

		{{#if (and stonetop.playbook stonetop.playbook.appearance.options.length stonetop.detailsShow.appearance)}}
		<div class="details-section{{#if stonetop.detailsEdit.appearance}} stonetop-section-editing{{/if}}">
			<div class="stonetop-details-heading-row">
				{{#if stonetop.detailsEdit.appearance}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.appearance.label") note=(localize "stonetop.character.selection.appearance.instruction")}}
				{{else}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.appearance.label")}}
				{{/if}}
				{{> "stonetop.details-section-edit-toggle" section="appearance" editing=stonetop.detailsEdit.appearance collapse="appearance"}}
			</div>
			{{#if stonetop.detailsEdit.appearance}}
			{{#each stonetop.playbook.appearance.options}}
			<div class="stonetop-appearance-row">
				{{#each options}}
				<label class="stonetop-item stonetop-appearance-option{{#if selected}} is-checked{{/if}}">
					<div class="stonetop-item-header">
						<input type="radio" class="stonetop-item-check stonetop-appearance-radio"
						       name="stonetop-appearance-{{../lineIdx}}"
						       data-line="{{../lineIdx}}"
						       value="{{value}}"{{#if selected}} checked{{/if}}>
						<strong class="stonetop-item-name">{{value}}</strong>
					</div>
				</label>
				{{/each}}
				{{! "…or make something up" — the section heading has said so all along, and the
				    onboarding wizard offers it on this very step, but the sheet had nowhere to
				    write one in: a line made up during creation could be read back here only as
				    four unticked suggestions. Typing here unticks the row's suggestions and
				    ticking a suggestion clears this (both in activateListeners), so the line
				    holds exactly one value either way. }}
				<label class="stonetop-item stonetop-appearance-option stonetop-appearance-custom-option{{#if isCustom}} is-checked{{/if}}">
					<div class="stonetop-item-header">
						{{! maxlength because this line is read out INLINE — the header joins all
						    four with " · " — and the longest authored suggestion in any playbook
						    is 20 characters ("like a whippin stick"). 60 leaves room to be
						    inventive without letting a pasted paragraph become the name-line. }}
						<input type="text" class="stonetop-appearance-custom"
						       data-line="{{lineIdx}}"
						       value="{{customValue}}"
						       maxlength="60"
						       aria-label="{{localize "stonetop.character.selection.appearance.customLabel"}}"
						       placeholder="{{localize "stonetop.character.selection.appearance.customPlaceholder"}}">
					</div>
				</label>
			</div>
			{{/each}}
			{{else}}
			<p class="stonetop-appearance-readonly">{{#each stonetop.playbook.appearance.options}}{{#if value}}<span class="stonetop-appearance-readonly-item">{{value}}</span>{{/if}}{{/each}}</p>
			{{/if}}
		</div>
		{{/if}}

		{{#if (and stonetop.playbook.origin.options.length stonetop.detailsShow.origin)}}
		<div class="details-section{{#if stonetop.detailsEdit.origin}} stonetop-section-editing{{/if}}">
			<div class="stonetop-details-heading-row">
				{{#if stonetop.detailsEdit.origin}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.origin.label") note=(localize "stonetop.character.selection.origin.instruction")}}
				{{else}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.selection.origin.label")}}
				{{/if}}
				{{> "stonetop.details-section-edit-toggle" section="origin" editing=stonetop.detailsEdit.origin collapse="origin"}}
			</div>
			{{#if stonetop.detailsEdit.origin}}
			{{#each stonetop.playbook.origin.options}}
			<div class="stonetop-item stonetop-origin-option{{#if selected}} is-checked selected{{/if}}">
				<label class="stonetop-item-header stonetop-origin-region">
					<input type="radio" class="stonetop-item-check" name="stonetop-origin"
					       value="{{region}}"{{#if selected}} checked{{/if}}>
					<strong class="stonetop-item-name">{{region}}</strong>
				</label>
				<div class="stonetop-origin-names">
					{{#each names}}
					<label class="stonetop-origin-name-label{{#if checked}} is-checked{{/if}}">
						<input type="radio" class="stonetop-origin-name-check"
						       name="stonetop-origin-name-{{../region}}"
						       value="{{name}}"
						       {{#if checked}}checked{{/if}}>
						{{name}}
					</label>
					{{/each}}
				</div>
			</div>
			{{/each}}
			{{else}}
			{{#if stonetop.playbook.origin.selected}}
			{{#each stonetop.playbook.origin.options}}
			{{#if selected}}
			<div class="stonetop-item is-checked stonetop-origin-readonly">
				<div class="stonetop-item-header">
					<strong class="stonetop-item-name">{{region}}</strong>
				</div>
				{{#if description}}
				<div class="stonetop-origin-description">{{{description}}}</div>
				{{/if}}
			</div>
			{{/if}}
			{{/each}}
			{{/if}}
			{{/if}}
		</div>
		{{/if}}

		{{!-- Relationships — how this character feels about the other player characters
		     and the folk on the steading sheet, on the same 1-5 hearts the NPC sheet uses
		     for its side of a tie. Clicking a heart sets the rating (click the last filled
		     one to drop it); it stays interactive in play mode, since regard shifts at the
		     table. The pencil reveals every candidate with a show/hide box — play mode
		     lists only the ticked ones. --}}
		<div class="details-section stonetop-character-relationships stonetop-rel-droppable{{#if stonetop.detailsEdit.relationships}} stonetop-section-editing{{/if}}">
			<div class="stonetop-details-heading-row">
				{{#if stonetop.detailsEdit.relationships}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.relationships.title") note=(localize "stonetop.character.relationships.chooseNote")}}
				{{else}}
				{{> "stonetop.section-heading" title=(localize "stonetop.character.relationships.title")}}
				{{/if}}
				{{> "stonetop.details-section-edit-toggle" section="relationships" editing=stonetop.detailsEdit.relationships collapse="relationships"}}
				{{!-- Table/Board toggle on the heading's own line, far right, above the
				      underline. Absolutely positioned clear of the pencil (which sits at
				      right:0), matching how this heading row already places that pencil.
				      Gated on the same condition as the section body: with no rows, neither
				      layout has anything to show, so a toggle would switch between two
				      identical empty states. --}}
				{{#if stonetop.hasRelationships}}
				{{> "stonetop.relationships-viewbar" resizeKey=stonetop.rel.resizeKey
				    view=stonetop.rel.view inHeading=true}}
				{{/if}}
			</div>
			{{#if stonetop.hasRelationships}}
			{{> "stonetop.relationships-view" rows=stonetop.relationships lanes=stonetop.rel.lanes
			    view=stonetop.rel.view resizeKey=stonetop.rel.resizeKey hideViewbar=true
			    nameLabel=(localize "stonetop.character.relationships.who") canRate=stonetop.canEdit
			    canToggle=stonetop.detailsEdit.relationships}}
			{{else}}
			<p class="stonetop-rel-empty">{{#if stonetop.relationshipsAllHidden}}{{localize "stonetop.character.relationships.allHidden"}}{{else}}{{localize "stonetop.character.relationships.empty"}}{{/if}}</p>
			{{/if}}
		</div>

		{{#if (and stonetop.playbook stonetop.hasIncompleteBackgroundQuestions)}}
		<div class="details-section stonetop-details-onboarding-actions">
			<button type="button" class="stonetop-answer-character-questions-btn" data-onboarding-start="first-incomplete">
				<i class="fas fa-question-circle" aria-hidden="true"></i>
				{{localize "stonetop.newCharacter.answerQuestionsButtonLabel"}}
			</button>
		</div>
		{{/if}}

</div>
