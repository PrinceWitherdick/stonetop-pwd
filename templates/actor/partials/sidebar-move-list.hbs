{{#if moves.length}}
<div class="stonetop-moves-collapsible{{#unless open}} is-collapsed{{/unless}}" data-section="{{sectionId}}">
<div class="stonetop-moves-summary" role="button" tabindex="0" aria-expanded="{{#if open}}true{{else}}false{{/if}}">{{> "stonetop.section-heading" title=(localize titleKey)}}</div>
<ol class="items-list">
{{#each moves}}
	{{#if (and owned rollType)}}
	<li class="item stonetop-move-item" data-item-id="{{ownedId}}">
	{{else}}
	<li class="stonetop-move-item{{#unless owned}} move-unowned{{/unless}}">
	{{/if}}
		{{#if (and owned rollType)}}
		<span class="rollable move-rollable" data-roll="{{rollType}}" data-mod="">
			<i class="fas fa-dice-d6"></i>
		</span>
		{{/if}}
		{{#if (and @root.stonetop.showRollStatChips rollLabel)}}<span class="stonetop-move-roll-chip">+{{rollLabel}}</span>{{/if}}
		<span class="stonetop-move-name {{openClass}}"
		      data-compendium-id="{{compendiumId}}">{{name}}</span>
		{{#if readiness}}
		{{!-- Readiness circles (Defend, p.216): filled from a Defend roll's tier, lost when
		      you go on the offense. Click a circle to set how much you hold; click the
		      highest filled one to spend back down. --}}
		<span class="stonetop-move-readiness" data-tooltip="Readiness (Defend, p.216). 10+: hold 3{{#if readiness.hasShield}} (4 with a shield){{/if}}. 7&ndash;9: hold 1{{#if readiness.hasShield}} (2 with a shield){{/if}}.{{#if readiness.hasGuardian}} Guardian: +1, and 1 even on a 6-.{{/if}} Filled when you Defend; lost when you go on the offense (Clash / Let Fly). Click a circle to set how much you hold; spend it to weather an attack for a ward, halve it, draw all attention, or strike back." data-tooltip-direction="UP">
			{{#each readiness.pips}}
			<button type="button" class="stonetop-readiness-pip stonetop-move-readiness-pip{{#if filled}} is-filled{{/if}}" data-index="{{index}}" title="Set Readiness"></button>
			{{/each}}
		</span>
		{{/if}}
		{{#if description}}<div class="stonetop-basic-move-desc" hidden>{{{moveBody description moveResults}}}</div>{{/if}}
	</li>
{{/each}}
</ol>
</div>
{{/if}}
