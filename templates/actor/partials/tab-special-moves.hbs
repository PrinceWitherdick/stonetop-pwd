<div class="tab stonetop-special-moves" data-group="primary" data-tab="special-moves">

	{{> "stonetop.section-heading" title=(localize "stonetop.sheet.tabs.specialMoves") collapse="specialMoves"}}

	<div class="stonetop-special-move-grid">

		<div class="stonetop-special-move-card">
			<h3 class="stonetop-special-move-name">{{localize "stonetop.specialMoves.burnBrightly.title"}}</h3>
			<p class="stonetop-special-move-summary">{{{localize "stonetop.specialMoves.burnBrightly.description"}}}</p>
			<p class="stonetop-special-move-locked-hint">
				<i class="fas fa-comment-dots"></i>
				{{localize "stonetop.specialMoves.burnBrightly.promptNote"}}
			</p>
		</div>

		<div class="stonetop-special-move-card{{#unless (or stonetop.deathsDoor.canFace stonetop.deathsDoor.isFatePending)}} is-locked{{/unless}}">
			<h3 class="stonetop-special-move-name">{{localize "stonetop.specialMoves.deathsDoor.title"}}</h3>
			<p class="stonetop-special-move-summary">{{{localize "stonetop.specialMoves.deathsDoor.summary"}}}</p>

			{{! Hint and control are both decided in _buildDeathsDoorData: the state they're in
			    wins over the "which move do I trigger" hint, which only matters while they're up. }}
			{{#with stonetop.deathsDoor.hint}}
			<p class="stonetop-special-move-locked-hint{{#if isState}} stonetop-deathsdoor-state{{/if}}">
				<i class="fas {{icon}}"></i>
				{{text}}
			</p>
			{{/with}}

			{{#with stonetop.deathsDoor.action}}
			<button type="button" class="{{cls}}" {{#if disabled}}disabled{{/if}}>
				<i class="fas {{icon}}"></i>
				{{label}}
			</button>
			{{/with}}

			{{! Edit mode's way off a fate that was settled away from this window — or retconned.
			    Nothing else clears `fate-pending`, and a sheet left holding it is never recognised
			    as dying again. See clearFate. }}
			{{#if stonetop.deathsDoor.clearFate}}
			<button type="button" class="stonetop-deathsdoor-clear-btn"
			        data-tooltip="{{localize "stonetop.specialMoves.deathsDoor.clearFateHint"}}">
				<i class="fas fa-rotate-left"></i>
				{{localize "stonetop.specialMoves.deathsDoor.clearFate"}}
			</button>
			{{/if}}

			{{! Edit mode's route to the Post-Death tab, for a table who resolved the Last Door away
			    from the sheet: that tab is opt-in, and this is what opts in. See openPostDeath. }}
			{{#if stonetop.deathsDoor.openPostDeath}}
			<button type="button" class="stonetop-deathsdoor-postdeath-btn"
			        data-tooltip="{{localize "stonetop.specialMoves.deathsDoor.postDeathTabHint"}}">
				<i class="fas fa-scale-unbalanced"></i>
				{{localize "stonetop.specialMoves.deathsDoor.postDeathTab"}}
			</button>
			{{/if}}
		</div>

		<div class="stonetop-special-move-card{{#unless stonetop.recover.canRecover}} is-locked{{/unless}}">
			<h3 class="stonetop-special-move-name">{{localize "stonetop.specialMoves.recover.title"}}</h3>
			<p class="stonetop-special-move-summary">{{{localize "stonetop.specialMoves.recover.summary"}}}</p>
			{{#if stonetop.recover.hint}}
			<p class="stonetop-special-move-locked-hint">
				<i class="fas {{stonetop.recover.hint.icon}}"></i>
				{{stonetop.recover.hint.text}}
			</p>
			{{/if}}
			<button type="button" class="stonetop-recover-open-btn"
				{{#unless stonetop.recover.canRecover}}disabled{{/unless}}>
				<i class="fas fa-heart-circle-plus"></i>
				{{localize "stonetop.specialMoves.recover.button"}}
			</button>
		</div>

		<div class="stonetop-special-move-card{{#unless stonetop.canLevelUp}} is-locked{{/unless}}">
			<h3 class="stonetop-special-move-name">{{localize "stonetop.specialMoves.levelUp.title"}}</h3>
			<p class="stonetop-special-move-summary">{{{localize "stonetop.specialMoves.levelUp.summary"}}}</p>
			{{#unless stonetop.canLevelUp}}
			<p class="stonetop-special-move-locked-hint">
				<i class="fas fa-lock"></i>
				{{{localize "stonetop.specialMoves.levelUp.lockedHint"}}}
			</p>
			{{/unless}}
			<button type="button" class="stonetop-levelup-open-btn"
				{{#unless stonetop.canLevelUp}}disabled{{/unless}}>
				<i class="fas fa-arrow-circle-up"></i>
				{{localize "stonetop.specialMoves.levelUp.button"}}
			</button>
		</div>

		<div class="stonetop-special-move-card{{#unless stonetop.convalesce.canConvalesce}} is-locked{{/unless}}">
			<h3 class="stonetop-special-move-name">{{localize "stonetop.specialMoves.convalesce.title"}}</h3>
			<p class="stonetop-special-move-summary">{{{localize "stonetop.specialMoves.convalesce.summary"}}}</p>
			{{#if stonetop.convalesce.hint}}
			<p class="stonetop-special-move-locked-hint">
				<i class="fas {{stonetop.convalesce.hint.icon}}"></i>
				{{stonetop.convalesce.hint.text}}
			</p>
			{{/if}}
			<button type="button" class="stonetop-convalesce-open-btn"
				{{#unless stonetop.convalesce.canConvalesce}}disabled{{/unless}}>
				<i class="fas fa-bed"></i>
				{{localize "stonetop.specialMoves.convalesce.button"}}
			</button>
		</div>

	</div>

</div>
