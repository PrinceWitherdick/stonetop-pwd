{{#unless listOnly}}
<div class="stonetop-move-group">
	{{#if editSection}}
	<div class="stonetop-details-heading-row">
		{{> "stonetop.section-heading" title=title note=note searchControl=searchControl searchTitle=searchTitle searchPlaceholder=searchPlaceholder}}
		{{!-- `collapseId`, not `editSection`: the playbook and learned groups share the
		      one "moves" edit section but fold independently. --}}
		{{> "stonetop.details-section-edit-toggle" section=editSection editing=editing collapse=collapseId}}
	</div>
	{{else}}
	{{!-- No pencil, so the caret goes inside the heading instead of beside one. --}}
	{{> "stonetop.section-heading" title=title note=note collapse=collapseId}}
	{{/if}}
	{{#if hideToggle}}
	{{!-- Both toggles share one row so they read as a pair of filters over the list
	      below, and so the row (not either label) owns the heading-to-first-card gap.
	      "Organize by category" is gated on `groups`, not on `groupByCategory`: the
	      playbook either has clusters to organize by or it doesn't, and gating it on
	      the toggle's own state would make the checkbox disappear the moment it was
	      un-ticked, with no way back. --}}
	<div class="stonetop-move-toggle-row">
		<label class="stonetop-hide-unselected-label">
			<input type="checkbox" class="stonetop-hide-unselected-check"{{#if hideUnselected}} checked{{/if}}>
			Hide un-learned moves
		</label>
		{{#if groups}}
		<label class="stonetop-hide-unselected-label">
			<input type="checkbox" class="stonetop-group-by-category-check"{{#if groupByCategory}} checked{{/if}}>
			Organize by category
		</label>
		{{/if}}
	</div>
	{{/if}}
	{{!-- A bare `groups` is safe here: `and` answers exactly as `{{#if groups}}` does,
	      empty array included (utils/hbs-truthy.js). It did not always — built on plain
	      `Boolean` it called a homebrew playbook's empty group list TRUE and rendered
	      this branch's empty `{{#each}}`, i.e. no move list at all. --}}
	{{#if (and groupByCategory groups)}}
		{{!-- The playbook's moves split into the three clusters the onboarding "choose
		      moves" step filters by (onboarding-move-groups.js), plus a trailing "Other"
		      for the moves no cluster claims — chiefly Improved / Superior Stat.

		      Each sub-group is its own <div> so the SECTION's fold still swallows the lot:
		      the collapse walks a heading's following SIBLINGS and stops at the next
		      heading (section-editing.js#_sectionFoldTargets), and these sub-titles are
		      `.stonetop-move-group-title` too. Boxed up they're never siblings of the
		      section's heading row, while inside a box a sub-title's own fold reaches
		      exactly its own lists. Sub-fold ids are namespaced under the section's, so a
		      group key can't collide with a section id elsewhere on the sheet.

		      Owned / un-owned stay split WITHIN each group, so "Hide un-learned moves"
		      and the tab search work the same as they do on a flat list. --}}
		{{#each groups}}
		<div class="stonetop-move-subgroup">
			{{> "stonetop.section-heading" title=label collapse=(concat ../collapseId ":" key)}}
			{{#if ownedMoves.length}}
			{{> "stonetop.move-group" listOnly=true moves=ownedMoves listClass="stonetop-move-list--owned"}}
			{{/if}}
			{{#if unownedMoves.length}}
			{{> "stonetop.move-group" listOnly=true moves=unownedMoves listClass="stonetop-move-list--unowned"}}
			{{/if}}
		</div>
		{{/each}}
	{{else if splitUnowned}}
		{{#if ownedMoves.length}}
		{{> "stonetop.move-group" listOnly=true moves=ownedMoves listClass="stonetop-move-list--owned"}}
		{{/if}}
		{{#if unownedMoves.length}}
		{{> "stonetop.move-group" listOnly=true moves=unownedMoves listClass="stonetop-move-list--unowned"}}
		{{/if}}
	{{else}}
		{{> "stonetop.move-group" listOnly=true moves=moves}}
	{{/if}}
</div>
{{else}}
	<ol class="items-list{{#if listClass}} {{listClass}}{{/if}}">
	{{#each moves}}
		{{!-- Every OWNED move is a draggable .item (so it can be dragged onto the macro
		      hotbar — rollable moves make a roll macro, description-only ones a post-to-chat
		      macro). Un-owned rows (the unpicked side of an either/or choice) stay
		      non-draggable. Whether the title ROLLS is gated on rollType below. --}}
		{{#if owned}}
		<li class="item stonetop-item is-checked{{#if requirementsUnmet}} move-requirements-unmet{{/if}}{{#if (or markBudget.needsChoice statChoiceNeeded)}} move-needs-choice{{/if}}{{#if isStarting}} move-starting{{/if}}" data-item-id="{{ownedId}}">
		{{else}}
		<li class="stonetop-item{{#if (and locked (not owned))}} move-locked{{/if}}{{#if requirementsUnmet}} move-requirements-unmet{{/if}}{{#if (or markBudget.needsChoice statChoiceNeeded)}} move-needs-choice{{/if}}{{#if isStarting}} move-starting{{/if}}">
		{{/if}}
			<div class="stonetop-item-header">
				{{!-- The source badge ("Starting move", "Background", "Granted by …") comes
				      FIRST so it can float into the top-right corner while the checkbox /
				      title / +stat chip flow around it (see the .stonetop-item-source
				      float rules). A right float only reserves its corner on line 1 if it
				      precedes the inline content in the DOM. --}}
				{{#if sourceLabel}}<span class="stonetop-item-source">{{sourceLabel}}</span>{{/if}}
				{{#if repeatable}}
				<span class="stonetop-repeat-checks">
					{{#each (repeatChecks this)}}
					<input type="checkbox" class="stonetop-item-check stonetop-repeat-check"
					       data-compendium-id="{{../compendiumId}}"
					       data-owned-id="{{ownedId}}"
					       data-move-name="{{../name}}"
					       {{#if checked}}checked{{/if}}
					       {{#if (or disabled (not @root.stonetop.movesEdit))}}disabled{{/if}}>
					{{/each}}
				</span>
				{{else}}
				<input type="checkbox" class="stonetop-item-check stonetop-move-check"
				       data-compendium-id="{{compendiumId}}"
				       data-owned-id="{{ownedId}}"
				       data-move-name="{{name}}"
				       {{#if owned}}checked{{/if}}
				       {{!-- An owned starting move is locked (can't be dropped); an UNowned one
				             — the unpicked side of an "either X OR Y" choice — stays pickable
				             in edit mode so the choice can be made/changed by hand on the sheet.
			             A move whose requirements aren't met stays faded (.move-locked) but is
			             still pickable in edit mode, so a player can deliberately learn it anyway
			             — it then shows the "requirement not met" warning. --}}
				       {{#if (or (and isStarting owned) (not @root.stonetop.movesEdit))}}disabled{{/if}}>
				{{/if}}
				{{!-- THE TITLE IS THE ROLL. There is no dice icon beside a move any more: the
				      name element IS the `.rollable`, carrying the stat and the classes the
				      icon used to, so the sheet's rollable handler answers a click on the
				      title exactly as it answered a click on the die.

				      That is what the icon's click always did anyway — the name forwarded to
				      it under the "Hide Rollable Icon" setting, which is now how every sheet
				      behaves. A move with no roll (or an un-owned row) gets a plain name and
				      falls through to the name handler, which posts its text to chat.

				      The "+STAT" chip follows the title rather than leading it, so the header
				      line reads as a title with its stat beside it rather than a stat with a
				      title trailing after. It rolls too — see the chip's own handler. --}}
				<strong class="stonetop-item-name{{#if (and owned rollType)}} rollable move-rollable{{/if}}"{{#if (and owned rollType)}} data-roll="{{rollType}}" data-mod=""{{/if}}>{{name}}</strong>
				{{#if (and @root.stonetop.showRollStatChips rollLabel)}}<span class="stonetop-move-roll-chip">+{{rollLabel}}</span>{{/if}}
				{{#if requirementsUnmet}}<i class="fas fa-triangle-exclamation stonetop-move-req-warning" data-tooltip="You own this move but do not meet its requirement{{#if requiresLabel}} ({{requiresLabel}}){{/if}}. Add the missing prerequisite, or drop this move." data-tooltip-direction="UP" aria-hidden="true"></i>{{/if}}
				{{#if markBudget.needsChoice}}<i class="fas fa-hand-pointer stonetop-move-choice-needed" data-tooltip="This move has selections left to make ({{markBudget.used}} of {{markBudget.max}} chosen). Tap the hand to jump into the moves editor and choose the rest." data-tooltip-direction="UP" role="button" tabindex="0"></i>{{/if}}
				{{#if statChoiceNeeded}}<i class="fas fa-hand-pointer stonetop-move-stat-choice-needed" data-tooltip="You took this move but haven't chosen which stat to raise, so it isn't boosting anything yet. Tap the hand to pick a stat (+1, max +{{statChoiceNeeded.cap}})." data-tooltip-direction="UP" role="button" tabindex="0"></i>{{/if}}
				{{#if (and owned resource)}}
				{{!-- Eats the header line's free space so the track sits at the right edge
				      while it shares the title's line, and starts at the LEFT when a narrow
				      card wraps it onto its own line. See .stonetop-item-header-spacer. --}}
				<span class="stonetop-item-header-spacer" aria-hidden="true"></span>
				<span class="stonetop-item-resources">
					{{#if resource.title}}<span class="stonetop-item-resource-title"{{#if resource.spendTooltip}} data-tooltip="{{resource.spendTooltip}}" data-tooltip-direction="UP"{{/if}}>{{resource.title}}</span>{{/if}}
					{{#each (resourceChecks resource)}}
					<span class="stonetop-item-resource-entry">
						<button type="button" class="stonetop-item-resource-check{{#if checked}} is-checked{{/if}}"
						        data-move-name="{{../name}}"
						        data-index="{{@index}}"></button>
						{{#if label}}<span class="stonetop-resource-label">{{label}}</span>{{/if}}
					</span>
					{{/each}}
				</span>
				{{/if}}
				{{#if (and @root.stonetop.movesEdit owned (lookup @root.stonetop.possessionTriggerMoves name))}}
				<a class="stonetop-move-possession-edit" data-possession-choices="{{lookup @root.stonetop.possessionTriggerMoves name}}"
				   data-tooltip="Choose your sacred pouch's remarkable trait(s)" data-tooltip-direction="UP">
					<i class="fas fa-pen-to-square" aria-hidden="true"></i>
				</a>
				{{/if}}
			</div>
			<div class="stonetop-item-description">{{{moveBody description moveResults}}}</div>
			{{#if markBudget}}
			<p class="stonetop-move-mark-budget{{#if markBudget.atBudget}} is-at-budget{{/if}}{{#if markBudget.over}} is-over{{/if}}"
			   data-tooltip="Each time you take this move you may choose another option." data-tooltip-direction="UP">
				{{markBudget.used}} / {{markBudget.max}} chosen
			</p>
			{{/if}}
			{{#if markOptions}}
			<ul class="stonetop-move-marks">
				{{#each markOptions}}
				<li class="stonetop-move-mark">
					{{#if statSlots}}
					<span class="stonetop-move-mark-label">{{label}}</span>
					<span class="stonetop-move-mark-slots">
						{{#each statSlots}}
						<span class="stonetop-move-mark-slot">
							<select class="stonetop-move-mark-stat"
							        data-move-name="{{../../name}}"
							        data-mark-slug="{{../slug}}"
							        data-idx="{{index}}"
							        {{#unless @root.stonetop.movesEdit}}disabled{{/unless}}>
								{{#each options}}<option value="{{key}}"{{#if selected}} selected{{/if}}>{{abbr}}</option>{{/each}}
							</select>
							{{> "stonetop.move-mark-level" moveName=../../name slug=../slug index=index level=level}}
						</span>
						{{/each}}
					</span>
					{{else}}
					<span class="stonetop-move-mark-checks">
						{{#each checks}}
						<input type="checkbox" class="stonetop-move-mark-check"
						       data-move-name="{{../../name}}"
						       data-mark-slug="{{../slug}}"
						       data-idx="{{index}}"
						       {{#if checked}}checked{{/if}}
						       {{#if (or disabled (not @root.stonetop.movesEdit))}}disabled{{/if}}>
						{{/each}}
					</span>
					<span class="stonetop-move-mark-label">{{label}}</span>
					{{#each checks}}{{#if checked}}{{> "stonetop.move-mark-level" moveName=../../name slug=../slug index=index level=level}}{{/if}}{{/each}}
					{{/if}}
				</li>
				{{/each}}
			</ul>
			{{/if}}
			{{#if statChoices}}
			<div class="stonetop-stat-choices">
				{{#each statChoices}}
				{{#if statKey}}
				<span class="stonetop-stat-boost-chip">+1 {{statAbbr}}</span>
				{{/if}}
				{{/each}}
			</div>
			{{/if}}
			{{#if backgroundAnswer}}
			<p class="stonetop-move-note stonetop-move-background-answer">
				{{backgroundAnswer.label}}: {{backgroundAnswer.value}}
			</p>
			{{/if}}
			{{#if requiresLabel}}<p class="stonetop-move-note{{#if requirementsUnmet}} stonetop-move-note--unmet{{/if}}">Requires: {{requiresLabel}}{{#if requirementsUnmet}} (not met){{/if}}</p>{{/if}}
			{{#if requiresPlaybook}}<p class="stonetop-move-note{{#if requirementsUnmet}} stonetop-move-note--unmet{{/if}}">Requires {{requiresPlaybook}} playbook</p>{{/if}}
			{{#if minLevel}}<p class="stonetop-move-note{{#if requirementsUnmet}} stonetop-move-note--unmet{{/if}}">Level {{minLevel}}+</p>{{/if}}
		</li>
	{{/each}}
	</ol>
{{/unless}}
