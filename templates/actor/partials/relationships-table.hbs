{{!-- Relationship hearts table, shared by the NPC sheet's Relationships tab and the
      character sheet's Details tab. Reuses the steading Residents table classes
      (.steading-residents-*) so it inherits that styling plus drag-resize +
      click-to-sort (wired by wireRelationshipTable). Columns: Who | Feelings | Notes,
      no actions column.
      Params: rows, resizeKey, nameLabel, canRate, canToggle, showTooltip.
      `canToggle` adds the per-row show/hide box to the name cell — it rides INSIDE that
      cell rather than as a fourth column so the grid (and the persisted drag-resize
      widths) stay identical whether or not the boxes are showing.
      `showTooltip` names what a row IS, so it has to come from the caller: the steading
      lists settlements here, not people. Falls back to the person wording. --}}
<div class="steading-residents-table stonetop-rel-table" data-resize-key="{{this.resizeKey}}">
	<div class="steading-residents-header">
		<div class="steading-residents-header-cell steading-residents-col-name"><span class="steading-residents-header-label">{{this.nameLabel}}</span></div>
		{{!-- data-col-min: the hearts are five fixed 18px masks that can't shrink or wrap,
		      so this column needs its own drag floor — below it the outer hearts clip out
		      of reach and a 5-heart rating becomes unclickable. --}}
		<div class="steading-residents-header-cell steading-residents-col-feelings" data-col-min="112"><span class="steading-residents-header-label">{{localize "stonetop.relationships.regard"}}</span></div>
		<div class="steading-residents-header-cell steading-residents-col-notes"><span class="steading-residents-header-label">{{localize "stonetop.relationships.notes"}}</span></div>
	</div>
	<ul class="steading-residents-list">
		{{#each rows}}
		<li class="steading-residents-row stonetop-rel-row" data-rel-id="{{this.id}}">
			<div class="steading-residents-col steading-residents-col-name stonetop-rel-namecell{{#unless shown}} stonetop-rel-row--hidden{{/unless}}" data-tooltip-text="{{#if tooltip}}{{this.tooltip}}{{else}}{{this.name}}{{/if}}">
				{{#if ../canToggle}}
				<input type="checkbox" class="stonetop-rel-show-check" data-rel-id="{{this.id}}"
				       {{#if shown}}checked{{/if}}
				       data-tooltip='{{#if ../showTooltip}}{{../showTooltip}}{{else}}{{localize "stonetop.relationships.showTooltip"}}{{/if}}'
				       aria-label='{{#if ../showTooltip}}{{../showTooltip}}{{else}}{{localize "stonetop.relationships.showTooltip"}}{{/if}}'>
				{{/if}}
				{{#if img}}
				{{!-- data-name is both the preview's caption and the hook wireRelationshipLinks
				      selects on, so a portrait that can be enlarged is exactly the one that
				      announces a name for the card.

				      .stonetop-rel-portrait is the CLIPPING BOX and appears exactly once per
				      row, on the outermost element of whichever branch renders — the glyph span
				      below already IS the box. Wrapping that one too would give two concentric
				      bordered circles and a glyph centred in the wrong one. --}}
				<span class="stonetop-rel-portrait stonetop-portrait-box"><img class="stonetop-rel-portrait-img" src="{{this.img}}" alt="" data-name="{{this.name}}"{{#if imgStyle}} style="{{this.imgStyle}}"{{/if}}></span>
				{{else}}
				{{!-- No portrait: a person icon for people, or the row's own icon for a
				      place (a town shouldn't wear a silhouette). No hover preview either —
				      there is no image to show a bigger version of. --}}
				<span class="stonetop-rel-portrait stonetop-rel-portrait--empty"><i class="{{#if icon}}{{this.icon}}{{else}}fas fa-user{{/if}}"></i></span>
				{{/if}}
				{{!-- Actor-backed rows open their sheet; a slug-keyed row (the steading's
				      settlements) has a uuid only once that place has a settlement sheet,
				      and until then stays plain text. The <a>
				      carries no href — it is a delegated handler, and an href would make it
				      natively draggable, which on the board would fight the card's own drag.
				      An href is also what would have made it focusable and Enter-activatable,
				      so tabindex + role restore the half worth keeping, and
				      wireRelationshipLinks binds the keys.

				      aria-label, not data-tooltip: with no href, nothing about this element says
				      it goes anywhere, and a screen reader would otherwise announce a bare name
				      with no hint that it is actionable. It carries no hover bubble because the
				      names sit in a dense list where one would cover the rows underneath — the
				      same call the note caret makes. --}}
				{{#if uuid}}
				<a class="stonetop-rel-name stonetop-rel-open" data-actor-uuid="{{this.uuid}}" data-actor-id="{{this.id}}"
				   role="link" tabindex="0"
				   aria-label='{{localize "stonetop.relationships.open" name=name}}'>{{this.name}}</a>
				{{else}}
				<span class="stonetop-rel-name">{{this.name}}</span>
				{{/if}}
			</div>
			<div class="steading-residents-col steading-residents-col-feelings stonetop-rel-heartscell">
				{{!-- Hidden numeric value the sort util reads (via textContent) to order by rating. --}}
				<span class="stonetop-rel-hearts-sortkey" aria-hidden="true">{{this.hearts}}</span>
				<span class="stonetop-rel-hearts{{#unless ../canRate}} stonetop-rel-hearts--readonly{{/unless}}"
				      role="img" aria-label="{{this.feeling}}" data-tooltip-text="{{this.feeling}}">
					{{#each heartSlots}}
					<span class="stonetop-rel-heart{{#if filled}} is-filled{{/if}}" data-position="{{this.position}}"></span>
					{{/each}}
				</span>
			</div>
			<div class="steading-residents-col steading-residents-col-notes">
				{{!-- NOT .steading-resident-input: that class is a behaviour hook the steading
				      sheet delegates on and stopPropagation()s, which would eat this field's
				      change event. .stonetop-rel-note-input carries the full styling itself. --}}
				<input type="text" class="stonetop-rel-note-input" data-rel-id="{{this.id}}"
				       value="{{this.notes}}" placeholder='{{localize "stonetop.relationships.notePlaceholder"}}'
				       {{#unless ../canRate}}disabled{{/unless}}>
			</div>
		</li>
		{{/each}}
	</ul>
</div>
