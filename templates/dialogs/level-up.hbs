<div class="stonetop-levelup-body">

	{{!-- ── Step 1: Overview ────────────────────────────────────────────── --}}
	{{#if isOverview}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">{{{this.overviewIntro}}}</p>
		{{#if awayWarning}}
		<p class="stonetop-levelup-aside stonetop-levelup-away"><i class="fas fa-triangle-exclamation"></i> {{this.awayWarning}}</p>
		{{/if}}

		<div class="stonetop-levelup-summary">
			<div class="stonetop-levelup-summary-row">
				<span class="stonetop-levelup-summary-label">{{{localize "stonetop.specialMoves.levelUp.xpCost"}}}</span>
				<span class="stonetop-levelup-summary-value stonetop-levelup-summary-value--cost">−{{this.cost}}</span>
			</div>
			<div class="stonetop-levelup-summary-row stonetop-levelup-summary-row--highlight">
				<span class="stonetop-levelup-summary-label">{{{localize "stonetop.specialMoves.levelUp.xpRemaining"}}}</span>
				<span class="stonetop-levelup-summary-value">{{this.xpRemaining}}</span>
			</div>
			<div class="stonetop-levelup-summary-divider"></div>
			<div class="stonetop-levelup-summary-row stonetop-levelup-summary-row--highlight">
				<span class="stonetop-levelup-summary-label">{{{localize "stonetop.specialMoves.levelUp.newLevel"}}}</span>
				<span class="stonetop-levelup-summary-value">{{this.newLevel}}</span>
			</div>
		</div>

		{{#if needsInvocation}}
		<p class="stonetop-levelup-aside">{{{localize "stonetop.specialMoves.levelUp.invocationAside"}}}</p>
		{{/if}}
		{{#if pouchGrowthNote}}
		<p class="stonetop-levelup-aside stonetop-levelup-pouch">{{this.pouchGrowthNote}}</p>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step 2: Choose a Move ──────────────────────────────────────── --}}
	{{#if isMove}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">{{{localize "stonetop.specialMoves.levelUp.moveIntro"}}}</p>
		{{#if hasLockedMoves}}
		<label class="stonetop-levelup-toggle-locked">
			<input type="checkbox" class="stonetop-levelup-locked-check" {{#if showLockedMoves}}checked{{/if}}>
			{{localize "stonetop.specialMoves.levelUp.showLocked"}}
		</label>
		{{/if}}

		{{#if showMoveFilter}}
		<div class="stonetop-levelup-move-search">
			<i class="fas fa-magnifying-glass" aria-hidden="true"></i>
			<input type="search" class="levelup-move-search" placeholder="{{localize "stonetop.specialMoves.levelUp.filterPlaceholder"}}" aria-label="{{localize "stonetop.specialMoves.levelUp.filterLabel"}}">
		</div>
		{{#if moveGroups.length}}
		<div class="stonetop-levelup-move-chips">
			{{#each moveGroups}}
			<button type="button" class="stonetop-levelup-move-chip" data-move-group="{{this.key}}" aria-pressed="false">{{this.label}}</button>
			{{/each}}
		</div>
		{{/if}}
		{{/if}}

		{{#if hasMoves}}
		<div class="stonetop-levelup-move-list">
			<div class="stonetop-levelup-move-grid">
			{{#each moves}}
			<div class="stonetop-levelup-move-option stonetop-levelup-pickable{{#if selected}} is-selected{{/if}}"
				role="button" tabindex="0" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"
				data-compendium-id="{{this.compendiumId}}"
				data-move-groups="{{this.groupsAttr}}">
				<div class="stonetop-levelup-move-header">
					<span class="stonetop-levelup-move-name">{{this.name}}</span>
					{{#if requiresLabel}}
					<span class="stonetop-levelup-move-req">{{this.requiresLabel}}</span>
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-levelup-move-description">{{{moveBody description moveResults}}}</div>
				{{/if}}
				{{! A move whose trigger an insert has taken away (Hard to Kill for a Revenant): said, never hidden. }}
				{{#if insertNote}}<p class="stonetop-levelup-move-note stonetop-levelup-insert-note">{{this.insertNote}}</p>{{/if}}
			</div>
			{{/each}}

			{{#if showLockedMoves}}
			<div class="stonetop-levelup-locked-divider">
				<span>{{localize "stonetop.specialMoves.levelUp.lockedDivider"}}</span>
			</div>
			{{#each lockedMoves}}
			<div class="stonetop-levelup-move-option is-locked" data-move-groups="{{this.groupsAttr}}">
				<div class="stonetop-levelup-move-header">
					<span class="stonetop-levelup-move-name">{{this.name}}</span>
					{{#if requiresLabel}}
					<span class="stonetop-levelup-move-req">{{this.requiresLabel}}</span>
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-levelup-move-description">{{{moveBody description moveResults}}}</div>
				{{/if}}
			</div>
			{{/each}}
			{{/if}}
			</div>
			{{!-- Revealed by the filter when it hides every card. Starts hidden so it cannot
			      flash before activateListeners runs. --}}
			<p class="stonetop-levelup-empty stonetop-levelup-move-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
		</div>
		{{else}}
			{{#if showLockedMoves}}
			<div class="stonetop-levelup-move-list">
				<div class="stonetop-levelup-move-grid">
				<div class="stonetop-levelup-locked-divider">
					<span>{{localize "stonetop.specialMoves.levelUp.lockedDivider"}}</span>
				</div>
				{{#each lockedMoves}}
				<div class="stonetop-levelup-move-option is-locked" data-move-groups="{{this.groupsAttr}}">
					<div class="stonetop-levelup-move-header">
						<span class="stonetop-levelup-move-name">{{this.name}}</span>
						{{#if requiresLabel}}
						<span class="stonetop-levelup-move-req">{{this.requiresLabel}}</span>
						{{/if}}
					</div>
					{{#if description}}
					<div class="stonetop-levelup-move-description">{{{moveBody description moveResults}}}</div>
					{{/if}}
				</div>
				{{/each}}
				</div>
				<p class="stonetop-levelup-empty stonetop-levelup-move-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
			</div>
			{{else}}
			<p class="stonetop-levelup-empty">{{{localize "stonetop.specialMoves.levelUp.noMoves"}}}</p>
			{{/if}}
		{{/if}}

		{{!-- Book I p.529: a move from another playbook "If everyone (not just you) agrees", or a
		      custom one (p.528 step 3's insert class). A move pick like the cards above. --}}
		<div class="stonetop-levelup-move-option stonetop-levelup-agreed-entry stonetop-levelup-pickable{{#if agreedPicked}} is-selected{{/if}}"
			role="button" tabindex="0" aria-pressed="{{#if agreedPicked}}true{{else}}false{{/if}}"
			data-compendium-id="{{this.agreedId}}">
			<div class="stonetop-levelup-move-header">
				<span class="stonetop-levelup-move-name">{{localize "stonetop.specialMoves.levelUp.agreedTitle"}}</span>
			</div>
			<div class="stonetop-levelup-move-description">{{localize "stonetop.specialMoves.levelUp.agreedHint"}}</div>
		</div>
	</div>
	{{/if}}

	{{!-- ── Step: A Move Agreed With the Table ─────────────────────────── --}}
	{{#if isAgreed}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">{{localize "stonetop.specialMoves.levelUp.agreedIntro"}}</p>
		{{#if customAllowed}}
		<div class="stonetop-levelup-move-option stonetop-levelup-agreed-option stonetop-levelup-agreed-custom stonetop-levelup-pickable{{#if customSelected}} is-selected{{/if}}"
			role="button" tabindex="0" aria-pressed="{{#if customSelected}}true{{else}}false{{/if}}"
			data-compendium-id="{{this.customId}}">
			<div class="stonetop-levelup-move-header">
				<span class="stonetop-levelup-move-name">{{localize "stonetop.specialMoves.levelUp.agreedCustomTitle"}}</span>
			</div>
			<div class="stonetop-levelup-move-description">{{localize "stonetop.specialMoves.levelUp.agreedCustomHint"}}</div>
		</div>
		{{else}}
		<p class="stonetop-levelup-aside">{{localize "stonetop.specialMoves.levelUp.agreedCustomGmOnly"}}</p>
		{{/if}}
		{{#if hasAgreedMoves}}
		<div class="stonetop-levelup-move-search">
			<i class="fas fa-magnifying-glass" aria-hidden="true"></i>
			<input type="search" class="levelup-agreed-search" placeholder="{{localize "stonetop.specialMoves.levelUp.filterPlaceholder"}}" aria-label="{{localize "stonetop.specialMoves.levelUp.filterLabel"}}">
		</div>
		<div class="stonetop-levelup-move-list">
			<div class="stonetop-levelup-move-grid">
			{{#each agreedMoves}}
			{{> "stonetop.level-up-other-card" family="agreed"}}
			{{/each}}
			</div>
			<p class="stonetop-levelup-empty stonetop-levelup-agreed-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
		</div>
		{{else if agreedLoaded}}
		<p class="stonetop-levelup-empty">{{localize "stonetop.specialMoves.levelUp.agreedEmpty"}}</p>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step: Choose a Foreign Move (cross-playbook moves) ────────── --}}
	{{#if isForeignMove}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.foreignIntro"}}}
			{{#if foreignFromMoveName}}<span class="stonetop-levelup-stat-cap-note">{{localize "stonetop.specialMoves.levelUp.foreignVia" move=foreignFromMoveName}}{{#if foreignGrantsPouch}} · {{localize "stonetop.specialMoves.levelUp.foreignAlsoPouch"}}{{/if}}</span>{{/if}}
		</p>
		{{#if foreignBlocked}}
		<p class="stonetop-levelup-empty">{{localize "stonetop.specialMoves.levelUp.foreignEmptyBlocked" move=foreignFromMoveName}}</p>
		{{else if foreignMovesEmpty}}
		<p class="stonetop-levelup-empty">{{{localize "stonetop.specialMoves.levelUp.foreignEmpty"}}}</p>
		{{else}}
		<div class="stonetop-levelup-move-search">
			<i class="fas fa-magnifying-glass" aria-hidden="true"></i>
			<input type="search" class="levelup-foreign-search" placeholder="{{localize "stonetop.specialMoves.levelUp.filterPlaceholder"}}" aria-label="{{localize "stonetop.specialMoves.levelUp.filterLabel"}}">
		</div>
		{{#if foreignPlaybooks.length}}
		<div class="stonetop-levelup-move-chips">
			{{#each foreignPlaybooks}}
			<button type="button" class="stonetop-levelup-move-chip stonetop-levelup-foreign-chip" data-playbook="{{this.key}}" aria-pressed="false">{{this.label}}</button>
			{{/each}}
		</div>
		{{/if}}
		<div class="stonetop-levelup-move-list">
			<div class="stonetop-levelup-move-grid">
			{{#each foreignMoves}}
			{{> "stonetop.level-up-other-card" family="foreign"}}
			{{/each}}
			</div>
			<p class="stonetop-levelup-empty stonetop-levelup-foreign-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
		</div>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step: Increase a Stat (Improved / Superior Stat) ──────────── --}}
	{{#if isStat}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.statIntro"}}}
			{{#if statMoveName}}<span class="stonetop-levelup-stat-cap-note">{{this.statMoveName}}: max +{{this.statCap}}</span>{{/if}}
		</p>
		<div class="stonetop-levelup-stat-list">
			{{#each statOptions}}
			<div class="stonetop-levelup-stat-option stonetop-levelup-pickable{{#if selected}} is-selected{{/if}}{{#if atCap}} is-at-cap{{/if}}"
				role="button" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"{{#if atCap}} aria-disabled="true"{{else}} tabindex="0"{{/if}}
				data-stat-key="{{this.key}}">
				<span class="stonetop-levelup-stat-name">{{this.name}}</span>
				<span class="stonetop-levelup-stat-value">{{this.valueLabel}}{{#if atCap}} <em>(max)</em>{{/if}}</span>
			</div>
			{{/each}}
		</div>
		{{#if statAllAtCap}}
		<p class="stonetop-levelup-empty">{{{localize "stonetop.specialMoves.levelUp.statAllAtCap"}}}</p>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step: Mark Selections (Veteran Crew / Heroes to the Last / Beast of Legend / Well Versed) ── --}}
	{{#if isMarks}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.marksIntro"}}}
			{{#if markStep}}<span class="stonetop-levelup-stat-cap-note">{{markStep.moveName}}: {{markStep.used}} / {{markStep.allowance}} chosen</span>{{/if}}
		</p>
		<div class="stonetop-levelup-mark-list">
			{{#each markStep.options}}
			<div class="stonetop-levelup-stat-option stonetop-levelup-mark-option stonetop-levelup-pickable{{#if selected}} is-selected{{/if}}{{#if disabled}} is-at-cap{{/if}}"
				role="button" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"{{#if disabled}} aria-disabled="true"{{else}} tabindex="0"{{/if}}
				data-mark-slug="{{this.slug}}"{{#if tooltip}} data-tooltip="{{this.tooltip}}" data-tooltip-direction="UP"{{/if}}>
				<span class="stonetop-levelup-stat-name">{{this.label}}</span>
				{{#if existingLabel}}<span class="stonetop-levelup-stat-value">{{this.existingLabel}}</span>{{/if}}
			</div>
			{{/each}}
		</div>
	</div>
	{{/if}}

	{{!-- ── Step: Mark a Companion Action (Beast-Bonded Ranger at 3rd/5th/7th/9th) ── --}}
	{{#if isCompanion}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.companionIntro"}}}
			{{#if companionStep}}<span class="stonetop-levelup-stat-cap-note">{{companionStep.used}} / {{companionStep.allowance}} chosen</span>{{/if}}
		</p>
		<div class="stonetop-levelup-mark-list">
			{{#each companionStep.options}}
			<div class="stonetop-levelup-stat-option stonetop-levelup-companion-option stonetop-levelup-pickable{{#if selected}} is-selected{{/if}}{{#if disabled}} is-at-cap{{/if}}"
				role="button" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"{{#if disabled}} aria-disabled="true"{{else}} tabindex="0"{{/if}}
				data-action-slug="{{this.slug}}">
				<span class="stonetop-levelup-stat-name">{{this.label}}</span>
				{{#if existingLabel}}<span class="stonetop-levelup-stat-value">{{this.existingLabel}}</span>{{/if}}
			</div>
			{{/each}}
		</div>
	</div>
	{{/if}}

	{{!-- ── Step 3: Choose an Invocation ──────────────────────────────── --}}
	{{#if isInvocation}}
	<div class="stonetop-levelup-step">
		<div class="stonetop-levelup-intro stonetop-levelup-intro--playbook">
			{{#if playbookIcon}}<img class="stonetop-levelup-intro-icon" src="{{this.playbookIcon}}" alt="{{this.playbookName}}">{{/if}}
			<span>{{{localize "stonetop.specialMoves.levelUp.invocationIntro"}}}</span>
		</div>

		<div class="stonetop-levelup-invocation-list">
			<div class="stonetop-levelup-invocation-grid">
			{{#each invocations}}
			<div class="stonetop-levelup-invocation-option stonetop-levelup-pickable{{#if selected}} is-selected{{/if}}"
				role="button" tabindex="0" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"
				data-slug="{{this.slug}}">
				<span class="stonetop-levelup-invocation-name">{{this.label}}</span>
				{{#if description}}
				<div class="stonetop-levelup-invocation-description">{{{this.description}}}</div>
				{{/if}}
			</div>
			{{/each}}
			</div>
		</div>
	</div>
	{{/if}}

	{{!-- Level Up step 6, on whichever step is last: review Instinct and Appearance. --}}
	{{#if isLastStep}}
	<p class="stonetop-levelup-aside stonetop-levelup-review">{{this.reviewLine}}</p>
	{{/if}}

	{{!-- ── Footer ────────────────────────────────────────────────────── --}}
	<footer class="stonetop-levelup-footer">
		{{#unless isOverview}}
		<button type="button" class="stonetop-levelup-back-btn">
			{{{localize "stonetop.specialMoves.levelUp.back"}}}
		</button>
		{{/unless}}
		<button type="button" class="stonetop-levelup-next-btn"
			{{#unless canContinue}}disabled{{/unless}}>
			{{#if isLastStep}}
				{{this.applyLabel}}
			{{else}}
				{{{localize "stonetop.specialMoves.levelUp.next"}}}
			{{/if}}
		</button>
	</footer>

</div>
