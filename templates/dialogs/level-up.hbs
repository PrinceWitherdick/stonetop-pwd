<div class="stonetop-levelup-body">

	{{!-- ── Step 1: Overview ────────────────────────────────────────────── --}}
	{{#if isOverview}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">{{{localize "stonetop.specialMoves.levelUp.overviewIntro"}}}</p>

		<div class="stonetop-levelup-summary">
			<div class="stonetop-levelup-summary-row">
				<span class="stonetop-levelup-summary-label">{{{localize "stonetop.specialMoves.levelUp.xpCost"}}}</span>
				<span class="stonetop-levelup-summary-value stonetop-levelup-summary-value--cost">−{{cost}}</span>
			</div>
			<div class="stonetop-levelup-summary-row stonetop-levelup-summary-row--highlight">
				<span class="stonetop-levelup-summary-label">{{{localize "stonetop.specialMoves.levelUp.xpRemaining"}}}</span>
				<span class="stonetop-levelup-summary-value">{{xpRemaining}}</span>
			</div>
			<div class="stonetop-levelup-summary-divider"></div>
			<div class="stonetop-levelup-summary-row stonetop-levelup-summary-row--highlight">
				<span class="stonetop-levelup-summary-label">{{{localize "stonetop.specialMoves.levelUp.newLevel"}}}</span>
				<span class="stonetop-levelup-summary-value">{{newLevel}}</span>
			</div>
		</div>

		{{#if needsInvocation}}
		<p class="stonetop-levelup-aside">{{{localize "stonetop.specialMoves.levelUp.invocationAside"}}}</p>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step 2: Choose a Move ──────────────────────────────────────── --}}
	{{#if isMove}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">{{{localize "stonetop.specialMoves.levelUp.moveIntro"}}}</p>
		{{#if hasLockedMoves}}
		<label class="stonetop-levelup-toggle-locked">
			<input type="checkbox" class="stonetop-levelup-locked-check" {{#if showLockedMoves}}checked{{/if}}>
			Show moves I don't qualify for yet
		</label>
		{{/if}}

		{{#if showMoveFilter}}
		<div class="stonetop-levelup-move-search">
			<i class="fas fa-magnifying-glass" aria-hidden="true"></i>
			<input type="search" class="levelup-move-search" placeholder="Filter moves…" aria-label="Filter moves">
		</div>
		{{#if moveGroups.length}}
		<div class="stonetop-levelup-move-chips">
			{{#each moveGroups}}
			<button type="button" class="stonetop-levelup-move-chip" data-move-group="{{key}}" aria-pressed="false">{{label}}</button>
			{{/each}}
		</div>
		{{/if}}
		{{/if}}

		{{#if hasMoves}}
		<div class="stonetop-levelup-move-list">
			<div class="stonetop-levelup-move-grid">
			{{#each moves}}
			<div class="stonetop-levelup-move-option{{#if selected}} is-selected{{/if}}"
				data-compendium-id="{{compendiumId}}"
				data-move-groups="{{groupsAttr}}">
				<div class="stonetop-levelup-move-header">
					<span class="stonetop-levelup-move-name">{{name}}</span>
					{{#if requiresLabel}}
					<span class="stonetop-levelup-move-req">{{requiresLabel}}</span>
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-levelup-move-description">{{{moveBody description}}}</div>
				{{/if}}
			</div>
			{{/each}}

			{{#if showLockedMoves}}
			<div class="stonetop-levelup-locked-divider">
				<span>Requires conditions not yet met</span>
			</div>
			{{#each lockedMoves}}
			<div class="stonetop-levelup-move-option is-locked" data-move-groups="{{groupsAttr}}">
				<div class="stonetop-levelup-move-header">
					<span class="stonetop-levelup-move-name">{{name}}</span>
					{{#if requiresLabel}}
					<span class="stonetop-levelup-move-req">{{requiresLabel}}</span>
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-levelup-move-description">{{{moveBody description}}}</div>
				{{/if}}
			</div>
			{{/each}}
			{{/if}}
			</div>
			{{!-- Revealed by the filter when it hides every card. Starts hidden so it cannot
			      flash before activateListeners runs. --}}
			<p class="stonetop-levelup-empty stonetop-levelup-move-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
		</div>
		{{else}}
			{{#if showLockedMoves}}
			<div class="stonetop-levelup-move-list">
				<div class="stonetop-levelup-move-grid">
				<div class="stonetop-levelup-locked-divider">
					<span>Requires conditions not yet met</span>
				</div>
				{{#each lockedMoves}}
				<div class="stonetop-levelup-move-option is-locked" data-move-groups="{{groupsAttr}}">
					<div class="stonetop-levelup-move-header">
						<span class="stonetop-levelup-move-name">{{name}}</span>
						{{#if requiresLabel}}
						<span class="stonetop-levelup-move-req">{{requiresLabel}}</span>
						{{/if}}
					</div>
					{{#if description}}
					<div class="stonetop-levelup-move-description">{{{moveBody description}}}</div>
					{{/if}}
				</div>
				{{/each}}
				</div>
				<p class="stonetop-levelup-empty stonetop-levelup-move-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
			</div>
			{{else}}
			<p class="stonetop-levelup-empty">{{{localize "stonetop.specialMoves.levelUp.noMoves"}}}</p>
			{{/if}}
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step: Choose a Foreign Move (cross-playbook moves) ────────── --}}
	{{#if isForeignMove}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.foreignIntro"}}}
			{{#if foreignFromMoveName}}<span class="stonetop-levelup-stat-cap-note">via {{foreignFromMoveName}}{{#if foreignGrantsPouch}} · also grants a Sacred Pouch{{/if}}</span>{{/if}}
		</p>
		{{#if foreignMovesEmpty}}
		<p class="stonetop-levelup-empty">{{{localize "stonetop.specialMoves.levelUp.foreignEmpty"}}}</p>
		{{else}}
		<div class="stonetop-levelup-move-search">
			<i class="fas fa-magnifying-glass" aria-hidden="true"></i>
			<input type="search" class="levelup-foreign-search" placeholder="Filter moves…" aria-label="Filter moves">
		</div>
		{{#if foreignPlaybooks.length}}
		<div class="stonetop-levelup-move-chips">
			{{#each foreignPlaybooks}}
			<button type="button" class="stonetop-levelup-move-chip stonetop-levelup-foreign-chip" data-playbook="{{key}}" aria-pressed="false">{{label}}</button>
			{{/each}}
		</div>
		{{/if}}
		<div class="stonetop-levelup-move-list">
			<div class="stonetop-levelup-move-grid">
			{{#each foreignMoves}}
			<div class="stonetop-levelup-move-option stonetop-levelup-foreign-option{{#if selected}} is-selected{{/if}}"
				data-compendium-id="{{compendiumId}}"
				data-playbook="{{playbook}}">
				<div class="stonetop-levelup-move-header">
					<span class="stonetop-levelup-move-name">{{name}}</span>
					<span class="stonetop-levelup-move-req">{{playbook}}</span>
				</div>
				{{#if description}}
				<div class="stonetop-levelup-move-description stonetop-levelup-foreign-description">{{{moveBody description}}}</div>
				{{/if}}
				{{#if requiresLabel}}<p class="stonetop-levelup-move-note">Requires: {{requiresLabel}}</p>{{/if}}
			</div>
			{{/each}}
			</div>
			<p class="stonetop-levelup-empty stonetop-levelup-foreign-no-matches is-filtered-out">{{{localize "stonetop.specialMoves.levelUp.noMovesMatch"}}}</p>
		</div>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step: Increase a Stat (Improved / Superior Stat) ──────────── --}}
	{{#if isStat}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.statIntro"}}}
			{{#if statMoveName}}<span class="stonetop-levelup-stat-cap-note">{{statMoveName}}: max +{{statCap}}</span>{{/if}}
		</p>
		<div class="stonetop-levelup-stat-list">
			{{#each statOptions}}
			<div class="stonetop-levelup-stat-option{{#if selected}} is-selected{{/if}}{{#if atCap}} is-at-cap{{/if}}"
				data-stat-key="{{key}}">
				<span class="stonetop-levelup-stat-name">{{name}}</span>
				<span class="stonetop-levelup-stat-value">{{valueLabel}}{{#if atCap}} <em>(max)</em>{{/if}}</span>
			</div>
			{{/each}}
		</div>
		{{#if statAllAtCap}}
		<p class="stonetop-levelup-empty">{{{localize "stonetop.specialMoves.levelUp.statAllAtCap"}}}</p>
		{{/if}}
	</div>
	{{/if}}

	{{!-- ── Step: Mark Selections (Veteran Crew / Heroes to the Last / Beast of Legend / Well Versed) ── --}}
	{{#if isMarks}}
	<div class="stonetop-levelup-step">
		<p class="stonetop-levelup-intro">
			{{{localize "stonetop.specialMoves.levelUp.marksIntro"}}}
			{{#if markStep}}<span class="stonetop-levelup-stat-cap-note">{{markStep.moveName}}: {{markStep.used}} / {{markStep.allowance}} chosen</span>{{/if}}
		</p>
		<div class="stonetop-levelup-mark-list">
			{{#each markStep.options}}
			<div class="stonetop-levelup-stat-option stonetop-levelup-mark-option{{#if selected}} is-selected{{/if}}{{#if disabled}} is-at-cap{{/if}}"
				data-mark-slug="{{slug}}">
				<span class="stonetop-levelup-stat-name">{{label}}</span>
				{{#if existingLabel}}<span class="stonetop-levelup-stat-value">{{existingLabel}}</span>{{/if}}
			</div>
			{{/each}}
		</div>
	</div>
	{{/if}}

	{{!-- ── Step 3: Choose an Invocation ──────────────────────────────── --}}
	{{#if isInvocation}}
	<div class="stonetop-levelup-step">
		<div class="stonetop-levelup-intro stonetop-levelup-intro--playbook">
			{{#if playbookIcon}}<img class="stonetop-levelup-intro-icon" src="{{playbookIcon}}" alt="{{playbookName}}">{{/if}}
			<span>{{{localize "stonetop.specialMoves.levelUp.invocationIntro"}}}</span>
		</div>

		<div class="stonetop-levelup-invocation-list">
			<div class="stonetop-levelup-invocation-grid">
			{{#each invocations}}
			<div class="stonetop-levelup-invocation-option{{#if selected}} is-selected{{/if}}"
				data-slug="{{slug}}">
				<span class="stonetop-levelup-invocation-name">{{label}}</span>
				{{#if description}}
				<div class="stonetop-levelup-invocation-description">{{{description}}}</div>
				{{/if}}
			</div>
			{{/each}}
			</div>
		</div>
	</div>
	{{/if}}

	{{!-- ── Footer ────────────────────────────────────────────────────── --}}
	<footer class="stonetop-levelup-footer">
		{{#unless isOverview}}
		<button type="button" class="stonetop-levelup-back-btn">
			{{{localize "stonetop.specialMoves.levelUp.back"}}}
		</button>
		{{/unless}}
		<button type="button" class="stonetop-levelup-next-btn"
			{{#unless canContinue}}disabled{{/unless}}>
			{{#if isLastStep}}
				{{{localize "stonetop.specialMoves.levelUp.apply"}}}
			{{else}}
				{{{localize "stonetop.specialMoves.levelUp.next"}}}
			{{/if}}
		</button>
	</footer>

</div>
