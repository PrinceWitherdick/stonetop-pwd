{{!-- Guided "make a monster" worksheet (Book I "Dangers", pp.392-398), laid out as a
      left-rail tabbed sheet like Run an Expedition: the rail (shared .stonetop-guide-toc)
      switches which worksheet section is shown, client-side, so the single <form> keeps
      every field's value and the banner's live stat readout as you move around. See
      dialogs/CreateMonsterDialog.js. --}}
<form class="stonetop create-monster" autocomplete="off">

	<div class="stonetop-guide-split cm-split">

		{{!-- Section rail (jump between worksheet steps; shared journal-style page list). --}}
		<nav class="stonetop-guide-toc" aria-label="Monster worksheet sections">
			<ol class="stonetop-guide-toc-list">
				{{#each sections}}
				<li class="stonetop-guide-toc-item{{#if selected}} is-active{{/if}}">
					<button type="button" class="stonetop-guide-toc-btn cm-tab" data-tab="{{key}}"{{#if selected}} aria-current="true"{{/if}}>
						<i class="fas {{icon}} stonetop-guide-toc-icon"></i>
						<span class="stonetop-guide-toc-text">{{title}}</span>
					</button>
				</li>
				{{/each}}
			</ol>
		</nav>

		<div class="stonetop-guide-main cm-main">

			{{!-- Banner: active section + a live stat line that recomputes as boxes are
			      ticked (updated in JS; no re-render, so fields keep focus). --}}
			<div class="stonetop-guide-banner cm-banner">
				<i class="fas {{active.icon}} stonetop-guide-banner-icon cm-banner-icon"></i>
				<div class="stonetop-guide-banner-info">
					<div class="stonetop-guide-banner-title cm-banner-title">{{active.title}}</div>
					<div class="cm-statline">
						<span class="cm-stat">HP <b class="cm-summary-hp">{{summary.hp}}</b></span>
						<span class="cm-stat">Armor <b class="cm-summary-armor">{{summary.armor}}</b></span>
						<span class="cm-stat">Damage <b class="cm-summary-damage">{{summary.damage}}</b></span>
					</div>
				</div>
				<div class="stonetop-guide-count cm-banner-count">{{active.index}} / {{sectionCount}}</div>
			</div>

			<div class="cm-glance">
				<span class="cm-glance-tags"><span class="cm-glance-label">Tags</span> <span class="cm-summary-tags">{{summary.tags}}</span></span>
				<span class="cm-summary-range"{{#unless summary.rangeAdvice}} hidden{{/unless}}>{{summary.rangeAdvice}}</span>
			</div>

			{{!-- Steps 1-2 & type: concept, name, creature type --}}
			<section class="cm-section" data-tab="concept">
				<p class="cm-section-hint">Steps 1&ndash;2 &middot; Picture the creature, then name it and pick a type.</p>
				<label class="cm-field">
					<span class="cm-label">Concept</span>
					<input type="text" name="concept" placeholder="e.g. a corpse-eating carrion bird the size of a hound">
				</label>
				<div class="cm-row">
					<label class="cm-field cm-grow">
						<span class="cm-label">Name</span>
						<input type="text" name="name" value="{{name}}" placeholder="e.g. butcherbird">
					</label>
					<label class="cm-field">
						<span class="cm-label">Type</span>
						<select name="creatureType">
							<option value="">&mdash;</option>
							{{#each creatureTypes}}
							<option value="{{slug}}">{{label}}</option>
							{{/each}}
						</select>
					</label>
				</div>
			</section>

			{{!-- Step 3: tags --}}
			<section class="cm-section" data-tab="tags" hidden>
				<p class="cm-section-hint">Step 3 &middot; How it hunts, how big it is, and what it's like.</p>

				<div class="cm-field">
					<span class="cm-label">How does it hunt or fight?</span>
					<div class="cm-tile-grid">
						{{#each organizations}}
						<label class="cm-tile" data-tooltip="{{hint}}" data-tooltip-direction="UP">
							<input type="radio" name="organization" value="{{id}}"{{#if selected}} checked{{/if}}>
							<span class="cm-tile-name">{{label}}</span>
							<span class="cm-tile-hint">{{hint}}</span>
						</label>
						{{/each}}
					</div>
				</div>

				<div class="cm-field">
					<span class="cm-label">How big is it?</span>
					<div class="cm-tile-grid cm-tile-grid--size">
						{{#each sizes}}
						<label class="cm-tile" data-tooltip="{{hint}}" data-tooltip-direction="UP">
							<input type="radio" name="size" value="{{id}}"{{#if selected}} checked{{/if}}>
							<span class="cm-tile-name">{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>

				<div class="cm-field">
					<span class="cm-label">What is its nature? <em>(all that apply)</em></span>
					<div class="cm-chip-grid">
						{{#each natureTags}}
						<label class="cm-chip" data-tooltip="{{hint}}" data-tooltip-direction="UP">
							<input type="checkbox" name="nature" value="{{id}}">
							<span>{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>

				<div class="cm-field">
					<span class="cm-label">What is it notable for? <em>(all that apply)</em></span>
					<div class="cm-chip-grid">
						{{#each notableTags}}
						<label class="cm-chip" data-tooltip="{{hint}}" data-tooltip-direction="UP">
							<input type="checkbox" name="notable" value="{{id}}">
							<span>{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>

				<label class="cm-field">
					<span class="cm-label">Other tags <em>(comma-separated)</em></span>
					<input type="text" name="customTags" placeholder="e.g. amphibious, drunkard">
				</label>
			</section>

			{{!-- Step 4: HP modifiers (base HP comes from org + size, shown in the banner) --}}
			<section class="cm-section" data-tab="hp" hidden>
				<p class="cm-section-hint">Step 4 &middot; Base HP comes from its organization and size. Add any of these:</p>
				<div class="cm-check-list">
					{{#each hpModifiers}}
					<label class="cm-check">
						<input type="checkbox" class="stonetop-cm-check" name="hpMod" value="{{id}}">
						<span>{{label}} <span class="cm-mod">+{{hp}}</span></span>
					</label>
					{{/each}}
				</div>
			</section>

			{{!-- Step 5: armor --}}
			<section class="cm-section" data-tab="armor" hidden>
				<p class="cm-section-hint">Step 5 &middot; What protects it, and anything that adds to that.</p>
				<div class="cm-field">
					<span class="cm-label">What is it protected by?</span>
					<div class="cm-radio-list">
						{{#each armorBases}}
						<label class="cm-radio">
							<input type="radio" class="stonetop-cm-radio" name="armorBase" value="{{id}}"{{#if selected}} checked{{/if}}>
							<span>{{label}} <span class="cm-mod">{{id}}</span></span>
						</label>
						{{/each}}
					</div>
				</div>
				<div class="cm-field">
					<span class="cm-label">What else applies? <em>(tiny adds +1 automatically)</em></span>
					<div class="cm-check-list">
						{{#each armorModifiers}}
						<label class="cm-check">
							<input type="checkbox" class="stonetop-cm-check" name="armorMod" value="{{id}}">
							<span>{{label}} <span class="cm-mod">+{{armor}}</span></span>
						</label>
						{{/each}}
					</div>
				</div>
				<label class="cm-field">
					<span class="cm-label">Armor source <em>(optional override)</em></span>
					<input type="text" name="armorSource" placeholder="e.g. hide, skill">
				</label>
			</section>

			{{!-- Step 6: damage --}}
			<section class="cm-section" data-tab="damage" hidden>
				<p class="cm-section-hint">Step 6 &middot; The base die comes from its organization; shape the attack.</p>
				<div class="cm-field">
					<span class="cm-label">Range <em>(all that apply)</em></span>
					<div class="cm-chip-grid">
						{{#each damageRangeTags}}
						<label class="cm-chip" data-tooltip="{{hint}}" data-tooltip-direction="UP">
							<input type="checkbox" name="damageTag" value="{{id}}">
							<span>{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>
				<div class="cm-field">
					<span class="cm-label">Attack tags <em>(all that apply)</em></span>
					<div class="cm-chip-grid">
						{{#each damageEffectTags}}
						<label class="cm-chip" data-tooltip="{{hint}}" data-tooltip-direction="UP">
							<input type="checkbox" name="damageTag" value="{{id}}">
							<span>{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>
				<div class="cm-field">
					<span class="cm-label">What else applies?</span>
					<div class="cm-check-list cm-check-list--two">
						{{#each damageModifiers}}
						<label class="cm-check">
							<input type="checkbox" class="stonetop-cm-check" name="damageMod" value="{{id}}">
							<span>{{label}}</span>
						</label>
						{{/each}}
					</div>
				</div>
			</section>

			{{!-- Step 8: instinct --}}
			<section class="cm-section" data-tab="instinct" hidden>
				<p class="cm-section-hint">Step 8 &middot; What it does that brings it into conflict.</p>
				<label class="cm-field">
					<span class="cm-label">Instinct</span>
					<input type="text" name="instinct" placeholder="e.g. to gorge itself on the fallen">
				</label>
			</section>

			{{!-- Step 9: moves. A little move builder — the book's prompts are tap-to-add
			      quick starts, and every move is written and edited right here. Cards are
			      injected/removed client-side (see CreateMonsterDialog.js), so they survive
			      tab switches like the rest of the form. --}}
			<section class="cm-section cm-section--moves" data-tab="moves" hidden>
				<p class="cm-section-hint">Step 9 &middot; Give it a few moves: things it does that you narrate, no roll needed. Tap a prompt to start from the book, or write your own. Most monsters have about three.</p>

				<div class="cm-field">
					<span class="cm-label">Book prompts <em>(tap to add &amp; edit)</em></span>
					<div class="cm-move-suggestions">
						{{#each moveSuggestions}}
						<button type="button" class="cm-move-suggestion" data-suggestion="{{id}}" data-tooltip="{{description}}" data-tooltip-direction="UP">
							<i class="fas fa-plus"></i><span>{{name}}</span>
						</button>
						{{/each}}
					</div>
				</div>

				<div class="cm-field">
					<span class="cm-label">This monster's moves</span>
					<div class="cm-move-list" data-empty="No moves yet. Tap a prompt above, or add one below."></div>
					<button type="button" class="cm-move-add"><i class="fas fa-plus"></i> Add a move</button>
				</div>

				{{!-- Cloned per card by the dialog; kept here so the markup lives with the rest. --}}
				<template class="cm-move-tpl">
					<div class="cm-move-card">
						<div class="cm-move-card-head">
							<input type="text" class="cm-move-name" placeholder="Move name (e.g. Snatch and drag off)">
							<button type="button" class="cm-move-remove" data-tooltip="Remove this move" aria-label="Remove this move"><i class="fas fa-xmark"></i></button>
						</div>
						<textarea class="cm-move-desc" rows="2" placeholder="What does it do? Narrate it; no roll needed."></textarea>
					</div>
				</template>
			</section>

		</div>

	</div>

	<div class="stonetop-guide-nav cm-footer">
		<button type="button" class="cm-create stonetop-guide-btn--primary"><i class="fas fa-dragon"></i> Create monster</button>
		<span class="cm-footer-note">Description &amp; lore are added on the stat block.</span>
		<button type="button" class="cm-next">Next<span class="stonetop-nav-arrow"></span></button>
	</div>

</form>
