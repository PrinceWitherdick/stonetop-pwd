{{!-- MAKE A PLAN (Book I p.530), one plan of the steading's: SteadingPlanDialog.js.

      The book's words in its own order: what you hope to achieve, what the GM says it requires (each with
      a tick box), and "which means ___ will go undone". The requirement rows are cloned from the template
      at the foot and read back off the DOM on save, so adding one never re-renders away what was typed. --}}
<form class="stonetop-steading-plan" autocomplete="off">

	<p class="spe-trigger">When you wish to accomplish some project but don't know how to go about it, tell the GM what you hope to achieve. They'll say what's required.</p>

	<label class="spe-label" for="spe-name-{{#if id}}{{id}}{{else}}new{{/if}}">What do you hope to achieve?</label>
	<input id="spe-name-{{#if id}}{{id}}{{else}}new{{/if}}" type="text" class="spe-name" value="{{name}}"
	       placeholder="Rebuild the mill before the snows">

	<span class="spe-label" id="spe-reqs-label-{{#if id}}{{id}}{{else}}new{{/if}}">What it requires</span>
	<ul class="spe-req-list" aria-labelledby="spe-reqs-label-{{#if id}}{{id}}{{else}}new{{/if}}"
	    data-empty="Nothing yet. Pick one of the book's prompts below, or write your own.">
		{{#each requirements}}
		<li class="spe-req" data-req-from="{{@index}}">
			<input type="checkbox" class="spe-req-done" aria-label="Done"{{#if done}} checked{{/if}}>
			<input type="text" class="spe-req-text" value="{{text}}" aria-label="Requirement">
			<button type="button" class="spe-req-remove" data-tooltip="Remove this requirement" aria-label="Remove this requirement"><i class="fas fa-xmark" aria-hidden="true"></i></button>
		</li>
		{{/each}}
	</ul>
	<button type="button" class="spe-req-add"><i class="fas fa-plus" aria-hidden="true"></i> Add a requirement</button>

	{{!-- One press drops the prompt in as a new row with its "___" selected, so typing replaces it. --}}
	<div class="spe-prompts" role="group" aria-label="The book's requirement prompts">
		<span class="spe-prompts-label">From the book</span>
		{{#each prompts}}
		<button type="button" class="spe-prompt" data-prompt="{{this}}">{{this}}</button>
		{{/each}}
	</div>

	<label class="spe-undone">
		<span>Which means</span>
		<input type="text" class="spe-undone-input" value="{{undone}}" placeholder="what work">
		<span>goes undone.</span>
	</label>

	{{!-- Affirmative on the LEFT, which is this system's own button order. --}}
	<footer class="spe-actions">
		<button type="button" class="stonetop-cta spe-save"><i class="fas fa-check" aria-hidden="true"></i> {{#if isNew}}Make the plan{{else}}Save the plan{{/if}}</button>
		<button type="button" class="spe-cancel">Cancel</button>
	</footer>

	<template class="spe-req-tpl">
		<li class="spe-req">
			<input type="checkbox" class="spe-req-done" aria-label="Done">
			<input type="text" class="spe-req-text" aria-label="Requirement" placeholder="You must…">
			<button type="button" class="spe-req-remove" data-tooltip="Remove this requirement" aria-label="Remove this requirement"><i class="fas fa-xmark" aria-hidden="true"></i></button>
		</li>
	</template>
</form>
