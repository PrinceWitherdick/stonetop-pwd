{{!-- ONE top-level element, deliberately: AppV1 hands activateListeners a jQuery of the
      template's root nodes, so `html[0]` is only the FIRST of them. With filters, body and
      footer as siblings, every querySelector off that root missed the grid and the footer.
      Keep everything inside this wrapper. --}}
<div class="stonetop-people-root">
<div class="stonetop-people-header">
{{#if showFilters}}
<div class="stonetop-people-filters">
	<div class="stonetop-people-filtergroup" role="group" aria-label="Filter by presentation">
		<button type="button" class="stonetop-people-chip is-on" data-filter="presenting" data-value="any">All <span class="stonetop-people-count">{{counts.all}}</span></button>
		<button type="button" class="stonetop-people-chip" data-filter="presenting" data-value="masculine">Masculine <span class="stonetop-people-count">{{counts.masculine}}</span></button>
		<button type="button" class="stonetop-people-chip" data-filter="presenting" data-value="feminine">Feminine <span class="stonetop-people-count">{{counts.feminine}}</span></button>
		<button type="button" class="stonetop-people-chip" data-filter="presenting" data-value="unspecified" title="Portraits left untagged: a bucket of their own, not a gap">Unspecified <span class="stonetop-people-count">{{counts.unspecified}}</span></button>
	</div>
	{{#if hasKids}}
	<div class="stonetop-people-filtergroup" role="group" aria-label="Filter by age">
		<button type="button" class="stonetop-people-chip is-on" data-filter="kid" data-value="any">All ages</button>
		<button type="button" class="stonetop-people-chip" data-filter="kid" data-value="kids">Children <span class="stonetop-people-count">{{counts.kid}}</span></button>
		<button type="button" class="stonetop-people-chip" data-filter="kid" data-value="adults">Not children <span class="stonetop-people-count">{{counts.notKid}}</span></button>
	</div>
	{{/if}}
	{{#if hasUsed}}
	<div class="stonetop-people-filtergroup" role="group" aria-label="Filter by whether the portrait is already assigned">
		<button type="button" class="stonetop-people-chip is-on" data-filter="used" data-value="any" title="Show every portrait, assigned or not">Any use</button>
		<button type="button" class="stonetop-people-chip" data-filter="used" data-value="unused" title="Hide the portraits other people already wear">Unused <span class="stonetop-people-count">{{counts.unused}}</span></button>
		<button type="button" class="stonetop-people-chip" data-filter="used" data-value="used" title="Only the portraits someone already wears">Assigned <span class="stonetop-people-count">{{counts.used}}</span></button>
	</div>
	{{/if}}
</div>
{{/if}}
{{!-- The two ways past the gallery's own art — bring your own file, or wear none — stacked
      in a column of one width. They live up here beside the filters rather than in the footer
      so the footer holds only the roll-and-take pair, and so neither of them sits in the
      bottom-right corner every other Stonetop dialog uses for a way to back out. --}}
<div class="stonetop-people-actions">
	{{#if canBrowse}}<button type="button" class="stonetop-people-browse"><i class="fas fa-folder-open"></i> Browse files&hellip;</button>{{/if}}
	<button type="button" class="stonetop-people-clear"><i class="fas fa-rotate-left"></i> Use default</button>
</div>
</div>
<div class="stonetop-people-gallery-body">
	{{#if people}}
	{{!-- Announced: clicking a tile no longer does anything visible beyond highlighting it,
	      so this line carries the whole outcome ("Picked X. Accept to use it") for anyone
	      who can't see the highlight. --}}
	<p class="stonetop-people-hint" aria-live="polite">Pick a portrait for this person, then Accept.</p>
	<div class="stonetop-people-grid">
		{{!-- Each facet dataset carries the SAME vocabulary as its filter chips' data-value, so
		      the filter pass is one generic `dataset[facet] === want` comparison rather than a
		      per-facet decoder. That is why an untagged portrait writes "unspecified" here
		      rather than "": it is a selectable bucket, not a gap. --}}
		{{#each people}}
		{{!-- `data-src` is what the tile SHOWS: the square face when one has been cut, otherwise
		      the whole illustration. `data-full` is always the illustration — the hover preview,
		      the test for whether two paths mean the same person, and what Accept commits. The
		      square as a rect over that illustration — which is how the committed portrait still
		      draws as a face on every small round surface — is read back out of `data-src`'s own
		      filename at click time (PeopleGalleryDialog#_frameOf), so it needs no attribute. --}}
		<button type="button" class="stonetop-people-pick{{#if isSquare}} is-square{{/if}}{{#if selected}} is-selected{{/if}}{{#if usedBy}} is-used{{/if}}" data-src="{{src}}" data-full="{{full}}" data-presenting="{{#if presenting}}{{presenting}}{{else}}unspecified{{/if}}" data-kid="{{#if kid}}kids{{else}}adults{{/if}}" data-used="{{#if usedBy}}used{{else}}unused{{/if}}" data-used-by="{{usedBy}}" title="{{name}}{{#if usedBy}} (already assigned to {{usedBy}}){{/if}}">
			<img src="{{src}}" alt="{{name}}" loading="lazy">
			<span class="stonetop-people-label">{{name}}</span>
		</button>
		{{/each}}
	</div>
	<p class="stonetop-people-nomatch" hidden="hidden">No portraits match this filter.</p>
	{{else}}
	{{!-- An empty gallery is not a dead end: it says what would fill it and offers to do it. Which
	      of the two cures is on the table (cut the faces out of art already on disk, or fetch the
	      art from the books) is settled in PeopleGalleryDialog#_emptyOffer, which is also where the
	      wording lives, so nothing here has to branch on the state of the art folder. --}}
	<div class="stonetop-people-empty">
		<p>No <strong>People of Stonetop</strong> portraits are available yet.</p>
		<p>{{empty.blurb}}</p>
		{{#if empty.canRebuild}}
		<button type="button" class="stonetop-people-rebuild" title="Cut the portraits out of book art this world already has, without opening your PDFs"><i class="fas fa-crop-simple"></i> {{empty.rebuildLabel}}</button>
		{{/if}}
		{{#if empty.canImport}}
		{{!-- The books, asked for here rather than in the importer's own window: a GM in front of an
		      empty gallery has already been told what is missing, so the shortest way to the faces is
		      the one that takes the PDF and goes. The `name` is what PeopleGalleryDialog._chosenBooks
		      reads each field back by, keyed on the same book NUMBER the macro's handoff is keyed on.
		      A file field cannot be given its selection back from script, so nothing here may be
		      re-rendered once a book has been chosen. --}}
		<div class="stonetop-people-books">
			{{#each empty.books}}
			<label class="stonetop-people-book">
				<span class="stonetop-people-book-name">{{title}} <span class="stonetop-people-book-hint">{{note}}</span></span>
				<input type="file" name="stonetop-book-file-{{book}}" accept="application/pdf,.pdf">
				{{!-- Which edition, with the page count that settles it. Not a nicety: every page
				      number the importer works from was measured on the spreads sheet, so the 1-up
				      file is refused outright rather than half-imported, and a GM who hands one over
				      without being warned first has spent a minute to be told no. --}}
				<span class="stonetop-people-book-edition">{{edition}}</span>
			</label>
			{{/each}}
		</div>
		{{!-- Said here because this shortcut skips the importer's own window, where the same
		      thing is a tick-box the GM can see and untick. A book supplied here is kept as well
		      as read, and a 60 MB copy of somebody's rulebook should never be a surprise. --}}
		{{#if empty.keepsBooks}}
		<p class="stonetop-people-book-keep">A book you supply is also kept in this world, so you can read it here afterwards: from the GM Toolkit, and your players from their character sheets. You will not be asked for it again.</p>
		{{/if}}
		{{!-- Disabled until a book is chosen, and re-armed by _activateBookImport. The fields it is
		      waiting on are two lines above it, which is what makes a dead button read as waiting
		      rather than as broken; the hint under it says the same thing in words. --}}
		<button type="button" class="stonetop-people-import" disabled="disabled" title="Rebuild the illustrations from your own Stonetop PDFs, on your own machine"><i class="fas fa-images"></i> {{empty.importLabel}}</button>
		<p class="stonetop-people-import-hint"></p>
		{{!-- The poster maps, the free GM playbook and the force-update tick are separate errands
		      with nothing to do with faces, so they keep the window they have always lived in. --}}
		<button type="button" class="stonetop-people-import-more" title="Open the full Import Book Art window: poster maps, the free GM playbook, and the force-update option"><i class="fas fa-sliders"></i> More import options&hellip;</button>
		{{/if}}
		{{#if canBrowse}}<p class="stonetop-people-empty-note">In the meantime you can choose any image with <strong>Browse files&hellip;</strong> above.</p>{{/if}}
	</div>
	{{/if}}
</div>
{{#if people}}
{{!-- Nothing here commits a portrait but Accept. Clicking a tile and rolling both only
      propose: they highlight a portrait and arm Accept, so a misclick or an unwanted roll
      costs one more click rather than a portrait you must come back to fix.

      Accept is FIRST in the DOM, which the footer's flex-end grouping makes the left of the
      pair: the affirmative — the only button here that commits a portrait — goes on the left,
      matching every other Stonetop modal and Foundry's own dialogs. This is not a wizard, so
      the Next-on-the-right exception does not apply; Randomize is a repeatable action rather
      than a step forward, and it sits beside the thing it arms. --}}
<footer class="stonetop-people-footer">
	<button type="button" class="stonetop-people-accept" disabled="disabled" title="Use the portrait on offer: click one, or roll for it"><i class="fas fa-check"></i> Accept</button>
	<button type="button" class="stonetop-people-random" title="Roll a portrait at random from the ones shown (the filters above apply)"><i class="fas fa-dice-d6"></i> Randomize</button>
</footer>
{{/if}}
</div>
