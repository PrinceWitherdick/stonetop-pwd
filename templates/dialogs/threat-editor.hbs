<form class="stonetop threat-edit threat-editor" autocomplete="off" data-page-uuid="{{this.uuid}}">

	<div class="threat-edit__row">
		<label class="threat-edit__field threat-edit__field--grow">
			<span class="threat-edit__label">Name</span>
			<input type="text" data-doc-field="name" value="{{this.name}}" placeholder="Threat name">
		</label>
		<label class="threat-edit__field">
			<span class="threat-edit__label">Type</span>
			<select data-doc-field="system.type">
				{{#each typeOptions}}<option value="{{this.id}}"{{#if selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
			</select>
		</label>
	</div>

	<label class="threat-edit__field">
		<span class="threat-edit__label">Instinct</span>
		<input type="text" data-doc-field="system.instinct" value="{{system.instinct}}" placeholder="to indulge its ego">
	</label>

	<div class="threat-edit__field">
		<span class="threat-edit__label">Proximity</span>
		<div class="stonetop-segmented-picker threat-proximity-picker">
			{{#each proximityOptions}}
			<label class="stonetop-segmented-picker-option threat-proximity-option{{#if selected}} is-selected{{/if}}">
				<input type="radio" name="threat-proximity-{{@root.id}}" data-doc-field="system.proximity" value="{{this.id}}"{{#if selected}} checked{{/if}}>
				<span>{{this.label}}</span>
			</label>
			{{/each}}
		</div>
	</div>

	{{!-- A TOGGLED rich editor: it shows the description as the card prints it, the pencil opens
	      it, and its own save commits one change. Toggled rather than always-on because this
	      window re-renders on every page update, which would tear a live editor down mid-edit. --}}
	<div class="threat-edit__field">
		<span class="threat-edit__label">Description <em class="threat-edit__hint">who or what it is, how it became a problem, its ties to NPCs or other threats</em></span>
		<prose-mirror class="threat-edit__rich" data-doc-field="system.description" toggled value="{{system.description}}">{{{this.descriptionEnriched}}}</prose-mirror>
	</div>

	<div class="threat-edit__field">
		<span class="threat-edit__label">Grim portents <em class="threat-edit__hint">the doom track</em></span>
		<div class="threat-list" data-list="grimPortents">
			{{#each grimPortents}}
			<div class="threat-list-row threat-list-row--portent" data-index="{{this.index}}">
				<input type="checkbox" class="threat-list-done" data-field="done"{{#if done}} checked{{/if}} data-tooltip="Come to pass">
				<input type="text" class="threat-list-text" data-field="text" value="{{this.text}}" placeholder="A concrete, observable milestone">
				<button type="button" class="threat-list-remove" data-list="grimPortents" data-index="{{this.index}}" data-tooltip="Remove"><i class="fas fa-times"></i></button>
			</div>
			{{/each}}
			<button type="button" class="threat-list-add" data-list="grimPortents"><i class="fas fa-plus"></i> Add portent</button>
		</div>
	</div>

	<div class="threat-edit__field">
		<span class="threat-edit__label">Impending doom</span>
		<div class="threat-doom-edit">
			<input type="checkbox" class="threat-list-done" data-doc-field="system.impendingDoom.done"{{#if system.impendingDoom.done}} checked{{/if}} data-tooltip="Come to pass">
			<input type="text" data-doc-field="system.impendingDoom.text" value="{{system.impendingDoom.text}}" placeholder="The irreversible outcome, if the PCs never intervene">
		</div>
	</div>

	<button type="button" class="threat-editor-more-toggle{{#if moreOpen}} is-open{{/if}}"><i class="fas fa-chevron-up"></i> Stakes, GM moves &amp; more</button>
	<div class="threat-editor-more{{#if moreOpen}} is-open{{/if}}">

		<div class="threat-edit__field">
			<span class="threat-edit__label">Themes <em class="threat-edit__hint">Things Below</em></span>
			{{> "stonetop.threat-string-list" key="themes" rows=themes placeholder="Darkness / cold / despair (obsidian, hoarfrost)" addLabel="Add theme"}}
		</div>

		<div class="threat-edit__field">
			<span class="threat-edit__label">Aspects <em class="threat-edit__hint">impossible, weird</em></span>
			{{> "stonetop.threat-string-list" key="aspects" rows=aspects placeholder="Many-limbed / many-eyed / many-bodied" addLabel="Add aspect"}}
		</div>

		<div class="threat-edit__field">
			<span class="threat-edit__label">Cleansing <em class="threat-edit__hint">corrupted site plan</em></span>
			{{> "stonetop.threat-string-list" key="cleansing" rows=cleansing placeholder="Learn the name of the Thing that taints this place" addLabel="Add requirement"}}
		</div>

		<div class="threat-edit__field">
			<span class="threat-edit__label">Stakes questions</span>
			{{> "stonetop.threat-string-list" key="stakes" rows=stakes placeholder="A future-facing question you're curious about" addLabel="Add question"}}
		</div>

		<div class="threat-edit__field">
			<span class="threat-edit__label">GM moves</span>
			{{#if suggestedMoves.length}}
			<div class="threat-suggested">
				<p class="threat-suggested__hint">Suggested for {{this.typeLabel}}. Click to add:</p>
				<div class="threat-suggested__chips">
					{{#each suggestedMoves}}
					<button type="button" class="threat-suggested__chip{{#if used}} is-used{{/if}}" data-suggested-move="{{this.text}}">{{this.text}}</button>
					{{/each}}
				</div>
			</div>
			{{/if}}
			{{> "stonetop.threat-string-list" key="gmMoves" rows=gmMoves placeholder="A GM move for this threat" addLabel="Add GM move"}}
		</div>

		<div class="threat-edit__field">
			<span class="threat-edit__label">Lesser threats</span>
			<div class="threat-list" data-list="nested">
				{{#each nested}}
				<div class="threat-list-row threat-list-row--nested" data-index="{{this.index}}">
					<input type="text" class="threat-list-text" data-field="name" value="{{this.name}}" placeholder="Name">
					<select class="threat-list-select" data-field="type">
						<option value="">type</option>
						{{#each @root.typeOptions}}<option value="{{this.id}}"{{#if (eq id ../type)}} selected{{/if}}>{{this.label}}</option>{{/each}}
					</select>
					<input type="text" class="threat-list-text" data-field="instinct" value="{{this.instinct}}" placeholder="instinct">
					<button type="button" class="threat-list-remove" data-list="nested" data-index="{{this.index}}" data-tooltip="Remove"><i class="fas fa-times"></i></button>
				</div>
				{{/each}}
				<button type="button" class="threat-list-add" data-list="nested"><i class="fas fa-plus"></i> Add lesser threat</button>
			</div>
		</div>

		<div class="threat-edit__field">
			<span class="threat-edit__label">Custom player moves</span>
			<div class="threat-list" data-list="customPlayerMoves">
				{{#each customPlayerMoves}}
				<div class="threat-list-row threat-list-row--pmove" data-index="{{this.index}}">
					<input type="text" class="threat-list-text" data-field="label" value="{{this.label}}" placeholder="Move name or trigger">
					<textarea class="threat-list-textarea" data-field="text" rows="2" placeholder="The move text">{{this.text}}</textarea>
					<button type="button" class="threat-list-remove" data-list="customPlayerMoves" data-index="{{this.index}}" data-tooltip="Remove"><i class="fas fa-times"></i></button>
				</div>
				{{/each}}
				<button type="button" class="threat-list-add" data-list="customPlayerMoves"><i class="fas fa-plus"></i> Add player move</button>
			</div>
		</div>

	</div>

	<footer class="threat-editor__footer">
		<button type="button" class="threat-editor-done"><i class="fas fa-check"></i> Done</button>
	</footer>
</form>
