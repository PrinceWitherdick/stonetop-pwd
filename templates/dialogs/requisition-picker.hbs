<div class="stonetop-requisition-picker">
	<p class="stonetop-requisition-trigger"><em>When you borrow some of the steading's assets for an expedition (like the horses or a plow), roll +Fortunes.</em></p>

	<div class="stonetop-requisition-roll">
		{{#if herdQuestion}}
		{{!-- Herd of Horses: "When you Requisition half the herd or less, treat a 6- as a 7-9." A
		     COUNT, read against the whole herd, and the take's default for how many leave it. --}}
		<label class="stonetop-requisition-herd"><input type="number" class="stonetop-requisition-herd-count" name="herdCount" min="0" max="{{herdQuestion.max}}" value="0"><span>{{herdQuestion.label}}</span></label>
		{{/if}}
		{{#if logistics}}
		{{!-- The Marshal's Logistics, ticked for a character who has it learned. --}}
		<label class="stonetop-requisition-herd stonetop-requisition-logistics"><input type="checkbox" class="stonetop-check" name="logistics" checked><span>{{logistics}}</span></label>
		{{/if}}
		{{#if nervesNote}}
		{{!-- We Happy Few's 6-: said, not asked; the roll takes the disadvantage on its own. --}}
		<p class="stonetop-requisition-herd stonetop-requisition-nerves"><em>{{nervesNote}}</em></p>
		{{/if}}
		{{#each advantageAsks}}
		{{!-- An improvement's asked advantage on Requisition: unticked, the table's call. --}}
		<label class="stonetop-requisition-herd stonetop-requisition-advantage"><input type="checkbox" class="stonetop-check" name="{{name}}"><span>{{label}}</span></label>
		{{/each}}
		<button type="button" class="stonetop-requisition-roll-btn">
			<i class="fas fa-dice-d6"></i> Roll +Fortunes ({{fortunes}})
		</button>
		<ul class="stonetop-requisition-results">
			<li><strong>10+:</strong> go ahead, but bring it back safely.</li>
			<li><strong>7-9:</strong> you'll need to do some convincing.</li>
			<li><strong>6-:</strong> don't mark XP; you can take the asset, but if you do, reduce Fortunes by 1.</li>
		</ul>
	</div>

	<h3 class="stonetop-requisition-heading">{{steadingName}}&rsquo;s Assets</h3>
	<div class="stonetop-requisition-choice">
		<label class="stonetop-requisition-choice-label" for="stonetop-requisition-asset">Asset</label>
		<select id="stonetop-requisition-asset" class="stonetop-requisition-asset-select">
			{{#each assets}}
			<option value="{{index}}">{{name}}</option>
			{{/each}}
			<option value="{{customAssetValue}}">Something else...</option>
		</select>
		<input type="text" class="stonetop-requisition-custom-input" placeholder="Enter an asset or item" disabled hidden>
		<button type="button" class="stonetop-requisition-take">
			<i class="fas fa-hand-holding"></i> Take
		</button>
	</div>
	{{#unless assets.length}}
	<p class="stonetop-requisition-empty">No assets are currently on hand. Enter something else if the fiction calls for it.</p>
	{{/unless}}

	{{#if takenAssets.length}}
	<h4 class="stonetop-requisition-subheading">Already out</h4>
	<ul class="stonetop-requisition-list stonetop-requisition-list--taken">
		{{#each takenAssets}}
		<li class="stonetop-requisition-item is-taken">
			<span class="stonetop-requisition-item-name">{{name}}</span>
			<span class="stonetop-requisition-taken-by">{{where}}</span>
		</li>
		{{/each}}
	</ul>
	{{/if}}

	<div class="stonetop-requisition-actions">
		<button type="button" class="stonetop-requisition-close">Close</button>
	</div>
</div>
