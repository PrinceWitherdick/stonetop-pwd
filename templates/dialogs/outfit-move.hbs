<div class="stonetop-outfit-move-body">

	<p class="stonetop-outfit-description">{{{localize "stonetop.specialMoves.outfit.description"}}}</p>
	<div class="stonetop-outfit-rule-note">
		<p>{{{localize "stonetop.specialMoves.outfit.selectIntro"}}}</p>
		<ul>
			<li>{{{localize "stonetop.specialMoves.outfit.selectPrinted"}}}</li>
			<li>{{{localize "stonetop.specialMoves.outfit.selectCommon"}}}</li>
			<li>{{{localize "stonetop.specialMoves.outfit.selectPossessions"}}}</li>
			<li>{{{localize "stonetop.specialMoves.outfit.selectTrade"}}}</li>
		</ul>
		<p>{{{localize "stonetop.specialMoves.outfit.tellGm"}}}</p>
	</div>

	{{!-- Load level bar --}}
	<div class="stonetop-outfit-load-bar">
		<div class="stonetop-outfit-load-option{{#if loadLevelLight}} is-active{{/if}}">
			<span class="stonetop-outfit-load-badge">{{loadBands.light}} <span class="stonetop-glyph stonetop-glyph--diamond-selected">◆</span></span>
			<span class="stonetop-outfit-load-text">{{{localize "stonetop.specialMoves.outfit.loadLight"}}}</span>
		</div>
		<div class="stonetop-outfit-load-option{{#if loadLevelNormal}} is-active{{/if}}">
			<span class="stonetop-outfit-load-badge">{{loadBands.normal}} <span class="stonetop-glyph stonetop-glyph--diamond-selected">◆</span></span>
			<span class="stonetop-outfit-load-text">{{{localize "stonetop.specialMoves.outfit.loadNormal"}}}</span>
		</div>
		<div class="stonetop-outfit-load-option{{#if loadLevelHeavy}} is-active{{/if}}">
			<span class="stonetop-outfit-load-badge">{{loadBands.heavy}} <span class="stonetop-glyph stonetop-glyph--diamond-selected">◆</span></span>
			<span class="stonetop-outfit-load-text">{{{localize "stonetop.specialMoves.outfit.loadHeavy"}}}</span>
		</div>
	</div>
	{{#if loadBonusFrom}}
	<p class="stonetop-outfit-load-bonus-note">{{{format "stonetop.specialMoves.outfit.loadBonusNote" moves=loadBonusFrom bonus=loadBonus light=loadLimits.light normal=loadLimits.normal heavy=loadLimits.heavy}}}</p>
	{{/if}}

	{{!-- Running mark total (specific items + undefined), shown once anything is marked --}}
	{{#unless loadLevelNone}}
	<div class="stonetop-outfit-weight-row">
		<span class="stonetop-outfit-weight-diamonds">
			{{!-- Empty spans: the icon is the background. A literal ◆ here would be re-skinned by
			      wrapStonetopGlyphsInEl into a second diamond overlapping the first. --}}
			{{#each (times totalMarks)}}<span class="stonetop-outfit-diamond-filled"></span>{{/each}}
		</span>
		<span class="stonetop-outfit-weight-count">{{this.totalMarks}} {{{localize "stonetop.specialMoves.outfit.totalWeight"}}}{{#if loadLevelOverloaded}} <strong class="stonetop-outfit-overloaded">{{localize "stonetop.inventory.outfit.overloaded"}}</strong>{{/if}}</span>
	</div>
	{{/unless}}

	<div class="stonetop-outfit-columns">

		{{!-- Regular items --}}
		<section class="stonetop-outfit-regular-section">
			{{> "stonetop.section-heading" headingClass="stonetop-outfit-section-heading" title=(localize "stonetop.specialMoves.outfit.regularItems")
			    searchControl=true
			    searchTitle=(localize "stonetop.inventory.searchLabel")
			    searchPlaceholder=(localize "stonetop.inventory.searchPlaceholder")}}
			<hr class="stonetop-inv-separator">
			{{!-- The undefined ◇ reserve, drawn as the Inventory tab draws it. --}}
			{{> "stonetop.inv-undefined-pool" pool=regularPool cap=regularPoolCap}}
			<hr class="stonetop-inv-separator">
			{{#each regularItems}}
			<label class="stonetop-outfit-item{{#if checked}} is-checked{{/if}}">
				<input type="checkbox" class="stonetop-outfit-item-check" data-slug="{{this.slug}}" {{#if checked}}checked{{/if}}>
				<span class="stonetop-outfit-item-diamonds">
					{{#each (times weight)}}<span class="stonetop-outfit-diamond"></span>{{/each}}
				</span>
				<span class="stonetop-outfit-item-name">{{this.name}}</span>
				{{#if note}}<span class="stonetop-outfit-item-note">({{{this.note}}})</span>{{/if}}
			</label>
			{{/each}}

			{{#if hasPossessionRegular}}
			<h3 class="stonetop-outfit-section-heading stonetop-outfit-section-heading--possessions">{{{localize "stonetop.specialMoves.outfit.possessionItems"}}}</h3>
			<hr class="stonetop-inv-separator">
			{{#each possessionRegular}}
			<label class="stonetop-outfit-item{{#if checked}} is-checked{{/if}}">
				<input type="checkbox" class="stonetop-outfit-item-check" data-slug="{{this.slug}}" {{#if checked}}checked{{/if}}>
				<span class="stonetop-outfit-item-diamonds">
					{{#each (times weight)}}<span class="stonetop-outfit-diamond"></span>{{/each}}
				</span>
				<span class="stonetop-outfit-item-name">{{this.name}}</span>
				{{#if note}}<span class="stonetop-outfit-item-note">({{this.note}})</span>{{/if}}
			</label>
			{{/each}}
			{{/if}}
		</section>

		{{!-- Small items --}}
		<section class="stonetop-outfit-small-section">
			{{> "stonetop.section-heading" headingClass="stonetop-outfit-section-heading" title=(localize "stonetop.specialMoves.outfit.smallItems")
			    searchControl=true
			    searchTitle=(localize "stonetop.inventory.searchSmallLabel")
			    searchPlaceholder=(localize "stonetop.inventory.searchSmallPlaceholder")}}
			{{#if hasSmallItemLimit}}
			<p class="stonetop-outfit-small-limit">{{{format "stonetop.specialMoves.outfit.smallItemLimit" limit=smallItemLimit}}}</p>
			{{/if}}
			<hr class="stonetop-inv-separator">
			{{!-- The undefined □ reserve, as on the Inventory tab: the full 4+Prosperity allowance. --}}
			{{> "stonetop.inv-undefined-pool" pool=smallPool cap=smallPoolCap small=true}}
			<hr class="stonetop-inv-separator">
			{{#each smallItems}}
			<label class="stonetop-outfit-item stonetop-outfit-item-small{{#if checked}} is-checked{{/if}}">
				<input type="checkbox" class="stonetop-outfit-item-check" data-slug="{{this.slug}}" {{#if checked}}checked{{/if}}>
				<span class="stonetop-outfit-square"></span>
				<span class="stonetop-outfit-item-name">{{this.name}}</span>
				{{#if note}}<span class="stonetop-outfit-item-note">({{{this.note}}})</span>{{/if}}
			</label>
			{{/each}}
			{{!-- The standard small items, two to a row and name only, as on the Inventory tab. --}}
			{{#if smallGridItems.length}}
			<hr class="stonetop-inv-separator">
			<div class="stonetop-inv-grid">
				{{#each smallGridItems}}
				<label class="stonetop-outfit-item stonetop-outfit-item-small{{#if checked}} is-checked{{/if}}">
					<input type="checkbox" class="stonetop-outfit-item-check" data-slug="{{this.slug}}" {{#if checked}}checked{{/if}}>
					<span class="stonetop-outfit-square"></span>
					<span class="stonetop-outfit-item-name">{{this.name}}</span>
				</label>
				{{/each}}
			</div>
			{{/if}}

			{{#if hasPossessionSmall}}
			<h3 class="stonetop-outfit-section-heading stonetop-outfit-section-heading--possessions">{{{localize "stonetop.specialMoves.outfit.possessionItems"}}}</h3>
			<hr class="stonetop-inv-separator">
			{{#each possessionSmall}}
			<label class="stonetop-outfit-item stonetop-outfit-item-small{{#if checked}} is-checked{{/if}}">
				<input type="checkbox" class="stonetop-outfit-item-check" data-slug="{{this.slug}}" {{#if checked}}checked{{/if}}>
				<span class="stonetop-outfit-square"></span>
				<span class="stonetop-outfit-item-name">{{this.name}}</span>
				{{#if note}}<span class="stonetop-outfit-item-note">({{this.note}})</span>{{/if}}
			</label>
			{{/each}}
			{{/if}}

			{{#if hasArcana}}
			<h3 class="stonetop-outfit-section-heading stonetop-outfit-section-heading--arcana">{{{localize "stonetop.specialMoves.outfit.arcanaItems"}}}</h3>
			<hr class="stonetop-inv-separator">
			{{!-- Weightless arcana render INERT, matching the gear tab's static rows: they
			      cost nothing against load or the small allowance, so a checkbox here would
			      be a mark that changes no number anywhere. --}}
			{{#each arcanaItems}}
			<label class="stonetop-outfit-item{{#if inert}} stonetop-outfit-item-static{{/if}}{{#if checked}} is-checked{{/if}}">
				{{#unless inert}}
				<input type="checkbox" class="stonetop-outfit-item-check" data-slug="{{this.slug}}" {{#if checked}}checked{{/if}}>
				{{/unless}}
				<span class="stonetop-outfit-item-diamonds">
					{{#each (times weight)}}<span class="stonetop-outfit-diamond"></span>{{/each}}
				</span>
				<span class="stonetop-outfit-item-name">{{this.name}}</span>
				{{#if note}}<span class="stonetop-outfit-item-note">({{{this.note}}})</span>{{/if}}
			</label>
			{{/each}}
			{{/if}}
		</section>

	</div>

	<footer class="stonetop-outfit-footer">
		<button type="button" class="stonetop-outfit-confirm-btn">
			{{{localize "stonetop.specialMoves.outfit.confirm"}}}
		</button>
	</footer>

</div>
