<div class="stonetop-marks-body">

	{{!-- Whose moves these are, then what they all have in common. The clause that makes this
	      window necessary ("so long as the mark remains") is the one a table forgets.

	      Above the rail rather than inside a panel, because it is true of all five kinds. --}}
	<div class="stonetop-marks-heading">
		{{#if playbookImg}}
		<img class="stonetop-marks-mark" src="{{playbookImg}}" alt="" draggable="false">
		{{/if}}
		<p class="stonetop-marks-rule">{{localize "stonetop.blessedMarks.rule"}}</p>
	</div>

	{{#if hasGroups}}
	{{!-- ONE suggestion list for all five bars. Every panel offers the same world actors — the
	      marks roster is not filtered by who is already marked, since the same woman can wear
	      Barkskin and a charm — so a list per panel was the whole world written out five times on
	      every render, on a window that re-renders after every write. `upgradeAll` resolves a
	      field's list by its id (utils/autocomplete.js), so five fields naming one list all read
	      it. --}}
	<datalist id="{{listId}}">
		{{#each suggestions}}<option value="{{value}}"{{#if hint}} label="{{hint}}"{{/if}}></option>{{/each}}
	</datalist>
	{{!-- One kind at a time behind a left rail, once this Blessed has more than one of the five.
	      With a single kind the rail is not drawn and `activeTab` is pointed at the only panel, so
	      the same markup renders the plain content-hugging window. See RosterDialog `_railFor`.

	      The panels are gated on `activeTab` — the Judge's gate exactly, and the only one either
	      window has. A per-panel `selected` would be a second answer to the same question, and
	      `_railFor` sets it on the RAIL ENTRIES rather than on the lists, so a panel asking for it
	      is asking for something nothing hands it. --}}
	<div class="stonetop-guide-split stonetop-roster-split">

		{{#if railed}}
		{{> "stonetop.guide-tabs" tabs=tabs btnClass="stonetop-roster-tab"
		    ariaLabel=(localize "stonetop.blessedMarks.kindLabel")}}
		{{/if}}

		<div class="stonetop-guide-main stonetop-roster-main">

			{{#each groups}}
			{{!-- One panel per kind: the ones somebody wears, and the ones this Blessed could lay.
			      The heading is the move; the line under it is what the mark is DOING for the person
			      wearing it, quoted from the move rather than paraphrased, since that is the question
			      this window exists to answer without a trip to the Moves tab.

			      The panel is also this kind's drop target and carries this kind's add bar, which is
			      what retired the old "which mark" picker: the kind is where you are standing. --}}
			<section class="stonetop-marks-group stonetop-roster-panel" data-mark-kind="{{key}}" data-tab="{{key}}"
			         {{#unless (eq ../activeTab key)}}hidden{{/unless}}>
				{{!-- Always, unlike the Judge's: his two lists are named by the window title, while
				      nothing else here says which of the five you are looking at — the rule line under
				      it quotes the move's effect without naming the move. --}}
				<h3 class="stonetop-marks-group-heading">{{label}}</h3>
				<p class="stonetop-marks-group-rule">{{rule}}</p>

				{{#if hasRows}}
				<ul class="stonetop-marks-list">
					{{#each rows}}
					{{#> "stonetop.roster-row" prefix="stonetop-marks" editable=../../editable
					     openClass="stonetop-mark-open" noteClass="stonetop-mark-note"
					     noteTextClass="stonetop-marks-note-text" notePlaceholder=notePlaceholder
					     removeClass="stonetop-mark-lift"
					     removeLabel=(localize "stonetop.blessedMarks.liftLabel" name=name)}}
					{{!-- Shared Souls only: "treat it as a follower with 3 Loyalty; when you spend its last
					      Loyalty, the effect ends". Absent (not empty) on every other kind, so nothing else
					      shows a track it could never spend. --}}
					{{!-- `../editable` / `../id`, NOT the deeper walk this needed when it sat inline: inside
					      a partial's block the hash arguments have pushed a frame, so one `../` out of the
					      pip loop already lands on the row. Getting it wrong fails by reading undefined,
					      which hands a writable sheet the read-only pips. --}}
					{{#if pips}}
					<span class="stonetop-mark-loyalty" data-tooltip="{{localize "stonetop.blessedMarks.loyaltyTooltip"}}" data-tooltip-direction="UP">
						{{#each pips}}
						{{#if ../editable}}
						<button type="button" class="stonetop-readiness-pip stonetop-mark-loyalty-pip{{#if filled}} is-filled{{/if}}"
						        data-row-id="{{../id}}" data-index="{{index}}"
						        aria-label="{{localize "stonetop.blessedMarks.loyaltySet"}}"></button>
						{{else}}
						<span class="stonetop-readiness-pip stonetop-mark-loyalty-pip{{#if filled}} is-filled{{/if}}"></span>
						{{/if}}
						{{/each}}
					</span>
					{{/if}}
					{{!-- Wards & Bindings only: "choose whether the affected beings are repelled or trapped by
					      the signs". One move, two outcomes, so it is a toggle on the row rather than a sixth
					      entry in the kind picker — see blessed-marks.js. Absent (not empty) on every other
					      kind, and `../id` inside the loop for the same reason the pips use it. --}}
					{{#if signs}}
					{{#if editable}}
					<span class="stonetop-mark-sign{{#if signUnset}} is-unset{{/if}}"
					      data-tooltip="{{#if signUnset}}{{localize "stonetop.blessedMarks.signUnset"}}{{else}}{{localize "stonetop.blessedMarks.signTooltip"}}{{/if}}"
					      data-tooltip-direction="UP">
						{{#each signs}}
						<button type="button" class="stonetop-mark-sign-btn{{#if active}} is-active{{/if}}"
						        data-row-id="{{../id}}" data-sign="{{key}}"
						        data-tooltip="{{rule}}" data-tooltip-direction="UP">{{label}}</button>
						{{/each}}
					</span>
					{{!-- A viewer who cannot write gets the ANSWER, not a widget that does nothing when
					      pressed — and NOTHING AT ALL where a pre-toggle ward has no answer to give, since
					      the wrapper would otherwise draw an empty dashed box asking a question this viewer
					      could not answer anyway. `:empty` could not have done that: the whitespace this
					      template indents with is a text node, so the span is never empty to CSS. --}}
					{{else}}{{#unless signUnset}}
					<span class="stonetop-mark-sign" data-tooltip="{{localize "stonetop.blessedMarks.signTooltip"}}"
					      data-tooltip-direction="UP">
						{{#each signs}}{{#if active}}<span class="stonetop-mark-sign-btn is-active"
						      data-tooltip="{{rule}}" data-tooltip-direction="UP">{{label}}</span>{{/if}}{{/each}}
					</span>
					{{/unless}}{{/if}}
					{{/if}}
					{{/"stonetop.roster-row"}}
					{{/each}}
				</ul>
				{{else}}
				{{!-- This kind alone, not the whole roster: the rail carries each kind's count, so
				      the line only has to speak for the panel it is in. --}}
				<p class="stonetop-marks-empty">{{localize "stonetop.blessedMarks.noneOfKind"}}</p>
				{{/if}}

				{{#if canAdd}}
				{{!-- This kind's own add bar. Nothing to pick first: the kind is the panel, and a ward
				      asks its one further question (repelled or trapped) right here, in the one panel
				      where that question means anything. --}}
				{{!-- No `suggestions`: the one list above serves every bar, and this names it. --}}
				{{#> "stonetop.roster-add" prefix="stonetop-marks"
				     nameClass="stonetop-marks-name" listId=../listId
				     addClass="stonetop-marks-add-btn"
				     addLabel=(localize "stonetop.blessedMarks.add")
				     placeholder=(localize "stonetop.blessedMarks.addPlaceholder")
				     hint=(localize "stonetop.blessedMarks.dropHint")}}
				{{#if signs}}
				<select class="stonetop-marks-sign" aria-label="{{localize "stonetop.blessedMarks.signLabel"}}">
					{{#each signs}}
					<option value="{{key}}"{{#if selected}} selected{{/if}}>{{label}}</option>
					{{/each}}
				</select>
				{{/if}}
				{{/"stonetop.roster-add"}}
				{{/if}}
			</section>
			{{/each}}

		</div>

	</div>
	{{else}}
	<p class="stonetop-marks-empty">{{localize "stonetop.blessedMarks.none"}}</p>
	{{/if}}

</div>
