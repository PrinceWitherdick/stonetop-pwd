{{!-- Make-a-Hazard walkthrough (Book I, Dangers, pp. 381-389). Reuses the
      spring/expedition dialog chrome (.stonetop-guide-* / .stonetop-spring-*) and the
      follower wizard's control styles (.stonetop-cf-*); hazard-specific hooks are
      .stonetop-ch-*. See hazards/create-hazard-dialog.js. --}}
<div class="stonetop-spring">

  <div class="stonetop-guide-split">

    {{> "stonetop.guide-toc" ariaLabel="Hazard steps"}}

    <div class="stonetop-guide-main">

      <div class="stonetop-guide-banner">
        <i class="fas {{step.icon}} stonetop-guide-banner-icon"></i>
        <div class="stonetop-guide-banner-info">
          <div class="stonetop-guide-banner-title">{{step.title}}</div>
          <div class="stonetop-guide-banner-sub">{{#if isEdit}}Edit a hazard{{else}}Make a hazard{{/if}}</div>
        </div>
        <div class="stonetop-guide-count">{{this.stepIndex}} / {{this.stepCount}}</div>
      </div>

      <div class="stonetop-spring-body">{{{step.body}}}</div>

      <div class="stonetop-cf-controls">

        {{#if is_concept}}
        <label class="stonetop-cf-label">Name
          <input type="text" class="stonetop-cf-input" data-field="name" value="{{sel.name}}" placeholder="unstable pillars, strangling vines, the climb…">
        </label>
        <label class="stonetop-cf-label">Description &amp; notes
          <textarea class="stonetop-cf-textarea" data-field="description" rows="5" placeholder="Where it is, what it looks like, what triggers it, how it works…">{{sel.description}}</textarea>
        </label>
        {{/if}}

        {{#if is_damage}}
        <div class="stonetop-cf-pick{{#if certainDeath}} stonetop-ch-damage--off{{/if}}">
          <div class="stonetop-cf-pick-label">What's the worst it could do? <span class="stonetop-cf-pick-hint">(pick 1)</span></div>
          <div class="stonetop-cf-option-list">
            {{#each damageDice}}
            <label class="stonetop-cf-option{{#if selected}} is-selected{{/if}}">
              <input type="radio" name="ch-damage-die" class="stonetop-ch-damage-die" value="{{this.id}}" {{#if selected}}checked{{/if}}{{#if ../certainDeath}} disabled{{/if}}>
              <span class="stonetop-cf-option-text">{{this.label}}</span>
              <span class="stonetop-cf-option-val">{{this.value}}</span>
            </label>
            {{/each}}
          </div>
        </div>
        <div class="stonetop-cf-pick{{#if certainDeath}} stonetop-ch-damage--off{{/if}}">
          <div class="stonetop-cf-pick-label">What else applies? <span class="stonetop-cf-pick-hint">(pick all that do)</span></div>
          <div class="stonetop-cf-option-list">
            {{#each damageEffects}}
            <label class="stonetop-cf-option{{#if checked}} is-selected{{/if}}">
              <input type="checkbox" class="stonetop-ch-damage-effect" value="{{this.id}}" {{#if checked}}checked{{/if}}{{#if ../certainDeath}} disabled{{/if}}>
              <span class="stonetop-cf-option-text">{{this.label}}</span>
              <span class="stonetop-cf-option-val">{{this.value}}</span>
            </label>
            {{/each}}
          </div>
        </div>
        <label class="stonetop-cf-label{{#if certainDeath}} stonetop-ch-damage--off{{/if}}">Anything else
          <input type="text" class="stonetop-cf-input" data-field="damageExtra" value="{{sel.damageExtra}}" placeholder="extra tags, comma-separated: area, poison…"{{#if certainDeath}} disabled{{/if}}>
        </label>
        {{!-- Certain death (p. 383) replaces the damage roll outright. --}}
        <label class="stonetop-cf-label stonetop-cf-group-label stonetop-ch-certain-label">
          <span><input type="checkbox" class="stonetop-ch-certain-death" {{#if certainDeath}}checked{{/if}}> <strong>Certain death.</strong> It would definitely, absolutely kill a normal person: no damage roll, straight to 0 HP and Death's Door. Telegraph it very clearly.</span>
        </label>
        <div class="stonetop-cf-total"><i class="fas fa-burst"></i> <strong>{{this.damagePreview}}</strong></div>
        <p class="stonetop-ch-advice">{{this.damageAdvice}}</p>
        {{/if}}

        {{#if is_moves}}
        <div class="stonetop-cf-gear">
          <div class="stonetop-cf-pick-label">GM moves</div>
          {{#each moveRows}}
          <div class="stonetop-cf-gear-row">
            <input type="text" class="stonetop-cf-input stonetop-ch-move-input" data-index="{{this.index}}" value="{{this.text}}" placeholder="{{this.placeholder}}">
            <button type="button" class="stonetop-ch-move-remove stonetop-cf-mini-btn stonetop-cf-mini-btn--danger" data-index="{{this.index}}"><i class="fas fa-times"></i></button>
          </div>
          {{/each}}
          <button type="button" class="stonetop-ch-move-add stonetop-cf-mini-btn"><i class="fas fa-plus"></i> Add GM move</button>
        </div>
        <label class="stonetop-cf-label">Instinct <span class="stonetop-cf-pick-hint">(for dynamic hazards; optional)</span>
          <input type="text" class="stonetop-cf-input" data-field="instinct" value="{{sel.instinct}}" placeholder="to ensnare, to spread, to bury…">
        </label>
        {{/if}}

        {{#if is_doom}}
        <label class="stonetop-cf-label">Advance this&hellip;
          <input type="text" class="stonetop-cf-input" data-field="advanceTrigger" value="{{sel.advanceTrigger}}" placeholder="each time a pillar is struck, or as a GM move…">
        </label>
        <div class="stonetop-cf-gear">
          <div class="stonetop-cf-pick-label">Grim portents <span class="stonetop-cf-pick-hint">(increasingly bad, in order)</span></div>
          {{#each portentRows}}
          <div class="stonetop-cf-gear-row">
            <span class="stonetop-ch-portent-glyph stonetop-glyph stonetop-glyph--circle" aria-hidden="true">○</span>
            <input type="text" class="stonetop-cf-input stonetop-ch-portent-input" data-index="{{this.index}}" value="{{this.text}}" placeholder="pillar cracks and buckles, dirt pours down…">
            <button type="button" class="stonetop-ch-portent-remove stonetop-cf-mini-btn stonetop-cf-mini-btn--danger" data-index="{{this.index}}"><i class="fas fa-times"></i></button>
          </div>
          {{/each}}
          <button type="button" class="stonetop-ch-portent-add stonetop-cf-mini-btn"><i class="fas fa-plus"></i> Add grim portent</button>
        </div>
        <label class="stonetop-cf-label">Impending doom
          <input type="text" class="stonetop-cf-input stonetop-ch-doom-final" value="{{sel.impendingDoom.text}}" placeholder="the ceiling collapses, burying anyone still inside…">
        </label>
        {{/if}}

        {{#if is_playermove}}
        <div class="stonetop-cf-gear">
          {{#each playerMoveRows}}
          <div class="stonetop-ch-pm-row">
            <div class="stonetop-cf-gear-row">
              <input type="text" class="stonetop-cf-input stonetop-ch-pm-label" data-index="{{this.index}}" value="{{this.label}}" placeholder="When you fall from the boughs of the tree…">
              <button type="button" class="stonetop-ch-pm-remove stonetop-cf-mini-btn stonetop-cf-mini-btn--danger" data-index="{{this.index}}"><i class="fas fa-times"></i></button>
            </div>
            <textarea class="stonetop-cf-textarea stonetop-ch-pm-text" data-index="{{this.index}}" rows="3" placeholder="…take 1d10+3 damage (ignores armor, forceful) and roll +CON: on a 10+…">{{this.text}}</textarea>
          </div>
          {{/each}}
          <button type="button" class="stonetop-ch-pm-add stonetop-cf-mini-btn"><i class="fas fa-plus"></i> Add player move</button>
        </div>
        {{/if}}

        {{#if is_review}}
        {{#with preview}}
        <div class="stonetop-cf-preview">
          <div class="stonetop-cf-preview-head">
            <span class="stonetop-cf-preview-name">{{this.name}}</span>
            <span class="stonetop-cf-preview-type">Hazard</span>
          </div>
          <div class="stonetop-cf-preview-stats">
            <span><strong>Damage</strong> {{this.damage}}</span>
          </div>
          {{#if instinct}}<div class="stonetop-cf-preview-line"><strong>Instinct</strong> {{this.instinct}}</div>{{/if}}
          {{#if description}}<div class="stonetop-cf-preview-line stonetop-ch-preview-desc">{{this.description}}</div>{{/if}}
          {{#if gmMoves.length}}<div class="stonetop-cf-preview-line"><strong>GM moves</strong> {{#each gmMoves}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</div>{{/if}}
          {{#if portents.length}}
          <div class="stonetop-cf-preview-line"><strong>Doom track</strong>{{#if advanceTrigger}} <em>(advance {{this.advanceTrigger}})</em>{{/if}} {{#each portents}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}{{#if impendingDoom}}; <strong>doom:</strong> {{this.impendingDoom}}{{/if}}</div>
          {{else}}{{#if impendingDoom}}<div class="stonetop-cf-preview-line"><strong>Impending doom</strong> {{this.impendingDoom}}</div>{{/if}}{{/if}}
          {{#if playerMoves.length}}<div class="stonetop-cf-preview-line"><strong>Player moves</strong> {{#each playerMoves}}{{#if label}}{{this.label}}{{else}}(untitled){{/if}}{{#unless @last}}; {{/unless}}{{/each}}</div>{{/if}}
        </div>
        {{/with}}
        {{/if}}

      </div>

    </div>

  </div>

  <div class="stonetop-guide-nav">
    <button class="stonetop-spring-back" {{#if isFirst}}disabled{{/if}}><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>
    <span class="stonetop-spring-step-label">{{this.stepLabel}}</span>
    {{#if isLast}}
    <button class="stonetop-ch-create stonetop-guide-btn--primary"><i class="fas {{#if isEdit}}fa-check{{else}}fa-triangle-exclamation{{/if}}"></i> {{#if isEdit}}Save hazard{{else}}Create hazard{{/if}}</button>
    {{else}}
    {{!-- Save what's there from any step: a new hazard lands on the GM Toolkit to finish later; an edit is written. --}}
    <span class="stonetop-guide-nav-group">
      <button type="button" class="stonetop-guide-save-for-now"><i class="fas {{#if isEdit}}fa-check{{else}}fa-floppy-disk{{/if}}" aria-hidden="true"></i> {{#if isEdit}}Save{{else}}Save for now{{/if}}</button>
      <button class="stonetop-spring-next">Next<span class="stonetop-nav-arrow"></span></button>
    </span>
    {{/if}}
  </div>

</div>
