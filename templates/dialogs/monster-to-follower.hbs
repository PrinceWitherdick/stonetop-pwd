{{!-- Monster → Follower conversion (Book I, NPCs & Followers, p.475). Compact
      confirm modal; reuses the spring dialog chrome. See dialogs/MonsterToFollowerDialog.js. --}}
<div class="stonetop-spring">

  <div class="stonetop-guide-main">

    <div class="stonetop-guide-banner">
      <i class="fas {{this.bannerIcon}} stonetop-guide-banner-icon"></i>
      <div class="stonetop-guide-banner-info">
        <div class="stonetop-guide-banner-title">{{this.monsterName}} <i class="fas fa-arrow-right stonetop-mf-arrow"></i> {{this.actorName}}'s follower</div>
        <div class="stonetop-guide-banner-sub">Convert a monster to a follower</div>
      </div>
    </div>

    <div class="stonetop-spring-body">
      <p>Keep its stats as-is, but add any <strong>tags</strong> you see fit, choose a <strong>cost</strong>, and it gains a <strong>Loyalty</strong> track (max 3).</p>
    </div>

    <div class="stonetop-cf-controls">

      {{!-- Stats kept from the monster --}}
      <div class="stonetop-mf-stats">
        <span><strong>HP</strong> {{this.hp}}</span>
        <span><strong>Armor</strong> {{this.armor}}</span>
        <span><strong>Damage</strong> {{this.damage}}</span>
      </div>
      {{#if instinct}}<div class="stonetop-cf-preview-line"><strong>Instinct</strong> {{this.instinct}}</div>{{/if}}
      {{#if keptTags.length}}
      <div class="stonetop-mf-kept">
        <span class="stonetop-cf-chosen-label">Kept tags:</span>
        <div class="stonetop-cf-chosen-tags">{{#each keptTags}}<span class="stonetop-cf-preview-tag">{{this}}</span>{{/each}}</div>
      </div>
      {{/if}}
      {{#if moves.length}}
      <div class="stonetop-cf-preview-line"><strong>Moves</strong> {{#each moves}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</div>
      {{/if}}

      {{!-- Add tags --}}
      <div class="stonetop-cf-chosen">
        <span class="stonetop-cf-chosen-label">Add tags:</span>
        {{#if addedTags.length}}
        <div class="stonetop-cf-chosen-tags">
          {{#each addedTags}}
          <button type="button" class="stonetop-cf-chosen-tag stonetop-mf-added-tag" data-tag="{{this}}"><span class="stonetop-chip-text">{{this}}</span> <i class="fas fa-times"></i></button>
          {{/each}}
        </div>
        {{else}}<span class="stonetop-cf-chosen-empty">none</span>{{/if}}
      </div>
      <div class="stonetop-cf-tag-add-row">
        <input type="text" class="stonetop-cf-input stonetop-mf-tag-input" placeholder="add a tag (or comma-separated)…">
        <button type="button" class="stonetop-mf-tag-add stonetop-cf-mini-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      {{!-- Group follower (p.470): a group- or horde-organization monster becomes a
            warband — shared stats, but a roster with per-member HP and the group-fight
            tools. Pre-checked for group/horde monsters. --}}
      <label class="stonetop-cf-label stonetop-mf-group-label">
        <span><input type="checkbox" class="stonetop-mf-group-toggle" {{#if isGroup}}checked{{/if}}> Treat as a group</span>
        {{#if isGroup}}
        <span class="stonetop-mf-group-size-row">of
          <input type="number" class="stonetop-cf-input stonetop-cf-input--num stonetop-mf-group-size" value="{{this.groupSize}}" min="2" max="99"> members
        </span>
        {{/if}}
      </label>

      {{!-- Pronoun --}}
      <label class="stonetop-cf-label stonetop-cf-label--narrow">Pronoun
        <input type="text" class="stonetop-cf-input stonetop-mf-pronoun" value="{{this.pronoun}}" placeholder="she/he/they…" maxlength="12">
      </label>

      {{!-- Cost --}}
      <label class="stonetop-cf-label">Cost
        <input type="text" class="stonetop-cf-input stonetop-mf-cost-input" value="{{this.cost}}" placeholder="what keeps it following your lead…">
      </label>
      <div class="stonetop-cf-chips">
        {{#each costOptions}}
        <button type="button" class="stonetop-cf-chip stonetop-mf-cost-ex{{#if selected}} is-selected{{/if}}" data-value="{{this.value}}">{{this.value}}</button>
        {{/each}}
      </div>

    </div>

  </div>

  <div class="stonetop-guide-nav">
    <button class="stonetop-mf-create stonetop-guide-btn--primary"><i class="fas fa-user-plus"></i> Create follower</button>
    <button class="stonetop-mf-cancel">Cancel</button>
  </div>

</div>
