{{!-- The steading-improvement authoring sheet, laid out as a left-rail stepped sheet
      like the custom-move dialog and Make a Monster: the rail (shared
      .stonetop-guide-toc) switches which group of fields is shown, client-side, so the
      single <form> keeps every value (and every requirement group added so far) as you
      move around. See dialogs/ImprovementBuilderDialog.js. --}}
<form class="stonetop-improvement-builder-form" autocomplete="off">

	<div class="stonetop-guide-split">

		{{!-- Section rail (jump between the field groups; shared journal-style page list). --}}
		<nav class="stonetop-guide-toc" aria-label="Improvement sections">
			<ol class="stonetop-guide-toc-list">
				{{#each sections}}
				<li class="stonetop-guide-toc-item{{#if selected}} is-active{{/if}}">
					<button type="button" class="stonetop-guide-toc-btn stonetop-improvement-builder-tab" data-tab="{{this.key}}"{{#if selected}} aria-current="true"{{/if}}>
						<i class="fas {{this.icon}} stonetop-guide-toc-icon" aria-hidden="true"></i>
						<span class="stonetop-guide-toc-text">{{this.title}}</span>
					</button>
				</li>
				{{/each}}
			</ol>
		</nav>

		<div class="stonetop-guide-main stonetop-improvement-builder-main">

			{{!-- Banner: the active section's icon + title + count (updated in JS on tab
			      switch, so panels never re-render and keep what's been typed). --}}
			<div class="stonetop-guide-banner">
				<i class="fas {{active.icon}} stonetop-guide-banner-icon stonetop-improvement-builder-banner-icon" aria-hidden="true"></i>
				<div class="stonetop-guide-banner-info">
					<div class="stonetop-guide-banner-title stonetop-improvement-builder-banner-title">{{active.title}}</div>
					<div class="stonetop-guide-banner-sub stonetop-improvement-builder-banner-sub">{{active.hint}}</div>
				</div>
				<div class="stonetop-guide-count stonetop-improvement-builder-banner-count">{{active.count}}</div>
			</div>

			{{!-- The improvement: what it is called and what it reads like --}}
			<section class="stonetop-improvement-builder-section" data-tab="improvement"{{#unless (eq activeTab "improvement")}} hidden{{/unless}}>

				{{!-- Copy an improvement that already exists into the form, rather than
				      retyping one of the book's out of the playbook. Fills every panel
				      (see ImprovementBuilderDialog._fillFrom). --}}
				<div class="stonetop-improvement-builder-field stonetop-improvement-builder-startfrom">
					<label for="{{@root.uid}}-stonetop-improvement-source">Start from</label>
					<select id="{{@root.uid}}-stonetop-improvement-source" class="stonetop-improvement-builder-source">
						<option value="">A blank improvement</option>
						{{#each sourceGroups}}
						<optgroup label="{{this.label}}">
							{{#each options}}
							<option value="{{this.value}}">{{this.label}}</option>
							{{/each}}
						</optgroup>
						{{/each}}
					</select>
					<p class="stonetop-improvement-builder-hint">Fills every panel with that improvement's own requirements and effects, ready to rename and change. It replaces what is in the form.</p>
				</div>

				<div class="stonetop-improvement-builder-field">
					<label for="{{@root.uid}}-stonetop-improvement-name">Name</label>
					<input type="text" id="{{@root.uid}}-stonetop-improvement-name" name="name" placeholder="e.g. Roadbuilding" required autofocus>
					{{!-- Said here rather than only in a fading notice: an empty name or one the
					      steading already has. Filled, and pointed at by the field's
					      aria-describedby, by ImprovementBuilderDialog._checkName. --}}
					<p id="{{@root.uid}}-name-error" class="stonetop-improvement-builder-error stonetop-improvement-builder-name-error" aria-live="polite" hidden></p>
				</div>

				<div class="stonetop-improvement-builder-field">
					<label for="{{@root.uid}}-stonetop-improvement-category">Category</label>
					<select id="{{@root.uid}}-stonetop-improvement-category" name="category">
						<option value="">None (always shown)</option>
						{{#each categories}}
						<option value="{{this.key}}">{{this.label}}</option>
						{{/each}}
					</select>
					<p class="stonetop-improvement-builder-hint">Which filter chip it files under on the Improvements tab. An uncategorised improvement is shown whatever the filter.</p>
				</div>

				<div class="stonetop-improvement-builder-field">
					<label for="{{@root.uid}}-stonetop-improvement-flavor">Flavor</label>
					<textarea id="{{@root.uid}}-stonetop-improvement-flavor" name="flavor" rows="2" placeholder="The line in the villagers' own voice, shown under the title. Optional."></textarea>
				</div>
			</section>

			{{!-- Requirements: one group per "requires all of these" / "requires 2 of these"
			      clause, with later groups able to be alternatives to the one above. --}}
			<section class="stonetop-improvement-builder-section" data-tab="requirements"{{#unless (eq activeTab "requirements")}} hidden{{/unless}}>
				<p class="stonetop-improvement-builder-hint">
					Each requirement is one check-off box; a group is one clause. Leave a heading blank and it is
					written for you ("requires all of the following", "requires 2 of the following", "or all of these").
					Set a requirement's <strong>&times;</strong> above 1 and it becomes that many boxes, numbered (1st), (2nd).
				</p>
				<p class="stonetop-improvement-builder-hint stonetop-improvement-builder-emphasis-hint">Wrap a move name in *asterisks* for italics, the way the book prints *Pull Together*.</p>

				<div class="stonetop-improvement-builder-groups"></div>

				<button type="button" class="stonetop-improvement-builder-add-group">
					<i class="fas fa-plus" aria-hidden="true"></i> Add requirement group
				</button>
			</section>

			{{!-- Effect: the prose, then the parts of it the sheet can apply by itself --}}
			<section class="stonetop-improvement-builder-section" data-tab="effect"{{#unless (eq activeTab "effect")}} hidden{{/unless}}>
				<div class="stonetop-improvement-builder-field">
					<label for="{{@root.uid}}-stonetop-improvement-effect">What completing it does</label>
					<textarea id="{{@root.uid}}-stonetop-improvement-effect" name="effect" rows="5" placeholder="The effect as the playbook would print it, including any ongoing rule (&quot;Henceforth, when...&quot;)."></textarea>
					<p class="stonetop-improvement-builder-hint stonetop-improvement-builder-emphasis-hint">Wrap a move name in *asterisks* for italics, the way the book prints *Pull Together*.</p>
				</div>

				<div class="stonetop-improvement-builder-grants">
					<h4 class="stonetop-improvement-builder-grants-title">Applied automatically on completion</h4>
					<p class="stonetop-improvement-builder-hint">
						The mechanical part of the effect, which the sheet performs when the improvement is
						ticked complete and undoes if it is un-ticked. Leave it all blank for an improvement
						whose effect is prose only.
					</p>

					<div class="stonetop-improvement-builder-row">
						{{#each statFields}}
						<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
							<label for="{{@root.uid}}-stonetop-improvement-grant-{{this.key}}">{{this.label}}</label>
							<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-{{this.key}}" name="grant-{{this.key}}" step="1" placeholder="no change">
						</div>
						{{/each}}
					</div>
					<p class="stonetop-improvement-builder-hint">A change, not a total: 1 raises Fortunes by one, -1 lowers it.</p>

					<div class="stonetop-improvement-builder-field">
						<label for="{{@root.uid}}-stonetop-improvement-grant-resources">Add to Resources</label>
						<textarea id="{{@root.uid}}-stonetop-improvement-grant-resources" name="grant-resources" rows="2" placeholder="One per line, e.g. Mill"></textarea>
					</div>

					<div class="stonetop-improvement-builder-field">
						<label for="{{@root.uid}}-stonetop-improvement-grant-fortifications">Add to Fortifications</label>
						<textarea id="{{@root.uid}}-stonetop-improvement-grant-fortifications" name="grant-fortifications" rows="2" placeholder="One per line, e.g. Stone Wall"></textarea>
					</div>

					<div class="stonetop-improvement-builder-field">
						<label for="{{@root.uid}}-stonetop-improvement-grant-remove-fortifications">Clear from Fortifications</label>
						<textarea id="{{@root.uid}}-stonetop-improvement-grant-remove-fortifications" name="grant-remove-fortifications" rows="2" placeholder="One per line, e.g. Palisade (what the new one replaces)"></textarea>
					</div>

					<div class="stonetop-improvement-builder-row">
						<div class="stonetop-improvement-builder-field">
							<label for="{{@root.uid}}-stonetop-improvement-grant-size">Set Size to</label>
							<select id="{{@root.uid}}-stonetop-improvement-grant-size" name="grant-size">
								<option value="">Leave alone</option>
								{{#each sizes}}
								<option value="{{this.value}}">{{this.label}}</option>
								{{/each}}
							</select>
						</div>
						<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
							<label for="{{@root.uid}}-stonetop-improvement-grant-set-population">Set Population to</label>
							<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-set-population" name="grant-set-population" step="1" placeholder="leave alone">
						</div>
					</div>

					<div class="stonetop-improvement-builder-field">
						<label for="{{@root.uid}}-stonetop-improvement-grant-replace-assets">Replace on Assets</label>
						<textarea id="{{@root.uid}}-stonetop-improvement-grant-replace-assets" name="grant-replace-assets" rows="2" placeholder="One per line: the entry it replaces =&gt; the new entry, e.g. draft horses =&gt; A herd of horses"></textarea>
						<p class="stonetop-improvement-builder-hint">The Assets entry whose name contains the left side is swapped for a plain entry named by the right (added when none matches). The book's Herd of Horses keeps its herd tracker to itself.</p>
					</div>

					<div class="stonetop-improvement-builder-field">
						<label for="{{@root.uid}}-stonetop-improvement-grant-mark">Also marks complete</label>
						<textarea id="{{@root.uid}}-stonetop-improvement-grant-mark" name="grant-mark" rows="2" placeholder="One improvement name per line, e.g. Greater Harvest"></textarea>
						<p id="{{@root.uid}}-mark-error" class="stonetop-improvement-builder-error stonetop-improvement-builder-mark-error" aria-live="polite" hidden></p>
					</div>

					<div class="stonetop-improvement-builder-field">
						<label for="{{@root.uid}}-stonetop-improvement-grant-completion-note">Reminder when it is built</label>
						<input type="text" id="{{@root.uid}}-stonetop-improvement-grant-completion-note" name="grant-completion-note" placeholder="no reminder (e.g. Draw it on the map.)">
					</div>
				</div>

				{{!-- The LIVE ("Henceforth") rules: read by the Seasons Change window, the move windows and
				      the holds tray every time, so an edit applies as soon as it is saved. The grant keys
				      are listed in utils/improvement-def.js (LIVE_GRANT_KEYS). --}}
				<div class="stonetop-improvement-builder-grants stonetop-improvement-builder-rules">
					<h4 class="stonetop-improvement-builder-grants-title">Henceforth, while it is built</h4>
					<p class="stonetop-improvement-builder-hint">
						The ongoing rules the sheet applies for you: in the Seasons Change window, in the move
						windows and in the steading's header. Changing them later applies at once.
					</p>

					<fieldset class="stonetop-improvement-builder-fieldset">
						<legend>Surplus it generates when the Seasons Change</legend>
						<div class="stonetop-improvement-builder-checks" role="group" aria-label="Seasons it generates Surplus in">
							{{#each seasons}}
							<label class="stonetop-improvement-builder-check"><input type="checkbox" class="stonetop-check" name="grant-yield-seasons" value="{{this.value}}"> <span>{{this.label}}</span></label>
							{{/each}}
						</div>
						<div class="stonetop-improvement-builder-row">
							<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
								<label for="{{@root.uid}}-stonetop-improvement-grant-yield-surplus">Surplus</label>
								<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-yield-surplus" name="grant-yield-surplus" min="0" step="1" placeholder="none">
							</div>
							<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
								<label for="{{@root.uid}}-stonetop-improvement-grant-yield-min-population">Only while Population is at least</label>
								<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-yield-min-population" name="grant-yield-min-population" step="1" placeholder="any">
							</div>
							<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
								<label for="{{@root.uid}}-stonetop-improvement-grant-yield-min-surplus">Only if Surplus is at least</label>
								<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-yield-min-surplus" name="grant-yield-min-surplus" min="0" step="1" placeholder="any">
							</div>
						</div>
						<div class="stonetop-improvement-builder-checks">
							<label class="stonetop-improvement-builder-check"><input type="checkbox" class="stonetop-check" name="grant-yield-population"> <span>Plus Population (Surplus equal to Population plus the number above)</span></label>
							<label class="stonetop-improvement-builder-check"><input type="checkbox" class="stonetop-check" name="grant-yield-hit"> <span>Only on a 7+ with Fortunes</span></label>
							<label class="stonetop-improvement-builder-check"><input type="checkbox" class="stonetop-check" name="grant-yield-while-met"> <span>Only while its requirements are still met</span></label>
						</div>
					</fieldset>

					<div class="stonetop-improvement-builder-row">
						<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
							<label for="{{@root.uid}}-stonetop-improvement-grant-harvest">Autumn harvest</label>
							<input type="text" id="{{@root.uid}}-stonetop-improvement-grant-harvest" name="grant-harvest" placeholder="no change" aria-describedby="{{@root.uid}}-stonetop-improvement-grant-harvest-hint">
						</div>
						<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
							<label for="{{@root.uid}}-stonetop-improvement-grant-surplus-bonus">Bonus on every Surplus generated</label>
							<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-surplus-bonus" name="grant-surplus-bonus" min="0" step="1" placeholder="no bonus">
						</div>
						<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
							<label for="{{@root.uid}}-stonetop-improvement-grant-winter">Winter: Surplus consumed</label>
							<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-winter" name="grant-winter" step="1" placeholder="no change">
						</div>
						<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
							<label for="{{@root.uid}}-stonetop-improvement-grant-winter-population">Winter: Population counted</label>
							<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-winter-population" name="grant-winter-population" step="1" placeholder="no change">
						</div>
					</div>
					<p class="stonetop-improvement-builder-hint" id="{{@root.uid}}-stonetop-improvement-grant-harvest-hint">Changes, not totals. Harvest: 1, or dice like 1d4. Winter: -1 consumes one less Surplus (the first roll only), and Population -1 counts it one lower.</p>

					<fieldset class="stonetop-improvement-builder-fieldset">
						<legend>Upkeep: pay it, or lose the improvement</legend>
						<div class="stonetop-improvement-builder-checks" role="group" aria-label="Seasons the upkeep is owed in">
							{{#each seasons}}
							<label class="stonetop-improvement-builder-check"><input type="checkbox" class="stonetop-check" name="grant-upkeep-seasons" value="{{this.value}}"> <span>{{this.label}}</span></label>
							{{/each}}
						</div>
						<div class="stonetop-improvement-builder-row">
							<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
								<label for="{{@root.uid}}-stonetop-improvement-grant-upkeep-surplus">Surplus owed</label>
								<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-upkeep-surplus" name="grant-upkeep-surplus" min="0" step="1" placeholder="none">
							</div>
						</div>
					</fieldset>

					<fieldset class="stonetop-improvement-builder-fieldset">
						<legend>Advantage on moves</legend>
						<div class="stonetop-improvement-builder-checks" role="group" aria-label="Moves it gives advantage to">
							{{#each advantageMoves}}
							<label class="stonetop-improvement-builder-check"><input type="checkbox" class="stonetop-check" name="grant-adv-moves" value="{{this}}"> <span>{{this}}</span></label>
							{{/each}}
						</div>
						<div class="stonetop-improvement-builder-field">
							<label for="{{@root.uid}}-stonetop-improvement-grant-adv-ask">Only when</label>
							<input type="text" id="{{@root.uid}}-stonetop-improvement-grant-adv-ask" name="grant-adv-ask" placeholder="always (or e.g. Trading for timber, ivory or wool)">
							<p class="stonetop-improvement-builder-hint">Leave it blank for advantage every time. Filled in, the move's window asks it as a box to tick.</p>
						</div>
					</fieldset>

					<fieldset class="stonetop-improvement-builder-fieldset">
						<legend>While its requirements are not met</legend>
						<div class="stonetop-improvement-builder-row">
							{{#each statFields}}
							<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
								<label for="{{@root.uid}}-stonetop-improvement-grant-lapse-{{this.key}}">{{this.label}}</label>
								<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-lapse-{{this.key}}" name="grant-lapse-{{this.key}}" step="1" placeholder="no change">
							</div>
							{{/each}}
						</div>
					</fieldset>

					<fieldset class="stonetop-improvement-builder-fieldset">
						<legend>As long as a condition holds</legend>
						<div class="stonetop-improvement-builder-field">
							<label for="{{@root.uid}}-stonetop-improvement-grant-condition-text">The condition</label>
							<input type="text" id="{{@root.uid}}-stonetop-improvement-grant-condition-text" name="grant-condition-text" placeholder="none (e.g. Trading aetherium to the outside world)">
							<p class="stonetop-improvement-builder-hint">A box on the built improvement's card. While it is ticked, these apply.</p>
						</div>
						<div class="stonetop-improvement-builder-row">
							{{#each statFields}}
							<div class="stonetop-improvement-builder-field stonetop-improvement-builder-field--num">
								<label for="{{@root.uid}}-stonetop-improvement-grant-condition-{{this.key}}">{{this.label}}</label>
								<input type="number" id="{{@root.uid}}-stonetop-improvement-grant-condition-{{this.key}}" name="grant-condition-{{this.key}}" step="1" placeholder="no change">
							</div>
							{{/each}}
						</div>
					</fieldset>
				</div>
			</section>

			{{!-- Preview: the card as the Improvements tab will draw it, rebuilt from the
			      form every time this panel is opened (and while it is open, as you type).
			      Same class names as the real card, so the same CSS paints it.
			      See utils/improvement-preview.js. --}}
			<section class="stonetop-improvement-builder-section" data-tab="preview"{{#unless (eq activeTab "preview")}} hidden{{/unless}}>
				<p class="stonetop-improvement-builder-hint">
					How the improvement will read on Stonetop's Improvements tab. The boxes here are inert.
				</p>
				{{!-- Soft warnings the card cannot show by itself (no requirements at all, blank
				      rows the save will leave out). Never blocks Save. Filled by
				      _renderPreview from utils/improvement-preview.js#improvementPreviewNotes. --}}
				<div class="stonetop-improvement-builder-preview-notes" aria-live="polite" hidden></div>
				<div class="stonetop-improvement-builder-preview" aria-live="polite"></div>
			</section>

		</div>

	</div>

	{{!-- Pinned footer: the save/cancel pair at one end, the rail's Back/Next at the
	      other (shared .stonetop-guide-nav row + button styling). --}}
	<footer class="stonetop-guide-nav stonetop-improvement-builder-nav">
		<span class="stonetop-improvement-builder-nav-btns">
			<button type="button" class="stonetop-improvement-builder-save stonetop-guide-btn--primary">
				<i class="fas fa-check" aria-hidden="true"></i> {{this.submitLabel}}
			</button>
			<button type="button" class="stonetop-improvement-builder-cancel">Cancel</button>
		</span>
		<span class="stonetop-improvement-builder-nav-btns">
			<button type="button" class="stonetop-improvement-builder-back"{{#if atFirst}} disabled{{/if}}><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>
			<button type="button" class="stonetop-improvement-builder-next"{{#if atLast}} disabled{{/if}}>Next<span class="stonetop-nav-arrow"></span></button>
		</span>
	</footer>

	{{!-- The empty requirement group, cloned by JS for each "Add requirement group" (and
	      once on open). Kept here rather than built as a string in the dialog so all of
	      this window's markup is in one file. --}}
	<template class="stonetop-improvement-builder-group-tpl">
		<div class="stonetop-improvement-builder-group" role="group" aria-label="Requirement group">
			<div class="stonetop-improvement-builder-group-head">
				<span class="stonetop-improvement-builder-group-num">Group 1</span>
				<span class="stonetop-improvement-builder-group-btns">
					<button type="button" class="stonetop-improvement-builder-group-up" data-tooltip="Move this group up" data-tooltip-direction="UP" aria-label="Move group up"><i class="fas fa-chevron-up" aria-hidden="true"></i></button>
					<button type="button" class="stonetop-improvement-builder-group-down" data-tooltip="Move this group down" data-tooltip-direction="UP" aria-label="Move group down"><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
					<button type="button" class="stonetop-improvement-builder-group-remove" data-tooltip="Remove this group" data-tooltip-direction="UP" aria-label="Remove group">
						<i class="fas fa-trash" aria-hidden="true"></i>
					</button>
				</span>
			</div>

			<div class="stonetop-improvement-builder-field">
				{{!-- `for` and the field's id are set per group by _labelGroup, which numbers
				      them; a clone of a fixed id would point every label at the first group. --}}
				<label class="stonetop-improvement-builder-group-heading-label">Heading</label>
				{{!-- The placeholder is kept in step with the group's own rules by
				      _syncGroupHeading, so "leave it blank and it is written for you"
				      shows you what it would write. --}}
				<input type="text" class="stonetop-improvement-builder-group-heading" placeholder="Requires all of the following:">
			</div>

			<div class="stonetop-improvement-builder-group-rules">
				<label class="stonetop-improvement-builder-group-rule">
					<span>Must tick</span>
					<select class="stonetop-improvement-builder-group-mode">
						<option value="all">all of them</option>
						<option value="min">at least</option>
					</select>
				</label>
				<span class="stonetop-improvement-builder-group-min-wrap is-hidden">
					<input type="number" class="stonetop-improvement-builder-group-min" min="1" step="1" value="1">
					<span>of them</span>
				</span>
				<label class="stonetop-improvement-builder-group-alt is-hidden">
					<input type="checkbox" class="stonetop-check">
					<span>Alternative to the group above (either/or)</span>
				</label>
			</div>

			<div class="stonetop-improvement-builder-field">
				<label>Requirements</label>
				<div class="stonetop-improvement-builder-rows" role="group" aria-label="Requirements"></div>
				<button type="button" class="stonetop-improvement-builder-add-row">
					<i class="fas fa-plus" aria-hidden="true"></i> Add requirement
				</button>
			</div>
		</div>
	</template>

	{{!-- One requirement: the text that goes beside the checkbox, how many boxes it makes,
	      and the controls to move or drop it. Cloned per row by _addRow. --}}
	<template class="stonetop-improvement-builder-row-tpl">
		<div class="stonetop-improvement-builder-req">
			<span class="stonetop-improvement-builder-req-box" aria-hidden="true"></span>
			{{!-- Labelled, not placeholder-labelled: a placeholder is not an accessible name,
			      and it is gone the moment there is anything in the field. --}}
			<input type="text" class="stonetop-improvement-builder-req-text" aria-label="Requirement" placeholder="What has to be true or done">
			<label class="stonetop-improvement-builder-req-repeat" data-tooltip="How many boxes this makes. Above 1 they are numbered (1st), (2nd)…" data-tooltip-direction="UP">
				<span aria-hidden="true">&times;</span>
				{{!-- `max` comes from MAX_REQUIREMENT_REPEAT, the same ceiling itemsFromRows
				      clamps to, so the control and the rule cannot drift apart. --}}
				<input type="number" class="stonetop-improvement-builder-req-count" min="1" max="{{this.maxRepeat}}" step="1" value="1" aria-label="How many boxes this requirement makes">
			</label>
			<span class="stonetop-improvement-builder-req-btns">
				<button type="button" class="stonetop-improvement-builder-req-up" data-tooltip="Move up" data-tooltip-direction="UP" aria-label="Move requirement up"><i class="fas fa-chevron-up" aria-hidden="true"></i></button>
				<button type="button" class="stonetop-improvement-builder-req-down" data-tooltip="Move down" data-tooltip-direction="UP" aria-label="Move requirement down"><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
				<button type="button" class="stonetop-improvement-builder-req-remove" data-tooltip="Remove this requirement" data-tooltip-direction="UP" aria-label="Remove requirement"><i class="fas fa-trash" aria-hidden="true"></i></button>
			</span>
		</div>
	</template>
</form>
