<form class="stonetop-custom-move-form stonetop-love-letter-form" autocomplete="off">
	{{#if drafts.length}}
	{{! Letters saved as drafts and not sent yet: open one to carry on writing it. }}
	<div class="stonetop-custom-move-field stonetop-love-letter-drafts">
		<label>{{localize "stonetop.character.moves.loveLetter.draftsLabel"}}</label>
		<ul class="stonetop-love-letter-drafts-list">
			{{#each drafts}}
			<li><button type="button" class="stonetop-custom-move-cancel stonetop-love-letter-draft-open" data-actor-id="{{this.actorId}}" data-item-id="{{this.itemId}}">
				<i class="fas fa-envelope" aria-hidden="true"></i> {{localize "stonetop.character.moves.loveLetter.draftRow" name=name recipient=recipient}}
			</button></li>
			{{/each}}
		</ul>
	</div>
	{{/if}}

	{{#if isEdit}}
	<div class="stonetop-custom-move-field">
		<label>{{localize "stonetop.character.moves.loveLetter.recipientLabel"}}</label>
		<p class="stonetop-love-letter-recipient-fixed">{{this.recipientName}}</p>
	</div>
	{{else}}
	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-recipient">{{localize "stonetop.character.moves.loveLetter.recipientLabel"}}</label>
		<select id="stonetop-love-letter-recipient" name="recipient" required>
			{{#each recipients}}
			<option value="{{this.id}}" {{#if selected}}selected{{/if}}>{{this.name}}</option>
			{{/each}}
		</select>
	</div>
	{{/if}}

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-name">{{localize "stonetop.character.moves.loveLetter.nameLabel"}}</label>
		<input type="text" id="stonetop-love-letter-name" name="name" value="{{this.name}}"
		       placeholder="{{localize 'stonetop.character.moves.loveLetter.namePlaceholder'}}" required>
	</div>

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-desc">{{localize "stonetop.character.moves.loveLetter.descriptionLabel"}}</label>
		<textarea id="stonetop-love-letter-desc" name="description" rows="7"
		          placeholder="{{localize 'stonetop.character.moves.loveLetter.descriptionPlaceholder'}}">{{this.description}}</textarea>
	</div>

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-roll">{{localize "stonetop.character.moves.loveLetter.rollLabel"}}</label>
		<select id="stonetop-love-letter-roll" name="rollType">
			{{#each rollOptions}}
			<option value="{{this.value}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>
			{{/each}}
		</select>
		<p class="stonetop-custom-move-hint">{{localize "stonetop.character.moves.loveLetter.rollHint"}}</p>
	</div>

	<div class="stonetop-custom-move-results stonetop-love-letter-results{{#unless hasRoll}} is-hidden{{/unless}}"
	     data-result-style="{{this.resultStyle}}">
		<div class="stonetop-love-letter-results-head">
			<h4 class="stonetop-custom-move-results-title">{{localize "stonetop.character.moves.loveLetter.resultsTitle"}}</h4>
			<div class="stonetop-segmented-picker stonetop-love-letter-style-picker" role="radiogroup"
			     aria-label="{{localize 'stonetop.character.moves.loveLetter.stylePickerLabel'}}">
				<label class="stonetop-segmented-picker-option stonetop-love-letter-style-option">
					<input type="radio" name="resultStyle" value="prose" {{#if (eq resultStyle "prose")}}checked{{/if}}>
					<span>{{localize "stonetop.character.moves.loveLetter.styleProse"}}</span>
				</label>
				<label class="stonetop-segmented-picker-option stonetop-love-letter-style-option">
					<input type="radio" name="resultStyle" value="list" {{#if (eq resultStyle "list")}}checked{{/if}}>
					<span>{{localize "stonetop.character.moves.loveLetter.styleList"}}</span>
				</label>
			</div>
		</div>

		{{! Style A: freeform prose for each of the 10+/7-9/6- tiers. }}
		<div class="stonetop-love-letter-panel stonetop-love-letter-panel--prose">
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-success">{{localize "stonetop.character.moves.custom.success"}}</label>
				<textarea id="stonetop-love-letter-success" name="success" rows="2">{{results.success}}</textarea>
			</div>
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-partial">{{localize "stonetop.character.moves.custom.partial"}}</label>
				<textarea id="stonetop-love-letter-partial" name="partial" rows="2">{{results.partial}}</textarea>
			</div>
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-failure">{{localize "stonetop.character.moves.custom.failure"}}</label>
				<textarea id="stonetop-love-letter-failure" name="failure" rows="2">{{results.failure}}</textarea>
			</div>
		</div>

		{{! Style B: one shared list plus how many the player picks on each result. }}
		<div class="stonetop-love-letter-panel stonetop-love-letter-panel--list">
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-options">{{localize "stonetop.character.moves.loveLetter.optionsLabel"}}</label>
				<textarea id="stonetop-love-letter-options" name="options" rows="4"
				          placeholder="{{localize 'stonetop.character.moves.loveLetter.optionsPlaceholder'}}">{{this.options}}</textarea>
				<p class="stonetop-custom-move-hint">{{localize "stonetop.character.moves.loveLetter.optionsHint"}}</p>
			</div>
			<div class="stonetop-custom-move-field stonetop-love-letter-picks">
				<label>{{localize "stonetop.character.moves.loveLetter.pickCountLabel"}}</label>
				<div class="stonetop-love-letter-picks-row">
					<label>{{localize "stonetop.character.moves.custom.success"}}
						<input type="number" name="pickSuccess" min="0" max="20" value="{{results.pickSuccess}}"></label>
					<label>{{localize "stonetop.character.moves.custom.partial"}}
						<input type="number" name="pickPartial" min="0" max="20" value="{{results.pickPartial}}"></label>
					<label>{{localize "stonetop.character.moves.custom.failure"}}
						<input type="number" name="pickFailure" min="0" max="20" value="{{results.pickFailure}}"></label>
				</div>
				<p class="stonetop-custom-move-hint">{{localize "stonetop.character.moves.loveLetter.pickCountHint"}}</p>
			</div>
			{{! Optional words to go with each result's picks ("and Owain hears of it"). }}
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-list-success">{{localize "stonetop.character.moves.custom.success"}} {{localize "stonetop.character.moves.loveLetter.listTextSuffix"}}</label>
				<textarea id="stonetop-love-letter-list-success" name="listSuccess" rows="2">{{results.success}}</textarea>
			</div>
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-list-partial">{{localize "stonetop.character.moves.custom.partial"}} {{localize "stonetop.character.moves.loveLetter.listTextSuffix"}}</label>
				<textarea id="stonetop-love-letter-list-partial" name="listPartial" rows="2">{{results.partial}}</textarea>
			</div>
			<div class="stonetop-custom-move-field">
				<label for="stonetop-love-letter-list-failure">{{localize "stonetop.character.moves.custom.failure"}} {{localize "stonetop.character.moves.loveLetter.listTextSuffix"}}</label>
				<textarea id="stonetop-love-letter-list-failure" name="listFailure" rows="2">{{results.failure}}</textarea>
			</div>
		</div>

		{{! A miss marks XP regardless of which style the letter uses. }}
		<label class="stonetop-love-letter-markxp">
			<input type="checkbox" class="stonetop-check" name="markXp" {{#if markXp}}checked{{/if}}>
			{{localize "stonetop.character.moves.loveLetter.markXp"}}
		</label>
	</div>

	<div class="stonetop-custom-move-field">
		<label for="stonetop-love-letter-signed">{{localize "stonetop.character.moves.loveLetter.signedLabel"}}</label>
		<input type="text" id="stonetop-love-letter-signed" name="signed" value="{{this.signed}}"
		       placeholder="{{localize 'stonetop.character.moves.loveLetter.signedPlaceholder'}}">
	</div>

	{{#if isDraft}}<p class="stonetop-custom-move-hint">{{localize "stonetop.character.moves.loveLetter.draftHint"}}</p>{{/if}}
	<div class="stonetop-custom-move-actions">
		<button type="button" class="stonetop-custom-move-save stonetop-love-letter-save">
			<i class="fas fa-feather" aria-hidden="true"></i> {{#if canDraft}}{{localize "stonetop.character.moves.loveLetter.save"}}{{else}}{{localize "stonetop.character.moves.loveLetter.saveChanges"}}{{/if}}
		</button>
		{{#if canDraft}}
		<button type="button" class="stonetop-custom-move-cancel stonetop-love-letter-draft">
			<i class="fas fa-floppy-disk" aria-hidden="true"></i> {{localize "stonetop.character.moves.loveLetter.saveDraft"}}
		</button>
		{{/if}}
		<button type="button" class="stonetop-custom-move-cancel stonetop-love-letter-cancel">{{localize "Cancel"}}</button>
	</div>
</form>
