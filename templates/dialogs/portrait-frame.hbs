{{!-- ONE top-level element: AppV1 hands activateListeners a jQuery of the template's root nodes,
      and html[0] is only the first of them, so a later sibling would never get its listeners. --}}
<div class="stonetop-portrait-frame-root">
	<div class="stonetop-frame-body">
		{{!-- role="application" so a screen reader hands the arrow keys to the stage rather than
		      consuming them for its own navigation; the live readout below is the label. --}}
		<div class="stonetop-frame-stage" role="application" tabindex="0" aria-label="">
			<img class="stonetop-frame-stage-img" src="{{this.stageSrc}}" data-fallback="{{this.fallbackSrc}}" alt="">
			<div class="stonetop-frame-layer"></div>
		</div>
		<div class="stonetop-frame-rail">
			<p class="stonetop-frame-hint">Drag inside the square to move it, a corner to resize, or
				anywhere outside to draw a new one. Arrow keys nudge it, Shift for bigger steps, and
				+ or &minus; resize.</p>
			{{!-- The three sizes this frame is actually used at, driven by the same function the
			      sheets use. If the geometry is wrong it is wrong here first, at 75px. --}}
			<div class="stonetop-frame-previews" aria-hidden="true">
				<span class="stonetop-frame-preview stonetop-frame-preview--75"><img alt=""></span>
				<span class="stonetop-frame-preview stonetop-frame-preview--26"><img alt=""></span>
				<span class="stonetop-frame-preview stonetop-frame-preview--22"><img alt=""></span>
			</div>
			<p class="stonetop-frame-sizes">Follower card, relationships, roster</p>
			<p class="stonetop-frame-readout" aria-live="polite"></p>
			<p class="stonetop-frame-error" hidden></p>
			{{!-- Only with Tokenizer installed and an ACTOR being framed (showTokenizerNote), because
			      it is only then that both routes are on offer and telling them apart is a question
			      anybody has. Without the module this paragraph would introduce a tool the reader
			      cannot see and has no way to act on. --}}
			{{#if showTokenizerNote}}
			<p class="stonetop-frame-note">
				<i class="fas fa-circle-info" aria-hidden="true"></i>
				<span><strong>Not Tokenizer.</strong> This square is the face the sheets, the steading
					roster and the relationship rows show. Tokenizer makes the map token, with its
					border, mask and tints. Saving also updates the token if it is still just the
					portrait. A token you made in Tokenizer is never changed.</span>
			</p>
			{{/if}}
		</div>
	</div>
	<footer class="stonetop-frame-footer">
		<button type="button" class="stonetop-frame-save"><i class="fas fa-check"></i> Save frame</button>
		<button type="button" class="stonetop-frame-suggest"><i class="fas fa-wand-magic-sparkles"></i> Suggest</button>
		{{!-- No Tokenizer button here. It is a pip beside the crop pip on the sheet header instead
		      (templates/actor/partials/portrait-frame-pip.hbs): the two jobs are siblings, not
		      steps — this dialog crops the face for the sheet, Tokenizer makes the pog for the
		      map — so neither belongs inside the other. --}}
	</footer>
</div>
