<div class="deaths-door-dialog-content">

	{{! The move heads every step of its own walkthrough; "Refuse to Go" and the insert's own
	    questions are past it, and bring their own headings. }}
	{{#unless (or isFate isChoices)}}
	<h2 class="deaths-door-move-name">{{move.name}}</h2>
	<p class="deaths-door-intro deaths-door-move-trigger">{{{move.trigger}}}</p>
	{{/unless}}

	{{#if isRoll}}
	<div class="deaths-door-step deaths-door-step--roll">
		{{! One <span> around the whole run: .deaths-door-note is a flex row, and bare inline
		    text beside the icon would break into an anonymous item per run. }}
		{{!-- Every string on this window is in languages/en.json under stonetop.specialMoves.deathsDoor. One that
		      carries markup is emitted raw (triple braces), so whatever rides into it (a name) is escaped on the
		      way in with escapeHtml. --}}
		<p class="deaths-door-note">
			<i class="fas fa-feather"></i>
			<span>{{localize "stonetop.specialMoves.deathsDoor.roll.describe"}}</span>
		</p>

		{{#if hasStatChoice}}
		{{! The Heavy's Hard to Kill: "you can roll +CON or +nothing (your choice)". The move's
		    name and its own words both come from the owned Item, so a player who is suddenly
		    offered a stat can see which move is giving it to them and read why. }}
		<div class="deaths-door-roll-option">
			<span class="deaths-door-roll-option-label">{{#if statChoiceMove}}{{localize "stonetop.specialMoves.deathsDoor.roll.rollWithMove" move=statChoiceMove}}{{else}}{{localize "stonetop.specialMoves.deathsDoor.roll.rollWith"}}{{/if}}</span>
			<div class="deaths-door-stat-choices">
				{{#each statChoices}}
				{{! The label wraps the radio so the text is a hit target too. No `is-checked`
				    mirror class: the radio's own dot is the state, and the dialog doesn't
				    re-render on change, so a stamped class would go stale on the first click. }}
				<label class="deaths-door-stat-choice-label">
					<input type="radio" class="deaths-door-stat-choice" name="deaths-door-stat"
					       value="{{stat}}" {{#if selected}}checked{{/if}}>
					<span>{{label}}</span>
				</label>
				{{/each}}
			</div>
			{{#if statChoiceMoveDescription}}
			{{! Raw: this is the move's own stored HTML, the same string its card and the playbook
			    reference print. }}
			<div class="deaths-door-roll-option-move">{{{statChoiceMoveDescription}}}</div>
			{{/if}}
		</div>
		{{/if}}

		{{#if unstoppableMarks}}
		<p class="deaths-door-penalty-note">
			<i class="fas fa-triangle-exclamation"></i>
			{{#if (eq unstoppableMarks 1)}}{{{localize "stonetop.specialMoves.deathsDoor.roll.unstoppableOne" penalty=penalty count=unstoppableMarks}}}{{else}}{{{localize "stonetop.specialMoves.deathsDoor.roll.unstoppableMany" penalty=penalty count=unstoppableMarks}}}{{/if}}
		</p>
		{{/if}}

		{{! The Would-Be Hero's two bends. Destined moves whatever the dice land on up a step; Never
		    Gonna Keep Me Down skips the dice once a session (its button is in the footer, beside the
		    roll), and says so when that use is already spent. }}
		{{#if tierShift}}
		<p class="deaths-door-note">
			<i class="fas fa-star"></i>
			<span>{{{localize "stonetop.specialMoves.deathsDoor.roll.destined" name=(escapeHtml tierShift)}}}</span>
		</p>
		{{/if}}
		{{#if skipRollMove}}
		<p class="deaths-door-note">
			<i class="fas fa-shield-heart"></i>
			<span>{{{localize "stonetop.specialMoves.deathsDoor.roll.neverGonna" name=(escapeHtml skipRollMove)}}}</span>
		</p>
		{{else if neverGonnaUsed}}
		<p class="deaths-door-note">
			<i class="fas fa-shield-heart"></i>
			<span>{{{localize "stonetop.specialMoves.deathsDoor.roll.neverGonnaUsed" name=(escapeHtml neverGonnaName)}}}</span>
		</p>
		{{/if}}

		{{! Stakes first, then the roll — which is in the footer with "Not yet", the one place a
		    dialog's actions live. }}
		<div class="deaths-door-outcomes">
			<p class="deaths-door-outcomes-label">{{localize "stonetop.specialMoves.deathsDoor.roll.outcomesLabel"}}</p>
			{{> "stonetop.deaths-door-outcomes" tiers=tiers}}
		</div>

		<p class="deaths-door-note">
			<i class="fas fa-hourglass-half"></i>
			<span>{{localize "stonetop.specialMoves.deathsDoor.roll.noRush"}}</span>
		</p>
	</div>
	{{/if}}

	{{! Another owner's roll is on the table (DeathsDoorDialog#_watchData): no dice here, only theirs, followed
	    until the tier lands. Taking it over is offered only once they have left the game or walked away from it. }}
	{{#if isWatching}}
	<div class="deaths-door-step deaths-door-step--watching">
		<p class="deaths-door-result-banner">{{{localize "stonetop.specialMoves.deathsDoor.watch.rolling" name=(escapeHtml watch.userName) actor=(escapeHtml watch.actorName)}}}</p>
		{{#if watch.rolled}}
		<p class="deaths-door-result-banner">{{{localize "stonetop.specialMoves.deathsDoor.watch.rolled" total=(escapeHtml watch.total)}}}</p>
		{{#if watch.notes}}
		<p class="deaths-door-result-banner">{{watch.notes}}</p>
		{{/if}}
		{{else}}
		<p class="deaths-door-note">
			<i class="fas fa-dice"></i>
			<span>{{localize "stonetop.specialMoves.deathsDoor.watch.inTheAir"}}</span>
		</p>
		{{/if}}

		<div class="deaths-door-outcomes">
			{{> "stonetop.deaths-door-outcomes" tiers=tiers}}
		</div>

		{{#if watch.canTakeOver}}
		<p class="deaths-door-note">
			<i class="fas fa-user-clock"></i>
			<span>{{watch.whyTakeOver}} {{#if watch.takeOverAccepts}}{{localize "stonetop.specialMoves.deathsDoor.watch.takeOverAccepts"}}{{else}}{{localize "stonetop.specialMoves.deathsDoor.watch.takeOverRolls"}}{{/if}}</span>
		</p>
		{{else}}
		<p class="deaths-door-note">
			<i class="fas fa-hourglass-half"></i>
			<span>{{localize "stonetop.specialMoves.deathsDoor.watch.follows"}}</span>
		</p>
		{{/if}}
	</div>
	{{/if}}

	{{#if isResult}}
	<div class="deaths-door-step deaths-door-step--result">
		{{#if rolledTotal}}
		<p class="deaths-door-result-banner">{{#if rolledBy}}{{{localize "stonetop.specialMoves.deathsDoor.result.rolledBy" name=(escapeHtml rolledBy) total=(escapeHtml rolledTotal)}}}{{else}}{{{localize "stonetop.specialMoves.deathsDoor.result.youRolled" total=(escapeHtml rolledTotal)}}}{{/if}}</p>
		{{/if}}
		{{#if tierNote}}
		<p class="deaths-door-result-banner">{{tierNote}}</p>
		{{/if}}

		{{! The same ladder the roll step previewed, with the tier that landed picked out, so the
		    result is read against what else was on the table. }}
		<div class="deaths-door-outcomes">
			{{> "stonetop.deaths-door-outcomes" tiers=tiers}}
		</div>

		{{! Burn Brightly or giving it your all could still move the tier, so nothing has landed on the
		    sheet yet: the footer asks (DeathsDoorDialog's class header). }}
		{{#if boostsPending}}
		<div class="deaths-door-actions">
			<p class="deaths-door-roll-option-hint">{{localize "stonetop.specialMoves.deathsDoor.result.notLanded"}}
				{{#if canBurnBrightly}}{{{localize "stonetop.specialMoves.deathsDoor.result.burnOffer" cost=burnBrightlyCost}}}{{/if}}
				{{#if canGiveItAll}}{{{localize "stonetop.specialMoves.deathsDoor.result.giveAllOffer"}}}{{/if}}
				{{#if canPlusOne}}{{{localize "stonetop.specialMoves.deathsDoor.result.plusOnesOffer"}}}{{/if}}
				{{localize "stonetop.specialMoves.deathsDoor.result.orAccept"}}</p>
			{{! A private roll taken over, with no GM connected to change its card (DeathsDoorDialog#_boostOffers). }}
			{{#if privateBoostsNote}}
			<p class="deaths-door-note">
				<i class="fas fa-user-shield"></i>
				<span>{{privateBoostsNote}}</span>
			</p>
			{{/if}}
		</div>
		{{/if}}

		{{#if isStrong}}
		<div class="deaths-door-actions">
			{{#if restored}}
			<p class="deaths-door-applied"><i class="fas fa-check"></i> {{{localize "stonetop.specialMoves.deathsDoor.result.restored"}}}</p>
			{{/if}}

			{{! The mark is already a wound on the sheet by the time this renders (the tier seeds it),
			    so there is no "record" button and no un-recorded state: this is the field where the
			    player says what it was, and it saves itself as they leave it. Theirs to say, so a
			    window that only watched the roll (`spectator`) has no field. }}
			{{#if spectator}}
			<p class="deaths-door-roll-option-hint">{{{localize "stonetop.specialMoves.deathsDoor.mark.spectator" name=(escapeHtml rolledBy)}}}</p>
			{{else}}
			<div class="deaths-door-mark">
				<p class="deaths-door-mark-label">{{localize "stonetop.specialMoves.deathsDoor.mark.label"}}</p>
				<div class="deaths-door-mark-chips">
					{{#each markChips}}
					<button type="button" class="deaths-door-mark-chip" data-mark="{{this}}">{{this}}</button>
					{{/each}}
				</div>
				<div class="deaths-door-mark-row">
					<input type="text" class="deaths-door-mark-input" value="{{markText}}" placeholder="{{localize "stonetop.specialMoves.deathsDoor.mark.inputPlaceholder"}}">
				</div>
				{{#if markSeeded}}
				<p class="deaths-door-mark-done">
					<i class="fas fa-check"></i>
					{{#if markText}}{{localize "stonetop.specialMoves.deathsDoor.mark.recorded"}}
					{{else}}{{localize "stonetop.specialMoves.deathsDoor.mark.seeded"}}{{/if}}
				</p>
				{{/if}}
			</div>
			{{/if}}
		</div>
		{{/if}}

		{{#if isWeak}}
		<div class="deaths-door-actions">
			{{#if outOfAction}}
			<p class="deaths-door-applied">
				<i class="fas fa-check"></i> {{localize "stonetop.specialMoves.deathsDoor.result.outOfAction"}}
			</p>
			{{/if}}

			{{#if hardToKill}}
			{{! Heavy only: the one route back to 1 HP on a weak hit. The roller's to take, so a window
			    that only watched the roll (`spectator`) doesn't offer it a second time. }}
			{{#unless spectator}}
			<div class="deaths-door-debility-trade">
				{{#if debilityTraded}}
				<p class="deaths-door-applied"><i class="fas fa-check"></i> {{{localize "stonetop.specialMoves.deathsDoor.result.debilityTraded"}}}</p>
				{{else if debilityChoices.length}}
				<p class="deaths-door-mark-label">{{{localize "stonetop.specialMoves.deathsDoor.result.debilityAsk"}}}</p>
				<div class="deaths-door-debility-choices">
					{{#each debilityChoices}}
					<button type="button" class="deaths-door-debility-btn" data-debility="{{key}}" title="{{description}}">
						{{name}}
					</button>
					{{/each}}
				</div>
				{{else}}
				<p class="deaths-door-roll-option-hint">
					{{{localize "stonetop.specialMoves.deathsDoor.result.debilityNone"}}}
				</p>
				{{/if}}
			</div>
			{{/unless}}
			{{/if}}
		</div>
		{{/if}}

		{{#if isMiss}}
		<div class="deaths-door-actions">
			{{#if spectator}}
			{{! Only the one fate, chosen once: it waits in the roller's window. Reopened from the sheet once this
			    one is closed, the window offers it here too, for a player who has gone. }}
			<p class="deaths-door-roll-option-hint">{{{localize "stonetop.specialMoves.deathsDoor.result.fateSpectator" name=(escapeHtml rolledBy)}}}</p>
			{{else if fateApplied}}
			<p class="deaths-door-applied"><i class="fas fa-check"></i> {{localize "stonetop.specialMoves.deathsDoor.result.fateRecorded"}}</p>
			{{else}}
			<div class="deaths-door-fates">
				{{#each fates}}
				<button type="button" class="deaths-door-fate-btn" data-fate="{{key}}">
					<span class="deaths-door-fate-label">{{label}}</span>
					<span class="deaths-door-fate-hint">{{hint}}</span>
				</button>
				{{/each}}
			</div>
			{{/if}}
		</div>
		{{/if}}
	</div>
	{{/if}}

	{{#if isFate}}
	<div class="deaths-door-step deaths-door-step--fate">
		<h2 class="deaths-door-move-name">{{localize "stonetop.specialMoves.deathsDoor.fate.title"}}</h2>
		<p class="deaths-door-intro deaths-door-move-trigger">
			{{localize "stonetop.specialMoves.deathsDoor.fate.intro"}}
		</p>
		<div class="deaths-door-fates">
			{{#each refusalInserts}}
			<button type="button" class="deaths-door-insert-btn" data-slug="{{slug}}">
				<span class="deaths-door-fate-label">{{name}}</span>
				<span class="deaths-door-fate-hint">{{hint}}</span>
			</button>
			{{/each}}
		</div>
	</div>
	{{/if}}

	{{! The insert is theirs; this is what it asks of them. Nothing here is compulsory — the answers
	    live on the sheet and can be changed there — so Done is always live, however much is still
	    outstanding.

	    Laid out as the shared left-rail sheet (the same .stonetop-guide-* chrome as the
	    first-session guide): one question on screen at a time, with the rail carrying the rest and
	    marking off what has been answered. Stacked, the four ran to a window taller than the
	    screen, and a player scrolling past three lists of the book's prose to reach the fourth had
	    no way of telling how much of it was still asking something of them. }}
	{{#if isChoices}}
	<div class="deaths-door-step deaths-door-step--choices">
		<div class="deaths-door-choices-head">
			<h2 class="deaths-door-move-name">{{insertName}}</h2>
			{{! Told per fate — a Thrall didn't refuse anything, they called something up. }}
			<p class="deaths-door-intro">{{choicesIntro}}</p>
		</div>

		<div class="stonetop-guide-split">
			{{! The rail. One entry per question, ticked as each is settled, so what is left to do is
			    read down the margin instead of scrolled for. }}
			<nav class="stonetop-guide-toc" aria-label="{{localize "stonetop.specialMoves.deathsDoor.choices.railLabel" name=insertName}}">
				<ol class="stonetop-guide-toc-list">
					{{#each choiceTabs}}
					<li class="stonetop-guide-toc-item{{#if isActive}} is-active{{/if}}{{#if done}} is-answered{{/if}}">
						<button type="button" class="stonetop-guide-toc-btn deaths-door-choice-tab"
						        data-choice-step="{{key}}"{{#if isActive}} aria-current="true"{{/if}}>
							<i class="fas {{icon}} stonetop-guide-toc-icon"></i>
							<span class="stonetop-guide-toc-text">{{label}}</span>
							{{#if done}}<i class="fas fa-check deaths-door-choice-tab-done" aria-label="{{localize "stonetop.specialMoves.deathsDoor.choices.answered"}}"></i>{{/if}}
						</button>
					</li>
					{{/each}}
				</ol>
			</nav>

			<div class="stonetop-guide-main deaths-door-choices-main">
				{{> "stonetop.post-death-choices" choices=choices}}
				{{! This used to name the button that reopened these questions. There is no such button
				    any more — the Post-Death tab prints the insert's own state — so it points at the
				    tab, and at edit mode, which is now the way to change an answer afterwards. }}
				<p class="deaths-door-note">
					<i class="fas fa-hourglass-half"></i>
					<span>{{localize "stonetop.specialMoves.deathsDoor.choices.noRush"}}</span>
				</p>
			</div>
		</div>
	</div>
	{{/if}}

</div>

<div class="deaths-door-dialog-buttons">
	{{#if isWatching}}
	{{! Taking over names what it does: accept the roll already made, or roll one that never was. It is the
	    affirmative, so it takes the left (Foundry's order), and Close keeps the right. }}
	{{#if watch.canTakeOver}}
	<button class="deaths-door-take-over-btn is-primary" type="button">
		<i class="fas fa-hand"></i>
		<span>{{#if watch.takeOverAccepts}}{{localize "stonetop.specialMoves.deathsDoor.buttons.takeOverAccept"}}{{else}}{{localize "stonetop.specialMoves.deathsDoor.buttons.takeOverRoll"}}{{/if}}</span>
	</button>
	{{/if}}
	<button class="deaths-door-cancel-btn" type="button">{{localize "stonetop.specialMoves.deathsDoor.buttons.close"}}</button>
	{{/if}}

	{{#if isRoll}}
	{{! The roll is this step's affirmative action, so it takes the left of the footer (Foundry's
	    order) at full button size, and "Not yet" keeps the right edge. The label carries what is
	    being rolled: with no stat choice on offer there is nothing else on the step that says
	    "+nothing". }}
	<button class="deaths-door-roll-btn is-primary" type="button" title="{{localize "stonetop.specialMoves.deathsDoor.buttons.rollTitle"}}">
		<i class="fas fa-dice-d6"></i>
		<span>{{#if hasStatChoice}}{{localize "stonetop.specialMoves.deathsDoor.buttons.rollDice"}}{{else}}{{localize "stonetop.specialMoves.deathsDoor.buttons.rollNothing"}}{{/if}}</span>
	</button>
	{{#if skipRollMove}}
	<button class="deaths-door-skip-roll-btn" type="button" title="{{localize "stonetop.specialMoves.deathsDoor.buttons.skipTitle" move=skipRollMove}}">
		<i class="fas fa-shield-heart"></i>
		<span>{{localize "stonetop.specialMoves.deathsDoor.buttons.skip"}}</span>
	</button>
	{{/if}}
	<button class="deaths-door-cancel-btn" type="button">{{localize "stonetop.specialMoves.deathsDoor.buttons.notYet"}}</button>
	{{/if}}

	{{#if isResult}}
	{{#if boostsPending}}
	{{! Accepting is the affirmative, so it takes the left (Foundry's order); each boost names what it
	    does and what it costs. }}
	<button class="deaths-door-accept-btn is-primary" type="button">
		<i class="fas fa-check"></i>
		<span>{{localize "stonetop.specialMoves.deathsDoor.buttons.accept"}}</span>
	</button>
	{{#if canBurnBrightly}}
	<button class="deaths-door-boost-btn deaths-door-burn-btn" type="button"
	        title="{{localize "stonetop.specialMoves.deathsDoor.buttons.burnTitle" cost=burnBrightlyCost}}">
		<i class="fas fa-fire"></i>
		<span>{{localize "stonetop.specialMoves.deathsDoor.buttons.burn" cost=burnBrightlyCost}}</span>
	</button>
	{{/if}}
	{{#if canGiveItAll}}
	<button class="deaths-door-boost-btn deaths-door-give-all-btn" type="button"
	        title="{{localize "stonetop.specialMoves.deathsDoor.buttons.giveAllTitle"}}">
		<i class="fas fa-hand-fist"></i>
		<span>{{localize "stonetop.specialMoves.deathsDoor.buttons.giveAll"}}</span>
	</button>
	{{/if}}
	{{! The roll-card +1s this user presses for their own characters (Diligence, Sanction, Many Hands, a
	    Blessing), labelled as the card labels them. Other players press theirs on the card. }}
	{{#each plusOneButtons}}
	<button class="deaths-door-boost-btn deaths-door-plus-one-btn" type="button" data-plus-one="{{key}}" title="{{title}}">
		<i class="fas fa-plus"></i>
		<span>{{label}}</span>
	</button>
	{{/each}}
	{{else}}
	<button class="deaths-door-close-btn is-primary" type="button">
		<i class="fas fa-check"></i> {{localize "stonetop.specialMoves.deathsDoor.buttons.done"}}
	</button>
	{{/if}}
	{{/if}}

	{{#if isFate}}
	<button class="deaths-door-cancel-btn" type="button">{{localize "stonetop.specialMoves.deathsDoor.buttons.cancel"}}</button>
	{{/if}}

	{{#if isChoices}}
	{{! `title` because the line is clipped to one row now that it shares the footer with three
	    buttons, and on a Thrall with nothing answered it names four steps. }}
	{{#if outstandingLabel}}<span class="deaths-door-outstanding" title="{{outstandingLabel}}">{{outstandingLabel}}</span>{{/if}}
	{{! Back / Next walk the rail; Done leaves. A wizard keeps its forward action on the right (the
	    one place our dialogs don't put the affirmative first), and Done sits past it because it is
	    the way OUT of the walkthrough rather than the next step of it. }}
	<span class="deaths-door-choices-nav">
		<button class="deaths-door-choice-back" type="button"{{#if atFirstChoice}} disabled{{/if}}>
			<span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>{{localize "stonetop.specialMoves.deathsDoor.buttons.back"}}
		</button>
		<button class="deaths-door-choice-next" type="button"{{#if atLastChoice}} disabled{{/if}}>
			{{localize "stonetop.specialMoves.deathsDoor.buttons.next"}}<span class="stonetop-nav-arrow"></span>
		</button>
		<button class="deaths-door-close-btn is-primary" type="button">
			<i class="fas fa-check"></i> {{localize "stonetop.specialMoves.deathsDoor.buttons.done"}}
		</button>
	</span>
	{{/if}}
</div>
