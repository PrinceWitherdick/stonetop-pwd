<div class="stonetop-onboarding-body">

	{{!-- A move's "pick 1" mark boxes, as radios: Well Versed's extra topic beside the background's,
	      and Veteran Crew's "Go mark it now" on the crew step. `optionClass` names each option for its
	      handler; an option the background already holds is noted with `fromLabel`. The radios carry
	      `backgroundSlug`/`choiceKey` (Well Versed) or `markMove`/`markCopy` (a creation mark) for it.
	      Inside the each, the partial's own params are read through `../`. --}}
	{{#*inline "stonetopCreationMarkRadios"}}
	<div class="stonetop-onboarding-background-choice-options {{this.groupClass}}">
		{{#each options}}
		<span class="stonetop-onboarding-bg-option {{../optionClass}}{{#if selected}} is-selected{{/if}}{{#if fromBackground}} is-from-background{{/if}}{{#if disabled}} is-disabled{{/if}}">
			<input type="radio"
			       name="{{../name}}"
			       value="{{this.slug}}"
			       {{#if ../backgroundSlug}}data-background-slug="{{../backgroundSlug}}"{{/if}}
			       {{#if ../choiceKey}}data-choice-key="{{../choiceKey}}"{{/if}}
			       {{#if ../markMove}}data-move="{{../markMove}}" data-copy="{{../markCopy}}"{{/if}}
			       {{#if selected}}checked{{/if}}
			       {{#if disabled}}disabled{{/if}}>
			<span{{#if ../labelClass}} class="{{../labelClass}}"{{/if}}{{#if summary}} data-tooltip="{{this.summary}}"{{/if}}>{{this.label}}</span>
			{{#if fromBackground}}<em class="stonetop-onboarding-background-extra-mark-note">({{../fromLabel}})</em>{{/if}}
		</span>
		{{/each}}
	</div>
	{{/inline}}

	{{!-- Header --}}
	<div class="stonetop-onboarding-header">
		{{#if playbookImg}}
		<img class="stonetop-onboarding-playbook-icon" src="{{this.playbookImg}}" alt="">
		{{/if}}
		<h2 class="stonetop-onboarding-playbook-name">{{this.playbookName}}</h2>
		{{#if hasFaq}}
		<button type="button" class="stonetop-onboarding-faq-badge" title="Related questions: click for the full FAQ" aria-label="Related questions">
			<i class="fas fa-question"></i>
		</button>
		{{/if}}
	</div>

	{{!-- Progress dots --}}
	{{#if progressDots.length}}
	<div class="stonetop-onboarding-progress">
		{{#each progressDots}}
		<span class="stonetop-onboarding-dot{{#if active}} is-active{{/if}}{{#if done}} is-done{{/if}}"></span>
		{{/each}}
	</div>
	{{/if}}

	{{!-- Step content --}}
	<div class="stonetop-onboarding-step">

		{{!-- ── Background ─────────────────────────────────────────── --}}
		{{#if isBackground}}
		<h3 class="stonetop-onboarding-step-title">Background</h3>
		<p class="stonetop-onboarding-step-hint">Choose 1</p>
		<div class="stonetop-onboarding-cards">
			{{#each backgrounds}}
			<label class="stonetop-onboarding-card{{#if selected}} is-selected{{/if}}">
				<div class="stonetop-onboarding-card-header">
					<input type="radio" name="onboard-background" value="{{this.slug}}" {{#if selected}}checked{{/if}}>
					<strong class="stonetop-onboarding-card-title">{{this.label}}</strong>
				</div>
				{{#if description}}
				<div class="stonetop-onboarding-card-desc">{{{this.description}}}</div>
				{{/if}}
				{{#if moveChoices.length}}
				<div class="stonetop-onboarding-background-move-choices">
					{{#each moveChoices}}
					<div class="stonetop-onboarding-background-move-choice">
						<p class="stonetop-onboarding-background-move-choice-label">{{this.label}}</p>
						{{#if hasOptions}}
						<div class="stonetop-onboarding-background-choice-options">
							{{#each options}}
							<span class="stonetop-onboarding-bg-option stonetop-onboarding-background-choice-option{{#if selected}} is-selected{{/if}}">
								<input type="radio"
								       name="onboard-background-move-choice-{{../key}}"
								       value="{{this.value}}"
								       data-background-slug="{{../../slug}}"
								       data-choice-key="{{../key}}"
								       data-choice-label="{{../label}}"
								       {{#if selected}}checked{{/if}}>
								{{#if topicSummary}}
								<span class="stonetop-onboarding-well-versed-topic" data-tooltip="{{this.topicSummary}}">{{this.label}}</span>
								{{else}}
								<span>{{this.label}}</span>
								{{/if}}
							</span>
							{{/each}}
						</div>
						{{else}}
						{{#if valueTopicSummary}}
						<p class="stonetop-onboarding-background-choice-fixed"><span class="stonetop-onboarding-well-versed-topic" data-tooltip="{{this.valueTopicSummary}}">{{this.value}}</span></p>
						{{else}}
						<p class="stonetop-onboarding-background-choice-fixed">{{this.value}}</p>
						{{/if}}
						{{/if}}
						{{!-- Well Versed: "Mark 1 topic, in addition to the one noted in your Background". --}}
						{{#if extraMark}}
						<p class="stonetop-onboarding-background-move-choice-label">{{extraMark.label}}</p>
						{{> stonetopCreationMarkRadios options=extraMark.options
						      groupClass="stonetop-onboarding-background-extra-marks"
						      optionClass="stonetop-onboarding-background-extra-mark"
						      labelClass="stonetop-onboarding-well-versed-topic"
						      name=(concat "onboard-background-extra-mark-" ../slug "-" key)
						      backgroundSlug=../slug choiceKey=key
						      fromLabel=extraMark.fromBackgroundLabel}}
						{{/if}}
					</div>
					{{/each}}
				</div>
				{{/if}}
				{{#if setup}}
				<div class="stonetop-onboarding-background-setup">
					{{#each setup.choices}}
					<div class="stonetop-onboarding-background-setup-choice">
						<p class="stonetop-onboarding-background-setup-label">{{this.label}}</p>
						<div class="stonetop-onboarding-background-choice-options">
							{{#each options}}
							<span class="stonetop-onboarding-bg-option stonetop-onboarding-background-setup-option{{#if selected}} is-selected{{/if}}">
								<input type="radio"
								       name="onboard-background-setup-choice-{{../key}}"
								       value="{{this.value}}"
								       data-background-slug="{{../../slug}}"
								       data-choice-key="{{../key}}"
								       {{#if selected}}checked{{/if}}>
								<span>{{this.label}}</span>
							</span>
							{{/each}}
						</div>
					</div>
					{{/each}}
					{{#each setup.texts}}
					<label class="stonetop-onboarding-background-setup-text">
						<span class="stonetop-onboarding-background-setup-label">{{this.label}}</span>
						<textarea class="onboard-background-setup-text"
						          data-background-slug="{{../slug}}"
						          data-text-key="{{this.key}}"
						          rows="2"
						          placeholder="{{this.placeholder}}">{{this.value}}</textarea>
					</label>
					{{/each}}
					{{#each setup.neighbors}}
					<label class="stonetop-onboarding-background-neighbor">
						<span class="stonetop-onboarding-background-neighbor-name">
							<strong>{{this.name}}</strong>{{#if origin}} <span>from {{this.origin}}</span>{{/if}}
						</span>
						<input type="text"
						       class="onboard-background-neighbor-trait"
						       data-background-slug="{{this.backgroundSlug}}"
						       data-trait-key="{{this.traitKey}}"
						       value="{{this.trait}}"
						       placeholder="{{this.traitLabel}}"
						       autocomplete="off">
						{{!-- A <button> is interactive content, so the wrapping <label> never
						      forwards a click on it to the trait input — it only rolls. --}}
						<button type="button"
						        class="onboard-background-neighbor-random"
						        title="Roll a trait at random"
						        aria-label="Roll a random trait for {{this.name}}">
							<i class="fas fa-dice-d6"></i>
						</button>
					</label>
					{{/each}}
					{{#each setup.neighborChoices}}
					<div class="stonetop-onboarding-background-neighbor-choice">
						<p class="stonetop-onboarding-background-setup-label">{{this.label}} ({{this.selectedCount}}/{{this.count}})</p>
						<div class="stonetop-onboarding-background-choice-options">
							{{#each options}}
							<span class="stonetop-onboarding-bg-option stonetop-onboarding-background-neighbor-option{{#if selected}} is-selected{{/if}}">
								<input type="checkbox" class="stonetop-onboarding-check"
								       name="onboard-background-neighbor-pick-{{../key}}"
								       value="{{this.value}}"
								       data-background-slug="{{../../slug}}"
								       data-choice-key="{{../key}}"
								       data-choice-count="{{../count}}"
								       {{#if selected}}checked{{/if}}>
								<span>
									{{!-- One inline child: the wrapper is a flex box (.stonetop-onboarding-bg-option > span),
									      which would eat the space between a bare <strong> and <em> ("Isaldefrom the
									      Manmarch"). Kept as one text flow so the space survives and it wraps normally. --}}
									<span><strong>{{this.name}}</strong>{{#if origin}} <em>from {{this.origin}}</em>{{/if}}</span>
								</span>
							</span>
							{{/each}}
						</div>
					</div>
					{{/each}}
				</div>
				{{/if}}
				{{#if picks}}
				{{!-- The background's own "choose N" list (the Would-Be Hero's Driven and Destined). Short
				      of the count is flagged, never refused. --}}
				<div class="stonetop-onboarding-background-picks{{#if picks.inline}} is-inline{{/if}}" data-background-slug="{{this.slug}}">
					<p class="stonetop-onboarding-background-setup-label">{{picks.label}} (choose {{picks.countLabel}})</p>
					<div class="stonetop-onboarding-background-choice-options">
						{{#each picks.options}}
						<span class="stonetop-onboarding-bg-option stonetop-onboarding-background-pick-option{{#if selected}} is-selected{{/if}}">
							<input type="checkbox" class="stonetop-onboarding-check"
							       name="onboard-background-pick-{{../slug}}"
							       value="{{this.slug}}"
							       data-background-slug="{{../slug}}"
							       {{#if selected}}checked{{/if}}
							       {{#if disabled}}disabled{{/if}}>
							<span>{{this.label}}</span>
						</span>
						{{/each}}
					</div>
					<p class="stonetop-onboarding-background-picks-flag"{{#unless picks.underMin}} hidden{{/unless}}>
						<i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
						<span class="stonetop-onboarding-background-picks-count">{{picks.selectedCount}}</span> chosen; the book asks for {{picks.countLabel}}.
					</p>
				</div>
				{{/if}}
				{{#if markableActions}}
				<div class="stonetop-onboarding-background-actions">
					<p class="stonetop-onboarding-background-setup-label">Mark an action
						(<span class="stonetop-onboarding-background-actions-count">{{markableActions.markedCount}}</span>/{{markableActions.allowed}})
					</p>
					<div class="stonetop-onboarding-background-choice-options stonetop-onboarding-background-actions-list">
						{{#each markableActions.options}}
						<span class="stonetop-onboarding-bg-option stonetop-onboarding-background-action-option{{#if isSelected}} is-selected{{/if}}">
							<input type="checkbox" class="stonetop-onboarding-check"
							       name="onboard-background-action"
							       value="{{this.slug}}"
							       data-background-slug="{{this.backgroundSlug}}"
							       {{#if isSelected}}checked{{/if}}
							       {{#if disabled}}disabled{{/if}}
							       {{#if isLearned}}data-learned="true"{{/if}}>
							<span>{{{this.label}}}</span>
							{{#if isLearned}}<span class="stonetop-onboarding-possession-badge">Marked at level-up</span>{{/if}}
						</span>
						{{/each}}
					</div>
				</div>
				{{/if}}
				{{#if majorArcana.length}}
				<div class="stonetop-onboarding-background-arcana">
					<p class="stonetop-onboarding-background-arcana-label">Major arcanum</p>
					<div class="stonetop-onboarding-arcana-grid stonetop-onboarding-arcana-grid--background">
						{{#each majorArcana}}
						<span class="stonetop-onboarding-arcana-option{{#if selected}} is-selected{{/if}}">
							<input type="radio"
							       name="onboard-background-major-arcanum"
							       value="{{this.slug}}"
							       data-background-slug="{{this.backgroundSlug}}"
							       {{#if selected}}checked{{/if}}>
							{{#if img}}<img class="stonetop-onboarding-arcana-thumb" src="{{this.img}}" alt="">{{/if}}
							<span class="stonetop-onboarding-arcana-name">{{this.name}}</span>
							<span class="stonetop-onboarding-arcana-preview">
								{{#if img}}<img src="{{this.img}}" alt="">{{/if}}
								<strong>{{this.name}}</strong>
								<span>{{this.description}}</span>
							</span>
						</span>
						{{/each}}
					</div>
				</div>
				{{/if}}
			</label>
			{{/each}}
		</div>
		{{/if}}

		{{!-- ── Instinct ──────────────────────────────────────────── --}}
		{{#if isInstinct}}
		<h3 class="stonetop-onboarding-step-title">Instinct</h3>
		<p class="stonetop-onboarding-step-hint">Choose 1, or write your own below</p>
		<div class="stonetop-onboarding-cards stonetop-onboarding-cards--compact">
			{{#each instincts}}
			<label class="stonetop-onboarding-card stonetop-onboarding-card--compact{{#if selected}} is-selected{{/if}}">
				<div class="stonetop-onboarding-card-header">
					<input type="radio" name="onboard-instinct" value="{{this.value}}" {{#if selected}}checked{{/if}}>
					<strong class="stonetop-onboarding-card-title">{{this.word}}</strong>
					<span class="stonetop-onboarding-card-inline-desc">{{this.description}}</span>
				</div>
			</label>
			{{/each}}
		</div>
		<label class="stonetop-onboarding-custom-label stonetop-onboarding-instinct-custom">
			<span>Custom instinct</span>
			<input type="text" class="onboard-instinct-word"
			       value="{{this.customInstinctWord}}"
			       aria-label="Instinct word"
			       placeholder="One word">
			<input type="text" class="onboard-instinct-desc"
			       value="{{this.customInstinctDescription}}"
			       aria-label="Instinct description"
			       placeholder="Instinct description">
		</label>
		{{/if}}

		{{!-- ── Appearance ───────────────────────────────────────── --}}
		{{#if isAppearance}}
		<h3 class="stonetop-onboarding-step-title">Appearance</h3>
		<p class="stonetop-onboarding-step-hint">Choose 1 in each row, or fill in Custom</p>
		<div class="stonetop-onboarding-appearance">
			{{#each appearanceLines}}
			<div class="stonetop-onboarding-appearance-row">
				<p class="stonetop-onboarding-appearance-label">{{this.label}}</p>
				<div class="stonetop-onboarding-appearance-options">
					{{#each options}}
					<label class="stonetop-onboarding-appearance-option{{#if selected}} is-selected{{/if}}">
						<input type="radio" name="onboard-appearance-{{../lineIdx}}"
						       value="{{this.value}}" {{#if selected}}checked{{/if}}>
						{{this.value}}
					</label>
					{{/each}}
					<label class="stonetop-onboarding-appearance-option stonetop-onboarding-appearance-custom{{#if customSelected}} is-selected{{/if}}">
						<input type="radio" name="onboard-appearance-{{this.lineIdx}}"
						       class="onboard-appearance-custom-radio"
						       value="{{this.customValue}}"
						       data-line="{{this.lineIdx}}"
						       {{#if customSelected}}checked{{/if}}>
						{{! Same 60 as the sheet's write-in box (tab-details.hbs) — a line typed
						    here is read back and edited there, and all four end up on one
						    inline header line. }}
						<input type="text" class="onboard-appearance-custom"
						       data-line="{{this.lineIdx}}"
						       value="{{this.customValue}}"
						       maxlength="60"
						       placeholder="Make your own">
					</label>
				</div>
			</div>
			{{/each}}
		</div>
		{{/if}}

		{{!-- ── Origin & Name ─────────────────────────────────────── --}}
		{{#if isOrigin}}
		<h3 class="stonetop-onboarding-step-title">Origin &amp; Name</h3>
		<p class="stonetop-onboarding-step-hint">Where are you from? What are you called?</p>

		<div class="stonetop-onboarding-origin-grid">
			{{#each origins}}
			<label class="stonetop-onboarding-origin-label{{#if selected}} is-selected{{/if}}">
				<input type="radio" name="onboard-origin" value="{{this.region}}" {{#if selected}}checked{{/if}}>
				{{this.region}}
			</label>
			{{/each}}
		</div>

		{{!-- Name input --}}
		<div class="stonetop-onboarding-name-row">
			<label class="stonetop-onboarding-name-label" for="onboard-name-input">Name</label>
			<input id="onboard-name-input" type="text" class="onboard-name-input"
			       value="{{this.selectedName}}"
			       placeholder="Enter your character's name…">
		</div>

		{{!-- Name suggestions, one block per region; JS shows the active one --}}
		{{#each origins}}
		{{#if isGordinsDelve}}
		<div class="stonetop-onboarding-names-section{{#if selected}} is-visible{{/if}}"
		     data-region="{{this.region}}">
			<p class="stonetop-onboarding-names-label">People from Gordin's Delve always come from somewhere else. Choose a name from another place, or write your own.</p>
			<p class="stonetop-onboarding-names-label">Suggested names for {{this.region}}:</p>
			{{#each nameGroups}}
			<div class="stonetop-onboarding-name-group">
				<p class="stonetop-onboarding-name-group-label">{{this.region}}{{#if note}}: {{this.note}}{{/if}}</p>
				<div class="stonetop-onboarding-name-chips">
					{{#each names}}
					<button type="button" class="onboard-name-chip" data-name="{{this}}" data-combine="{{../combine}}">{{this}}</button>
					{{/each}}
				</div>
			</div>
			{{/each}}
		</div>
		{{else}}
		{{#if names.length}}
		<div class="stonetop-onboarding-names-section{{#if selected}} is-visible{{/if}}"
		     data-region="{{this.region}}">
			<p class="stonetop-onboarding-names-label">Suggested names for {{this.region}}:</p>
			{{#if note}}<p class="stonetop-onboarding-names-label">{{this.note}}</p>{{/if}}
			<div class="stonetop-onboarding-name-chips">
				{{#each names}}
				<button type="button" class="onboard-name-chip" data-name="{{this}}" data-combine="{{../combine}}">{{this}}</button>
				{{/each}}
			</div>
		</div>
		{{/if}}
		{{/if}}
		{{/each}}

		{{/if}}

		{{!-- ── Stats ──────────────────────────────────────────────── --}}
		{{#if isStats}}
		<h3 class="stonetop-onboarding-step-title">Stats</h3>
		<p class="stonetop-onboarding-step-hint">Assign each score to a stat. Drag scores onto stats or use the dropdowns; each score must be used exactly once.</p>

		<div class="stonetop-onboarding-stats-pool">
			<span class="stonetop-onboarding-stats-pool-label">Scores to assign</span>
			<button type="button" class="stonetop-onboarding-stats-reset">Reset</button>
			{{#each statScores}}
			<span class="stonetop-onboarding-stats-chip" draggable="true" data-score="{{this}}">{{this}}</span>
			{{/each}}
		</div>

		<div class="stonetop-onboarding-stats-grid">
			{{#each statBoxes}}
			<div class="stonetop-onboarding-stat-box{{#if assigned}} is-filled{{/if}}" data-stat-key="{{this.key}}">
				<span class="stonetop-onboarding-stat-abbr">{{this.abbr}}</span>
				<select class="stonetop-onboarding-stat-select" name="onboard-stat-{{this.key}}">
					<option value="">—</option>
					{{#each options}}
					<option value="{{this.value}}" {{#if selected}}selected{{/if}}>{{this.label}}</option>
					{{/each}}
				</select>
				<span class="stonetop-onboarding-stat-name">{{this.label}}</span>
			</div>
			{{/each}}
		</div>

		{{/if}}

		{{!-- ── Special Possessions ───────────────────────────────── --}}
		{{#if isPossession}}
		<h3 class="stonetop-onboarding-step-title">Special Possessions</h3>
		<p class="stonetop-onboarding-step-hint">{{possession.pickNote}}</p>
		<p class="stonetop-onboarding-possession-counter">
			<span class="stonetop-onboarding-possession-count">{{possession.selectedCount}}</span>
			/ {{possession.pickCount}} chosen
		</p>
		<div class="stonetop-onboarding-cards">
			{{#each possession.options}}
			<div class="stonetop-onboarding-possession-group{{#if isSelected}} is-selected{{/if}}">
				<label class="stonetop-onboarding-card stonetop-onboarding-card--possession{{#if isSelected}} is-selected{{/if}}{{#if isPreselected}} is-preselected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<input type="checkbox" class="stonetop-onboarding-check" name="onboard-possession" value="{{this.slug}}"
						       {{#if isSelected}}checked{{/if}}
						       {{#if disabled}}disabled{{/if}}
						       {{#if isPreselected}}data-preselected="true"{{/if}}>
						<strong class="stonetop-onboarding-card-title">{{{this.label}}}</strong>
						{{#if isPreselected}}
						<span class="stonetop-onboarding-possession-badge">{{#if isFromBackground}}From your background{{else}}Included{{/if}}</span>
						{{/if}}
					</div>
					{{#if description}}
					<div class="stonetop-onboarding-card-desc">{{{this.description}}}</div>
					{{/if}}
				</label>
				{{#if choices}}
				<div class="stonetop-onboarding-suboptions{{#if choices.locked}} is-locked{{/if}}" data-possession="{{this.slug}}">
					<p class="stonetop-onboarding-suboptions-hint">
						{{choices.pickNote}}, 
						<span class="stonetop-onboarding-suboption-count" data-possession="{{this.slug}}">{{choices.selectedCount}}</span>
						/ {{choices.pickCount}}
					</p>
					{{#each choices.options}}
					<label class="stonetop-onboarding-suboption{{#if isSelected}} is-selected{{/if}}">
						<input type="checkbox" class="stonetop-onboarding-check stonetop-onboarding-subcheck"
						       name="onboard-possession-sub" value="{{this.slug}}" data-possession="{{this.possessionSlug}}"
						       {{#if isSelected}}checked{{/if}}
						       {{#if disabled}}disabled{{/if}}>
						<span class="stonetop-onboarding-suboption-label">{{#if hasBlank}}{{{this.fillBefore}}}<input type="text" class="onboard-possession-sub-fill" data-possession="{{this.possessionSlug}}" data-choice="{{this.slug}}" value="{{this.fillValue}}" placeholder="…" aria-label="Fill in the blank">{{{this.fillAfter}}}{{else}}{{{this.label}}}{{/if}}</span>
					</label>
					{{/each}}
				</div>
				{{/if}}
				{{#if choiceGroups}}
				{{#each choiceGroups}}
				<div class="stonetop-onboarding-choice-group">
					<p class="stonetop-onboarding-choice-group-heading">{{this.heading}}{{#if note}} <em>({{this.note}})</em>{{/if}}</p>
					{{#each subgroups}}
					<div class="stonetop-onboarding-choice-subgroup">
						{{#if max}}
						<span class="stonetop-onboarding-subcheck-cap">
							<span class="stonetop-onboarding-subcheck-count" data-group="{{this.groupId}}">{{this.selectedCount}}</span> / {{this.max}}
						</span>
						{{/if}}
						{{#each options}}
						<label class="stonetop-onboarding-suboption{{#if isSelected}} is-selected{{/if}}">
							{{#if ../multiSelect}}
							<input type="checkbox" class="stonetop-onboarding-check stonetop-onboarding-subcheck"
							       name="onboard-possession-cg-check" value="{{this.slug}}" data-possession="{{this.possessionSlug}}"
							       {{#if isSelected}}checked{{/if}}
							       {{#if disabled}}disabled{{/if}}>
							{{else}}
							<input type="radio" class="stonetop-onboarding-radio"
							       name="onboard-possession-cg-{{this.groupId}}" value="{{this.slug}}"
							       data-possession="{{this.possessionSlug}}" data-siblings="{{this.siblingSlugsCsv}}"
							       {{#if isSelected}}checked{{/if}}
							       {{#if disabled}}disabled{{/if}}>
							{{/if}}
							<span class="stonetop-onboarding-suboption-label">{{{this.label}}}</span>
						</label>
						{{/each}}
					</div>
					{{/each}}
				</div>
				{{/each}}
				{{/if}}
			</div>
			{{/each}}

			{{!-- Write-in possession: anything not on the list, on par with the other
			     options. Filling it spends a pick like any listed possession. --}}
			<div class="stonetop-onboarding-possession-group stonetop-onboarding-possession-group--custom{{#if possession.custom.filled}} is-selected{{/if}}">
				<div class="stonetop-onboarding-card stonetop-onboarding-card--possession stonetop-onboarding-card--custom{{#if possession.custom.filled}} is-selected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<strong class="stonetop-onboarding-card-title">Something else</strong>
						<span class="stonetop-onboarding-possession-custom-gm">(discuss with GM)</span>
					</div>
					<input type="text" class="onboard-possession-custom"
					       value="{{possession.custom.label}}"
					       placeholder="Describe your own special possession…"
					       {{#if possession.custom.disabled}}disabled{{/if}}>
				</div>
			</div>
		</div>
		{{/if}}

		{{!-- ── Starting Moves ────────────────────────────────────── --}}
		{{#if isMoves}}
		<h3 class="stonetop-onboarding-step-title">Starting Moves</h3>

		{{#each moveChoiceGroups}}
		<div class="stonetop-onboarding-move-choice-group">
			<p class="stonetop-onboarding-step-hint">{{this.label}}</p>
			<div class="stonetop-onboarding-cards stonetop-onboarding-cards--columns">
				{{#each options}}
				<label class="stonetop-onboarding-card stonetop-onboarding-card--move-choice{{#if selected}} is-selected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<input type="radio" class="stonetop-onboarding-radio" name="onboard-move-choice-{{this.groupIndex}}" value="{{this.id}}"
						       data-group="{{this.groupIndex}}"
						       {{#if selected}}checked{{/if}}>
						<strong class="stonetop-onboarding-card-title">{{this.name}}</strong>
					</div>
					{{#if description}}
					<div class="stonetop-onboarding-card-desc">{{{moveBody description moveResults}}}</div>
					{{/if}}
				</label>
				{{/each}}
			</div>
		</div>
		{{/each}}

		{{#if movePickCount}}
		<p class="stonetop-onboarding-step-hint">{{this.movePickNote}}</p>
		<p class="stonetop-onboarding-move-counter">
			<span class="stonetop-onboarding-move-count">{{this.moveSelectedCount}}</span>
			/ {{this.movePickCount}} chosen
		</p>
		<div class="stonetop-onboarding-move-search">
			<i class="fas fa-magnifying-glass" aria-hidden="true"></i>
			<input type="search" class="onboard-move-search" placeholder="Filter moves…" aria-label="Filter moves">
		</div>
		{{#if moveGroups.length}}
		<div class="stonetop-onboarding-move-chips">
			{{#each moveGroups}}
			<button type="button" class="stonetop-onboarding-move-chip" data-move-group="{{this.key}}">{{this.label}}</button>
			{{/each}}
		</div>
		{{/if}}
		<div class="stonetop-onboarding-cards stonetop-onboarding-cards--columns">
			{{#each moveOptions}}
			<label class="stonetop-onboarding-card stonetop-onboarding-card--move{{#if selected}} is-selected{{/if}}{{#if statChoice}} stonetop-onboarding-card--stat-move{{/if}}"
			       data-move-groups="{{#each groups}}{{this}} {{/each}}">
				<div class="stonetop-onboarding-card-header">
					<input type="checkbox" class="stonetop-onboarding-check" name="onboard-move" value="{{this.id}}"
					       {{#if selected}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}>
					<strong class="stonetop-onboarding-card-title">{{this.name}}</strong>
				</div>
				{{#if description}}
				<div class="stonetop-onboarding-card-desc">{{{moveBody description moveResults}}}</div>
				{{/if}}
				{{#if statChoice}}
				{{!-- Inline "+1 to which stat?" picker (Improved Stat). stopPropagation keeps a
				      radio click from also toggling the parent card's checkbox. Always laid out
				      (faded until the move is ticked, so the columns don't reshuffle); until then it is
				      inert and its radios disabled, and the tick handler switches both. --}}
				<div class="stonetop-onboarding-move-stat-picker" onclick="event.stopPropagation()"{{#unless this.selected}} inert{{/unless}}>
					<span class="stonetop-onboarding-move-stat-label">Increase which stat? <em>(max +{{statChoice.cap}})</em></span>
					<div class="stonetop-onboarding-appearance-options stonetop-onboarding-move-stat-options">
						{{#each statChoice.options}}
						<label class="stonetop-onboarding-appearance-option stonetop-onboarding-move-stat-option{{#if selected}} is-selected{{/if}}{{#if atCap}} is-disabled{{/if}}">
							<input type="radio" class="onboard-move-stat" name="onboard-move-stat-{{this.moveId}}"
							       value="{{this.key}}" data-move-id="{{this.moveId}}"
							       {{#if selected}}checked{{/if}} {{#if atCap}}disabled{{else}}{{#unless ../selected}}disabled{{/unless}}{{/if}}>
							{{this.label}}
							<span class="stonetop-onboarding-move-stat-delta">{{#if atCap}}{{this.currentDisplay}} (max){{else}}{{this.currentDisplay}} &rarr; {{this.nextDisplay}}{{/if}}</span>
						</label>
						{{/each}}
					</div>
				</div>
				{{/if}}
			</label>
			{{/each}}
		</div>
		{{/if}}
		{{/if}}

		{{!-- ── Invocations (Lightbearer) ─────────────────────────── --}}
		{{#if isInvocations}}
		<h3 class="stonetop-onboarding-step-title">Invocations</h3>
		<p class="stonetop-onboarding-step-hint">You start knowing {{invocationData.startingCount}} Invocations. Choose them now.{{#if invocationData.learnedCount}} The ones you learned at level-up stay known.{{/if}}</p>
		<p class="stonetop-onboarding-move-counter">
			<span class="stonetop-onboarding-invocation-count">{{invocationData.selectedCount}}</span>
			/ {{invocationData.startingCount}} chosen
		</p>
		<div class="stonetop-onboarding-cards stonetop-onboarding-cards--columns">
			{{#each invocationData.options}}
			<label class="stonetop-onboarding-card stonetop-onboarding-card--invocation{{#if isSelected}} is-selected{{/if}}{{#if isLearned}} is-preselected{{/if}}">
				<div class="stonetop-onboarding-card-header">
					<input type="checkbox" class="stonetop-onboarding-check" name="onboard-invocation" value="{{this.slug}}"
					       {{#if isSelected}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}
					       {{#if isLearned}}data-learned="true"{{/if}}>
					<strong class="stonetop-onboarding-card-title">{{this.label}}</strong>
					{{#if isLearned}}
					<span class="stonetop-onboarding-possession-badge">Learned at level-up</span>
					{{/if}}
				</div>
				{{#if description}}
				<div class="stonetop-onboarding-card-desc">{{{this.description}}}</div>
				{{/if}}
			</label>
			{{/each}}
		</div>
		{{/if}}

		{{!-- ── Initiates of Danu (Blessed + Initiate bg) ─────────── --}}
		{{#if isInitiates}}
		<h3 class="stonetop-onboarding-step-title">Initiates of <span class="stonetop-onboarding-lookup">Danu</span></h3>
		<p class="stonetop-onboarding-step-hint">Choose {{initiatesData.minCount}}–{{initiatesData.maxCount}} fellow initiates who serve <span class="stonetop-onboarding-lookup">the goddess</span> alongside you.</p>
		<p class="stonetop-onboarding-move-counter">
			<span class="stonetop-onboarding-initiate-count">{{initiatesData.selectedCount}}</span>
			/ {{initiatesData.maxCount}} chosen
		</p>
		<div class="stonetop-onboarding-cards">
			{{#each initiatesData.options}}
			<label class="stonetop-onboarding-card stonetop-onboarding-card--initiate{{#if isSelected}} is-selected{{/if}}">
				<div class="stonetop-onboarding-card-header">
					<input type="checkbox" class="stonetop-onboarding-check" name="onboard-initiate" value="{{this.slug}}"
					       {{#if isSelected}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}>
					<strong class="stonetop-onboarding-card-title">{{this.label}}</strong>
				</div>
				{{#if description}}
				<div class="stonetop-onboarding-card-desc">{{{this.description}}}</div>
				{{/if}}
				{{#if choiceRows.length}}
				<div class="stonetop-onboarding-initiate-choices" onclick="event.stopPropagation()">
					{{#each choiceRows}}
					<div class="stonetop-onboarding-initiate-row">
						<span class="stonetop-onboarding-initiate-row-label">{{#if isPronoun}}Pick 1 on each line:{{else}}{{this.label}}{{/if}}</span>
						<div class="stonetop-onboarding-appearance-row stonetop-onboarding-initiate-options">
							{{#each options}}
							<label class="stonetop-onboarding-appearance-option{{#if selected}} is-selected{{/if}}">
								<input type="radio"
								       data-onboard-initiate-radio="1"
								       data-slug="{{this.slug}}"
								       data-row-idx="{{this.rowIdx}}"
								       data-is-pronoun="{{../isPronoun}}"
								       name="onboard-initiate-row-{{this.slug}}-{{this.rowIdx}}"
								       value="{{this.value}}"
								       {{#if selected}}checked{{/if}}>
								{{this.value}}
							</label>
							{{/each}}
							{{#if allowCustom}}
							<label class="stonetop-onboarding-appearance-option stonetop-onboarding-initiate-custom-label">
								<input type="text"
								       class="onboard-initiate-custom stonetop-onboarding-initiate-custom-input"
								       data-slug="{{this.slug}}"
								       data-row-idx="{{this.rowIdx}}"
								       value="{{this.customValue}}"
								       placeholder="other…">
							</label>
							{{/if}}
						</div>
					</div>
					{{/each}}
				</div>
				{{/if}}
			</label>
			{{/each}}
		</div>
		{{/if}}

		{{!-- ── Crew (Marshal) ────────────────────────────────────── --}}
		{{#if isCrew}}
		<h3 class="stonetop-onboarding-step-title">Crew</h3>
		<p class="stonetop-onboarding-step-hint">Your crew starts with the <em>group</em> tag{{#if crewData.bgTag}} and <em>{{crewData.bgTag}}</em> (from your background){{/if}}. Pick {{crewData.additionalTagCount}} more tags, an instinct, and a cost.</p>

		{{!-- Veteran Crew's "Go mark it now" (Book I p.125): one pick for each copy creation gives.
		      Picking "Select 2 new tags" raises the tag count below. --}}
		{{#if crewData.creationMarks.length}}
		<div class="stonetop-onboarding-insert-section stonetop-onboarding-creation-marks">
			<p class="stonetop-onboarding-step-hint">{{crewData.creationMarkHint}}</p>
			{{#each crewData.creationMarks}}
			<p class="stonetop-onboarding-background-move-choice-label">{{this.label}}</p>
			{{> stonetopCreationMarkRadios options=options
			      optionClass="stonetop-onboarding-creation-mark"
			      name=name markMove=move markCopy=copy}}
			{{/each}}
		</div>
		{{/if}}

		<div class="stonetop-onboarding-name-row">
			<label class="stonetop-onboarding-name-label" for="onboard-crew-name">Crew name <em>(optional)</em></label>
			<input id="onboard-crew-name" type="text" class="onboard-crew-name"
			       value="{{crewData.name}}"
			       placeholder="What do people call your crew?">
		</div>

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">
				Tags &nbsp;
				<span class="stonetop-onboarding-insert-counter">
					<span class="stonetop-onboarding-crew-tag-count">{{crewData.selectedTagCount}}</span> / {{crewData.additionalTagCount}}
				</span>
			</p>
			<div class="stonetop-onboarding-tag-grid">
				{{#each crewData.tags}}
				<label class="stonetop-onboarding-tag-option{{#if isSelected}} is-selected{{/if}}">
					<input type="checkbox" name="onboard-crew-tag" value="{{this.slug}}"
					       {{#if isSelected}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}
					       {{#if isAuto}}data-auto="true"{{/if}}>
					{{this.label}}{{#if isAuto}} <em>(included)</em>{{/if}}
				</label>
				{{/each}}
			</div>
			{{!-- The insert's three blank tag lines (p.144): each one written in spends a pick. --}}
			{{#each crewData.customTags}}
			<label class="stonetop-onboarding-custom-label">
				<span>Custom tag</span>
				<input type="text" class="onboard-crew-tag-custom"
				       data-index="{{this.index}}"
				       value="{{this.value}}"
				       aria-label="Custom tag"
				       placeholder="Write your own…"
				       {{#if disabled}}disabled{{/if}}>
			</label>
			{{/each}}
		</div>

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">Instinct</p>
			<div class="stonetop-onboarding-cards stonetop-onboarding-cards--compact">
				{{#each crewData.instincts}}
				<label class="stonetop-onboarding-card stonetop-onboarding-card--compact{{#if selected}} is-selected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<input type="radio" name="onboard-crew-instinct" value="{{this.value}}"
						       {{#if selected}}checked{{/if}}>
						<span class="stonetop-onboarding-card-inline-desc">{{this.value}}</span>
					</div>
				</label>
				{{/each}}
			</div>
			<label class="stonetop-onboarding-custom-label">
				<span>Custom instinct</span>
				<input type="text" class="onboard-crew-instinct-custom"
				       value="{{crewData.customInstinct}}"
				       aria-label="Custom instinct"
				       placeholder="Write your own…">
			</label>
		</div>

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">Cost</p>
			<div class="stonetop-onboarding-cards stonetop-onboarding-cards--compact">
				{{#each crewData.costs}}
				<label class="stonetop-onboarding-card stonetop-onboarding-card--compact{{#if selected}} is-selected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<input type="radio" name="onboard-crew-cost" value="{{this.value}}"
						       {{#if selected}}checked{{/if}}>
						<span class="stonetop-onboarding-card-inline-desc">{{this.value}}</span>
					</div>
				</label>
				{{/each}}
			</div>
			<label class="stonetop-onboarding-custom-label">
				<span>Custom cost</span>
				<input type="text" class="onboard-crew-cost-custom"
				       value="{{crewData.customCost}}"
				       aria-label="Custom cost"
				       placeholder="Write your own…">
			</label>
		</div>
		{{/if}}

		{{!-- ── Animal Companion (Ranger) ──────────────────────────── --}}
		{{#if isAnimalCompanion}}
		<h3 class="stonetop-onboarding-step-title">Animal Companion</h3>
		<p class="stonetop-onboarding-step-hint">Choose your companion's type, traits, instinct, and cost.</p>

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">Type</p>
			<div class="stonetop-onboarding-tag-grid stonetop-onboarding-tag-grid--types">
				{{#each acData.types}}
				<label class="stonetop-onboarding-tag-option stonetop-onboarding-tag-option--type{{#if selected}} is-selected{{/if}}">
					<input type="radio" name="onboard-ac-type" value="{{this.slug}}" {{#if selected}}checked{{/if}}>
					<span class="stonetop-onboarding-ac-type-name">{{this.label}}</span>
					<span class="stonetop-onboarding-ac-type-stats">HP {{this.hp}} · Armor {{this.armor}} · {{this.damage}}</span>
					<span class="stonetop-onboarding-ac-type-examples">{{this.examples}}</span>
				</label>
				{{/each}}
			</div>
		</div>

		{{#if acData.selectedType}}
		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">Kind</p>
			<div class="stonetop-onboarding-ac-kind-options">
				{{#each acData.selectedType.kindOptions}}
				<label class="stonetop-onboarding-appearance-option{{#if selected}} is-selected{{/if}}">
					<input type="radio" name="onboard-ac-kind" value="{{this.value}}" {{#if selected}}checked{{/if}}>
					<span>{{this.value}}</span>
				</label>
				{{/each}}
				<label class="stonetop-onboarding-appearance-option stonetop-onboarding-ac-kind-custom{{#if acData.selectedType.isCustomKind}} is-selected{{/if}}">
					<input type="radio" name="onboard-ac-kind" value="custom" {{#if acData.selectedType.isCustomKind}}checked{{/if}}>
					<input type="text" class="onboard-ac-kind-custom-input"
					       value="{{acData.selectedType.customKind}}"
					       placeholder="Other kind...">
				</label>
			</div>
		</div>

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">
				Traits: pick {{acData.selectedType.pickCount}} more &nbsp;
				<span class="stonetop-onboarding-insert-counter">
					<span class="stonetop-onboarding-ac-trait-count">{{acData.selectedType.selectedCount}}</span> / {{acData.selectedType.pickCount}}
				</span>
			</p>
			<p class="stonetop-onboarding-step-hint stonetop-onboarding-ac-over"{{#unless acData.selectedType.overCount}} hidden{{/unless}}>You have more options picked than your companion can have (only {{acData.selectedType.pickCount}}). Untick <span class="stonetop-onboarding-ac-over-count">{{acData.selectedType.overCount}}</span> to go on.</p>
			<div class="stonetop-onboarding-tag-grid">
				{{#each acData.selectedType.traits}}
				<label class="stonetop-onboarding-tag-option{{#if isSelected}} is-selected{{/if}}{{#if isMandatory}} is-mandatory{{/if}}"{{#if isMandatory}} title="Always included; doesn't count toward your picks"{{/if}}>
					<input type="checkbox" name="onboard-ac-trait" value="{{this.slug}}"
					       {{#if isSelected}}checked{{/if}}
					       {{#if disabled}}disabled{{/if}}>
					{{#if hasTooltip}}<span class="stonetop-onboarding-lookup">{{this.label}}</span>{{else}}{{this.label}}{{/if}}{{#if isMandatory}} <em class="stonetop-onboarding-ac-included">(included)</em>{{/if}}
				</label>
				{{/each}}
			</div>
			<label class="stonetop-onboarding-custom-label">
				<span>Custom trait</span>
				<input type="text" class="onboard-ac-trait-custom"
				       value="{{acData.selectedType.customTrait}}"
				       aria-label="Custom trait"
				       placeholder="Write your own…"
				       {{#if acData.selectedType.customTraitDisabled}}disabled{{/if}}>
			</label>
		</div>
		{{/if}}

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">Instinct</p>
			<div class="stonetop-onboarding-cards stonetop-onboarding-cards--compact">
				{{#each acData.instincts}}
				<label class="stonetop-onboarding-card stonetop-onboarding-card--compact{{#if selected}} is-selected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<input type="radio" name="onboard-ac-instinct" value="{{this.value}}"
						       {{#if selected}}checked{{/if}}>
						<span class="stonetop-onboarding-card-inline-desc">{{this.value}}</span>
					</div>
				</label>
				{{/each}}
			</div>
			<label class="stonetop-onboarding-custom-label">
				<span>Custom instinct</span>
				<input type="text" class="onboard-ac-instinct-custom"
				       value="{{acData.customInstinct}}"
				       aria-label="Custom instinct"
				       placeholder="Write your own…">
			</label>
		</div>

		<div class="stonetop-onboarding-insert-section">
			<p class="stonetop-onboarding-insert-section-label">Cost</p>
			<div class="stonetop-onboarding-cards stonetop-onboarding-cards--compact">
				{{#each acData.costs}}
				<label class="stonetop-onboarding-card stonetop-onboarding-card--compact{{#if selected}} is-selected{{/if}}">
					<div class="stonetop-onboarding-card-header">
						<input type="radio" name="onboard-ac-cost" value="{{this.value}}"
						       {{#if selected}}checked{{/if}}>
						<span class="stonetop-onboarding-card-inline-desc">{{this.value}}</span>
					</div>
				</label>
				{{/each}}
			</div>
			<label class="stonetop-onboarding-custom-label">
				<span>Custom cost</span>
				<input type="text" class="onboard-ac-cost-custom"
				       value="{{acData.customCost}}"
				       aria-label="Custom cost"
				       placeholder="Write your own…">
			</label>
		</div>

		<div class="stonetop-onboarding-name-row">
			<label class="stonetop-onboarding-name-label" for="onboard-ac-name">Name <em>(optional)</em></label>
			<input id="onboard-ac-name" type="text" class="onboard-ac-name"
			       value="{{acData.companionName}}"
			       placeholder="Your companion's name…">
		</div>
		{{/if}}

		{{!-- ── Lore (Character History) ─────────────────────────── --}}
		{{!-- ── Seeker: Major Arcanum ────────────────────────────── --}}
		{{#if isSeekerArcana}}
		<h3 class="stonetop-onboarding-step-title">{{seekerArcanaData.title}}</h3>
		<div class="stonetop-onboarding-arcana-picker">
			<section class="stonetop-onboarding-arcana-section">
				<h4 class="stonetop-onboarding-lore-section-title">Major Arcanum</h4>
				<p class="stonetop-onboarding-step-hint">Choose the major arcanum granted by your background.</p>
				<div class="stonetop-onboarding-arcana-grid stonetop-onboarding-arcana-grid--major">
					{{#each seekerArcanaChoices.major}}
					<label class="stonetop-onboarding-arcana-option{{#if selected}} is-selected{{/if}}">
						<input type="radio" name="onboard-seeker-major-arcanum" value="{{this.slug}}" {{#if selected}}checked{{/if}}>
						{{#if img}}<img class="stonetop-onboarding-arcana-thumb" src="{{this.img}}" alt="">{{/if}}
						<span class="stonetop-onboarding-arcana-name">{{this.name}}</span>
						<span class="stonetop-onboarding-arcana-preview">
							{{#if img}}<img src="{{this.img}}" alt="">{{/if}}
							<strong>{{this.name}}</strong>
							<span>{{this.description}}</span>
						</span>
					</label>
					{{/each}}
				</div>
			</section>
		</div>
		{{#if seekerArcanaData.sections.length}}
		<div class="stonetop-onboarding-combined-lore">
			{{#each seekerArcanaData.sections}}
			<section class="stonetop-onboarding-lore-section">
				<h4 class="stonetop-onboarding-lore-section-title">{{this.title}}</h4>
				{{#if description}}
				<div class="stonetop-onboarding-lore-desc">{{{this.description}}}</div>
				{{/if}}
				{{#if isTextSection}}
				<div class="stonetop-onboarding-lore-texts">
					{{#each options}}
					<div class="stonetop-onboarding-lore-text-row{{#if isUnlockMark}} stonetop-onboarding-arcana-unlock-row{{/if}}">
						{{#if isUnlockMark}}{{#if unlockHasTrack}}
						<div class="stonetop-onboarding-arcana-unlock">
							<p class="stonetop-onboarding-arcana-unlock-hint">You’ve begun to unlock the mysteries of {{#if majorName}}the {{this.majorName}}{{else}}your major arcanum{{/if}}. This is the front of its insert: mark 1 below:</p>
							<div class="stonetop-onboarding-arcana-front-card">
								<div class="stonetop-onboarding-arcana-front-header">
									{{#if frontCard.img}}<img class="stonetop-onboarding-arcana-front-thumb" src="{{frontCard.img}}" alt="">{{/if}}
									<span class="stonetop-onboarding-arcana-front-title">{{frontCard.title}}</span>
								</div>
								<div class="stonetop-arcanum-body stonetop-onboarding-arcana-front-body">
									{{{frontCard.descriptionHtml}}}
									{{#if frontCard.unlockHtml}}
									<p class="stonetop-arcanum-unlock-lead">{{{frontCard.unlockHtml}}}</p>
									{{/if}}
								</div>
							</div>
						</div>
						{{/if}}{{/if}}
						<label class="stonetop-onboarding-lore-text-label">{{{this.description}}}</label>
						<textarea class="onboard-lore-text"
						          data-section="{{this.sectionSlug}}"
						          data-option="{{this.slug}}"
						          rows="2"
						          placeholder="Your answer…">{{this.value}}</textarea>
					</div>
					{{/each}}
				</div>
				{{/if}}
			</section>
			{{/each}}
		</div>
		{{/if}}
		{{/if}}

		{{!-- ── Seeker: Minor Arcana + Questions ──────────────────── --}}
		{{#if isSeekerArcanaMinor}}
		<h3 class="stonetop-onboarding-step-title">Minor Arcana &amp; Questions</h3>
		<div class="stonetop-onboarding-arcana-picker">
			<section class="stonetop-onboarding-arcana-section">
				<h4 class="stonetop-onboarding-lore-section-title">Minor Arcana</h4>
				<p class="stonetop-onboarding-step-hint">Three minor arcana have been drawn at random below. Review both sides of each (<em>Read both sides</em>), then assign a role: one you've Mastered, one you've Found, and one you have a Lead on. Not the draw you wanted? Use <em>Draw again</em> to re-roll all three, or swap any single card for a specific one.</p>
				<p class="stonetop-onboarding-lore-counter">
					<span class="stonetop-onboarding-seeker-minor-count">{{seekerArcanaChoices.minorAssignedCount}}</span>
					/ {{seekerArcanaChoices.minorPickCount}} assigned
					<button type="button" class="stonetop-onboarding-redraw-minor">Draw again</button>
				</p>
				<div class="stonetop-onboarding-arcana-grid stonetop-onboarding-arcana-grid--minor">
					{{#each seekerArcanaChoices.minor}}
					<div class="stonetop-onboarding-arcana-option stonetop-onboarding-arcana-option--minor-role{{#if role}} is-selected{{/if}}">
						<span class="stonetop-onboarding-arcana-name">{{this.name}}</span>
						<span class="stonetop-onboarding-arcana-preview">
							{{#if img}}<img src="{{this.img}}" alt="">{{/if}}
							<strong>{{this.name}}</strong>
							<span>{{this.description}}</span>
							{{#if backSummary}}<strong>{{#if backTitle}}{{this.backTitle}}{{else}}Back{{/if}}</strong>
							<span>{{this.backSummary}}</span>{{/if}}
						</span>
						{{!-- "Review both sides": the whole card, front and back, folded until opened. --}}
						<details class="stonetop-onboarding-minor-sides">
							<summary>Read both sides</summary>
							<div class="stonetop-arcanum-body stonetop-onboarding-minor-side">
								<h5>Front{{#if frontTitle}}: {{this.frontTitle}}{{/if}}</h5>
								{{{this.frontDescription}}}
								{{#if unlockDescription}}<p class="stonetop-arcanum-unlock-lead">{{{this.unlockDescription}}}</p>{{/if}}
							</div>
							{{#if backDescription}}
							<div class="stonetop-arcanum-body stonetop-onboarding-minor-side">
								<h5>Back{{#if backTitle}}: {{this.backTitle}}{{/if}}</h5>
								{{{this.backDescription}}}
							</div>
							{{/if}}
						</details>
						<div class="stonetop-onboarding-minor-roles">
							<label>
								<input type="radio" name="onboard-seeker-minor-role-{{this.slug}}" value="mastered" data-slug="{{this.slug}}" {{#if (eq role "mastered")}}checked{{/if}}>
								Mastered
							</label>
							<label>
								<input type="radio" name="onboard-seeker-minor-role-{{this.slug}}" value="found" data-slug="{{this.slug}}" {{#if (eq role "found")}}checked{{/if}}>
								Found
							</label>
							<label>
								<input type="radio" name="onboard-seeker-minor-role-{{this.slug}}" value="lead" data-slug="{{this.slug}}" {{#if (eq role "lead")}}checked{{/if}}>
								Lead
							</label>
						</div>
						{{#if swapOptions.length}}
						<label class="stonetop-onboarding-minor-swap">
							<span class="stonetop-onboarding-minor-swap-label">Swap this card</span>
							<select class="stonetop-onboarding-minor-swap-select" data-slug="{{this.slug}}">
								<option value="" selected>Swap for…</option>
								{{#each swapOptions}}
								<option value="{{this.slug}}">{{this.name}}</option>
								{{/each}}
							</select>
						</label>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</section>
		</div>

		<div class="stonetop-onboarding-combined-lore">
			{{#each seekerArcanaData.sections}}
			<section class="stonetop-onboarding-lore-section">
				{{!-- Header + intro moved up under the picker's "Minor Arcana" heading. --}}
				{{#if isTextSection}}
				<div class="stonetop-onboarding-lore-texts">
					{{#each options}}
					<div class="stonetop-onboarding-lore-text-row">
						<label class="stonetop-onboarding-lore-text-label">{{{this.description}}}</label>
						<textarea class="onboard-lore-text"
						          data-section="{{this.sectionSlug}}"
						          data-option="{{this.slug}}"
						          rows="2"
						          placeholder="Your answer…">{{this.value}}</textarea>
					</div>
					{{/each}}
				</div>
				{{/if}}
			</section>
			{{/each}}
		</div>
		{{/if}}

		{{#if isLore}}
		{{#if loreSectionData.groupHeading}}
		<h3 class="stonetop-onboarding-step-title">{{loreSectionData.groupHeading}}</h3>
		{{#if loreSectionData.groupIntro}}<div class="stonetop-onboarding-lore-intro">{{{loreSectionData.groupIntro}}}</div>{{/if}}
		{{#if loreSectionData.title}}<p class="stonetop-onboarding-lore-prompt">{{loreSectionData.title}}</p>{{/if}}
		{{else}}
		{{#if loreSectionData.title}}<h3 class="stonetop-onboarding-step-title">{{loreSectionData.title}}</h3>{{/if}}
		{{/if}}
		{{#if loreSectionData.description}}
		<div class="stonetop-onboarding-lore-desc">{{{loreSectionData.description}}}</div>
		{{/if}}
		{{#if loreSectionData.contextAnswers}}
		<div class="stonetop-onboarding-lore-context">
			{{#if loreSectionData.contextTitle}}
			<div class="stonetop-onboarding-lore-context-label">{{loreSectionData.contextTitle}}</div>
			{{/if}}
			{{#each loreSectionData.contextAnswers}}
			<div class="stonetop-onboarding-lore-context-answer">{{{this}}}</div>
			{{/each}}
		</div>
		{{/if}}

		{{#if loreSectionData.isPickSection}}
		{{#if loreSectionData.pickMax}}
		<p class="stonetop-onboarding-lore-counter">
			<span class="stonetop-onboarding-lore-pick-count">{{loreSectionData.selectedPickCount}}</span>
			/ {{loreSectionData.pickMax}} chosen
		</p>
		{{/if}}
		<div class="stonetop-onboarding-lore-picks">
			{{#each loreSectionData.options}}
			<label class="stonetop-onboarding-lore-pick{{#if isSelected}} is-selected{{/if}}{{#if disabled}} stonetop-onboarding-lore-pick--disabled{{/if}}">
				<input type="checkbox" class="stonetop-onboarding-check"
				       name="onboard-lore-pick-{{this.sectionSlug}}"
				       value="{{this.slug}}"
				       data-section="{{this.sectionSlug}}"
				       data-option="{{this.slug}}"
				       data-index="0"
				       {{#if isSelected}}checked{{/if}}
				       {{#if disabled}}disabled{{/if}}>
				{{#each extraBoxes}}
				<input type="checkbox" class="stonetop-onboarding-check"
				       name="onboard-lore-pick-{{../sectionSlug}}"
				       value="{{../slug}}"
				       data-section="{{../sectionSlug}}"
				       data-option="{{../slug}}"
				       data-index="{{this.index}}"
				       aria-label="Choose it again"
				       {{#if checked}}checked{{/if}}
				       {{#if disabled}}disabled{{/if}}>
				{{/each}}
				<span class="stonetop-onboarding-lore-pick-text">{{#if hasBlank}}{{{this.fillBefore}}}<input type="text" class="onboard-lore-text stonetop-onboarding-lore-fill" data-section="{{this.sectionSlug}}" data-option="{{this.slug}}" value="{{this.fillValue}}" placeholder="…" aria-label="Fill in the blank">{{{this.fillAfter}}}{{else}}{{{this.description}}}{{/if}}</span>
			</label>
			{{/each}}
		</div>
		{{/if}}

		{{#if loreSectionData.isTextSection}}
		<div class="stonetop-onboarding-lore-texts">
			{{#each loreSectionData.options}}
			<div class="stonetop-onboarding-lore-text-row">
				<label class="stonetop-onboarding-lore-text-label">{{{this.description}}}</label>
				<textarea class="onboard-lore-text"
				          data-section="{{this.sectionSlug}}"
				          data-option="{{this.slug}}"
				          rows="2"
				          placeholder="Your answer…">{{this.value}}</textarea>
			</div>
			{{/each}}
		</div>
		{{/if}}
		{{/if}}

	</div>{{!-- /.stonetop-onboarding-step --}}

	{{!-- Footer --}}
	<footer class="stonetop-onboarding-footer">
		{{!-- The last page names the earlier pages left unfinished (Skip). A flag, never a
		      block: Create Character stays live, and each name jumps back to its page. --}}
		{{#if skippedSteps.length}}
		<div class="stonetop-onboarding-skipped" role="note">
			<p class="stonetop-onboarding-skipped-lead"><strong>Not finished yet:</strong> you can create the character now and fill these in on the sheet, or go back to them.</p>
			<ul class="stonetop-onboarding-skipped-list">
				{{#each skippedSteps}}
				<li><button type="button" class="stonetop-onboarding-skipped-jump" data-step-index="{{this.index}}">{{this.label}}</button></li>
				{{/each}}
			</ul>
		</div>
		{{/if}}
		<div class="stonetop-onboarding-footer-nav">
			{{#if showBack}}
			{{#if isFirst}}
			<button type="button" class="stonetop-onboarding-back-to-picker"><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>
			{{else}}
			<button type="button" class="stonetop-onboarding-back"><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>
			{{/if}}
			{{else}}
			<span class="stonetop-onboarding-footer-placeholder" aria-hidden="true"></span>
			{{/if}}

			<span class="stonetop-onboarding-step-counter">{{this.stepNumber}} / {{this.stepCount}}</span>

			<div class="stonetop-onboarding-footer-right">
				<button type="button" class="stonetop-onboarding-skip">Skip</button>
				{{#if isLast}}
				<button type="button" class="stonetop-onboarding-confirm" {{#unless stepComplete}}disabled{{/unless}}>Create Character</button>
				{{else}}
				<button type="button" class="stonetop-onboarding-next" {{#unless stepComplete}}disabled{{/unless}}>Next<span class="stonetop-nav-arrow"></span></button>
				{{/if}}
			</div>
		</div>
	</footer>

</div>
