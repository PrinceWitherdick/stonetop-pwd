{{!-- Call Up the Deep Ones (Book II, "Mysteries of the Ring of Daagon"). A left-rail
      window on the spring/guide chrome: the dice and their aspects, the traits, the
      moves and the batch each get a panel, one at a time. Reactive (every change
      re-renders); the active panel is instance state. See
      dialogs/CallUpDeepOnesDialog.js. --}}
<div class="stonetop-spring">

  <div class="stonetop-guide-split">

    {{> "stonetop.guide-tabs" tabs=tabs btnClass="stonetop-cu-tab" ariaLabel="Call Up the Deep Ones"}}

    <div class="stonetop-guide-main stonetop-cu-main">

      {{!-- Banner: the active panel's title, and the batch as it stands so far, so a size
            die or a trait shows what it does while it is being chosen. --}}
      <div class="stonetop-guide-banner">
        <i class="fas {{active.icon}} stonetop-guide-banner-icon stonetop-cu-banner-icon"></i>
        <div class="stonetop-guide-banner-info">
          <div class="stonetop-guide-banner-title stonetop-cu-banner-title">{{active.title}}</div>
          <div class="stonetop-guide-banner-sub stonetop-cu-stat-line">{{this.statLine}}</div>
        </div>
      </div>

      {{!-- The five d4s, and which aspect each one shapes --}}
      <section class="stonetop-cu-panel" data-tab="dice"{{#unless (eq activeTab "dice")}} hidden{{/unless}}>
        <p class="stonetop-cu-rule">Roll five d4s and assign each to a different aspect.</p>
        <div class="stonetop-cu-dice-row">
          {{#each dice}}
          <span class="stonetop-cu-die{{#if assignedTo}} is-assigned{{/if}}" data-tooltip="{{this.label}}{{#if assignedTo}} → {{this.assignedTo}}{{/if}}" data-tooltip-direction="UP">
            <span class="stonetop-cu-die-value">{{this.value}}</span>
            <span class="stonetop-cu-die-label">{{this.label}}</span>
          </span>
          {{/each}}
          <button type="button" class="stonetop-cu-reroll stonetop-inline-btn" data-tooltip="Roll five fresh d4s. The table sees the re-roll in chat." data-tooltip-direction="UP">
            <i class="fas fa-dice" aria-hidden="true"></i> Re-roll
          </button>
        </div>

        <div class="stonetop-cu-aspects">
          {{#each aspects}}
          <div class="stonetop-cu-aspect">
            <div class="stonetop-cu-aspect-name">
              <span class="stonetop-cu-aspect-label">{{this.label}}</span>
              <span class="stonetop-cu-aspect-hint">{{this.hint}}</span>
            </div>
            <select class="stonetop-cu-input stonetop-cu-assign" data-aspect="{{this.key}}" data-cu-focus="assign-{{this.key}}" aria-label="Die for {{this.label}}">
              {{#each options}}<option value="{{this.index}}" {{#if selected}}selected{{/if}} {{#if disabled}}class="is-used"{{/if}}>{{this.label}}</option>{{/each}}
            </select>
            <span class="stonetop-cu-aspect-result">{{this.outcome}}</span>
          </div>
          {{/each}}
        </div>
      </section>

      {{!-- Traits: choose exactly as many as the Traits die --}}
      <section class="stonetop-cu-panel" data-tab="traits"{{#unless (eq activeTab "traits")}} hidden{{/unless}}>
        <p class="stonetop-cu-rule">Choose a number equal to the assigned die
          <span class="stonetop-cu-picker-count{{#if traitsMet}} is-met{{/if}}">{{this.traitCount}} of {{this.traitLimit}}</span></p>
        <div class="stonetop-cu-picker-options">
          {{#each traitOptions}}
          <label class="stonetop-cu-option{{#if checked}} is-checked{{/if}}{{#if disabled}} is-disabled{{/if}}">
            <input type="checkbox" class="stonetop-cu-trait" value="{{this.key}}" data-cu-focus="trait-{{this.key}}" {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}}>
            <span class="stonetop-cu-option-label">{{this.label}}</span>
            <span class="stonetop-cu-option-detail">{{this.detail}}</span>
          </label>
          {{/each}}
        </div>
      </section>

      {{!-- Moves: choose exactly as many as the Moves die --}}
      <section class="stonetop-cu-panel" data-tab="moves"{{#unless (eq activeTab "moves")}} hidden{{/unless}}>
        <p class="stonetop-cu-rule">Choose a number equal to the assigned die
          <span class="stonetop-cu-picker-count{{#if movesMet}} is-met{{/if}}">{{this.moveCount}} of {{this.moveLimit}}</span></p>
        <div class="stonetop-cu-picker-options">
          {{#each moveOptions}}
          <label class="stonetop-cu-option{{#if checked}} is-checked{{/if}}{{#if disabled}} is-disabled{{/if}}">
            <input type="checkbox" class="stonetop-cu-move" value="{{this.label}}" data-cu-focus="move-{{@index}}" {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}}>
            <span class="stonetop-cu-option-label">{{this.label}}</span>
          </label>
          {{/each}}
        </div>
      </section>

      {{!-- The batch: its name, what will manifest, and the price --}}
      <section class="stonetop-cu-panel" data-tab="summon"{{#unless (eq activeTab "summon")}} hidden{{/unless}}>
        <label class="stonetop-cf-label stonetop-cu-name-label">Name this batch
          <input type="text" class="stonetop-cf-input stonetop-cu-name" data-cu-focus="name" value="{{this.name}}" placeholder="{{this.namePlaceholder}}">
        </label>

        <div class="stonetop-cu-preview">
          <div class="stonetop-cu-preview-head">
            <i class="fas fa-fish"></i>
            <span class="stonetop-cu-preview-name">{{preview.name}}</span>
            <span class="stonetop-cu-preview-type">{{preview.typeLabel}}{{#if preview.strength}} · {{preview.strength}}, rolled as they appear{{/if}}</span>
          </div>
          <div class="stonetop-cu-preview-tags">
            {{#each preview.tags}}<span class="stonetop-cu-preview-tag">{{this}}</span>{{/each}}
            {{#if preview.exceptional}}<span class="stonetop-cu-preview-tag is-exceptional">exceptional</span>{{/if}}
          </div>
          <div class="stonetop-cu-preview-stats">
            <span><strong>HP</strong> {{preview.hp}}{{#if preview.strength}} each{{/if}}</span>
            <span><strong>Armor</strong> {{preview.armor}}</span>
            <span><strong>Damage</strong> {{preview.damage}}</span>
          </div>
          <div class="stonetop-cu-preview-moves"><strong>Instinct</strong> {{preview.instinct}}</div>
          {{#if preview.moves.length}}
          <div class="stonetop-cu-preview-moves"><strong>Moves</strong> {{#each preview.moves}}<span>{{this}}</span>{{/each}}</div>
          {{/if}}
        </div>

        {{!-- Cost: spend 1 Loyalty from the Ring, or mark a consequence --}}
        {{#if hasRing}}
        <div class="stonetop-cu-cost">
          <span class="stonetop-cu-cost-label">To call them up you must</span>
          <label class="stonetop-cu-cost-choice{{#if loyaltyDisabled}} is-disabled{{/if}}">
            <input type="radio" name="callup-cost" class="stonetop-cu-cost-input" data-cu-focus="cost-loyalty" value="loyalty" {{#if costLoyalty}}checked{{/if}} {{#if loyaltyDisabled}}disabled{{/if}}>
            <span>Spend <strong>1 Loyalty</strong> from {{this.ringName}} <span class="stonetop-cu-cost-note">({{this.ringLoyalty}} held)</span></span>
          </label>
          <label class="stonetop-cu-cost-choice">
            <input type="radio" name="callup-cost" class="stonetop-cu-cost-input" data-cu-focus="cost-consequence" value="consequence" {{#if costConsequence}}checked{{/if}}>
            <span>Mark a <strong>consequence</strong></span>
          </label>
        </div>
        {{/if}}

        {{#unless complete}}
        <p class="stonetop-cu-missing"><i class="fas fa-circle-info" aria-hidden="true"></i> Still to choose: {{this.stillToChoose}}.</p>
        {{/unless}}
      </section>

    </div>
  </div>

  {{!-- Call them up / Cancel at one end, the rail's Back/Next at the other. --}}
  <footer class="stonetop-guide-nav stonetop-cu-nav">
    <span class="stonetop-cu-nav-btns">
      <button type="button" class="stonetop-cu-manifest stonetop-guide-btn--primary" {{#unless complete}}disabled{{/unless}}>
        <i class="fas fa-fish" aria-hidden="true"></i> Call them up
      </button>
      <button type="button" class="stonetop-cu-cancel">Cancel</button>
    </span>
    <span class="stonetop-cu-nav-btns">
      <button type="button" class="stonetop-cu-back"{{#if atFirst}} disabled{{/if}}><span class="stonetop-nav-arrow stonetop-nav-arrow--back" aria-hidden="true"></span>Back</button>
      <button type="button" class="stonetop-cu-next"{{#if atLast}} disabled{{/if}}>Next<span class="stonetop-nav-arrow" aria-hidden="true"></span></button>
    </span>
  </footer>

</div>
