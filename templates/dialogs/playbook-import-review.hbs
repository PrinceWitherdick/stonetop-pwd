{{!-- Check a PDF import before it reaches the Playbook Builder (playbooks/PlaybookImportReview.js):
      a left rail of pages like the Welcome guide. "Start here" holds what needs confirming (the
      stats, HP, name and description are seen and edited in the builder, not here); then one page per section of the playbook, every piece movable with its "Belongs in"
      list. Pages switch client-side (applyGuideRail); every panel is always in the DOM. Nothing is
      saved from here. --}}
<form class="stonetop-pb-review-form" autocomplete="off">
	<div class="stonetop-guide-split stonetop-pb-review-split">
		{{> "stonetop.guide-tabs" tabs=this.tabs btnClass="stonetop-pb-review-tab" ariaLabel="Playbook sections"}}

		<div class="stonetop-guide-main stonetop-pb-review-body">

		<section class="stonetop-pb-review-panel" data-tab="overview"{{#unless this.overviewSelected}} hidden{{/unless}}>
		<header class="stonetop-pb-review-head">
			<h2 class="stonetop-pb-review-imported"><i class="fas fa-circle-check stonetop-pb-review-imported-icon" aria-hidden="true"></i>Successfully imported from <strong>{{this.fileName}}</strong></h2>
			<p class="stonetop-pb-review-lead">Nothing is saved yet. Answer anything below, move any piece that landed in the wrong place, then finish it in the builder, where the name, description and every other word can be edited.</p>
			{{#if this.existing}}<p class="stonetop-pb-review-issue stonetop-pb-review-existing">{{this.existing}}</p>{{/if}}
			{{#each this.issues}}<p class="stonetop-pb-review-issue">{{this}}</p>{{/each}}
		</header>

		{{!-- Heads the questions and the hard-to-place pieces below; gone when the import has neither. --}}
		{{#if this.hasIssues}}
		<h3 class="stonetop-pb-review-h3 stonetop-pb-review-issues-head">To check</h3>
		{{/if}}

		{{#if this.confirm.length}}
		<section class="stonetop-pb-review-confirm" aria-label="Please confirm">
			{{#each this.confirm}}
			<div class="stonetop-pb-review-question{{#if this.answered}} is-answered{{/if}}" data-key="{{this.key}}">
				<p class="stonetop-pb-review-q-label">{{this.label}}</p>
				<p class="stonetop-pb-review-q-why">{{this.why}}</p>
				<div class="stonetop-pb-review-q-answers">
					{{#if this.isText}}
					<input type="text" data-confirm="{{this.key}}" value="{{this.value}}" aria-label="{{this.label}}">
					{{/if}}
					{{#if this.isSelect}}
					<select class="stonetop-pb-review-q-select" data-confirm="{{this.key}}" aria-label="{{this.label}}">
						{{#unless this.value}}<option value="" selected>Choose…</option>{{/unless}}
						{{#each this.options}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
					</select>
					{{/if}}
					{{#each this.choices}}
					<label class="stonetop-pb-review-q-choice"><input type="radio" name="confirm-{{../key}}" data-confirm="{{../key}}" value="{{this.value}}"{{#if this.checked}} checked{{/if}}> <span class="stonetop-chip-text">{{this.label}}</span></label>
					{{/each}}
					{{#if this.isNumber}}
					<label class="stonetop-pb-review-q-choice">
						{{#if this.choices.length}}<input type="radio" name="confirm-{{this.key}}" data-confirm="{{this.key}}" value="__other"{{#if this.isOther}} checked{{/if}}> <span class="stonetop-chip-text">Another number:</span>{{/if}}
						<input type="number" class="stonetop-pb-review-q-number" min="1" max="40" data-confirm-other="{{this.key}}" value="{{#if this.isOther}}{{this.value}}{{else}}{{#unless this.choices.length}}{{this.value}}{{/unless}}{{/if}}" aria-label="{{this.label}}">
					</label>
					{{/if}}
				</div>
			</div>
			{{/each}}
		</section>
		{{/if}}

		{{#if this.unsureCount}}
		<section class="stonetop-pb-review-unsure">
			<p><strong>{{this.unsureCount}} {{#if (eq this.unsureCount 1)}}piece needs{{else}}pieces need{{/if}} a look.</strong></p>
			<p class="stonetop-pb-review-unsure-why">The importer wasn't sure how to read {{#if (eq this.unsureCount 1)}}it{{else}}them{{/if}}. Find {{#if (eq this.unsureCount 1)}}it{{else}}them{{/if}} on:</p>
			<ul class="stonetop-pb-review-unsure-where">{{#each this.unsureSections}}<li><a class="stonetop-pb-review-unsure-link" role="button" tabindex="0" data-goto-tab="{{this.key}}">{{this.title}}</a></li>{{/each}}</ul>
			<p class="stonetop-pb-review-unsure-todo">Each one is edged in red, with a note saying what to check. If it's fine as it is, press <em>Looks right</em>. If it's in the wrong section, choose the right one in its <em>Belongs in</em> list.</p>
		</section>
		{{/if}}

		</section>

		{{#each this.groups}}
		<section class="stonetop-pb-review-panel" data-tab="{{this.kind}}"{{#unless this.selected}} hidden{{/unless}}>
			{{!-- A page can hold more than one kind (Starting moves and Other moves on Moves): each kind
			      is its own part under the character sheet's section heading (the red underline); a page
			      of one kind heads its one part with the page's name. Join reaches only within a part. --}}
			{{#each this.parts}}
			<section class="stonetop-pb-review-group" data-kind="{{this.kind}}">
				{{> "stonetop.section-heading" title=this.title}}
				{{#if this.lead}}<p class="stonetop-pb-review-lead">{{this.lead}}</p>{{/if}}
				{{#each this.blocks}}
				{{!-- A piece's controls (Belongs in, Split, Join) stay hidden until its pencil is pressed
				      (is-editing). A flagged piece (is-unsure) has no pencil: it shows Belongs in, Looks right,
				      Split and Join from the start. The pencil shows on hover or focus, and is a check while pressed. --}}
				<article class="stonetop-pb-review-block{{#if this.unsure}} is-unsure{{/if}}{{#if this.moved}} is-moved{{/if}}{{#if this.editing}} is-editing{{/if}}" data-id="{{this.id}}">
					<div class="stonetop-pb-review-block-head">
						<strong class="stonetop-pb-review-block-title">{{this.title}}</strong>
						{{#if this.tags}}<span class="stonetop-pb-review-block-tags">{{this.tags}}</span>{{/if}}
						{{!-- Belongs in and Looks right share a field row: the button stands the dropdown's height. --}}
						<span class="stonetop-pb-review-belongs-row stonetop-field-btns">
						<label class="stonetop-pb-review-belongs" data-tooltip="The section this piece will be built into. Choose another to move it there, or Leave it out to drop it from the playbook.">Belongs in
							<select data-block="{{this.id}}">
								{{#each this.kindOptions}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}
								{{#each this.insertOptions}}<optgroup label="{{this.label}}">{{#each this.options}}<option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>{{/each}}</optgroup>{{/each}}
								<optgroup label="Not in the playbook"><option value="skip"{{#if this.leftOut}} selected{{/if}}>Leave it out</option></optgroup>
							</select>
						</label>
						{{#if this.unsure}}<button type="button" class="stonetop-pb-review-act stonetop-pb-review-ok" data-looks-right="{{this.id}}" data-tooltip="Keep this piece where it is and take the red off."><i class="fas fa-check" aria-hidden="true"></i> <span class="stonetop-chip-text">Looks right</span></button>{{/if}}
						</span>
						{{#unless this.unsure}}{{#if this.editing}}<a class="stonetop-pb-review-edit stonetop-section-done" role="button" tabindex="0" data-edit="{{this.id}}" aria-expanded="true" aria-label="Hide the controls for {{this.title}}"><i class="fas fa-check" aria-hidden="true"></i></a>{{else}}<a class="stonetop-pb-review-edit stonetop-section-edit" role="button" tabindex="0" data-edit="{{this.id}}" aria-expanded="false" aria-label="Move, split or join {{this.title}}"><i class="fas fa-pencil" aria-hidden="true"></i></a>{{/if}}{{/unless}}
					</div>
					{{#if this.unsure}}<p class="stonetop-pb-review-why"><strong>Why it's marked:</strong> {{this.why}}</p>{{/if}}
					{{#if this.leftOutWhy}}<p class="stonetop-pb-review-why">{{this.leftOutWhy}}</p>{{/if}}
					{{#if this.moved}}<p class="stonetop-pb-review-why">Moved here by you. It was read as: {{this.readAsLabel}}.</p>{{/if}}
					{{#if this.long}}
					<details class="stonetop-pb-review-block-text"{{#if this.open}} open{{/if}}>
						<summary class="stonetop-pb-review-excerpt"><span class="stonetop-pb-review-excerpt-text">{{this.excerpt}}</span> <span class="stonetop-pb-review-more" data-tooltip="Show the whole of this piece">Show all</span><span class="stonetop-pb-review-less">Show less</span></summary>
						<div class="stonetop-pb-review-full">{{this.full}}</div>
					</details>
					{{else}}
					{{#if this.full}}<div class="stonetop-pb-review-full">{{this.full}}</div>{{/if}}
					{{/if}}
					<div class="stonetop-pb-review-block-foot">
						{{#if this.canSplit}}<button type="button" class="stonetop-pb-review-act" data-split="{{this.id}}" data-tooltip="Cut this piece into one piece per paragraph. Each new one is named by its opening words."><i class="fas fa-scissors" aria-hidden="true"></i> <span class="stonetop-chip-text">Split into {{this.splitCount}}</span></button>{{/if}}
						{{#if this.canJoin}}<button type="button" class="stonetop-pb-review-act" data-join="{{this.id}}" data-tooltip="Add this piece's words to the end of the one above it, for a piece the PDF cut in two."><i class="fas fa-arrow-up" aria-hidden="true"></i> <span class="stonetop-chip-text">Join to the one above</span></button>{{/if}}
					</div>
				</article>
				{{/each}}
			</section>
			{{/each}}
		</section>
		{{/each}}
		</div>
	</div>

	<footer class="stonetop-guide-nav stonetop-pb-review-nav">
		<span class="stonetop-custom-move-nav-btns">
			<button type="button" class="stonetop-custom-move-save stonetop-guide-btn--primary stonetop-pb-review-go">
				<i class="fas fa-arrow-right" aria-hidden="true"></i> Finish in the builder
			</button>
			<button type="button" class="stonetop-custom-move-cancel stonetop-pb-review-cancel">Cancel</button>
		</span>
		<span class="stonetop-custom-move-nav-btns">
			<button type="button" class="stonetop-custom-move-cancel stonetop-pb-review-undo" data-tooltip="Undo the last move, split, join or answer (Ctrl+Z)"{{#unless this.canUndo}} disabled{{/unless}}><i class="fas fa-rotate-left" aria-hidden="true"></i> <span class="stonetop-chip-text">Undo</span></button>
			<button type="button" class="stonetop-custom-move-cancel stonetop-pb-review-redo" data-tooltip="Redo what was undone (Ctrl+Y)"{{#unless this.canRedo}} disabled{{/unless}}><i class="fas fa-rotate-right" aria-hidden="true"></i> <span class="stonetop-chip-text">Redo</span></button>
			<button type="button" class="stonetop-custom-move-cancel stonetop-pb-review-reset" data-tooltip="Undo every move, split, join and answer, back to how the PDF was read"{{#unless this.changed}} disabled{{/unless}}><i class="fas fa-backward-fast" aria-hidden="true"></i> <span class="stonetop-chip-text">Start over</span></button>
		</span>
	</footer>
</form>
