<div class="stonetop-eos-body{{#if mirror}} stonetop-eos-body--mirror{{/if}}">

	<div class="stonetop-eos-sections">

		{{!-- ── Personal XP ─────────────────────────────────────────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.personalHeading"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.personalTag"}}</span></h3>
			<ul class="stonetop-eos-personal-list">
				<li>{{{localize "stonetop.endOfSession.instinct"}}}</li>
				<li>{{{localize "stonetop.endOfSession.relationship"}}}</li>
			</ul>
		</section>

		{{!-- ── Group XP ───────────────────────────────────────────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.groupHeading"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.groupTag"}}</span></h3>
			{{#if mirror}}
			<p class="stonetop-eos-who-hint">{{localize "stonetop.endOfSession.mirrorHint"}}</p>
			{{/if}}
			<div class="stonetop-eos-question-list">
				{{#each questions}}
				<label class="stonetop-eos-question{{#if checked}} is-checked{{/if}}">
					<input type="checkbox" class="stonetop-eos-group-check" data-key="{{this.key}}" {{#if checked}}checked{{/if}}{{#if ../mirror}} disabled{{/if}}>
					<span class="stonetop-eos-question-text">{{this.label}}</span>
				</label>
				{{/each}}
			</div>
			{{#if xpCount}}
			<p class="stonetop-eos-xp-tally">{{this.tally}}</p>
			{{/if}}
		</section>

		{{!-- ── Who marks it: everyone at the table (Book I p.232). The GM's to settle, so not on a player's copy. --}}
		{{#unless mirror}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.whoHeading"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.whoTag"}}</span></h3>
			{{#if pcs.length}}
			<p class="stonetop-eos-who-hint">{{localize "stonetop.endOfSession.whoHint"}}</p>
			<p class="stonetop-eos-who-hint">{{localize "stonetop.endOfSession.personalHint"}}</p>
			<div class="stonetop-eos-question-list stonetop-eos-pc-list">
				{{#each pcs}}
				<div class="stonetop-eos-pc">
					<label class="stonetop-eos-question{{#if checked}} is-checked{{/if}}">
						<input type="checkbox" class="stonetop-eos-group-check" data-pc="{{this.id}}" {{#if checked}}checked{{/if}}>
						<span class="stonetop-eos-question-text">{{this.name}}{{#if dead}} <em>({{localize "stonetop.endOfSession.dead"}})</em>{{/if}}</span>
					</label>
					{{! Their own XP (Book I p.75): one each for instinct and relationship, ticked as they answer. }}
					<div class="stonetop-eos-pc-personal">
						{{#each personal}}
						<label class="stonetop-eos-pc-tick">
							<input type="checkbox" class="stonetop-eos-personal-check" data-pc="{{../id}}" data-xp="{{this.key}}" {{#if checked}}checked{{/if}}>
							<span>{{this.label}}</span>
						</label>
						{{/each}}
					</div>
					<input type="text" class="stonetop-eos-note" data-pc="{{this.id}}" value="{{this.note}}"
					       placeholder="{{localize "stonetop.endOfSession.notePlaceholder"}}"
					       aria-label="{{localize "stonetop.endOfSession.noteLabel" name=name}}">
					{{#if lastWish}}
					<p class="stonetop-eos-last-wish"><strong>{{localize "stonetop.endOfSession.lastWish"}}</strong> {{this.lastWish}}</p>
					{{/if}}
				</div>
				{{/each}}
			</div>
			{{else}}
			<p class="stonetop-eos-who-hint">{{localize "stonetop.endOfSession.nobody"}}</p>
			{{/if}}
		</section>
		{{/unless}}

		{{!-- ── Around the Table ────────────────────────────────────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.tableHeading"}}</h3>
			<ul class="stonetop-eos-personal-list">
				<li>{{{localize "stonetop.endOfSession.praise"}}}</li>
				<li>{{{localize "stonetop.endOfSession.wish"}}}</li>
			</ul>
		</section>

		{{!-- ── Updating followers (Book I p.480): the GM's between-session review, folded, never on a player's copy. --}}
		{{#unless mirror}}
		<details class="stonetop-eos-section stonetop-eos-follower-review">
			<summary class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.followerReviewTitle"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.followerReviewTag"}}</span></summary>
			<p class="stonetop-eos-who-hint">{{followerReview.lead}}</p>
			<ul class="stonetop-eos-personal-list">{{#each followerReview.items}}<li>{{this}}</li>{{/each}}</ul>
			<p class="stonetop-eos-review-cite">{{localize "stonetop.endOfSession.followerReviewCite"}}</p>
		</details>
		{{/unless}}

	</div>{{!-- /.stonetop-eos-sections --}}

	<footer class="stonetop-eos-footer">
		<button type="button" class="stonetop-eos-confirm-btn">
			{{#if mirror}}
				{{localize "stonetop.endOfSession.close"}}
			{{else if canAward}}
				{{this.awardLabel}}
			{{else}}
				{{localize "stonetop.endOfSession.close"}}
			{{/if}}
		</button>
	</footer>

</div>
