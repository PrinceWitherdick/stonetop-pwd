<div class="stonetop-eos-body">

	<div class="stonetop-eos-sections">

		{{!-- ── Personal XP ─────────────────────────────────────────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.personalHeading"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.personalTag"}}</span></h3>
			<ul class="stonetop-eos-personal-list">
				<li>{{{localize "stonetop.endOfSession.instinct"}}}</li>
				<li>{{{localize "stonetop.endOfSession.relationship"}}}</li>
			</ul>
		</section>

		{{!-- ── Group XP ───────────────────────────────────────────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.groupHeading"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.groupTag"}}</span></h3>
			<div class="stonetop-eos-question-list">
				{{#each questions}}
				<label class="stonetop-eos-question{{#if checked}} is-checked{{/if}}">
					<input type="checkbox" class="stonetop-eos-group-check" data-key="{{key}}" {{#if checked}}checked{{/if}}>
					<span class="stonetop-eos-question-text">{{label}}</span>
				</label>
				{{/each}}
			</div>
			{{#if xpCount}}
			<p class="stonetop-eos-xp-tally">{{tally}}</p>
			{{/if}}
		</section>

		{{!-- ── Who marks it: everyone at the table (Book I p.232) ────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.whoHeading"}} <span class="stonetop-eos-section-tag">{{localize "stonetop.endOfSession.whoTag"}}</span></h3>
			{{#if pcs.length}}
			<p class="stonetop-eos-who-hint">{{localize "stonetop.endOfSession.whoHint"}}</p>
			<div class="stonetop-eos-question-list stonetop-eos-pc-list">
				{{#each pcs}}
				<label class="stonetop-eos-question{{#if checked}} is-checked{{/if}}">
					<input type="checkbox" class="stonetop-eos-group-check" data-pc="{{id}}" {{#if checked}}checked{{/if}}>
					<span class="stonetop-eos-question-text">{{name}}{{#if dead}} <em>({{localize "stonetop.endOfSession.dead"}})</em>{{/if}}</span>
				</label>
				{{/each}}
			</div>
			{{else}}
			<p class="stonetop-eos-who-hint">{{localize "stonetop.endOfSession.nobody"}}</p>
			{{/if}}
		</section>

		{{!-- ── Around the Table ────────────────────────────────────────── --}}
		<section class="stonetop-eos-section">
			<h3 class="stonetop-eos-section-heading">{{localize "stonetop.endOfSession.tableHeading"}}</h3>
			<ul class="stonetop-eos-personal-list">
				<li>{{{localize "stonetop.endOfSession.praise"}}}</li>
				<li>{{{localize "stonetop.endOfSession.wish"}}}</li>
			</ul>
		</section>

	</div>{{!-- /.stonetop-eos-sections --}}

	<footer class="stonetop-eos-footer">
		<button type="button" class="stonetop-eos-confirm-btn">
			{{#if xpCount}}
				{{awardLabel}}
			{{else}}
				{{localize "stonetop.endOfSession.close"}}
			{{/if}}
		</button>
	</footer>

</div>
