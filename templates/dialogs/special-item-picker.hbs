<div class="stonetop-special-picker">
	<p class="stonetop-special-picker-intro">Pick an item to add to this character's inventory. You can remove it later from the Inventory tab.</p>
	<div class="stonetop-special-picker-cols">
		{{#each columns}}
		<div class="stonetop-special-picker-col">
			<div class="stonetop-special-picker-head">
				<span class="stonetop-special-picker-head-item">Item</span>
				<span class="stonetop-special-picker-head-value">Value</span>
			</div>
			{{#each this}}
			<div class="stonetop-special-picker-group">
				<h3 class="stonetop-special-picker-cat">{{this.category}}</h3>
				{{!-- One category carries a rule of its own on the handout, printed under its
				      table rather than with the list's footnote: bronze never pierces. --}}
				{{#if note}}<p class="stonetop-special-picker-cat-note">{{this.note}}</p>{{/if}}
				{{#each items}}
				<button type="button" class="stonetop-special-pick{{#if added}} is-added{{/if}}" data-slug="{{this.slug}}"{{#if added}} disabled{{/if}}>
					<span class="stonetop-special-pick-text"><span class="stonetop-special-pick-name">{{this.name}}</span>{{#if traits}} <span class="stonetop-special-pick-traits">({{this.traits}})</span>{{/if}}</span>
					<span class="stonetop-special-pick-value"{{#if valueTooltip}} data-tooltip="{{this.valueTooltip}}" data-tooltip-direction="LEFT"{{/if}}>{{this.value}}</span>
				</button>
				{{/each}}
			</div>
			{{/each}}
		</div>
		{{/each}}
	</div>
	{{#if footnote}}<p class="stonetop-special-picker-footnote">{{this.footnote}}</p>{{/if}}
	<div class="stonetop-special-picker-actions">
		<button type="button" class="stonetop-special-picker-close">Close</button>
	</div>
</div>
