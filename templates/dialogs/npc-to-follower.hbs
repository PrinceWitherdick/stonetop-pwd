{{!-- NPC → Follower conversion (Book I, NPCs & Followers, p.475: a follower "is
      first an NPC"). Compact confirm modal; reuses the spring dialog chrome and the
      monster→follower styling. Stats are editable because an NPC may have none to
      keep as-is. See dialogs/NpcToFollowerDialog.js. --}}
<div class="stonetop-spring">

  <div class="stonetop-guide-main">

    <div class="stonetop-guide-banner">
      <i class="fas fa-user-plus stonetop-guide-banner-icon"></i>
      <div class="stonetop-guide-banner-info">
        <div class="stonetop-guide-banner-title">{{this.npcName}} <i class="fas fa-arrow-right stonetop-mf-arrow"></i> {{this.actorName}}'s follower</div>
        <div class="stonetop-guide-banner-sub">Make this NPC a follower</div>
      </div>
    </div>

    <div class="stonetop-spring-body">
      <p>A follower takes orders, holds <strong>Loyalty</strong> (max 3), and can trigger your moves. Set their <strong>stats</strong>, add any <strong>tags</strong>, and choose a <strong>cost</strong>.</p>
    </div>

    <div class="stonetop-cf-controls">

      {{!-- Stats — seeded from the NPC's game stats (or the able-bodied baseline) and
            editable here, since an NPC may carry no combat stats to keep as-is. --}}
      <div class="stonetop-mf-stats">
        <label class="stonetop-cf-label stonetop-cf-label--narrow">HP
          <input type="number" class="stonetop-cf-input stonetop-cf-input--num stonetop-nf-hp" value="{{this.hp}}" min="0" max="99">
        </label>
        <label class="stonetop-cf-label stonetop-cf-label--narrow">Armor
          <input type="number" class="stonetop-cf-input stonetop-cf-input--num stonetop-nf-armor" value="{{this.armor}}" min="0" max="9">
        </label>
        <label class="stonetop-cf-label">Damage
          <input type="text" class="stonetop-cf-input stonetop-nf-damage" value="{{this.damage}}" placeholder="e.g. knife d6 (hand)">
        </label>
      </div>

      {{#if instinct}}<div class="stonetop-cf-preview-line"><strong>Instinct</strong> {{this.instinct}}</div>{{/if}}
      {{#if keptTags.length}}
      <div class="stonetop-mf-kept">
        <span class="stonetop-cf-chosen-label">Kept tags:</span>
        <div class="stonetop-cf-chosen-tags">{{#each keptTags}}<span class="stonetop-cf-preview-tag">{{this}}</span>{{/each}}</div>
      </div>
      {{/if}}
      {{#if moves.length}}
      <div class="stonetop-cf-preview-line"><strong>Moves</strong> {{#each moves}}{{this}}{{#unless @last}}; {{/unless}}{{/each}}</div>
      {{/if}}

      {{!-- Add tags (mixed useful / problematic / mixed-blessing, per p.476) --}}
      <div class="stonetop-cf-chosen">
        <span class="stonetop-cf-chosen-label">Add tags:</span>
        {{#if addedTags.length}}
        <div class="stonetop-cf-chosen-tags">
          {{#each addedTags}}
          <button type="button" class="stonetop-cf-chosen-tag stonetop-nf-added-tag" data-tag="{{this}}"><span class="stonetop-chip-text">{{this}}</span> <i class="fas fa-times"></i></button>
          {{/each}}
        </div>
        {{else}}<span class="stonetop-cf-chosen-empty">none</span>{{/if}}
      </div>
      <div class="stonetop-cf-tag-add-row">
        <input type="text" class="stonetop-cf-input stonetop-nf-tag-input" placeholder="add a tag (or comma-separated)…">
        <button type="button" class="stonetop-nf-tag-add stonetop-cf-mini-btn"><i class="fas fa-plus"></i> Add</button>
      </div>

      {{!-- Group follower (p.470): a warband with shared stats but a roster and the
            group-fight tools. Off by default for a lone NPC. --}}
      <label class="stonetop-cf-label stonetop-mf-group-label">
        <span><input type="checkbox" class="stonetop-nf-group-toggle" {{#if isGroup}}checked{{/if}}> Treat as a group</span>
        {{#if isGroup}}
        <span class="stonetop-mf-group-size-row">of
          <input type="number" class="stonetop-cf-input stonetop-cf-input--num stonetop-nf-group-size" value="{{this.groupSize}}" min="2" max="99"> members
        </span>
        {{/if}}
      </label>

      {{!-- Pronoun (prefilled from the NPC) --}}
      <label class="stonetop-cf-label stonetop-cf-label--narrow">Pronoun
        <input type="text" class="stonetop-cf-input stonetop-nf-pronoun" value="{{this.pronoun}}" placeholder="she/he/they…" maxlength="12">
      </label>

      {{!-- Cost (p.479): what keeps them following your lead --}}
      <label class="stonetop-cf-label">Cost
        <input type="text" class="stonetop-cf-input stonetop-nf-cost-input" value="{{this.cost}}" placeholder="what keeps them following your lead…">
      </label>
      <div class="stonetop-cf-chips">
        {{#each costOptions}}
        <button type="button" class="stonetop-cf-chip stonetop-nf-cost-ex{{#if selected}} is-selected{{/if}}" data-value="{{this.value}}">{{this.value}}</button>
        {{/each}}
      </div>

    </div>

  </div>

  <div class="stonetop-guide-nav">
    <button class="stonetop-nf-create stonetop-guide-btn--primary"><i class="fas fa-user-plus"></i> Create follower</button>
    <button class="stonetop-nf-cancel">Cancel</button>
  </div>

</div>
