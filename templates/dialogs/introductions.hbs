<div class="stonetop-intros">

  {{!-- ── Pre-check screen ──────────────────────────────────────────────────── --}}
  {{#if isPreCheck}}
  <div class="stonetop-intros-precheck">

    <p class="stonetop-intros-preamble">
      Introductions go around the table in this order.{{#if canReorder}} Randomize it, or move someone up or down, then begin.{{/if}}
    </p>

    {{#if hasNone}}
    <div class="stonetop-intros-notice stonetop-intros-notice--warn">
      <i class="fas fa-exclamation-triangle"></i>
      <span>No characters with a playbook were found. Create your player characters first.</span>
    </div>
    {{else}}
    <div class="stonetop-intros-notice stonetop-intros-notice--ok">
      <i class="fas fa-check-circle"></i>
      <div class="stonetop-intros-ok-body">
        <p>All {{this.pcCount}} player characters are ready, in order:</p>
        {{!-- The order is the introductions' own setting (dialogs/introductions-order.js). A GM
              moves a name one place at a time; the arrow that would move it off either end is
              disabled rather than hidden, so every row's arrows line up. Labels carry the name,
              a player-typed string, so the hover text is data-tooltip-text (plain text). --}}
        <ol class="stonetop-intros-order">
          {{#each pcs}}
          <li class="stonetop-intros-order-item">
            <div class="stonetop-intros-order-row">
              <span class="stonetop-intros-order-name">{{this.name}}</span>
              {{#if ../canReorder}}
              <span class="stonetop-intros-order-moves">
                <button type="button" class="stonetop-intros-move" data-actor-id="{{this.id}}" data-delta="-1"
                        aria-label="{{this.upLabel}}" data-tooltip-text="{{this.upLabel}}"{{#if first}} disabled{{/if}}>
                  <i class="fas fa-arrow-up" aria-hidden="true"></i>
                </button>
                <button type="button" class="stonetop-intros-move" data-actor-id="{{this.id}}" data-delta="1"
                        aria-label="{{this.downLabel}}" data-tooltip-text="{{this.downLabel}}"{{#if last}} disabled{{/if}}>
                  <i class="fas fa-arrow-down" aria-hidden="true"></i>
                </button>
              </span>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ol>
      </div>
      {{#if canReorder}}
      <button type="button" class="stonetop-intros-shuffle" title="Randomize the order">
        <i class="fas fa-shuffle"></i> Randomize
      </button>
      {{/if}}
    </div>
    {{/if}}

    <p class="stonetop-intros-reminder">
      <i class="fas fa-info-circle"></i>
      <em>When someone reveals something and you want to know more, ask them about it. When someone asks you a question, answer it truthfully.</em>
    </p>

  </div>

  {{!-- ── Main intro content ─────────────────────────────────────────────────── --}}
  {{else}}
  <div class="stonetop-guide-split">

    {{!-- GM-only jump-to-step rail (shared guide-toc partial). Players have no rail
          (they follow the GM's cursor), so the split holds a lone column that fills
          the width. --}}
    {{#if steps}}
    {{> "stonetop.guide-toc" ariaLabel="Introduction steps"}}
    {{/if}}

    <div class="stonetop-guide-main">

    {{#if currentPc}}
    <div class="stonetop-guide-banner">
      {{#if currentPc.icon}}<img class="stonetop-intros-pc-icon" src="{{currentPc.icon}}" alt="">{{/if}}
      <div class="stonetop-guide-banner-info">
        <div class="stonetop-guide-banner-title stonetop-guide-truncate">{{currentPc.name}}{{#if currentPc.playerName}} <span class="stonetop-guide-banner-player">({{currentPc.playerName}})</span>{{/if}}</div>
        {{#if currentPc.playbookName}}<div class="stonetop-guide-banner-sub">{{currentPc.playbookName}}</div>{{/if}}
      </div>
      <div class="stonetop-guide-count">{{currentPc.index}} / {{currentPc.total}}</div>
    </div>
    {{/if}}

    {{#if placeInLine}}
    <div class="stonetop-intros-place stonetop-intros-place--{{placeInLine.state}}">
      <i class="fas {{placeInLine.icon}}"></i>
      <span class="stonetop-intros-place-text">{{placeInLine.text}}{{#if placeInLine.pcNote}} <span class="stonetop-intros-place-pc">{{placeInLine.pcNote}}</span>{{/if}}</span>
    </div>
    {{/if}}

    {{!-- Nobody's turn as far as this window can tell: everyone is done with this step, or the PC
          whose turn it was has gone. A wait, not the first PC being up. --}}
    {{#if waiting}}
    <div class="stonetop-intros-place stonetop-intros-place--wait">
      <i class="fas fa-hourglass-half"></i>
      <span class="stonetop-intros-place-text">Waiting for the GM to move on to the next turn.</span>
    </div>
    {{/if}}

    {{!-- A second GM: who is running the table, in place of the controls only they have. --}}
    {{#if watchingNote}}
    <div class="stonetop-intros-place stonetop-intros-place--watching">
      <i class="fas fa-eye"></i>
      <span class="stonetop-intros-place-text">{{this.watchingNote}}</span>
    </div>
    {{/if}}

    <div class="stonetop-intros-instruction">{{{this.instruction}}}</div>

    {{#if capture.isStep}}
    {{!-- ── Looping answer/ask step ─────────────────────────────────────────── --}}

    {{#if capture.hasRecorded}}
    <div class="stonetop-intros-recorded-list">
      <p class="stonetop-intros-recorded-list-label">
        <i class="fas fa-feather"></i>
        {{#if capture.isAsk}}Asked so far{{else}}Recorded so far{{/if}} ({{capture.answeredCount}}{{#if capture.total}} / {{capture.total}}{{/if}})
      </p>
      <ul>
        {{#each capture.recorded}}
        <li{{#if ../capture.canManage}} class="stonetop-intros-recorded-item--managed"{{/if}}>
          <div class="stonetop-intros-recorded-body">
          {{#if this.question}}<span class="stonetop-intros-recorded-q">{{{this.question}}}</span>{{/if}}
          {{#if this.editing}}
          {{!-- The GM rewording a recorded answer in place. --}}
          <textarea class="stonetop-intros-recorded-edit-field" rows="3" aria-label="{{this.editLabel}}">{{this.editText}}</textarea>
          <span class="stonetop-intros-recorded-edit-actions">
            <button type="button" class="stonetop-intros-recorded-cancel">Cancel</button>
            <button type="button" class="stonetop-intros-recorded-save stonetop-guide-btn--primary">Save</button>
          </span>
          {{else}}
          <span class="stonetop-intros-recorded-a">{{this.answer}}</span>
          {{/if}}
          {{!-- Who it was recorded as being about, where somebody picked. The only part of an
                answer that is not in its own writing, so it is said back here. --}}
          {{#if this.about}}<span class="stonetop-intros-recorded-about"><i class="fas fa-arrow-right"></i> {{this.about}}</span>{{/if}}
          </div>
          {{#if ../capture.canManage}}{{#unless this.editing}}
          {{!-- The GM's corrections to a recorded answer. Icon buttons, so each says what it does
                to a screen reader (aria-label) and on hover (data-tooltip). --}}
          <span class="stonetop-intros-recorded-tools">
            <button type="button" class="stonetop-intros-recorded-edit"
                    data-actor-id="{{../capture.actorId}}" data-step-key="{{../capture.stepKey}}" data-answer-index="{{this.index}}"
                    aria-label="{{this.editLabel}}" data-tooltip="{{this.editLabel}}">
              <i class="fas fa-pen" aria-hidden="true"></i>
            </button>
            <button type="button" class="stonetop-intros-recorded-delete"
                    data-actor-id="{{../capture.actorId}}" data-step-key="{{../capture.stepKey}}" data-answer-index="{{this.index}}"
                    aria-label="{{this.deleteLabel}}" data-tooltip="{{this.deleteLabel}}">
              <i class="fas fa-trash" aria-hidden="true"></i>
            </button>
          </span>
          {{/unless}}{{/if}}
        </li>
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if capture.passed}}
    <div class="stonetop-intros-passed">
      <i class="fas fa-check-circle"></i> <span>Passed: no more questions this step.</span>
      {{#if capture.canManage}}
      <button type="button" class="stonetop-intros-unpass" data-actor-id="{{capture.actorId}}" data-step-key="{{capture.stepKey}}"
              data-tooltip="{{capture.unpassLabel}}: they can answer again" aria-label="{{capture.unpassLabel}}">Un-pass</button>
      {{/if}}
    </div>
    {{else if capture.noQuestions}}
    {{!-- A playbook the introductions have no questions for: nothing to pick, so nothing to wait on. --}}
    <div class="stonetop-intros-place stonetop-intros-place--wait">
      <i class="fas fa-circle-info"></i>
      <span class="stonetop-intros-place-text">{{currentPc.name}}'s playbook has no questions for this step, so they sit this one out.</span>
    </div>
    {{else}}

    {{#if hasQuestions}}
    <div class="stonetop-intros-questions-wrap">
      <p class="stonetop-intros-questions-label">
        {{#if capture.canEdit}}{{#if capture.isAsk}}Choose a question to ask{{else}}Choose a question to answer{{/if}}{{else}}{{#if capture.isAsk}}They can ask:{{else}}They can answer:{{/if}}{{/if}}
      </p>
      <ul class="stonetop-intros-questions">
        {{#each questions}}
        {{#if ../capture.canEdit}}
        <li>
          <button type="button" class="stonetop-intros-question-pick{{#if isSelected}} is-selected{{/if}}{{#if isUsed}} is-used{{/if}}"
                  {{#if isUsed}}disabled data-tooltip="Already answered: pick a different one"{{/if}}
                  data-actor-id="{{../capture.actorId}}" data-step-key="{{../capture.stepKey}}" data-q-index="{{this.index}}">
            {{{this.html}}}
          </button>
        </li>
        {{else}}
        <li class="stonetop-intros-question-static{{#if isSelected}} is-selected{{/if}}{{#if isUsed}} is-used{{/if}}">{{{this.html}}}</li>
        {{/if}}
        {{/each}}
      </ul>
    </div>
    {{/if}}

    {{#if capture.canEdit}}
    <div class="stonetop-intros-capture">
      {{> "stonetop.intros-capture-head"}}
      <textarea class="stonetop-intros-draft" rows="3"
                data-actor-id="{{capture.actorId}}" data-step-key="{{capture.stepKey}}"
                placeholder="{{capture.placeholder}}">{{capture.draftAnswer}}</textarea>
      {{!-- Who at this table the answer is about. Optional, and blank by default: plenty of
            answers are about somebody outside the party, and nobody should have to name a
            player character to record one. What it buys is the arrow on The Party map of the
            relationship maps, which otherwise has only the names in the writing to go on. --}}
      {{#if capture.hasAbout}}
      <label class="stonetop-intros-about">
        <span class="stonetop-intros-about-label">{{#if capture.isAsk}}Who did you ask?{{else}}Who is this about?{{/if}}</span>
        <select class="stonetop-intros-about-pick"
                data-actor-id="{{capture.actorId}}" data-step-key="{{capture.stepKey}}"
                data-tooltip="Naming somebody here draws the arrow to them on The Party map of the relationship maps. Leave it blank when the answer is about someone outside the party.">
          <option value="">Nobody at this table</option>
          {{#each capture.about}}
          <option value="{{this.id}}" {{#if this.isSelected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
    </div>
    {{else if capture.canPreview}}
    {{!-- GM watching the active player type: read-only mirror, no data-* so no stray write. --}}
    <div class="stonetop-intros-capture">
      <label class="stonetop-intros-capture-label"><i class="fas fa-feather"></i> {{#if currentPc.name}}{{currentPc.name}} is writing…{{else}}Their answer, as they write it…{{/if}}</label>
      <textarea class="stonetop-intros-draft" rows="3" readonly
                placeholder="{{capture.placeholder}}">{{capture.draftAnswer}}</textarea>
      {{#if capture.aboutName}}
      <p class="stonetop-intros-about-said"><i class="fas fa-arrow-right"></i> {{#if capture.isAsk}}Asking{{else}}About{{/if}} <strong>{{capture.aboutName}}</strong></p>
      {{/if}}
    </div>
    {{/if}}

    {{/if}}{{!-- /capture.passed --}}

    {{#if stepReady}}
    <div class="stonetop-intros-ready-tally{{#if stepReady.all}} is-all{{/if}}">
      <i class="fas fa-users"></i>
      {{stepReady.count}} / {{stepReady.total}} done{{#if stepReady.all}}, everyone's passed or answered all{{/if}}
    </div>
    {{/if}}

    {{else if capture}}
    {{!-- ── Narration round (1–3): one plain-string answer ──────────────────── --}}
    {{#if capture.canEdit}}
    <div class="stonetop-intros-capture">
      {{> "stonetop.intros-capture-head"}}
      <textarea class="stonetop-intros-answer" rows="3"
                data-actor-id="{{capture.actorId}}" data-round-key="{{capture.key}}"
                placeholder="{{capture.placeholder}}">{{capture.answer}}</textarea>
    </div>
    {{else if capture.canPreview}}
    {{!-- GM watching the active player type their narration: read-only mirror, no data-* so no stray write. --}}
    <div class="stonetop-intros-capture">
      <label class="stonetop-intros-capture-label"><i class="fas fa-feather"></i> {{#if currentPc.name}}{{currentPc.name}} is writing…{{else}}Their answer, as they write it…{{/if}}</label>
      <textarea class="stonetop-intros-answer" rows="3" readonly
                placeholder="{{capture.placeholder}}">{{capture.answer}}</textarea>
    </div>
    {{else if capture.answer}}
    {{!-- What the narrator has written so far. Their turn is still going, so it is labelled as
          being written rather than as a finished record. --}}
    <div class="stonetop-intros-recorded">
      <span class="stonetop-intros-recorded-label">{{#if currentPc.name}}{{currentPc.name}} is writing…{{else}}Being written…{{/if}}</span>
      <p class="stonetop-intros-recorded-text">{{capture.answer}}</p>
    </div>
    {{/if}}
    {{/if}}

    </div>
  </div>
  {{/if}}

  {{!-- ── Navigation ─────────────────────────────────────────────────────────── --}}
  <div class="stonetop-guide-nav">
    {{#if isPreCheck}}

    {{#if isGM}}
    <button class="stonetop-intros-begin stonetop-guide-btn--primary" {{#unless canBegin}}disabled{{/unless}}>
      Begin Introductions<span class="stonetop-nav-arrow"></span>
    </button>
    {{else}}
    <span class="stonetop-intros-turn-hint">Waiting for the GM to begin…</span>
    {{/if}}

    {{else if isDone}}

    {{#if isDriver}}<button class="stonetop-intros-back"><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>{{else}}<span class="stonetop-intros-turn-hint"></span>{{/if}}
    <span class="stonetop-intros-step-label">{{this.stepLabel}}</span>
    <span class="stonetop-intros-done-actions">
      {{#unless watchingNote}}
      <button class="stonetop-intros-close stonetop-guide-btn--primary"{{#if isDriver}} data-tooltip="Saves everyone's recorded answers to the Chronicle journal, then closes." data-tooltip-direction="UP"{{/if}}>{{#if isDriver}}Save to Chronicle{{else}}Let spring burst forth!{{/if}}</button>
      {{/unless}}
    </span>

    {{else}}

    {{#if isDriver}}
    <button class="stonetop-intros-back" {{#if isPrevDisabled}}disabled{{/if}}><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>
    {{else}}
    {{!-- Empty left-flank spacer: keeps the nav's 1fr/auto/1fr grid centring the step
          label now that players have no turn-hint here (the banner + place-in-line strip
          above carry whose turn it is and where the viewer sits in line). --}}
    <span class="stonetop-intros-turn-hint"></span>
    {{/if}}
    <span class="stonetop-intros-step-label">{{this.stepLabel}}</span>
    <span class="stonetop-intros-nav-actions">
      {{#if capture.canEdit}}{{#if capture.canPass}}<button class="stonetop-intros-pass">Pass</button>{{/if}}{{/if}}
      {{#if capture.canDone}}<button class="stonetop-intros-done stonetop-guide-btn--primary">Done</button>{{/if}}
      {{#if isDriver}}<button class="stonetop-intros-next stonetop-guide-btn--primary">{{#if stepReady.all}}Everyone's done, continue{{else}}Next{{/if}}<span class="stonetop-nav-arrow"></span></button>{{/if}}
    </span>

    {{/if}}
  </div>

</div>
