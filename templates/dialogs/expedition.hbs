{{!-- Expedition walkthrough. Reuses the spring dialog's shared chrome
      (.stonetop-guide-*) and body/qa/tier styling (.stonetop-spring-*); only the
      Chart-a-Course / arriving-home checklist and Die of Fate button are new
      (.stonetop-exp-*). See dialogs/ExpeditionDialog.js. --}}
<div class="stonetop-spring">

  <div class="stonetop-guide-split">

    {{!-- Jump-to-step table of contents (journal-style; shared guide-toc partial). --}}
    {{> "stonetop.guide-toc" ariaLabel="Expedition steps"}}

    <div class="stonetop-guide-main">

    <div class="stonetop-guide-banner">
      <i class="fas {{step.icon}} stonetop-guide-banner-icon"></i>
      <div class="stonetop-guide-banner-info">
        <div class="stonetop-guide-banner-title">{{step.title}}</div>
        {{!-- Past the opening step this reads "Run an expedition: <the trip's name>",
              which is where the read-only nameplate under the log bar used to say it.
              Truncated, because the name is whatever the table typed. --}}
        <div class="stonetop-guide-banner-sub stonetop-guide-truncate">{{bannerSub}}</div>
      </div>
      <div class="stonetop-guide-count">{{stepIndex}} / {{stepCount}}</div>
    </div>

    {{!-- Expedition-log bar: name the current trip, switch between logged trips, or
          start a fresh one. Each trip with content becomes its own Chronicle page.
          The opening step only — see the `editable` note in ExpeditionDialog getData.
          Every later step reads the trip's name off the banner above instead. --}}
    {{#if expedition.editable}}
    <div class="stonetop-exp-bar">
      <label class="stonetop-exp-bar-field">
        <span class="stonetop-exp-bar-label">Expedition</span>
        <input type="text" class="stonetop-exp-title" value="{{expedition.title}}"
               placeholder="Name this expedition (e.g. The Wandering Tower)">
      </label>
      {{#if expedition.hasMultiple}}
      <select class="stonetop-exp-switch" aria-label="Switch expedition">
        {{#each expedition.options}}
        <option value="{{id}}" {{#if isCurrent}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{/if}}
      {{#if expedition.hasAny}}
      <button type="button" class="stonetop-exp-delete" title="Delete this expedition" aria-label="Delete this expedition">
        <i class="fas fa-trash"></i>
      </button>
      {{/if}}
      <button type="button" class="stonetop-exp-new" title="Start a new expedition">
        <i class="fas fa-plus"></i> New
      </button>
    </div>
    {{/if}}

    <div class="stonetop-spring-body">{{{step.body}}}</div>

    {{!-- A headed aside below the body: advice this step doesn't walk you through,
          set off from the prose but always shown. Currently the intro step's "What to
          prep", which used to be a twelfth step past Going home. --}}
    {{#if aside}}
    <div class="stonetop-guide-aside">
      <h3 class="stonetop-guide-aside-head">{{aside.label}}</h3>
      <div class="stonetop-guide-aside-body stonetop-spring-body">{{{aside.body}}}</div>
    </div>
    {{/if}}

    {{!-- Route step: the regional maps and the book's travel times (built in
          ExpeditionDialog getData). Its own partial — the panel is long, and this
          template is already the biggest in the dialogs folder. --}}
    {{#if journey}}{{> "stonetop.expedition-journey" journey=journey}}{{/if}}

    {{!-- Outfit step: live party-load readout (GM-only; built in ExpeditionDialog
          getData). One row per party member, scoped to the current expedition. --}}
    {{#if loadReadout}}
    <div class="stonetop-exp-load">
      <div class="stonetop-exp-load-head">
        <span class="stonetop-exp-load-title"><span class="stonetop-glyph stonetop-glyph--diamond">◇</span> Party load</span>
        <span class="stonetop-exp-load-live">live from sheets</span>
      </div>

      {{#if loadReadout.chips.length}}
      <div class="stonetop-exp-load-pick">
        <span class="stonetop-exp-load-picklab">On this trip:</span>
        {{#each loadReadout.chips}}
        <button type="button" class="stonetop-exp-load-chip{{#unless on}} is-out{{/unless}}" data-actor-id="{{id}}">
          <span class="tick">✓</span> {{name}}
        </button>
        {{/each}}
      </div>
      {{/if}}

      {{#if loadReadout.hasRows}}
      <div class="stonetop-exp-load-glance">
        <span class="g-head">Setting out</span>
        {{#if loadReadout.summary.anyOver}}<span class="g-tally g-warn"><b>{{loadReadout.summary.overloaded}}</b> overloaded</span>{{/if}}
        {{#if loadReadout.summary.anyHeavy}}<span class="g-tally g-caut"><b>{{loadReadout.summary.heavy}}</b> heavy</span>{{/if}}
        {{#if loadReadout.summary.anySneak}}<span class="g-tally"><b>{{loadReadout.summary.cantSneak}}</b> can't move quiet</span>{{/if}}
        {{#unless loadReadout.summary.anySneak}}<span class="g-tally g-ok">all set to move</span>{{/unless}}
      </div>

      {{#each loadReadout.rows}}
      <div class="stonetop-exp-load-row {{levelClass}}{{#if isFollower}} is-follower{{/if}}">
        <span class="stonetop-exp-load-ava">{{initial}}</span>
        <span class="stonetop-exp-load-name">{{name}}{{#if sub}} <em>{{sub}}</em>{{/if}}{{#if folTag}} <span class="stonetop-exp-load-fol">{{folTag}}</span>{{/if}}</span>
        <span class="stonetop-exp-load-track">
          {{#each bands}}<span class="stonetop-exp-load-band">{{#each pips}}<i class="stonetop-exp-load-pip{{#if on}} on{{/if}}"></i>{{/each}}</span>{{/each}}
          {{#if overflow}}<span class="stonetop-exp-load-over">+{{overflow}}</span>{{/if}}
        </span>
        <span class="stonetop-exp-load-pill {{pillClass}}">{{levelLabel}}</span>
        <span class="stonetop-exp-load-count"><b>{{marks}}</b>/{{cap}}</span>
        {{#if gated.length}}
        <span class="stonetop-exp-load-gated">
          {{#each gated}}<span class="stonetop-exp-load-move {{#if active}}on{{else}}off{{/if}}"><span class="ic">{{#if active}}✓{{else}}✕{{/if}}</span> <span class="nm">{{name}}</span> <span class="rq">{{req}}</span></span>{{/each}}
        </span>
        {{/if}}
        {{#if packHorse}}<span class="stonetop-exp-load-note"><span class="mod">▲ Pack Horse</span> {{packHorse}}</span>{{/if}}
        {{#if note}}<span class="stonetop-exp-load-note{{#if noteDanger}} danger{{/if}}">{{#if noteDanger}}⚠ {{/if}}{{note}}</span>{{/if}}
      </div>
      {{/each}}
      {{else}}
      <p class="stonetop-exp-load-empty">No one's on this trip yet. Pick who's coming above.</p>
      {{/if}}
    </div>
    {{/if}}

    {{!-- Requisition step: the steading's communal assets, and which of them this trip
          takes (GM-only; built in ExpeditionDialog getData). Clicking an on-hand asset
          marks it out on the steading sheet, tagged with this expedition; clicking one
          that is already ours sends it home. --}}
    {{#if assetPicker}}
    <div class="stonetop-exp-assets">
      <div class="stonetop-exp-assets-head">
        <span class="stonetop-exp-assets-title"><span class="stonetop-glyph stonetop-glyph--diamond">◇</span> Steading assets</span>
        <span class="stonetop-exp-assets-live">live from the steading</span>
      </div>

      {{#if assetPicker.hasSteading}}
        {{#if assetPicker.hasRows}}
        <p class="stonetop-exp-assets-hint">
          Click what they leave with. It shows struck through on {{assetPicker.steadingName}}&rsquo;s sheet, named to this expedition, until you click it again to bring it home.
        </p>
        <ul class="stonetop-exp-assets-list">
          {{#each assetPicker.rows}}
          <li class="stonetop-exp-asset{{#if stateClass}} {{stateClass}}{{/if}}">
            {{!-- Where it went is printed under the row rather than hung off the button as a
                  tooltip: the button is disabled, and a disabled control fires no pointer
                  events, so a tooltip on it would never open. --}}
            <button type="button" class="stonetop-exp-asset-btn"
                    data-asset-index="{{index}}" data-take="{{take}}"
                    {{#if elsewhere}}disabled{{/if}}>
              <span class="tick">{{glyph}}</span>
              <span class="nm">{{name}}</span>
            </button>
            {{#if elsewhere}}<span class="stonetop-exp-asset-where">{{where}}</span>{{/if}}
          </li>
          {{/each}}
        </ul>
        <p class="stonetop-exp-assets-foot">
          {{#if assetPicker.takenCount}}Going with them: <b>{{assetPicker.takenCount}}</b>. Bring it back safely.
          {{else}}Nothing of the village&rsquo;s is going with them yet.{{/if}}
        </p>
        {{else}}
        <p class="stonetop-exp-assets-empty">{{assetPicker.steadingName}} has no assets listed yet. Add them on the steading sheet.</p>
        {{/if}}
      {{else}}
      <p class="stonetop-exp-assets-empty">No steading sheet in this world yet, so there is nothing to requisition from.</p>
      {{/if}}
    </div>
    {{/if}}

    {{#if showRoll}}
    <div class="stonetop-spring-roll-wrap">
      {{#if roll}}
      <div class="stonetop-spring-roll-result stonetop-spring--{{roll.tier}}">
        <span class="stonetop-spring-roll-result-total">{{roll.total}}</span>
        <span class="stonetop-spring-roll-result-label">{{{roll.label}}}</span>
      </div>
      <button type="button" class="stonetop-exp-roll-btn stonetop-spring-roll-btn">
        <i class="fas fa-rotate-right"></i> Roll again
      </button>
      {{else}}
      <button type="button" class="stonetop-exp-roll-btn stonetop-spring-roll-btn stonetop-spring-roll-btn--primary">
        <i class="fas fa-dice"></i> Roll +Fortunes ({{fortunesLabel}})
      </button>
      {{/if}}
    </div>
    {{/if}}

    {{#if showTiers}}
    <ul class="stonetop-spring-tiers">
      {{#each tiers}}
      <li class="stonetop-spring-tier{{#if isActive}} is-active{{/if}}">
        <span class="stonetop-spring-tier-label">{{{label}}}</span>
        <span class="stonetop-spring-tier-text">{{{text}}}</span>
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{#if showFate}}
    <div class="stonetop-spring-roll-wrap">
      <button type="button" class="stonetop-exp-fate-btn stonetop-spring-roll-btn stonetop-spring-roll-btn--primary">
        <i class="fas fa-dice-d6"></i> Roll the Die of Fate
      </button>
    </div>
    {{/if}}

    {{#if qa}}
    <div class="stonetop-spring-qa-wrap">

      {{#if (eq qa.kind "checklist")}}
        {{#if qa.intro}}
        <div class="stonetop-spring-qa">
          <p class="stonetop-spring-qa-prompt">{{{qa.intro.prompt}}}</p>
          <textarea class="stonetop-exp-field stonetop-spring-qa-answer" rows="2"
                    data-answer-path="{{qa.intro.path}}"
                    placeholder="{{qa.intro.placeholder}}">{{qa.intro.value}}</textarea>
        </div>
        {{/if}}
        {{#each qa.groups}}
        <div class="stonetop-exp-checkgroup">
          <div class="stonetop-exp-checkgroup-label">{{label}}</div>
          <ul class="stonetop-exp-checks">
            {{#each items}}
            <li class="stonetop-exp-check">
              <label>
                <input type="checkbox" class="stonetop-exp-checkbox"
                       data-answer-path="{{path}}" {{#if checked}}checked{{/if}}>
                <span>{{{text}}}</span>
              </label>
            </li>
            {{/each}}
          </ul>
        </div>
        {{/each}}
        {{#if qa.notes}}
        <div class="stonetop-spring-qa">
          <p class="stonetop-spring-qa-prompt">{{{qa.notes.prompt}}}</p>
          <textarea class="stonetop-exp-field stonetop-spring-qa-answer" rows="2"
                    data-answer-path="{{qa.notes.path}}"
                    placeholder="{{qa.notes.placeholder}}">{{qa.notes.value}}</textarea>
        </div>
        {{/if}}

      {{else}}
      <div class="stonetop-spring-qa">
        <p class="stonetop-spring-qa-prompt">{{{qa.prompt}}}</p>
        <textarea class="stonetop-exp-field stonetop-spring-qa-answer" rows="2"
                  data-answer-path="{{qa.path}}"
                  placeholder="{{qa.placeholder}}">{{qa.answer}}</textarea>
      </div>
      {{/if}}

    </div>
    {{/if}}

    </div>

    {{!-- EXPLORATION MOVES — a permanent right-hand rail, on every step, wearing the
          character sheet's own sidebar chrome (.stonetop-moves-sidebar and its collapse
          handle) so the two read as the same furniture. The modifier class is what makes
          it fit here: the character sheet's rail is `width: max-content` around short
          names like "Aid", and these seven run to "Introduce a danger, person, or
          faction", so this one is a fixed column whose names wrap.

          Reference only. Nothing here rolls and nothing is stored: a GM move is something
          you say. That is why the rows are plain <li>, with none of the `data-item-id` /
          `.rollable` machinery the character sheet's rows carry.

          The list comes from module/gm-toolkit/gm-moves.js, by way of
          EXPLORATION_SIDEBAR_MOVES, so the walkthrough and the GM Toolkit's Moves tab
          cannot come to word the same move differently. --}}
    <div class="stonetop-moves-sidebar stonetop-guide-moves-sidebar{{#if movesRailCollapsed}} is-collapsed{{/if}}">
      <button type="button" class="stonetop-sidebar-toggle"
              aria-expanded="{{#if movesRailCollapsed}}false{{else}}true{{/if}}"
              aria-label="{{#if movesRailCollapsed}}Expand exploration moves{{else}}Collapse exploration moves{{/if}}">
        <i class="fas fa-chevron-right"></i>
      </button>
      <div class="stonetop-sidebar-body">
        {{!-- ONE collapse, the edge handle above, and no second one on the heading.

              This rail used to carry the character sheet's group fold as well — the whole
              `.stonetop-moves-collapsible` / `.stonetop-moves-summary` pair, a `role="button"`
              heading with a rotating caret that clamped the list to zero height. That is the
              right control on a sheet, where one sidebar holds four groups and folding one of
              them is how you get to the others. Here there is exactly ONE group and it is the
              only thing in the column, so folding it away leaves a heading floating over an
              empty rail — while the handle beside it already collapses the whole column and
              hands its 200px back to the step, which is what a reader who wants the moves out
              of the way actually wants. Two controls, one useful outcome.

              Dropping the caret also gives the title back the 14px it took, which is the
              difference between "Exploration moves" fitting on one line in a 200px column and
              breaking after the first word.

              So the heading is a plain heading now: no role, no tabindex, no aria-expanded, no
              handler. Do not reach for the shared collapsible classes to re-style it — they
              carry the caret and the clamp with them. --}}
        <div class="stonetop-guide-moves-head">
          {{!-- `note` rather than a line of our own: it is the same "what this list is"
                caption the GM Toolkit's move groups carry. It is an inline span by
                default, which tucks against the title in a column this narrow, so the
                modifier's CSS drops it onto its own line. --}}
          {{> "stonetop.section-heading" title="Exploration moves" note="once they leave town"}}
          {{!-- The die: draw one of the seven at random, run a light down the list to it, and
                whisper it to the GM — the same control, the same walk and the same card the GM
                Toolkit's move groups carry (module/gm-toolkit/random-gm-move.js). This rail is
                the other place a GM reaches for an exploration move, and mid-leg with the table
                waiting is exactly the moment seven of them read as soup.

                A SIBLING of the heading rather than the section-heading partial's `randomize=`
                parameter, which would emit it inside the <h3>. Out here it is a flex item, so it
                sits at the end of the title's line without the heading having to hold it, and
                the caption underneath keeps the full width of the column.

                GM-only, like the load readout and the asset picker on their own steps: the card
                is whispered to the GMs, so a player clicking this would get silence. --}}
          {{#if movesRandomize}}
          {{> "stonetop.section-randomize" section=movesRandomize title=movesRandomizeTitle}}
          {{/if}}
        </div>
        <ol class="items-list stonetop-guide-moves-list">
          {{#each explorationMoves}}
          {{!-- `data-move` is how the randomizer finds the row it just drew, the same way the
                GM Toolkit's list is matched: by NAME, not by index, because the index would be
                a position this template is free to reorder while the handler kept counting. --}}
          <li class="stonetop-guide-move" data-move="{{name}}">
            <span class="stonetop-guide-move-name">{{name}}</span>
            <span class="stonetop-guide-move-gloss">{{gloss}}</span>
          </li>
          {{/each}}
        </ol>
      </div>
    </div>

  </div>

  <div class="stonetop-guide-nav">
    <button class="stonetop-spring-back" {{#if isFirst}}disabled{{/if}}><span class="stonetop-nav-arrow stonetop-nav-arrow--back"></span>Back</button>
    <span class="stonetop-spring-step-label">{{stepLabel}}</span>
    {{#if isLast}}
    <span class="stonetop-exp-done-actions">
      {{#if isGM}}<button type="button" class="stonetop-exp-chronicle" data-tooltip="Compiles each logged trip into the Expeditions journal (in a &quot;The Chronicle&quot; folder), GM-only." data-tooltip-direction="UP"><i class="fas fa-feather"></i> Save to the Chronicle</button>{{/if}}
      <button class="stonetop-spring-done stonetop-guide-btn--primary">Done ✦</button>
    </span>
    {{else}}
    <button class="stonetop-spring-next">Next<span class="stonetop-nav-arrow"></span></button>
    {{/if}}
  </div>

</div>
