{{!-- Shared, book-faithful "GM note" hazard card. Rendered from buildHazardCardVM
      by the page sheet (view), the steading tab's Hazards section, and the canvas
      overlay. It reuses the threat card's classes (.threat-card wrapper, portent
      checkboxes) so the shared threat-view wiring and the card CSS apply unchanged;
      hazard-specific rows carry .hazard-* classes on top. --}}
<article class="threat-card threat-card--hazard hazard-card{{#if collapsed}} is-collapsed{{/if}}{{#if canDrag}} is-draggable{{/if}}"
         data-hazard-id="{{this.id}}" data-page-uuid="{{this.uuid}}" style="--threat-accent-raw:{{this.accent}};"{{#if canDrag}} draggable="true"{{/if}}>
	{{> "stonetop.card-head" kind="hazard" typeLabel="Hazard"}}

	{{#if hasInstinct}}
	<p class="threat-instinct"><span class="threat-label">Instinct</span><em>{{this.instinct}}</em></p>
	{{/if}}

	{{#if hasDamage}}
	<p class="hazard-damage{{#if certainDeath}} hazard-damage--certain{{/if}}">
		<span class="threat-label">Damage</span><strong>{{this.damage}}</strong>
		{{!-- GM only (buildHazardCardVM): wired by hazards/hazard-damage.js#wireHazardDamage. --}}
		{{#if canRollDamage}}
		<button type="button" class="hazard-damage-btn hazard-damage-roll"
		        data-tooltip="{{localize "stonetop.hazards.damage.rollTip"}}" data-tooltip-direction="UP">
			<i class="fas fa-dice-d20" aria-hidden="true"></i> {{localize "stonetop.hazards.damage.roll"}}
		</button>
		{{/if}}
		{{#if canCertainDeath}}
		<button type="button" class="hazard-damage-btn hazard-certain-death"
		        data-tooltip="{{localize "stonetop.hazards.damage.certainDeathTip"}}" data-tooltip-direction="UP">
			<i class="fas fa-skull" aria-hidden="true"></i> {{localize "stonetop.hazards.damage.certainDeath"}}
		</button>
		{{/if}}
	</p>
	{{/if}}

	{{#if hasDescription}}
	<div class="threat-desc">{{{this.description}}}</div>
	{{/if}}

	{{#if hasAdvanceTrigger}}
	<p class="hazard-advance"><span class="threat-label">Advance</span>{{this.advanceTrigger}}</p>
	{{/if}}

	{{#if hasDoomTrack}}
	{{> "stonetop.card-doom-track"}}
	{{/if}}

	{{> "stonetop.card-gm-moves"}}

	{{> "stonetop.card-player-moves"}}
</article>
